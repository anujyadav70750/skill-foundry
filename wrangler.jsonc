{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"hub",
  "main":"./src/worker.js",
  "compatibility_date":"2026-09-07",
  "secrets":{
    "required":["GITHUB_TOKEN"]
  },
  "assets":{
    "directory":"./dist",
    "binding":"ASSETS",
    "run_worker_first":["/api/*","/resources/*","/admin","/admin/*"]
  }
}
