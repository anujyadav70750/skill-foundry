{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hub",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-07",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "skill-foundry-analytics",
      "database_id": "484225c7-1cab-407d-a472-6455569b489f"
    }
  ],
  "secrets": {
    "required": [
      "GITHUB_TOKEN",
      "ADMIN_PASSWORD"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/resources/*",
      "/admin",
      "/admin/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimitDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-rate-limit-do",
      "new_sqlite_classes": [
        "RateLimitDO"
      ]
    }
  ]
}
