<dialog class="sf-contact-dialog" id="sf-contact-dialog" aria-labelledby="sf-contact-title">
  <div class="sf-contact-panel">
    <div class="sf-contact-heading">
      <div class="sf-contact-heading-copy">
        <p class="sf-contact-eyebrow">CONTACT</p>
        <h2 id="sf-contact-title">Send us a message</h2>
        <p class="sf-contact-intro">Fields marked (*) are required.</p>
      </div>
      <button class="sf-contact-close" type="button" aria-label="Close contact form">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </button>
    </div>

    <form class="sf-contact-form" id="sf-contact-form" novalidate>
      <div class="sf-contact-grid">
        <label class="sf-contact-field">
          <span class="sf-contact-field-title">Name <span class="sf-contact-required" aria-hidden="true">*</span></span>
          <input name="name" type="text" autocomplete="name" maxlength="100" placeholder="Your name" required />
        </label>
        <label class="sf-contact-field">
          <span class="sf-contact-field-title">Email <span class="sf-contact-required" aria-hidden="true">*</span></span>
          <input name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required />
        </label>
      </div>

      <label class="sf-contact-field">
        <span class="sf-contact-field-title">Subject <span class="sf-contact-required" aria-hidden="true">*</span></span>
        <select name="subject-choice" id="sf-contact-subject" required>
          <option value="">Choose a subject</option>
          <option>General question</option>
          <option>Website or technical issue</option>
          <option>Question about a resource</option>
          <option>Feedback or suggestion</option>
          <option>Collaboration or business enquiry</option>
          <option value="Other">Other</option>
        </select>
      </label>

      <label class="sf-contact-field" id="sf-contact-other-wrap" hidden>
        <span class="sf-contact-field-title">Enter your subject <span class="sf-contact-required" aria-hidden="true">*</span></span>
        <input name="otherSubject" id="sf-contact-other" type="text" maxlength="160" placeholder="Write your subject" />
      </label>

      <label class="sf-contact-field">
        <span class="sf-contact-field-title">Message <span class="sf-contact-required" aria-hidden="true">*</span></span>
        <textarea name="message" rows="3" maxlength="5000" placeholder="Write your message here…" required></textarea>
      </label>

      <label class="sf-contact-honey" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>

      <div class="sf-contact-actions">
        <button type="submit" class="sf-contact-submit">Send message <span aria-hidden="true">→</span></button>
        <p class="sf-contact-status" role="status" aria-live="polite"></p>
      </div>
    </form>
  </div>
</dialog>

<script is:inline>
(() => {
  const dialog = document.getElementById('sf-contact-dialog');
  if (!dialog || dialog.dataset.ready) return;
  dialog.dataset.ready = 'true';

  const form = dialog.querySelector('#sf-contact-form');
  const close = dialog.querySelector('.sf-contact-close');
  const subject = dialog.querySelector('#sf-contact-subject');
  const otherWrap = dialog.querySelector('#sf-contact-other-wrap');
  const other = dialog.querySelector('#sf-contact-other');
  const message = form.querySelector('[name="message"]');
  const status = dialog.querySelector('.sf-contact-status');
  const submit = dialog.querySelector('.sf-contact-submit');
  let opener = null;

  document.querySelectorAll('[data-open-contact]').forEach(button => {
    button.addEventListener('click', () => {
      opener = button;
      // Keep browser-saved name/email suggestions, but start every message fresh.
      subject.value = '';
      message.value = '';
      other.value = '';
      other.required = false;
      otherWrap.hidden = true;
      status.textContent = '';
      status.className = 'sf-contact-status';
      submit.disabled = false;
      if (!dialog.open) dialog.showModal();
      // Do not focus an input on open: that can shift the dialog and clip its heading.
      close.focus({ preventScroll: true });
    });
  });

  const closeDialog = () => {
    dialog.close();
    if (opener?.isConnected) opener.focus({ preventScroll: true });
  };

  close.addEventListener('click', closeDialog);
  dialog.addEventListener('click', event => {
    if (event.target === dialog) closeDialog();
  });

  subject.addEventListener('change', () => {
    const isOther = subject.value === 'Other';
    otherWrap.hidden = !isOther;
    other.required = isOther;
    if (!isOther) other.value = '';
  });

  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (!form.reportValidity()) return;

    const email = form.elements.email.value.trim();
    if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      status.textContent = 'Enter a valid email address.';
      status.className = 'sf-contact-status error';
      return;
    }

    const chosenSubject = subject.value === 'Other' ? other.value.trim() : subject.value;
    if (!chosenSubject) {
      other.reportValidity();
      return;
    }

    submit.disabled = true;
    status.textContent = 'Sending message…';
    status.className = 'sf-contact-status';

    const data = {
      name: form.elements.name.value.trim(),
      email,
      subject: chosenSubject,
      message: message.value.trim(),
      website: form.elements.website.value
    };

    try {
      const response = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok || !result.ok) {
        throw new Error(result.error || 'We could not send your message. Please try again.');
      }

      form.reset();
      otherWrap.hidden = true;
      other.required = false;
      status.textContent = 'Message sent successfully. Thanks for reaching out.';
      status.className = 'sf-contact-status success';
    } catch (error) {
      status.textContent = error.message || 'We could not send your message. Please try again.';
      status.className = 'sf-contact-status error';
    } finally {
      submit.disabled = false;
    }
  });
})();
</script>

<style>
