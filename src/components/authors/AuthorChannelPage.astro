---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatResourceDate, resourceImageAlt, resourceDisplaySrcSet, resourceSlug, resourceThumbnail } from '../../lib/resource';
import { authorCategorySlug } from '../../lib/author';
const { profile, resources, basePath, view = 'home', categoryName = '' } = Astro.props;
const latestResources = resources.slice(0, 4);
const categories = [...new Set(resources.map((resource) => resource.data.category?.trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b));
const activeTab = view === 'about' ? 'about' : view === 'home' ? 'home' : 'resources';
const pagePath = view === 'home' ? basePath : view === 'category' ? basePath + 'category/' + authorCategorySlug(categoryName) + '/' : basePath + view + '/';
const pageTitle = view === 'home' ? profile.name + ' | Skill Foundry' : view === 'about' ? 'About ' + profile.name + ' | Skill Foundry' : view === 'category' ? categoryName + ' Resources by ' + profile.name + ' | Skill Foundry' : 'Resources by ' + profile.name + ' | Skill Foundry';
const categoryResources = view === 'category' ? resources.filter((resource) => resource.data.category?.trim() === categoryName) : [];
const pageUrl = 'https://hub.skillfoundry-web.workers.dev' + pagePath;
---
<BaseLayout title={pageTitle} description={profile.description} canonical={pageUrl} image={profile.image} imageAlt={profile.name + ' profile photograph'}>
  <main class="author-channel-page">
    <header class="author-channel-header">
      <div class="author-channel-shell">
        <div class="author-channel-profile">
          <img class="author-channel-photo" src={profile.image} alt={profile.name + ' profile photograph'} width="720" height="720" loading="eager" fetchpriority="high" decoding="async" />
          <div class="author-channel-identity">
            <p class="author-channel-role">{profile.role}</p>
            <h1>{profile.name}</h1>
            {profile.instagramUrl && profile.handle && (
              <a class="author-channel-handle" href={profile.instagramUrl} target="_blank" rel="noopener noreferrer">
                {profile.handle}
                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true"><path d="M4.5 11.5 11.5 4.5M5 4.5h6.5V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </a>
            )}
          </div>
        </div>
        <p class="author-channel-description">{profile.description}</p>
        <nav class="author-channel-tabs" aria-label={profile.name + ' sections'}>
          <a class:list={['author-channel-tab', activeTab === 'home' && 'is-active']} href={basePath} aria-current={activeTab === 'home' ? 'page' : undefined}>Home</a>
          <a class:list={['author-channel-tab', activeTab === 'resources' && 'is-active']} href={basePath + 'resources/'} aria-current={activeTab === 'resources' ? 'page' : undefined}>Resources</a>
          <a class:list={['author-channel-tab', activeTab === 'about' && 'is-active']} href={basePath + 'about/'} aria-current={activeTab === 'about' ? 'page' : undefined}>About</a>
        </nav>
      </div>
    </header>

    {view === 'home' && (
      <>
        <section class="author-home-latest">
          <div class="author-channel-content">
            <div class="author-section-heading"><h2><a class="category-heading-link" href={basePath + 'resources/'} aria-label="View all resources by this author"><span>Latest Resources</span><svg class="category-heading-chevron" aria-hidden="true" viewBox="0 0 16 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 5L10 12L3 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a></h2></div>
            {latestResources.length > 0 ? (
              <div class="author-latest-track" role="region" aria-label="Latest resources by this author">
                {latestResources.map((resource, index) => {
                  const thumbnail = resourceThumbnail(resource);
                  const alt = resourceImageAlt(resource);
                  const dateLabel = formatResourceDate(resource.data.date);
                  const srcSet = resourceDisplaySrcSet(resource.data.heroImage || resource.data.thumbnail || resource.data.inputImage);
                  return (
                    <a class="author-latest-card" href={'/resources/' + resourceSlug(resource) + '/'} aria-label={'Open ' + resource.data.title}>
                      <div class="author-latest-thumb"><img src={thumbnail} srcset={srcSet} sizes="(max-width: 700px) 72vw, 380px" alt={alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
                      <div class="author-latest-meta">
                        <span class="author-latest-category">{resource.data.category}</span>
                        <time class="author-latest-date" datetime={resource.data.date.toISOString()}>
                          <svg class="author-calendar-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                          </svg>
                          <span>{dateLabel}</span>
                        </time>
                      </div>
                      <h3>{resource.data.title}</h3>
                    </a>
                  );
                })}
              </div>
            ) : <p class="author-channel-empty">New resources will appear here when this author publishes them.</p>}
          </div>
        </section>
        {categories.map((category) => {
          const items = resources.filter((resource) => resource.data.category?.trim() === category).slice(0, 4);
          const categoryUrl = basePath + 'category/' + authorCategorySlug(category) + '/';
          return (
            <section class="author-home-category">
              <div class="author-channel-content">
                <div class="author-section-heading"><h2><a class="category-heading-link" href={categoryUrl} aria-label={'View all ' + category + ' resources'}><span>{category}</span><svg class="category-heading-chevron" aria-hidden="true" viewBox="0 0 16 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 5L10 12L3 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg></a></h2></div>
                <div class="author-resource-list">
                  {items.map((resource) => (
                    <a class="author-resource-row" href={'/resources/' + resourceSlug(resource) + '/'} aria-label={'Open ' + resource.data.title}>
                      <div class="author-resource-thumb"><img src={resourceThumbnail(resource)} srcset={resourceDisplaySrcSet(resource.data.heroImage || resource.data.thumbnail || resource.data.inputImage)} sizes="(max-width: 600px) 42vw, 260px" alt={resourceImageAlt(resource)} loading="lazy" decoding="async" /></div>
                      <div class="author-resource-copy">
                        <div class="author-resource-meta">
                          
                          <time class="author-resource-date" datetime={resource.data.date.toISOString()}>
                            <svg class="author-calendar-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                              <line x1="16" y1="2" x2="16" y2="6"></line>
                              <line x1="8" y1="2" x2="8" y2="6"></line>
                              <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>{formatResourceDate(resource.data.date)}</span>
                          </time>
                        </div>
                        <h3>{resource.data.title}</h3>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </section>
          );
        })}
        {resources.length === 0 && <section class="author-home-category"><div class="author-channel-content"><p class="author-channel-empty">Published resources will appear here as this author adds to the library.</p></div></section>}
      </>
    )}

    {view === 'resources' && (
      <section class="author-secondary-page"><div class="author-channel-content">
        {resources.length > 0 ? (
          <>
            <div class="author-resource-toolbar" aria-label="Filter author resources">
              <div class="author-resource-sort-tabs" role="group" aria-label="Resource order">
                <button class="author-resource-filter-tab is-active" type="button" data-author-sort="newest" aria-pressed="true">Latest</button>
                <button class="author-resource-filter-tab" type="button" data-author-sort="featured" aria-pressed="false">Featured</button>
                <button class="author-resource-filter-tab" type="button" data-author-sort="oldest" aria-pressed="false">Oldest</button>
              </div>
              {categories.length > 1 && (
                <div class="author-resource-category-tabs" role="group" aria-label="Filter by category">
                  <button class="author-resource-category-tab is-active" type="button" data-author-category="" aria-pressed="true">All</button>
                  {categories.map((category) => <button class="author-resource-category-tab" type="button" data-author-category={category} aria-pressed="false">{category}</button>)}
                </div>
              )}
            </div>
            <div class="author-resource-list" data-author-resource-list>
              {resources.map((resource) => (
                <a class="author-resource-row" href={'/resources/' + resourceSlug(resource) + '/'} data-author-resource-card data-category={resource.data.category} data-date={resource.data.date.toISOString()} data-featured={resource.data.featured ? 'true' : 'false'}>
                  <div class="author-resource-thumb"><img src={resourceThumbnail(resource)} srcset={resourceDisplaySrcSet(resource.data.heroImage || resource.data.thumbnail || resource.data.inputImage)} sizes="(max-width: 600px) 42vw, 260px" alt={resourceImageAlt(resource)} loading="lazy" decoding="async" /></div>
                  <div class="author-resource-copy">
                        <div class="author-resource-meta">
                          <span class="author-resource-category">{resource.data.category}</span>
                          <time class="author-resource-date" datetime={resource.data.date.toISOString()}>
                            <svg class="author-calendar-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                              <line x1="16" y1="2" x2="16" y2="6"></line>
                              <line x1="8" y1="2" x2="8" y2="6"></line>
                              <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>{formatResourceDate(resource.data.date)}</span>
                          </time>
                        </div>
                        <h3>{resource.data.title}</h3>
                      </div>
                </a>
              ))}
            </div>
            <p class="author-channel-empty" data-author-no-results hidden>No resources match your search. Try another word or category.</p>
          </>
        ) : <p class="author-channel-empty">This author has not published any resources yet.</p>}
      </div></section>
    )}

    {view === 'category' && (
      <section class="author-secondary-page"><div class="author-channel-content">
        <a class="author-back-link" href={basePath + 'resources/'}>All Resources <span aria-hidden="true">←</span></a>
        <div class="author-page-heading"><h2>{categoryName}</h2><p>{categoryResources.length} {categoryResources.length === 1 ? 'resource' : 'resources'} published in this category.</p></div>
        {categoryResources.length > 0 ? (
          <div class="author-resource-list">
            {categoryResources.map((resource) => (
              <a class="author-resource-row" href={'/resources/' + resourceSlug(resource) + '/'}>
                <div class="author-resource-thumb"><img src={resourceThumbnail(resource)} srcset={resourceDisplaySrcSet(resource.data.heroImage || resource.data.thumbnail || resource.data.inputImage)} sizes="(max-width: 600px) 42vw, 260px" alt={resourceImageAlt(resource)} loading="lazy" decoding="async" /></div>
                <div class="author-resource-copy">
                        <div class="author-resource-meta">
                          
                          <time class="author-resource-date" datetime={resource.data.date.toISOString()}>
                            <svg class="author-calendar-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                              <line x1="16" y1="2" x2="16" y2="6"></line>
                              <line x1="8" y1="2" x2="8" y2="6"></line>
                              <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                            <span>{formatResourceDate(resource.data.date)}</span>
                          </time>
                        </div>
                        <h3>{resource.data.title}</h3>
                      </div>
              </a>
            ))}
          </div>
        ) : <p class="author-channel-empty">No resources are currently published in this category.</p>}
      </div></section>
    )}

    {view === 'about' && (
      <section class="author-secondary-page"><div class="author-about-content">
        <section class="author-about-block"><h2>About the Author</h2>{profile.about.map((paragraph) => <p>{paragraph}</p>)}</section>
        {profile.expertise.length > 0 && <section class="author-about-block"><h2>Areas of Expertise</h2><div class="author-expertise-list">{profile.expertise.map((item) => <article><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></section>}
        <section class="author-about-block"><h2>Connect</h2><p>Follow {profile.name}'s work or get in touch through the website.</p><div class="author-about-links">{profile.instagramUrl && profile.handle && <a href={profile.instagramUrl} target="_blank" rel="noopener noreferrer">{profile.handle}<span aria-hidden="true">↗</span></a>}<a href="/contact/">Website Contact Form <span aria-hidden="true">→</span></a></div></section>
      </div></section>
    )}
  </main>
</BaseLayout>

{view === 'resources' && (
  <script data-astro-rerun>
    const list = document.querySelector<HTMLElement>('[data-author-resource-list]');
    if (list) {
      const cards = Array.from(list.querySelectorAll<HTMLElement>('[data-author-resource-card]'));
      const sortTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-author-sort]'));
      const categoryTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-author-category]'));
      const empty = document.querySelector<HTMLElement>('[data-author-no-results]');
      let activeSort = 'newest';
      let activeCategory = '';

      const update = () => {
        const matches = cards.filter((card) =>
          (!activeCategory || card.dataset.category === activeCategory) &&
          (activeSort !== 'featured' || card.dataset.featured === 'true')
        );
        matches.sort((a, b) => {
          const left = new Date(a.dataset.date || '').getTime();
          const right = new Date(b.dataset.date || '').getTime();
          return activeSort === 'oldest' ? left - right : right - left;
        });
        cards.forEach((card) => { card.hidden = true; });
        matches.forEach((card) => { card.hidden = false; list.appendChild(card); });
        if (empty) {
          empty.textContent = activeSort === 'featured'
            ? 'No featured resources have been selected yet.'
            : 'No resources are available in this category.';
          empty.hidden = matches.length > 0;
        }
      };

      sortTabs.forEach((tab) => tab.addEventListener('click', () => {
        activeSort = tab.dataset.authorSort || 'newest';
        sortTabs.forEach((item) => {
          const selected = item === tab;
          item.classList.toggle('is-active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        update();
      }));

      categoryTabs.forEach((tab) => tab.addEventListener('click', () => {
        activeCategory = tab.dataset.authorCategory || '';
        categoryTabs.forEach((item) => {
          const selected = item === tab;
          item.classList.toggle('is-active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        update();
      }));

      update();
    }
  </script>
)}

<style>
  .author-channel-page { padding-bottom: 28px; }
  .author-channel-header { padding: 31px 0 0; }
  .author-channel-shell, .author-channel-content { width: min(980px, calc(100% - 48px)); margin: 0 auto; }
  .author-channel-profile { display: flex; align-items: center; gap: 24px; }
  .author-channel-photo { display: block; flex: 0 0 156px; width: 156px; height: 156px; border: 1px solid var(--sf-page-border, rgba(255,255,255,.08)); border-radius: 50%; background: var(--sf-page-surface, #0B0D12); object-fit: cover; object-position: center; }
  .author-channel-identity { display: flex; min-width: 0; min-height: 132px; flex-direction: column; justify-content: center; padding-left: 24px; border-left: 1px solid var(--sf-page-border, rgba(255,255,255,.16)); }
  .author-channel-role { margin: 0 0 5px; color: var(--sf-page-copy, #A1A9B6); font: 600 12px/1.4 'Plus Jakarta Sans', system-ui, sans-serif; letter-spacing: .04em; }
  .author-channel-identity h1 { margin: 0; color: var(--sf-page-heading, #F5F5F5); font: 500 clamp(30px, 4vw, 42px)/1.08 'Newsreader', Georgia, serif; letter-spacing: -.025em; }
  .author-channel-handle { display: inline-flex; align-items: center; gap: 5px; width: max-content; margin-top: 9px; color: var(--sf-page-accent, #35C9C1); font: 600 13px/1.4 'Plus Jakarta Sans', system-ui, sans-serif; text-decoration: none; }
  .author-channel-handle:hover { text-decoration: underline; text-underline-offset: 3px; }
  .author-channel-description { max-width: 760px; margin: 18px 0 0; color: var(--sf-page-copy, #A1A9B6); font: 400 14px/1.65 'Plus Jakarta Sans', system-ui, sans-serif; }
  .author-channel-tabs { display: flex; align-items: stretch; gap: 30px; min-height: 48px; margin-top: 21px; border-bottom: 1px solid var(--sf-page-border, rgba(255,255,255,.08)); overflow-x: auto; scrollbar-width: none; }
  .author-channel-tabs::-webkit-scrollbar { display: none; }
  .author-channel-tab { position: relative; display: inline-flex; flex: 0 0 auto; align-items: center; color: var(--sf-page-copy, #9298A4); font: 600 14px/1.4 'Plus Jakarta Sans', system-ui, sans-serif; text-decoration: none; transition: color .18s ease; }
  .author-channel-tab:hover, .author-channel-tab.is-active { color: var(--sf-page-heading, #F5F5F5); }
  .author-channel-tab.is-active::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: var(--sf-page-accent, #35C9C1); content: ''; }
  .author-home-latest { padding: 25px 0 26px; border-bottom: 1px solid var(--sf-page-border, rgba(255,255,255,.08)); }
  .author-section-heading { display: flex; align-items: center; margin-bottom: 15px; }
  .author-section-heading h2 { margin: 0; color: var(--sf-page-heading, #F5F5F5); font: 700 clamp(19px, 2.8vw, 22px)/1.25 'Plus Jakarta Sans', system-ui, sans-serif; letter-spacing: -.015em; }
  .category-heading-link { display: inline-flex; align-items: center; justify-content: flex-start; gap: 6px; width: auto; min-height: 24px; padding: 0; border: 0; background: transparent; color: inherit; font: inherit; line-height: inherit; text-align: left; text-decoration: none; cursor: pointer; }
  .category-heading-link:hover { color: inherit; }
  .category-heading-chevron { display: block; flex: 0 0 16px; width: 16px; height: 24px; color: currentColor; opacity: .58; transform: translateY(1px); transition: transform .2s ease, opacity .2s ease; }
  .category-heading-link:hover .category-heading-chevron { transform: translate(4px, 1px); opacity: 1; }
  .author-latest-track { display: flex; gap: 18px; padding: 3px 1px 8px; overflow-x: auto; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .author-latest-track::-webkit-scrollbar { display: none; }
  .author-latest-card { display: flex; flex: 0 0 calc((100% - 40px)/3.25); flex-direction: column; min-width: 250px; max-width: 380px; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; color: inherit; text-decoration: none; scroll-snap-align: start; }
  .author-latest-thumb { width: 100%; aspect-ratio: 16/9; border: 0; border-radius: 10px; background: #090B10; overflow: hidden; }
  .author-latest-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .author-latest-meta { display: flex; align-items: center; justify-content: space-between; gap: 5px 8px; margin: 10px 0 7px; color: #9298A4; font: 500 10px/1.4 'JetBrains Mono', monospace; letter-spacing: 0; }
  .author-latest-category, .author-resource-category { color: #9298A4; font: 600 10px/1.4 'JetBrains Mono', monospace; letter-spacing: .07em; text-transform: uppercase; white-space: nowrap; }
  .author-resource-category { flex: 0 1 auto; min-width: 0; }
  .author-latest-date, .author-resource-date { display: inline-flex; flex: 0 0 auto; align-items: center; justify-content: flex-end; gap: 5px; color: #9298A4; font: 500 10.5px/1.2 'JetBrains Mono', monospace; letter-spacing: 0; white-space: nowrap; }
  .author-calendar-icon { display: block; flex: 0 0 14px; width: 14px; height: 14px; color: #7E8492; }
  .author-latest-card h3 { display: -webkit-box; margin: 0; overflow: hidden; color: var(--sf-page-heading, #F5F5F5); font: 600 14px/1.38 'Plus Jakarta Sans', system-ui, sans-serif; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .author-home-category { padding: 24px 0; border-bottom: 1px solid var(--sf-page-border, rgba(255,255,255,.08)); }
  .author-resource-list { display: flex; flex-direction: column; gap: 18px; }
  .author-resource-row { display: flex; align-items: center; gap: 14px; width: 100%; min-width: 0; box-sizing: border-box; padding: 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; color: var(--sf-page-heading, #F5F5F5); text-decoration: none; transition: opacity .18s ease; }
  .author-resource-row:hover { opacity: .92; }
  .author-resource-thumb { flex: 0 0 42%; width: 42%; max-width: 300px; aspect-ratio: 16/9; border: 0; border-radius: 7px; background: #090B10; overflow: hidden; }
  .author-resource-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .author-resource-copy { flex: 1 1 auto; min-width: 0; padding: 0 4px; }
  .author-resource-meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: nowrap; gap: 8px; width: 100%; margin: 0 0 6px; }
  .author-resource-copy h3 { display: -webkit-box; margin: 0 0 5px; overflow: hidden; color: var(--sf-page-heading, #F5F5F5); font: 600 14px/1.35 'Plus Jakarta Sans', system-ui, sans-serif; letter-spacing: -.01em; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  :global([data-theme="light"]) .author-latest-category,
  :global(html.light-theme) .author-latest-category,
  :global([data-theme="light"]) .author-resource-category,
  :global(html.light-theme) .author-resource-category { color: #64748B; }
  :global([data-theme="light"]) .author-latest-date,
  :global(html.light-theme) .author-latest-date,
  :global([data-theme="light"]) .author-resource-date,
  :global(html.light-theme) .author-resource-date,
  :global([data-theme="light"]) .author-calendar-icon,
  :global(html.light-theme) .author-calendar-icon { color: #64748B; }
  .author-secondary-page { padding: 27px 0 50px; }
  .author-page-heading { margin-bottom: 18px; }
  .author-page-heading h2 { margin: 0 0 6px; color: var(--sf-page-heading, #F5F5F5); font: 700 clamp(21px, 3.2vw, 26px)/1.25 'Plus Jakarta Sans', system-ui, sans-serif; }
  .author-page-heading p { margin: 0; color: var(--sf-page-copy, #9298A4); font: 400 13.5px/1.6 'Plus Jakarta Sans', system-ui, sans-serif; }
  .author-resource-toolbar { display: flex; flex-direction: column; gap: 10px; margin: 0 0 17px; }
  .author-resource-sort-tabs, .author-resource-category-tabs { display: flex; align-items: center; gap: 8px; width: 100%; overflow-x: auto; padding: 1px 0 4px; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
