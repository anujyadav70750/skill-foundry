---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  robots?: string;
}

const {
  title = 'Skill Foundry — Practical AI Skills, Prompts & Tutorials',
  description = 'Practical AI prompts, tutorials, workflows and resources to help you build useful skills for the AI era.',
  canonical,
  image,
  imageAlt,
  type = 'website',
  robots = 'index, follow, max-image-preview:large'
} = Astro.props;

const siteName = 'Skill Foundry';
const fullTitle = title.includes('Skill Foundry') ? title : `${title} | ${siteName}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const socialImage = image ? new URL(image, siteUrl).href : undefined;

const platformLinks = [
  {
    name: 'Facebook',
    url: 'https://www.facebook.com/',
    icon: 'facebook',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>'
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/',
    icon: 'instagram',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>'
  },
  {
    name: 'YouTube',
    url: 'https://www.youtube.com/',
    icon: 'youtube',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>'
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/',
    icon: 'linkedin',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.64 1.64 0 1 0 0 3.28 1.64 1.64 0 0 0 0-3.28z"/></svg>'
  },
  {
    name: 'GitHub',
    url: 'https://github.com/',
    icon: 'github',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>'
  }
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090D14" />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="C_J2tHd4KyewCilkXDUref97yEkMTr0yWQtLCKBsCEI" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/workflow-fixes.css?v=20260919-prompt-polish" />
    <script src="/workflow-fixes.js?v=20260916-final" defer></script>
    <title>{fullTitle}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Skill Foundry home"><span class="brand-mark">SF</span><span>SKILL FOUNDRY</span></a>
        <div class="nav-actions">
          <form class="header-search-form" action="/resources/" method="get" role="search"><label class="sr-only" for="header-resource-search">Search resources</label><input id="header-resource-search" name="q" type="search" placeholder="Search resources…" autocomplete="off" spellcheck="false" /><button class="header-search-submit" type="submit" aria-label="Search resources"><svg class="search-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg></button></form>
          <div class="menu-wrap"><button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open navigation menu"><span></span><span></span><span></span></button><nav class="site-menu" id="site-menu" aria-label="Main navigation" hidden><a href="/">Home</a><a href="/resources/">Resources</a><a href="/about/">About</a></nav></div>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-container">
        <!-- 1. Centered Brand -->
        <div class="footer-brand-wrap">
          <a class="brand footer-brand" href="/" aria-label="Skill Foundry home">
            <span class="brand-mark">SF</span>
            <span class="brand-name">SKILL FOUNDRY</span>
          </a>
        </div>

        <!-- 2. Three Descriptor Points -->
        <div class="footer-descriptors" aria-label="Skill Foundry Focus Areas">
          <span class="descriptor-item"><span class="descriptor-dot" aria-hidden="true">•</span> PRACTICAL SKILLS</span>
          <span class="descriptor-item"><span class="descriptor-dot" aria-hidden="true">•</span> TUTORIALS &amp; WORKFLOWS</span>
          <span class="descriptor-item"><span class="descriptor-dot" aria-hidden="true">•</span> TOOLS &amp; PROJECTS</span>
        </div>

        <!-- 3. First Subtle Horizontal Divider -->
        <div class="footer-divider footer-divider-top" role="separator"></div>

        <!-- 4. Main Navigation -->
        <nav class="footer-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/resources/">All Resources</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>

        <!-- 5. Social Platform Icons -->
        <div class="footer-platforms" aria-label="External platforms">
          <div class="footer-platform-list">
            {platformLinks.map((item) => (
              <a
                class="footer-platform-btn"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Skill Foundry on ${item.name}`}
                title={item.name}
                set:html={item.svg}
              />
            ))}
          </div>
        </div>

        <!-- 6. Legal Links -->
        <nav class="footer-legal" aria-label="Legal navigation">
          <a href="/privacy/">Privacy</a>
          <span class="legal-separator" aria-hidden="true">|</span>
          <a href="/terms/">Terms</a>
        </nav>

        <!-- 7. Copyright -->
        <div class="footer-copyright">
          <span>© {new Date().getFullYear()} Skill Foundry. All rights reserved.</span>
        </div>
      </div>
    </footer>
    <style>
      .header-search-form{display:flex;align-items:center;width:clamp(180px,24vw,300px);min-height:40px;padding:0 9px 0 12px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.025);color:var(--muted)}.header-search-form:focus-within{border-color:rgba(var(--accent-rgb),.55);box-shadow:0 0 0 3px rgba(var(--accent-rgb),.1)}.header-search-form input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--text);font-size:13px}.header-search-form input::placeholder{color:var(--muted-dark)}.header-search-form input::-webkit-search-cancel-button{-webkit-appearance:none;appearance:none;display:none}.header-search-submit{display:grid;place-items:center;flex:0 0 auto;width:34px;height:34px;padding:0;border:1px solid var(--line);border-radius:9px;background:var(--surface-2);color:var(--muted);cursor:pointer}.header-search-submit:hover,.header-search-submit:focus-visible{border-color:rgba(var(--accent-rgb),.55);background:rgba(var(--accent-rgb),.12);color:var(--accent);outline:none}.search-svg{display:block;width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}.menu-wrap{position:relative}.menu-toggle{display:grid;place-content:center;gap:4px;width:40px;height:40px;padding:0;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.025);cursor:pointer}.menu-toggle span{display:block;width:16px;height:1.5px;border-radius:2px;background:var(--muted);transition:transform .2s ease,opacity .2s ease,background .2s ease}.menu-toggle:hover,.menu-toggle[aria-expanded="true"]{border-color:rgba(var(--accent-rgb),.45)}.menu-toggle:hover span,.menu-toggle[aria-expanded="true"] span{background:var(--accent)}.menu-toggle[aria-expanded="true"] span:nth-child(1){transform:translateY(5.5px) rotate(45deg)}.menu-toggle[aria-expanded="true"] span:nth-child(2){opacity:0}.menu-toggle[aria-expanded="true"] span:nth-child(3){transform:translateY(-5.5px) rotate(-45deg)}.site-menu{position:absolute;top:calc(100% + 10px);right:0;display:grid;min-width:170px;padding:7px;border:1px solid var(--line);border-radius:13px;background:rgba(17,23,34,.98);box-shadow:0 18px 45px rgba(0,0,0,.55)}.site-menu[hidden]{display:none}.site-menu a{padding:10px 12px;border-radius:8px;color:var(--muted);font-size:13px;font-weight:700}.site-menu a:hover{background:rgba(var(--accent-rgb),.08);color:var(--accent)}.site-footer{background:#0E1215;border-top:0;color:#AAB4C0;padding:54px 0 46px;margin-top:0;width:100%}.footer-container{display:flex;flex-direction:column;align-items:center;text-align:center;max-width:1120px;margin-left:auto;margin-right:auto;padding-left:28px;padding-right:28px}.footer-brand-wrap{display:flex;justify-content:center;margin-bottom:20px}.footer-brand-wrap .footer-brand{display:inline-flex;align-items:center;gap:12px;color:#F8FAFC;text-decoration:none;transition:opacity .15s ease}.footer-brand-wrap .footer-brand:hover{opacity:.92}.footer-brand-wrap .brand-mark{width:34px;height:34px;min-width:34px;border-radius:9px;font-size:12px;font-weight:800;background:#FF6600;color:#FFFFFF;display:grid;place-items:center;box-shadow:0 4px 16px rgba(255,102,0,.20)}.footer-brand-wrap .brand-name{font-size:20px;font-weight:800;letter-spacing:.14em;color:#F8FAFC;text-transform:uppercase}.footer-description{margin:0 auto 18px;text-align:center;color:#94a3b8;font-size:15px;line-height:1.45;max-width:760px}.site-footer{background:#080d0f;color:#f8fafc}.footer-copyright{color:#94a3b8}
.footer-descriptors{display:flex;align-items:center;justify-content:space-between;width:100%;max-width:940px;gap:28px;margin:0 auto}.descriptor-item{display:inline-flex;align-items:center;gap:8px;font-size:11px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:#AEB8C5;white-space:nowrap}.descriptor-dot{color:#697788;font-size:11px;user-select:none}.footer-divider{width:100%;max-width:1040px;height:1px;background:rgba(255,255,255,.12)}.footer-divider-top{margin:32px auto 40px}.footer-nav{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:0 clamp(38px,5vw,68px)}.footer-nav a{color:#F4F6F8;font-size:15px;font-weight:500;letter-spacing:0;text-decoration:none;transition:color .15s ease,transform .15s ease}.footer-nav a:hover,.footer-nav a:focus-visible{color:#FF6600;outline:none}.footer-platforms{margin-top:34px;display:flex;justify-content:center}.footer-platform-list{display:flex;align-items:center;justify-content:center;gap:14px;flex-wrap:wrap}.footer-platform-btn{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;min-width:36px;min-height:36px;border-radius:8px;background:#171C20;border:1px solid #252B30;color:#D5DCE3;transition:all .2s cubic-bezier(0.16,1,0.3,1);text-decoration:none}.footer-platform-btn:hover{color:#FF6600;border-color:rgba(255,102,0,.5);background:rgba(255,102,0,.1);transform:translateY(-2px)}.footer-platform-btn:focus-visible{outline:2px solid rgba(255,102,0,.6);outline-offset:2px}.footer-platform-btn svg{display:block;width:18px;height:18px}.footer-legal{display:flex;align-items:center;justify-content:center;gap:14px;margin-top:50px}.footer-legal a{color:#8F9AAA;font-size:12px;font-weight:500;text-decoration:none;transition:color .15s ease}.footer-legal a:hover,.footer-legal a:focus-visible{color:#FF6600;outline:none}.legal-separator{color:#56616D;font-size:11px;user-select:none}.footer-copyright{color:#A1ACB8;font-size:12px;line-height:1.5;text-align:center;margin-top:18px}@media(max-width:768px){.site-header{position:fixed;top:8px;left:50%;right:auto;transform:translateX(-50%);width:min(calc(100% - 20px),520px);border-radius:9999px;background:rgba(8,12,20,.96);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,.12);box-shadow:0 10px 28px -4px rgba(0,0,0,.35),0 2px 8px rgba(0,0,0,.2);z-index:1000}.nav-wrap{min-height:42px;height:42px;padding:0 6px 0 10px;gap:8px;display:flex;align-items:center;justify-content:space-between}.brand{font-size:10px;font-weight:700;letter-spacing:.08em;gap:6px;flex-shrink:0;color:#fff}.brand span:last-child{font-size:9.5px;letter-spacing:.06em;line-height:1.1}.brand-mark{width:26px;height:26px;min-width:26px;border-radius:8px;font-size:9.5px}.nav-actions{gap:6px;flex:1 1 auto;justify-content:flex-end;min-width:0}.header-search-form{flex:1 1 auto;min-width:0;width:auto;max-width:220px;min-height:30px;height:30px;padding:0 3px 0 10px;border-radius:9999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);gap:4px}.header-search-form input{font-size:11.5px}.header-search-form input::placeholder{font-size:11px}.header-search-submit{width:24px;height:24px;min-width:24px;border-radius:9999px;background:transparent;border:none;color:#94a3b8}.search-svg{width:13px;height:13px}.menu-toggle{width:30px;height:30px;min-width:30px;border-radius:9999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);gap:3px;padding:0}.menu-toggle span{width:12px;height:1.5px}.site-footer{padding:58px 0 44px}.footer-container{padding-left:24px;padding-right:24px}.footer-brand-wrap{margin-bottom:14px}.footer-brand-wrap .brand-mark{width:34px;height:34px;min-width:34px;border-radius:9px;font-size:12px}.footer-brand-wrap .brand-name{font-size:19px;letter-spacing:.13em}.footer-descriptors{flex-direction:row;align-items:center;justify-content:center;gap:34px;margin:0 auto}.descriptor-item{font-size:9px;letter-spacing:.09em;gap:6px;line-height:1.4}.descriptor-dot{font-size:9px}.footer-divider-top{margin:26px auto 34px}.footer-nav{gap:0 24px}.footer-nav a{font-size:15px;padding:2px 0;white-space:nowrap}.footer-platforms{margin-top:34px}.footer-platform-list{gap:12px}.footer-platform-btn{width:42px;height:42px;min-width:42px;min-height:42px;border-radius:10px}.footer-platform-btn svg{width:19px;height:19px}.footer-legal{margin-top:46px;gap:12px}.footer-legal a{font-size:13px;padding:2px 0}.footer-copyright{font-size:12px;margin-top:18px}}
@media(max-width:420px){.footer-description{display:none}.site-footer{padding:64px 0 54px}.footer-container{padding-left:18px;padding-right:18px}.footer-brand-wrap{margin-bottom:18px}.footer-brand-wrap .brand-mark{width:36px;height:36px;min-width:36px;border-radius:10px;font-size:13px}.footer-brand-wrap .brand-name{font-size:21px;letter-spacing:.13em}.footer-descriptors{width:calc(100% + 16px);max-width:none;margin-left:-8px;margin-right:-8px;padding:0;display:flex;flex-direction:row;flex-wrap:nowrap;align-items:center;justify-content:space-between;gap:0}.descriptor-item{flex:0 1 auto;min-width:0;font-size:10px;letter-spacing:.04em;gap:4px;line-height:1.4;white-space:nowrap}.descriptor-dot{font-size:9px}.footer-divider-top{margin:30px auto 38px}.footer-nav{gap:0 22px}.footer-nav a{font-size:16px;line-height:1.3}.footer-platforms{margin-top:34px}.footer-platform-list{gap:10px}.footer-platform-btn{width:42px;height:42px;min-width:42px;min-height:42px}.footer-platform-btn svg{width:19px;height:19px}.footer-legal{margin-top:44px}.footer-legal a{font-size:14px}.footer-copyright{font-size:14px;color:#B6C0CB;margin-top:20px}}
    </style>
    <style is:global>
      .builder-page .repeat-item input:not([type="checkbox"]),.builder-page .repeat-item textarea,.builder-page .repeat-item select,.builder-page .media-control input.path-input,.builder-page .media-item input.path-input{width:100%;box-sizing:border-box;min-height:46px;padding:10px 12px;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--text);font:inherit;font-size:14px;line-height:1.5;outline:none;color-scheme:dark}.builder-page .repeat-item textarea{min-height:84px;resize:vertical}.builder-page .repeat-item input::placeholder,.builder-page .repeat-item textarea::placeholder,.builder-page .media-control input::placeholder{color:var(--muted-dark);opacity:1}.builder-page .repeat-item input:focus,.builder-page .repeat-item textarea:focus,.builder-page .media-control input.path-input:focus{border-color:rgba(var(--accent-rgb),.55);box-shadow:0 0 0 3px rgba(var(--accent-rgb),.08)}.builder-page .remove-button{position:absolute;top:10px;right:10px;display:grid;place-items:center;width:32px!important;height:32px!important;min-width:32px!important;min-height:32px!important;margin:0;padding:0!important;border:1px solid var(--line);border-radius:50%;background:rgba(255,255,255,.035);color:var(--muted);font:inherit;font-size:18px;font-weight:500;line-height:1;cursor:pointer;appearance:none;-webkit-appearance:none}.builder-page .remove-button:hover,.builder-page .remove-button:focus-visible{border-color:rgba(255,100,100,.5);color:#ff9b9b;background:rgba(255,100,100,.07);outline:none}.builder-page .repeat-item{position:relative;padding-right:56px}.builder-page .file-button{display:flex!important;align-items:center;justify-content:center;min-height:46px;min-width:118px;box-sizing:border-box;padding:0 14px;border:1px solid var(--line);border-radius:10px;background:var(--surface-2);color:var(--text);font-size:12px;font-weight:800;cursor:pointer}.builder-page .file-button:hover{border-color:rgba(var(--accent-rgb),.45);color:var(--accent);background:rgba(var(--accent-rgb),.08)}.builder-page .file-button input[type="file"]{display:none!important}.builder-page .upload-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:stretch}.builder-page .media-control{min-width:0}.builder-page .image-preview{display:none;margin-top:10px;padding:10px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.builder-page .image-preview.has-image{display:block}.builder-page .image-preview img{display:block;width:min(100%,420px);max-height:260px;object-fit:cover;border:1px solid var(--line);border-radius:10px}.builder-page .image-preview span{display:block;margin-top:7px;color:var(--muted);font-size:11px}.builder-page .check-inline{display:flex!important;align-items:center;gap:8px;min-height:46px}.builder-page .check-inline input[type="checkbox"]{width:17px!important;height:17px!important;min-height:17px!important;padding:0!important;accent-color:var(--accent)}@media(max-width:700px){.builder-page .repeat-item.tool,.builder-page .repeat-item.step{grid-template-columns:1fr}.builder-page .upload-row{grid-template-columns:1fr}.builder-page .file-button{min-height:44px;width:100%}.builder-page .repeat-item{padding-right:52px}.builder-page .remove-button{width:32px!important;height:32px!important}}
    </style>
    <script>
      const menuToggle=document.querySelector('#menu-toggle');const siteMenu=document.querySelector('#site-menu');const closeMenu=()=>{if(!menuToggle||!siteMenu)return;menuToggle.setAttribute('aria-expanded','false');menuToggle.setAttribute('aria-label','Open navigation menu');siteMenu.hidden=true};menuToggle?.addEventListener('click',()=>{if(!siteMenu)return;const open=menuToggle.getAttribute('aria-expanded')==='true';menuToggle.setAttribute('aria-expanded',String(!open));menuToggle.setAttribute('aria-label',open?'Open navigation menu':'Close navigation menu');siteMenu.hidden=open});document.addEventListener('click',(event)=>{if(!siteMenu||!menuToggle)return;const target=event.target;if(target instanceof Node&&!siteMenu.contains(target)&&!menuToggle.contains(target))closeMenu()});document.addEventListener('keydown',(event)=>{if(event.key==='Escape')closeMenu()});
    </script>
  </body>
