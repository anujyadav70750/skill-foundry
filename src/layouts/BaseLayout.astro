---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'Skill Foundry — Practical AI Skills, Prompts & Tutorials',
  description = 'Practical AI prompts, tutorials, workflows and resources to help you build useful skills for the AI era.',
  canonical
} = Astro.props;

const siteName = 'Skill Foundry';
const fullTitle = title.includes('Skill Foundry') ? title : `${title} | ${siteName}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Skill Foundry home">
          <span class="brand-mark">SF</span>
          <span>SKILL FOUNDRY</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/resources/">Resources</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <div class="brand footer-brand"><span class="brand-mark">SF</span><span>SKILL FOUNDRY</span></div>
          <p>Practical AI resources for learning, creating and building.</p>
        </div>
        <div>
          <strong>Explore</strong>
          <a href="/resources/">All Resources</a>
          <a href="/about/">About</a>
        </div>
      </div>
      <div class="container footer-bottom">© {new Date().getFullYear()} Skill Foundry. All rights reserved.</div>
    </footer>
  </body>
</html>
