---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../lib/resource';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  robots?: string;
  hideHeaderSearch?: boolean;
  hideFooter?: boolean;
  hideHeader?: boolean;
  hideBackButton?: boolean;
}

const siteUrl = 'https://hub.skillfoundry-web.workers.dev';
const siteName = 'Skill Foundry';
const defaultTitle = 'Skill Foundry | Practical Skills Platform & Resource Library';
const defaultDescription = 'Skill Foundry is a practical learning platform for building useful skills through clear resources, tutorials, and real-world workflows.';

const currentPath = Astro.url.pathname;
const isHomePage = currentPath === '/' || currentPath === '';

const {
  title,
  description = defaultDescription,
  canonical,
  image = '/og-image.svg',
  imageAlt = 'Skill Foundry — Practical learning resources, tutorials, and workflows',
  type = 'website',
  robots = 'index, follow',
  hideHeaderSearch = false,
  hideFooter = false,
  hideHeader = false,
  hideBackButton = isHomePage
} = Astro.props;

const fullTitle = title
  ? (title.includes(siteName) ? title : `${title} | ${siteName}`)
  : defaultTitle;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const socialImage = image ? new URL(image, siteUrl).href : undefined;

// Single Source of Truth: published resources for global search
const allResources = await getCollection('resources');
const publishedSearchData = allResources
  .filter((r) => !('draft' in r.data && r.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((r) => ({
    title: r.data.title,
    slug: resourceSlug(r),
    description: r.data.description,
    category: r.data.category || '',
    tool: r.data.tool || '',
    toolsUsed: Array.isArray(r.data.toolsUsed) ? r.data.toolsUsed.map((t: any) => t.name) : [],
    tags: Array.isArray(r.data.tags) ? r.data.tags : [],
    thumbnail: resourceThumbnail(r),
    imageAlt: resourceImageAlt(r),
    date: r.data.date ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(r.data.date)) : ''
  }));

const searchHref = currentPath && currentPath !== '/search/' && currentPath !== '/search'
  ? `/search/?from=${encodeURIComponent(currentPath)}`
  : '/search/';

const platformLinks = [
  {
    name: 'Facebook',
    url: 'https://facebook.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>'
  },
  {
    name: 'X',
    url: 'https://x.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>'
  },
  {
    name: 'Instagram',
    url: 'https://instagram.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>'
  },
  {
    name: 'LinkedIn',
    url: 'https://linkedin.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>'
  },
  {
    name: 'Pinterest',
    url: 'https://pinterest.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>'
  },
  {
    name: 'YouTube',
    url: 'https://youtube.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>'
  },
  {
    name: 'GitHub',
    url: 'https://github.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090D14" />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="C_J2tHd4KyewCilkXDUref97yEkMTr0yWQtLCKBsCEI" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/workflow-fixes.css?v=20261007-result-integrated" />
    <script src="/workflow-fixes.js?v=20260916-final" defer></script>
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('sf_theme');
          var theme = saved || 'dark';
          document.documentElement.setAttribute('data-theme', theme);
          if (theme === 'light') {
            document.documentElement.classList.add('light-theme');
          } else {
            document.documentElement.classList.remove('light-theme');
          }
        } catch (e) {}

        var isFaqReturn = false;
        try {
          if (sessionStorage.getItem('sf_back_to_faq') === 'true') {
            isFaqReturn = true;
          }
        } catch (e) {}
        if (typeof window !== 'undefined' && (window.location.hash === '#faq-submit-card' || window.location.hash === '#faq')) {
          isFaqReturn = true;
        }

        if (isFaqReturn) {
          document.documentElement.classList.add('jump-to-faq-pending');
          document.documentElement.style.scrollBehavior = 'auto';
          if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
          }
        }
      })();
    </script>
    <style is:inline>
      html.jump-to-faq-pending body {
        opacity: 0 !important;
        visibility: hidden !important;
      }
    </style>
    <title>{fullTitle}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
  </head>
  <body class={hideHeader ? 'no-header' : ''}>
    <!-- GLOBAL UNIFIED NAVIGATION HEADER (ROUNDED RECTANGLE WITH BRAND LEFT, SEARCH & MENU RIGHT) -->
    {!hideHeader && (
      <header class="site-header" id="global-site-header">
        <nav class="nav-bar-container" aria-label="Main navigation">
          <!-- LEFT SIDE: Brand Logo + Brand Name -->
          <a class="nav-brand" href="/" aria-label="Skill Foundry home">
            <span class="brand-mark">SF</span>
            <span class="brand-name">Skill <span class="brand-name-accent">Foundry</span></span>
          </a>

          <!-- RIGHT SIDE: Search Capsule + Hamburger Menu Button -->
          <div class="nav-actions">
            {!hideHeaderSearch && (
              <div class="header-search-wrap" id="header-search-wrap">
                <a class="header-search-box" id="header-search-box" href={searchHref} aria-label="Search resources">
                  <span class="header-search-submit" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="11" cy="11" r="7"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                  </span>
                </a>
              </div>
            )}

            <button
              type="button"
              class="nav-menu-btn"
              id="menu-toggle"
              aria-expanded="false"
              aria-controls="site-menu"
              aria-label="Open navigation menu"
            >
              <svg class="icon-hamburger" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="4" y1="7" x2="20" y2="7"></line>
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <line x1="4" y1="17" x2="20" y2="17"></line>
              </svg>
              <svg class="icon-close" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>

          <!-- DROPDOWN MENU PANEL -->
          <div class="nav-dropdown-menu" id="site-menu" hidden aria-labelledby="menu-toggle">
            <nav class="menu-nav-list" aria-label="Site menu navigation">
              <a class={`menu-nav-item ${currentPath === '/' ? 'active' : ''}`} href="/">
                <span class="menu-item-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                  </svg>
                </span>
                <span class="menu-item-label">Home</span>
              </a>

              <a class={`menu-nav-item ${currentPath === '/resources/' || (currentPath.startsWith('/resources') && !currentPath.includes('guides')) ? 'active' : ''}`} href="/resources/">
                <span class="menu-item-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                  </svg>
                </span>
                <span class="menu-item-label">Resources</span>
              </a>

              <a class={`menu-nav-item ${currentPath.startsWith('/guides') ? 'active' : ''}`} href="/guides/">
                <span class="menu-item-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                    <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                  </svg>
                </span>
                <span class="menu-item-label">Guides</span>
              </a>

              <a class={`menu-nav-item ${currentPath.startsWith('/faq') ? 'active' : ''}`} href="/faq/">
                <span class="menu-item-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                    <line x1="12" y1="17" x2="12.01" y2="17"></line>
                  </svg>
                </span>
                <span class="menu-item-label">FAQ</span>
              </a>

              <a class={`menu-nav-item ${currentPath.startsWith('/about') ? 'active' : ''}`} href="/about/">
                <span class="menu-item-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="16" x2="12" y2="12"></line>
                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                  </svg>
                </span>
                <span class="menu-item-label">About</span>
              </a>

              <a class={`menu-nav-item ${currentPath.startsWith('/privacy') ? 'active' : ''}`} href="/privacy/">
                <span class="menu-item-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <line x1="10" y1="9" x2="8" y2="9"></line>
                  </svg>
                </span>
                <span class="menu-item-label">Privacy Policy</span>
              </a>

              <a class={`menu-nav-item ${currentPath.startsWith('/terms') ? 'active' : ''}`} href="/terms/">
                <span class="menu-item-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <polyline points="9 12 11 14 15 10"></polyline>
                  </svg>
                </span>
                <span class="menu-item-label">Terms &amp; Conditions</span>
              </a>

              <a class={`menu-nav-item ${currentPath.startsWith('/contact') ? 'active' : ''}`} href="/contact/">
                <span class="menu-item-icon">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </span>
                <span class="menu-item-label">Contact</span>
              </a>
            </nav>

            <div class="menu-divider" role="separator"></div>

            <!-- SINGLE COMBINED PILL THEME TOGGLE (Sun / Moon) -->
            <div class="menu-theme-wrap">
              <button
                type="button"
                class="theme-pill-toggle"
                id="theme-pill-toggle"
                role="switch"
                aria-checked="true"
                data-theme="dark"
                aria-label="Toggle dark and light theme"
                title="Toggle Theme"
              >
                <span class="theme-pill-option theme-pill-light" aria-label="Light mode">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4.2"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                  </svg>
                </span>
                <span class="theme-pill-option theme-pill-dark is-active" aria-label="Dark mode">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                  </svg>
                </span>
              </button>
            </div>
          </div>
        </nav>
      </header>
    )}

    {!hideBackButton && (
      <aside class="site-back-bar" id="site-back-bar" aria-label="Page navigation">
        <div class="site-back-container">
          <button
            type="button"
            class="site-back-btn"
            id="site-global-back-btn"
            aria-label="Go back to previous page"
            title="Go back"
          >
            <svg class="site-back-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
          </button>
        </div>
      </aside>
    )}

    <main><slot /></main>

    <!-- EMBEDDED PUBLISHED RESOURCE SEARCH DATA -->
    <script type="application/json" id="sf-search-data" set:html={JSON.stringify(publishedSearchData)}></script>

    <!-- GLOBAL FOOTER -->
    {!hideFooter && (
      <footer class="site-footer">
        <div class="container footer-container">
          <!-- 1. Centered Brand -->
          <div class="footer-brand-wrap">
