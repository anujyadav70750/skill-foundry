---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: string;
}

const {
  title = 'Skill Foundry — Practical AI Skills, Prompts & Tutorials',
  description = 'Practical AI prompts, tutorials, workflows and resources to help you build useful skills for the AI era.',
  canonical,
  image,
  type = 'website'
} = Astro.props;

const siteName = 'Skill Foundry';
const fullTitle = title.includes('Skill Foundry') ? title : `${title} | ${siteName}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const socialImage = image ? new URL(image, siteUrl).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Skill Foundry home">
          <span class="brand-mark">SF</span>
          <span>SKILL FOUNDRY</span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/resources/">Resources</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <div class="brand footer-brand"><span class="brand-mark">SF</span><span>SKILL FOUNDRY</span></div>
          <p>Practical AI resources for learning, creating and building.</p>
        </div>
        <div>
          <strong>Explore</strong>
          <a href="/">Home</a>
          <a href="/resources/">All Resources</a>
          <a href="/about/">About</a>
        </div>
      </div>
      <div class="container footer-bottom">© {new Date().getFullYear()} Skill Foundry. All rights reserved.</div>
    </footer>
  </body>
</html>
