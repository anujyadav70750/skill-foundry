      }
    

      /* MOBILE-ONLY SF TAB CONNECTION
         Extend the EXISTING navigation wings themselves into the SF tab area.
         No separate connector lines; preserve the existing fill and borders. */
      @media (max-width: 768px) {
        .nav-segment-left {
          margin-right: -16px;
        }

        .nav-segment-right {
          margin-left: -16px;
        }
      }

</style>

    <style is:global>
      .builder-page .repeat-item input:not([type="checkbox"]),.builder-page .repeat-item textarea,.builder-page .repeat-item select,.builder-page .media-control input.path-input,.builder-page .media-item input.path-input{width:100%;box-sizing:border-box;min-height:46px;padding:10px 12px;border:1px solid var(--line);border-radius:11px;background:var(--surface);color:var(--text);font:inherit;font-size:14px;line-height:1.5;outline:none;color-scheme:dark}.builder-page .repeat-item textarea{min-height:84px;resize:vertical}.builder-page .repeat-item input::placeholder,.builder-page .repeat-item textarea::placeholder,.builder-page .media-control input::placeholder{color:var(--muted-dark);opacity:1}.builder-page .repeat-item input:focus,.builder-page .repeat-item textarea:focus,.builder-page .media-control input.path-input:focus{border-color:rgba(var(--accent-rgb),.55);box-shadow:0 0 0 3px rgba(var(--accent-rgb),.08)}.builder-page .remove-button{position:absolute;top:10px;right:10px;display:grid;place-items:center;width:32px!important;height:32px!important;min-width:32px!important;min-height:32px!important;margin:0;padding:0!important;border:1px solid var(--line);border-radius:50%;background:rgba(255,255,255,.035);color:var(--muted);font:inherit;font-size:18px;font-weight:500;line-height:1;cursor:pointer;appearance:none;-webkit-appearance:none}.builder-page .remove-button:hover,.builder-page .remove-button:focus-visible{border-color:rgba(255,100,100,.5);color:#ff9b9b;background:rgba(255,100,100,.07);outline:none}.builder-page .repeat-item{position:relative;padding-right:56px}.builder-page .file-button{display:flex!important;align-items:center;justify-content:center;min-height:46px;min-width:118px;box-sizing:border-box;padding:0 14px;border:1px solid var(--line);border-radius:10px;background:var(--surface-2);color:var(--text);font-size:12px;font-weight:800;cursor:pointer}.builder-page .file-button:hover{border-color:rgba(var(--accent-rgb),.45);color:var(--accent);background:rgba(var(--accent-rgb),.08)}.builder-page .file-button input[type="file"]{display:none!important}.builder-page .upload-row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;align-items:stretch}.builder-page .media-control{min-width:0}.builder-page .image-preview{display:none;margin-top:10px;padding:10px;border:1px solid var(--line);border-radius:12px;background:var(--surface)}.builder-page .image-preview.has-image{display:block}.builder-page .image-preview img{display:block;width:min(100%,420px);max-height:260px;object-fit:cover;border:1px solid var(--line);border-radius:10px}.builder-page .image-preview span{display:block;margin-top:7px;color:var(--muted);font-size:11px}.builder-page .check-inline{display:flex!important;align-items:center;gap:8px;min-height:46px}.builder-page .check-inline input[type="checkbox"]{width:17px!important;height:17px!important;min-height:17px!important;padding:0!important;accent-color:var(--accent)}@media(max-width:700px){.builder-page .repeat-item.tool,.builder-page .repeat-item.step{grid-template-columns:1fr}.builder-page .upload-row{grid-template-columns:1fr}.builder-page .file-button{min-height:44px;width:100%}.builder-page .repeat-item{padding-right:52px}.builder-page .remove-button{width:32px!important;height:32px!important}}
    </style>

    <script>
      // 1. Mobile Menu Toggle
      const menuToggle = document.querySelector('#menu-toggle');
      const siteMenu = document.querySelector('#site-menu');
      const closeMenu = () => {
        if (!menuToggle || !siteMenu) return;
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Open navigation menu');
        siteMenu.hidden = true;
      };
      menuToggle?.addEventListener('click', () => {
        if (!siteMenu) return;
        const open = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!open));
        menuToggle.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu');
        siteMenu.hidden = open;
      });

      // 2. Search Data & Shared Matching Engine
      let searchData: Array<{
        title: string;
        slug: string;
        description: string;
        category: string;
        tool: string;
        toolsUsed?: string[];
        tags?: string[];
        thumbnail: string;
        imageAlt: string;
        date?: string;
      }> = [];

      try {
        const rawJson = document.querySelector('#sf-search-data')?.textContent;
        if (rawJson) {
          searchData = JSON.parse(rawJson);
        }
      } catch (e) {
        console.error('Failed to parse search data', e);
      }

      const matchResources = (query: string) => {
        const q = query.trim().toLowerCase();
        if (!q) return [];
        const tokens = q.split(/\s+/).filter(Boolean);
        return searchData.filter((item) => {
          const searchable = [
            item.title,
            item.description,
            item.category,
            item.tool,
            ...(item.toolsUsed || []),
            ...(item.tags || [])
          ].join(' ').toLowerCase();

          return tokens.every((token) => searchable.includes(token));
        });
      };

      // 3. Desktop Header Search Field & Live Dropdown
      const headerSearchInput = document.querySelector('#header-search-input') as HTMLInputElement | null;
      const headerSearchDropdown = document.querySelector('#header-search-dropdown') as HTMLElement | null;
      const dropdownStatus = document.querySelector('#dropdown-status') as HTMLElement | null;
      const dropdownList = document.querySelector('#dropdown-list') as HTMLElement | null;
      const dropdownEmpty = document.querySelector('#dropdown-empty') as HTMLElement | null;

      const renderDropdownItem = (item: typeof searchData[0]) => `
        <a href="/resources/${item.slug}/" class="dropdown-item">
          <div class="dropdown-thumb">
            <img src="${item.thumbnail}" alt="${item.imageAlt || item.title}" loading="lazy" />
          </div>
          <div class="dropdown-info">
            <div class="dropdown-cat">${item.category || 'Blueprint'}</div>
            <p class="dropdown-title">${item.title}</p>
            <p class="dropdown-desc">${item.description}</p>
          </div>
          <div class="dropdown-arrow">
            <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
          </div>
        </a>
      `;

      const updateDesktopSearch = (query: string) => {
        if (!headerSearchDropdown || !dropdownList || !dropdownStatus || !dropdownEmpty) return;

        const trimmed = query.trim();
        if (!trimmed) {
          headerSearchDropdown.hidden = true;
          return;
        }

        const matches = matchResources(trimmed);
        headerSearchDropdown.hidden = false;

        if (matches.length > 0) {
          dropdownEmpty.hidden = true;
          dropdownStatus.hidden = false;
          dropdownStatus.textContent = `${matches.length} published ${matches.length === 1 ? 'match' : 'matches'}`;
          dropdownList.innerHTML = matches.slice(0, 5).map(renderDropdownItem).join('');
        } else {
          dropdownStatus.hidden = true;
          dropdownList.innerHTML = '';
          dropdownEmpty.hidden = false;
        }
      };

      headerSearchInput?.addEventListener('input', () => {
        updateDesktopSearch(headerSearchInput.value);
      });

      headerSearchInput?.addEventListener('focus', () => {
        if (window.innerWidth <= 768) {
          openModalSearch(headerSearchInput.value);
        } else if (headerSearchInput.value.trim()) {
          updateDesktopSearch(headerSearchInput.value);
        }
      });

      headerSearchInput?.addEventListener('click', (e) => {
        if (window.innerWidth <= 768) {
          e.preventDefault();
          openModalSearch(headerSearchInput.value);
        }
      });

      const headerSearchForm = document.querySelector('#header-search-form') as HTMLFormElement | null;
      headerSearchForm?.addEventListener('submit', (e) => {
        if (window.innerWidth <= 768) {
          e.preventDefault();
          openModalSearch(headerSearchInput?.value || '');
        }
      });

      // 4. Mobile / Modal Global Search Overlay
      const searchModal = document.querySelector('#global-search-modal') as HTMLElement | null;
      const searchBackdrop = document.querySelector('#search-backdrop');
      const modalSearchInput = document.querySelector('#global-search-input') as HTMLInputElement | null;
      const searchClearBtn = document.querySelector('#search-clear-btn') as HTMLElement | null;
      const searchCloseBtn = document.querySelector('#search-close-btn') as HTMLElement | null;
      const mobileSearchSubmitBtn = document.querySelector('#mobile-search-submit-btn');
      const mobileSearchInputPreview = document.querySelector('#mobile-search-input-preview') as HTMLInputElement | null;
      const searchResultsList = document.querySelector('#search-results-list') as HTMLElement | null;
      const searchStatusBar = document.querySelector('#search-status-bar') as HTMLElement | null;
      const searchEmptyState = document.querySelector('#search-empty-state') as HTMLElement | null;
      const searchEmptyDesc = document.querySelector('#search-empty-desc') as HTMLElement | null;
      const searchInitialState = document.querySelector('#search-initial-state') as HTMLElement | null;
      const searchInitialList = document.querySelector('#search-initial-list') as HTMLElement | null;
      const emptyClearBtn = document.querySelector('#empty-clear-btn');

      const renderModalCard = (item: typeof searchData[0]) => `
        <a href="/resources/${item.slug}/" class="search-result-card" role="option">
          <div class="card-thumb-wrap">
            <img src="${item.thumbnail}" alt="${item.imageAlt || item.title}" class="card-thumb-img" loading="lazy" />
          </div>
          <div class="card-info">
            <div class="card-meta-row">
              <span class="card-cat-badge">${item.category || 'Blueprint'}</span>
            </div>
            <p class="card-title">${item.title}</p>
            <p class="card-desc">${item.description}</p>
          </div>
          <div class="card-arrow">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="currentColor"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg>
          </div>
        </a>
      `;

      const renderInitialResources = () => {
        if (!searchInitialList || !searchInitialState) return;
        searchInitialState.hidden = false;
        searchStatusBar && (searchStatusBar.hidden = true);
        searchResultsList && (searchResultsList.innerHTML = '');
        searchEmptyState && (searchEmptyState.hidden = true);
        searchInitialList.innerHTML = searchData.slice(0, 4).map(renderModalCard).join('');
      };

      const openModalSearch = (initialVal?: string) => {
        if (!searchModal || !modalSearchInput) return;
        searchModal.hidden = false;
        document.body.style.overflow = 'hidden';
        modalSearchInput.value = initialVal || '';
        if (initialVal) {
          performModalSearch(initialVal);
        } else {
          renderInitialResources();
        }
        setTimeout(() => modalSearchInput.focus(), 50);
      };

      const closeModalSearch = () => {
        if (!searchModal) return;
        searchModal.hidden = true;
        document.body.style.overflow = '';
      };

      const performModalSearch = (query: string) => {
        if (!modalSearchInput || !searchResultsList || !searchStatusBar || !searchEmptyState || !searchEmptyDesc || !searchInitialState) return;

        const trimmed = query.trim();
        if (!trimmed) {
          renderInitialResources();
          return;
        }

        searchInitialState.hidden = true;
        const matches = matchResources(trimmed);

        if (matches.length > 0) {
          searchEmptyState.hidden = true;
          searchStatusBar.hidden = false;
          searchStatusBar.textContent = `Found ${matches.length} published ${matches.length === 1 ? 'resource' : 'resources'}`;
          searchResultsList.innerHTML = matches.map(renderModalCard).join('');
        } else {
          searchStatusBar.hidden = true;
          searchResultsList.innerHTML = '';
          searchEmptyState.hidden = false;
          searchEmptyDesc.textContent = `No published blueprints match "${trimmed}".`;
        }
      };

      mobileSearchSubmitBtn?.addEventListener('click', () => {
        openModalSearch(mobileSearchInputPreview?.value || '');
      });

      mobileSearchInputPreview?.addEventListener('focus', () => {
        openModalSearch(mobileSearchInputPreview.value);
      });

      searchCloseBtn?.addEventListener('click', closeModalSearch);
      searchBackdrop?.addEventListener('click', closeModalSearch);

      emptyClearBtn?.addEventListener('click', () => {
        if (modalSearchInput) {
          modalSearchInput.value = '';
          searchClearBtn && (searchClearBtn.hidden = true);
          modalSearchInput.focus();
          renderInitialResources();
        }
      });

      searchClearBtn?.addEventListener('click', () => {
        if (modalSearchInput) {
          modalSearchInput.value = '';
          searchClearBtn.hidden = true;
          modalSearchInput.focus();
          renderInitialResources();
        }
      });

      modalSearchInput?.addEventListener('input', () => {
        const val = modalSearchInput.value;
        if (searchClearBtn) {
          searchClearBtn.hidden = val.length === 0;
        }
        performModalSearch(val);
      });

      // Global click outside to dismiss desktop search dropdown & mobile menu
      document.addEventListener('click', (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        // Dismiss desktop search dropdown when clicking outside
        const searchWrap = document.querySelector('#header-search-wrap');
        if (headerSearchDropdown && !headerSearchDropdown.hidden && searchWrap && !searchWrap.contains(target)) {
          headerSearchDropdown.hidden = true;
        }

        // Dismiss mobile menu when clicking outside
        if (siteMenu && !siteMenu.hidden && menuToggle && !siteMenu.contains(target) && !menuToggle.contains(target)) {
          closeMenu();
        }
      });

      // Keyboard support
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          if (headerSearchDropdown && !headerSearchDropdown.hidden) {
            headerSearchDropdown.hidden = true;
          }
          if (searchModal && !searchModal.hidden) {
            closeModalSearch();
          }
          closeMenu();
        }

        // Cmd/Ctrl + K shortcut
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          if (window.innerWidth <= 768) {
            if (searchModal && !searchModal.hidden) {
              closeModalSearch();
            } else {
              openModalSearch();
            }
          } else {
            headerSearchInput?.focus();
            headerSearchInput?.select();
          }
        }
      });
    </script>
  </body>
</html>
