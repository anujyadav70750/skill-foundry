        }
        .footer-platforms {
          margin-top: 38px;
        }
        .footer-platform-list {
          gap: 10px;
        }
        .footer-platform-btn {
          width: 44px;
          height: 44px;
          min-width: 44px;
          min-height: 44px;
          border-radius: 10px;
        }
        .footer-platform-btn svg {
          width: 20px;
          height: 20px;
        }
        .footer-legal {
          margin-top: 48px;
        }
        .footer-legal a {
