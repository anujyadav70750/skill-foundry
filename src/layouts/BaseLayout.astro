---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: string;
}

const {
  title = 'Skill Foundry — Practical AI Skills, Prompts & Tutorials',
  description = 'Practical AI prompts, tutorials, workflows and resources to help you build useful skills for the AI era.',
  canonical,
  image,
  type = 'website'
} = Astro.props;

const siteName = 'Skill Foundry';
const fullTitle = title.includes('Skill Foundry') ? title : `${title} | ${siteName}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const socialImage = image ? new URL(image, siteUrl).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Skill Foundry home">
          <span class="brand-mark">SF</span>
          <span>SKILL FOUNDRY</span>
        </a>

        <div class="nav-actions">
          <form class="header-search-form" action="/resources/" method="get" role="search">
            <label class="sr-only" for="header-resource-search">Search resources</label>
            <input id="header-resource-search" name="q" type="search" placeholder="Search resources…" autocomplete="off" spellcheck="false" />
            <button class="header-search-submit" type="submit" aria-label="Search resources">⌕</button>
          </form>

          <div class="menu-wrap">
            <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open navigation menu">
              <span></span><span></span><span></span>
            </button>
            <nav class="site-menu" id="site-menu" aria-label="Main navigation" hidden>
              <a href="/">Home</a>
              <a href="/resources/">Resources</a>
              <a href="/about/">About</a>
            </nav>
          </div>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand-block">
          <div class="brand footer-brand"><span class="brand-mark">SF</span><span>SKILL FOUNDRY</span></div>
          <p>Practical AI resources for learning, creating and building.</p>
        </div>
        <nav class="footer-links" aria-label="Explore">
          <strong>Explore</strong>
          <a href="/">Home</a>
          <a href="/resources/">All Resources</a>
          <a href="/about/">About</a>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} Skill Foundry. All rights reserved.</span>
        <span class="footer-separator" aria-hidden="true">•</span>
        <span>Useful skills for the AI era.</span>
      </div>
    </footer>

    <style>
      .header-search-form {
        display: flex;
        align-items: center;
        width: clamp(180px, 24vw, 300px);
        min-height: 40px;
        padding: 0 4px 0 12px;
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255,255,255,.025);
        color: var(--muted);
        transition: border-color .2s ease, box-shadow .2s ease;
      }

      .header-search-form:focus-within {
        border-color: rgba(61,214,208,.5);
        box-shadow: 0 0 0 3px rgba(61,214,208,.07);
      }

      .header-search-form input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--text);
        font-size: 13px;
      }
      .header-search-form input::placeholder { color: #71849a; }
      .header-search-form input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }

      .header-search-submit {
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        width: 34px;
        height: 32px;
        padding: 0;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: var(--muted);
        font-size: 20px;
        line-height: 1;
        cursor: pointer;
        transition: background .2s ease, color .2s ease;
      }
      .header-search-submit:hover,
      .header-search-submit:focus-visible { background: rgba(61,214,208,.10); color: var(--accent); outline: none; }

      .menu-wrap { position: relative; }
      .menu-toggle {
        display: grid;
        place-content: center;
        gap: 4px;
        width: 40px;
        height: 40px;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: rgba(255,255,255,.025);
        cursor: pointer;
      }
      .menu-toggle span {
        display: block;
        width: 16px;
        height: 1.5px;
        border-radius: 2px;
        background: var(--muted);
        transition: transform .2s ease, opacity .2s ease, background .2s ease;
      }
      .menu-toggle:hover,
      .menu-toggle[aria-expanded="true"] { border-color: rgba(61,214,208,.45); }
      .menu-toggle:hover span,
      .menu-toggle[aria-expanded="true"] span { background: var(--accent); }
      .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
      .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
      .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

      .site-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        display: grid;
        min-width: 170px;
        padding: 7px;
        border: 1px solid var(--line);
        border-radius: 13px;
        background: rgba(12,24,41,.98);
        box-shadow: 0 18px 45px rgba(0,0,0,.35);
      }
      .site-menu[hidden] { display: none; }
      .site-menu a {
        padding: 10px 12px;
        border-radius: 8px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 700;
      }
      .site-menu a:hover { background: rgba(61,214,208,.07); color: var(--text); }

      .site-footer { padding: 34px 0 16px; }
      .footer-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 180px;
        gap: 32px;
        align-items: start;
      }
      .footer-brand-block p { max-width: 430px; margin: 10px 0 0; }
      .footer-links { display: grid; align-content: start; gap: 5px; }
      .footer-links strong { display: block; margin-bottom: 3px; color: var(--text); font-size: 14px; }
      .footer-links a { display: block; color: var(--muted); font-size: 13px; line-height: 1.45; }
      .footer-links a:hover { color: var(--accent); }
      .footer-bottom {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
        padding-top: 14px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 12px;
        text-align: center;
      }
      .footer-separator { color: var(--accent); }

      @media (max-width: 640px) {
        .nav-wrap { min-height: 64px; gap: 10px; }
        .brand { font-size: 11px; gap: 8px; }
        .brand-mark { width: 32px; height: 32px; }
        .nav-actions { gap: 8px; }
        .header-search-form { width: clamp(145px, 46vw, 190px); min-height: 40px; }
        .header-search-form input { font-size: 12px; }
        .header-search-submit { width: 32px; height: 30px; }
        .site-footer { padding-top: 30px; }
        .footer-grid { grid-template-columns: minmax(0, 1fr) 112px; gap: 20px; }
        .footer-brand-block p { max-width: 240px; }
        .footer-links strong { font-size: 13px; }
        .footer-links a { font-size: 12px; }
        .footer-bottom { gap: 7px; margin-top: 20px; padding-top: 13px; line-height: 1.4; }
      }
    </style>

    <script>
      const menuToggle = document.querySelector('#menu-toggle');
      const siteMenu = document.querySelector('#site-menu');

      const closeMenu = () => {
        if (!menuToggle || !siteMenu) return;
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Open navigation menu');
        siteMenu.hidden = true;
      };

      menuToggle?.addEventListener('click', () => {
        if (!siteMenu) return;
        const open = menuToggle.getAttribute('aria-expanded') === 'true';
        menuToggle.setAttribute('aria-expanded', String(!open));
        menuToggle.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu');
        siteMenu.hidden = open;
      });

      document.addEventListener('click', (event) => {
        if (!siteMenu || !menuToggle) return;
        const target = event.target;
        if (target instanceof Node && !siteMenu.contains(target) && !menuToggle.contains(target)) closeMenu();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeMenu();
      });
    </script>
  </body>
</html>
