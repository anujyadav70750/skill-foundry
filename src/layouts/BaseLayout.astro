---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../lib/resource';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  robots?: string;
}

const siteUrl = 'https://skillfoundry.dev';
const siteName = 'Skill Foundry';
const defaultTitle = 'Skill Foundry | Practical AI Blueprint Library';
const defaultDescription = 'Skill Foundry is an editorial library for builders. Discover practical AI blueprints, prompt systems, and executable workflows that turn models into production software.';

const {
  title,
  description = defaultDescription,
  canonical,
  image = '/og-image.svg',
  imageAlt = 'Skill Foundry — Practical AI blueprints, workflows, and tools',
  type = 'website',
  robots = 'index, follow'
} = Astro.props;

const fullTitle = title ? `${title} | ${siteName}` : defaultTitle;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const socialImage = image ? new URL(image, siteUrl).href : undefined;

// Single Source of Truth: published resources for global search
const allResources = await getCollection('resources');
const publishedSearchData = allResources
  .filter((r) => !('draft' in r.data && r.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .map((r) => ({
    title: r.data.title,
    slug: resourceSlug(r),
    description: r.data.description,
    category: r.data.category || '',
    tool: r.data.tool || '',
    toolsUsed: Array.isArray(r.data.toolsUsed) ? r.data.toolsUsed.map((t: any) => t.name) : [],
    tags: Array.isArray(r.data.tags) ? r.data.tags : [],
    thumbnail: resourceThumbnail(r),
    imageAlt: resourceImageAlt(r),
    date: r.data.date ? new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(new Date(r.data.date)) : ''
  }));

const currentPath = Astro.url.pathname;

const platformLinks = [
  {
    name: 'Facebook',
    url: 'https://facebook.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>'
  },
  {
    name: 'X',
    url: 'https://x.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>'
  },
  {
    name: 'Instagram',
    url: 'https://instagram.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>'
  },
  {
    name: 'LinkedIn',
    url: 'https://linkedin.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>'
  },
  {
    name: 'Pinterest',
    url: 'https://pinterest.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0c-6.627 0-12 5.372-12 12 0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345-.09.375-.293 1.199-.334 1.363-.053.225-.172.271-.401.165-1.495-.69-2.433-2.878-2.433-4.646 0-3.776 2.748-7.252 7.92-7.252 4.158 0 7.392 2.967 7.392 6.923 0 4.135-2.607 7.462-6.233 7.462-1.214 0-2.354-.629-2.758-1.379l-.749 2.848c-.269 1.045-1.004 2.352-1.498 3.146 1.123.345 2.306.535 3.55.535 6.607 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>'
  },
  {
    name: 'YouTube',
    url: 'https://youtube.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>'
  },
  {
    name: 'GitHub',
    url: 'https://github.com',
    svg: '<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>'
  }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090D14" />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="C_J2tHd4KyewCilkXDUref97yEkMTr0yWQtLCKBsCEI" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/workflow-fixes.css?v=20260924-capsule-final" />
    <script src="/workflow-fixes.js?v=20260916-final" defer></script>
    <title>{fullTitle}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
  </head>
  <body>
    <!-- GLOBAL UNIFIED NAVIGATION HEADER (TWO WINGS INTERLOCKING WITH CENTER COMPACT SF TAB) -->
    <header class="site-header" id="global-site-header">
      <nav class="nav-pill-container" aria-label="Main navigation">
        <!-- LEFT WING: HOME & RESOURCES -->
        <div class="nav-segment nav-segment-left">
          <a class={`nav-link ${currentPath === '/' ? 'active' : ''}`} href="/">HOME</a>
          <a class={`nav-link ${currentPath.startsWith('/resources') ? 'active' : ''}`} href="/resources/">RESOURCES</a>
        </div>

        <!-- CENTER RAISED COMPACT ROUNDED-SQUARE SF TAB -->
        <div class="nav-zone-logo">
          <a class="nav-logo-tab" href="/" aria-label="Skill Foundry home">
            <span class="brand-mark">SF</span>
          </a>
        </div>

        <!-- RIGHT WING: SEARCH & ABOUT -->
        <div class="nav-segment nav-segment-right">
          <div class="header-search-wrap" id="header-search-wrap">
            <form class="header-search-box" id="header-search-form" action="/resources/" method="get" role="search">
              <input
                id="header-search-input"
                class="header-search-input"
                type="search"
                name="q"
                autocomplete="off"
                spellcheck="false"
                aria-label="Search resources"
                aria-autocomplete="list"
                aria-controls="header-search-dropdown"
              />
              <button class="header-search-submit" type="submit" aria-label="Submit search">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="11" cy="11" r="7"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </button>
            </form>

            <!-- Attached Search Dropdown -->
            <div class="header-search-dropdown" id="header-search-dropdown" role="region" aria-label="Search suggestions" hidden>
              <div class="dropdown-status" id="dropdown-status"></div>
              <div class="dropdown-list" id="dropdown-list" role="listbox"></div>
              <div class="dropdown-empty" id="dropdown-empty" hidden>
                <p class="dropdown-empty-title">No resources found</p>
                <p class="dropdown-empty-sub">Try searching for prompts, tools, or blueprint workflows.</p>
              </div>
              <div class="dropdown-footer">
                <a href="/resources/" class="dropdown-view-all">View all published blueprints →</a>
              </div>
            </div>
          </div>

          <a class={`nav-link ${currentPath.startsWith('/about') ? 'active' : ''}`} href="/about/">ABOUT</a>
        </div>
      </nav>
    </header>

    <main><slot /></main>

    <!-- MOBILE / MODAL GLOBAL SEARCH OVERLAY -->
    <div id="global-search-modal" class="search-overlay" role="dialog" aria-modal="true" aria-labelledby="global-search-title" hidden>
      <div class="search-backdrop" id="search-backdrop"></div>
      <div class="search-modal-card">
        <div class="search-header-bar">
          <span class="sr-only" id="global-search-title">Search Skill Foundry Resources</span>
          <div class="search-input-wrap">
            <svg class="search-modal-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              id="global-search-input"
              class="search-modal-input"
              type="search"
              placeholder="Search resources, tools, prompts..."
              autocomplete="off"
              spellcheck="false"
              aria-autocomplete="list"
              aria-controls="search-results-list"
            />
            <button id="search-clear-btn" class="search-modal-clear" type="button" aria-label="Clear query" hidden>
              <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
          <button id="search-close-btn" class="search-modal-close" type="button" aria-label="Close search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <div class="search-modal-body" id="search-modal-body">
          <div class="search-status-bar" id="search-status-bar" hidden></div>
          <div class="search-results-list" id="search-results-list" role="listbox"></div>
          
          <div class="search-empty-state" id="search-empty-state" hidden>
            <div class="empty-icon-wrap">
              <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="8" y1="8" x2="14" y2="14"></line>
              </svg>
            </div>
            <p class="empty-title">No resources found</p>
            <p class="empty-desc" id="search-empty-desc">No published blueprints or workflows match your query.</p>
            <button class="empty-clear-btn" id="empty-clear-btn" type="button">Clear Search</button>
          </div>

          <div class="search-initial-state" id="search-initial-state">
            <p class="search-section-label">PUBLISHED BLUEPRINTS &amp; WORKFLOWS</p>
            <div class="search-initial-list" id="search-initial-list"></div>
          </div>
        </div>

        <div class="search-modal-footer">
          <a href="/resources/" class="search-all-link">View all resources in library →</a>
        </div>
      </div>
    </div>

    <!-- EMBEDDED PUBLISHED RESOURCE SEARCH DATA -->
    <script type="application/json" id="sf-search-data" set:html={JSON.stringify(publishedSearchData)}></script>

    <!-- GLOBAL FOOTER -->
    <footer class="site-footer">
      <div class="container footer-container">
        <!-- 1. Centered Brand -->
        <div class="footer-brand-wrap">
          <a class="brand footer-brand" href="/" aria-label="Skill Foundry home">
            <span class="brand-mark">SF</span>
            <span class="brand-name">SKILL FOUNDRY</span>
          </a>
        </div>

        <!-- 2. Three Descriptor Points -->
        <div class="footer-descriptors" aria-label="Skill Foundry Focus Areas">
          <span class="descriptor-item"><span class="descriptor-dot" aria-hidden="true">•</span> PRACTICAL SKILLS</span>
          <span class="descriptor-item"><span class="descriptor-dot" aria-hidden="true">•</span> TUTORIALS &amp; WORKFLOWS</span>
          <span class="descriptor-item"><span class="descriptor-dot" aria-hidden="true">•</span> TOOLS &amp; PROJECTS</span>
        </div>

        <!-- 3. First Subtle Horizontal Divider -->
        <div class="footer-divider footer-divider-top" role="separator"></div>

        <!-- 4. Main Navigation -->
        <nav class="footer-nav" aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/resources/">Resources</a>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
        </nav>

        <!-- 5. Social Platform Icons -->
        <div class="footer-platforms" aria-label="External platforms">
          <div class="footer-platform-list">
            {platformLinks.map((item) => (
              <a
                class="footer-platform-btn"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Skill Foundry on ${item.name}`}
                title={item.name}
                set:html={item.svg}
              />
            ))}
          </div>
        </div>

        <!-- 6. Legal Links -->
        <nav class="footer-legal" aria-label="Legal navigation">
          <a href="/privacy/">Privacy</a>
          <span class="legal-separator" aria-hidden="true">|</span>
          <a href="/terms/">Terms</a>
        </nav>

        <!-- 7. Copyright -->
        <div class="footer-copyright">
          <span>© {new Date().getFullYear()} Skill Foundry. All rights reserved.</span>
        </div>
      </div>
    </footer>

    <style>
      /* ==========================================================================
         GLOBAL UNIFIED HEADER (TWO WINGS INTERLOCKING WITH CENTER SF TAB)
         ========================================================================== */
      .site-header {
        position: fixed;
        top: 18px;
        left: 0;
        right: 0;
        width: 100%;
        z-index: 1000;
        display: flex;
        justify-content: center;
        pointer-events: none;
        padding: 0 24px;
      }
      /* The opening section on each page owns its background surface and extends
         underneath this fixed header. No separate header background layer is used. */



      .nav-pill-container {
        pointer-events: auto;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 820px;
        margin: 0 auto;
        overflow: visible;
      }

      /* Two Horizontal Capsule Wings (Stop at SF Tab Sides) */
      .nav-segment {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex: 1 1 0%;
        height: 56px;
        min-height: 56px;
        background: rgba(6, 11, 20, 0.96);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-top: 1px solid rgba(255, 255, 255, 0.10);
        border-bottom: 1px solid rgba(255, 255, 255, 0.10);
        box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.75), 0 2px 6px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      }
      .nav-segment-left {
        border-left: 1px solid rgba(255, 255, 255, 0.10);
        border-right: none;
        border-radius: 9999px 0 0 9999px;
        padding: 0 82px 0 48px;
        margin-right: -10px;
      }
      .nav-segment-right {
        border-right: 1px solid rgba(255, 255, 255, 0.10);
        border-left: none;
        border-radius: 0 9999px 9999px 0;
        padding: 0 48px 0 82px;
        margin-left: -10px;
      }

      /* Navigation Links (HOME, RESOURCES, ABOUT - NO DIVIDER LINES) */
      .nav-link {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: #DCE4EE;
        text-transform: uppercase;
        text-decoration: none;
        transition: color 0.15s ease, opacity 0.15s ease;
        padding: 4px 0;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
      }
      .nav-link:hover {
        color: #FFFFFF;
      }
      .nav-link.active {
        color: #FFFFFF;
        text-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
      }

      /* Center Compact Rounded-Square SF Tab (RAISED • PROTRUDES SLIGHTLY • WINGS ATTACH AT SIDES) */
      .nav-zone-logo {
        position: relative;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
      }
      .nav-logo-tab {
        position: relative;
        display: grid;
        place-items: center;
        width: 64px;
        height: 64px;
        min-width: 64px;
        margin: 0;
        padding: 0;
        border-radius: 14px;
        overflow: hidden;
        background: #060B14;
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 10px 24px -2px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.12);
        text-decoration: none;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .nav-logo-tab:hover {
        background: #0A111E;
        border-color: rgba(255, 255, 255, 0.22);
        transform: translateY(-1px);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.90), inset 0 1px 0 rgba(255, 255, 255, 0.20);
      }
      .brand-mark {
        width: 44px;
        height: 44px;
        min-width: 44px;
        border-radius: 10px;
        background: #FF6600;
        color: #FFFFFF;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 0.02em;
        display: grid;
        place-items: center;
        box-shadow: 0 2px 8px rgba(255, 102, 0, 0.38);
