---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  robots?: string;
}

const {
  title = 'Skill Foundry — Practical AI Skills, Prompts & Tutorials',
  description = 'Practical AI prompts, tutorials, workflows and resources to help you build useful skills for the AI era.',
  canonical,
  image,
  imageAlt,
  type = 'website',
  robots = 'index, follow, max-image-preview:large'
} = Astro.props;

const siteName = 'Skill Foundry';
const fullTitle = title.includes('Skill Foundry') ? title : `${title} | ${siteName}`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const socialImage = image ? new URL(image, siteUrl).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07111f" />
    <meta name="robots" content={robots} />
    <meta name="google-site-verification" content="C_J2tHd4KyewCilkXDUref97yEkMTr0yWQtLCKBsCEI" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {socialImage && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="Skill Foundry home">
          <span class="brand-mark">SF</span>
          <span>SKILL FOUNDRY</span>
        </a>
        <div class="nav-actions">
          <form class="header-search-form" action="/resources/" method="get" role="search">
            <label class="sr-only" for="header-resource-search">Search resources</label>
            <input id="header-resource-search" name="q" type="search" placeholder="Search resources…" autocomplete="off" spellcheck="false" />
            <button class="header-search-submit" type="submit" aria-label="Search resources">
              <svg class="search-svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="10.5" cy="10.5" r="6.5"></circle>
                <path d="M15.5 15.5 21 21"></path>
              </svg>
            </button>
          </form>
          <div class="menu-wrap">
            <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open navigation menu">
              <span></span><span></span><span></span>
            </button>
            <nav class="site-menu" id="site-menu" aria-label="Main navigation" hidden>
              <a href="/">Home</a>
              <a href="/resources/">Resources</a>
              <a href="/about/">About</a>
            </nav>
          </div>
        </div>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand-block">
          <div class="brand footer-brand"><span class="brand-mark">SF</span><span>SKILL FOUNDRY</span></div>
          <p>Practical AI resources for learning, creating and building.</p>
        </div>
        <nav class="footer-links" aria-label="Explore">
          <strong>Explore</strong>
          <a href="/">Home</a>
          <a href="/resources/">All Resources</a>
          <a href="/about/">About</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
      <div class="container footer-bottom"><span>© {new Date().getFullYear()} Skill Foundry. All rights reserved.</span></div>
    </footer>
    <style>
      .header-search-form { display: flex; align-items: center; width: clamp(180px, 24vw, 300px); min-height: 40px; padding: 0 9px 0 12px; border: 1px solid var(--line); border-radius: 999px; background: rgba(255,255,255,.025); color: var(--muted); transition: border-color .2s ease, box-shadow .2s ease; }
      .header-search-form:focus-within { border-color: rgba(61,214,208,.5); box-shadow: 0 0 0 3px rgba(61,214,208,.07); }
      .header-search-form input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--text); font-size: 13px; }
      .header-search-form input::placeholder { color: #71849a; }
      .header-search-form input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
      .header-search-submit { display: grid; place-items: center; flex: 0 0 auto; width: 34px; height: 34px; padding: 0; border: 1px solid rgba(255,255,255,.12); border-radius: 9px; background: #16243a; color: var(--muted); cursor: pointer; transition: border-color .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease; }
      .header-search-submit:hover, .header-search-submit:focus-visible { border-color: rgba(61,214,208,.55); background: rgba(61,214,208,.10); color: var(--accent); box-shadow: 0 0 0 3px rgba(61,214,208,.07); outline: none; }
      .search-svg { display: block; width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
      .menu-wrap { position: relative; }
      .menu-toggle { display: grid; place-content: center; gap: 4px; width: 40px; height: 40px; padding: 0; border: 1px solid var(--line); border-radius: 10px; background: rgba(255,255,255,.025); cursor: pointer; }
      .menu-toggle span { display: block; width: 16px; height: 1.5px; border-radius: 2px; background: var(--muted); transition: transform .2s ease, opacity .2s ease, background .2s ease; }
      .menu-toggle:hover, .menu-toggle[aria-expanded="true"] { border-color: rgba(61,214,208,.45); }
      .menu-toggle:hover span, .menu-toggle[aria-expanded="true"] span { background: var(--accent); }
      .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
      .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
      .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }
      .site-menu { position: absolute; top: calc(100% + 10px); right: 0; display: grid; min-width: 170px; padding: 7px; border: 1px solid var(--line); border-radius: 13px; background: rgba(12,24,41,.98); box-shadow: 0 18px 45px rgba(0,0,0,.35); }
      .site-menu[hidden] { display: none; }
      .site-menu a { padding: 10px 12px; border-radius: 8px; color: var(--muted); font-size: 13px; font-weight: 700; }
      .site-menu a:hover { background: rgba(61,214,208,.07); color: var(--text); }
      .site-footer { padding: 34px 0 16px; }
      .footer-grid { display: grid; grid-template-columns: minmax(0, 1fr) 180px; gap: 32px; align-items: start; }
      .footer-brand-block p { max-width: 430px; margin: 10px 0 0; }
      .footer-links { display: grid; align-content: start; gap: 2px; }
      .footer-links strong { display: block; margin: 0 0 12px; color: var(--text); font-size: 14px; }
      .footer-links a { display: block; margin: 0 !important; padding: 0; color: var(--muted); font-size: 13px; line-height: 1.35; }
      .footer-links a:hover { color: var(--accent); }
      .footer-bottom { display: flex; align-items: center; justify-content: center; margin-top: 20px; padding-top: 13px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; line-height: 1.4; text-align: center; }
      @media (max-width: 640px) {
        .nav-wrap { min-height: 64px; gap: 10px; }
        .brand { font-size: 11px; gap: 8px; }
        .brand-mark { width: 32px; height: 32px; }
        .nav-actions { gap: 8px; }
        .header-search-form { width: clamp(145px, 46vw, 190px); padding-right: 8px; }
        .header-search-form input { font-size: 12px; }
        .header-search-submit { width: 32px; height: 32px; }
        .search-svg { width: 16px; height: 16px; }
        .site-footer { padding-top: 30px; }
        .footer-grid { grid-template-columns: minmax(0, 1fr) 112px; gap: 20px; }
        .footer-brand-block p { max-width: 240px; }
        .footer-links strong { font-size: 13px; margin-bottom: 12px; }
        .footer-links a { font-size: 12px; line-height: 1.35; }
        .footer-bottom { margin-top: 18px; padding-top: 12px; font-size: 12px; }
      }
    </style>
    <style is:global>
      .builder-page .repeat-item input:not([type="checkbox"]),
      .builder-page .repeat-item textarea,
      .builder-page .repeat-item select,
      .builder-page .media-control input.path-input,
      .builder-page .media-item input.path-input {
        width:100%; box-sizing:border-box; min-height:46px; padding:10px 12px; border:1px solid var(--line); border-radius:11px; background:rgba(7,17,31,.75); color:var(--text); font:inherit; font-size:14px; line-height:1.5; outline:none; color-scheme:dark;
      }
      .builder-page .repeat-item textarea { min-height:84px; resize:vertical; }
      .builder-page .repeat-item input::placeholder,
      .builder-page .repeat-item textarea::placeholder,
      .builder-page .media-control input::placeholder { color:#71849a; opacity:1; }
      .builder-page .repeat-item input:focus,
      .builder-page .repeat-item textarea:focus,
      .builder-page .media-control input.path-input:focus { border-color:rgba(61,214,208,.55); box-shadow:0 0 0 3px rgba(61,214,208,.07); }
      .builder-page .remove-button { position:absolute; top:10px; right:10px; display:grid; place-items:center; width:32px!important; height:32px!important; min-width:32px!important; min-height:32px!important; margin:0; padding:0!important; border:1px solid var(--line); border-radius:50%; background:rgba(255,255,255,.035); color:var(--muted); font:inherit; font-size:18px; font-weight:500; line-height:1; cursor:pointer; appearance:none; -webkit-appearance:none; }
      .builder-page .remove-button:hover,
      .builder-page .remove-button:focus-visible { border-color:rgba(255,100,100,.5); color:#ff9b9b; background:rgba(255,100,100,.07); outline:none; }
      .builder-page .repeat-item { position:relative; padding-right:56px; }
      .builder-page .file-button { display:flex!important; align-items:center; justify-content:center; min-height:46px; min-width:118px; box-sizing:border-box; padding:0 14px; border:1px solid var(--line); border-radius:10px; background:rgba(16,34,56,.55); color:var(--text); font-size:12px; font-weight:800; cursor:pointer; }
      .builder-page .file-button:hover { border-color:rgba(61,214,208,.45); color:var(--accent); background:rgba(61,214,208,.08); }
      .builder-page .file-button input[type="file"] { display:none!important; }
      .builder-page .upload-row { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px; align-items:stretch; }
      .builder-page .media-control { min-width:0; }
      .builder-page .image-preview { display:none; margin-top:10px; padding:10px; border:1px solid var(--line); border-radius:12px; background:rgba(7,17,31,.5); }
      .builder-page .image-preview.has-image { display:block; }
      .builder-page .image-preview img { display:block; width:min(100%,420px); max-height:260px; object-fit:cover; border:1px solid var(--line); border-radius:10px; }
      .builder-page .image-preview span { display:block; margin-top:7px; color:var(--muted); font-size:11px; }
      .builder-page .check-inline { display:flex!important; align-items:center; gap:8px; min-height:46px; }
      .builder-page .check-inline input[type="checkbox"] { width:17px!important; height:17px!important; min-height:17px!important; padding:0!important; accent-color:var(--accent); }
      @media(max-width:700px){
        .builder-page .repeat-item.tool,
        .builder-page .repeat-item.step { grid-template-columns:1fr; }
        .builder-page .upload-row { grid-template-columns:1fr; }
        .builder-page .file-button { min-height:44px; width:100%; }
        .builder-page .repeat-item { padding-right:52px; }
        .builder-page .remove-button { width:32px!important; height:32px!important; }
      }
    </style>
    <script>
      const menuToggle = document.querySelector('#menu-toggle');
      const siteMenu = document.querySelector('#site-menu');
      const closeMenu = () => { if (!menuToggle || !siteMenu) return; menuToggle.setAttribute('aria-expanded', 'false'); menuToggle.setAttribute('aria-label', 'Open navigation menu'); siteMenu.hidden = true; };
      menuToggle?.addEventListener('click', () => { if (!siteMenu) return; const open = menuToggle.getAttribute('aria-expanded') === 'true'; menuToggle.setAttribute('aria-expanded', String(!open)); menuToggle.setAttribute('aria-label', open ? 'Open navigation menu' : 'Close navigation menu'); siteMenu.hidden = open; });
      document.addEventListener('click', (event) => { if (!siteMenu || !menuToggle) return; const target = event.target; if (target instanceof Node && !siteMenu.contains(target) && !menuToggle.contains(target)) closeMenu(); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
    </script>
  </body>
</html>
