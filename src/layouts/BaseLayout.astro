          gap: 0;
          padding: 0;
        }
        .descriptor-item {
          width: 100%;
          min-width: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 9.5px;
          letter-spacing: 0.055em;
          gap: 5px;
          line-height: 1.35;
          white-space: nowrap;
        }
        .descriptor-dot {
          font-size: 9px;
          flex: 0 0 auto;
        }
        .footer-divider-top {
          margin: 32px auto 38px;
        }
        .footer-nav {
          gap: 0 24px;
