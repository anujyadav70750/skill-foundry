      /* ZONE 4. Search Capsule (SAME DARK FAMILY & BORDER AS NAV CONTROLS • NO PLACEHOLDER • ICON ON RIGHT) */
      .header-search-wrap {
        position: relative;
        display: flex;
        align-items: center;
      }
      .header-search-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 88px;
        height: 32px;
        padding: 0 8px 0 10px;
        border: 1px solid rgba(255, 255, 255, 0.10);
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.035);
        color: #94A3B8;
        transition: border-color 0.2s ease, background 0.2s ease;
        cursor: text;
      }
      .header-search-box:hover {
        border-color: rgba(255, 255, 255, 0.18);
        background: rgba(255, 255, 255, 0.05);
      }
      .header-search-box:focus-within {
        border-color: rgba(255, 255, 255, 0.25);
        background: rgba(10, 16, 26, 0.95);
        box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.06);
      }
      .header-search-input {
        width: 100%;
        min-width: 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #F8FAFC;
        font-family: inherit;
        font-size: 11.5px;
        font-weight: 500;
        padding: 0;
      }
      .header-search-input::-webkit-search-cancel-button {
        -webkit-appearance: none;
        appearance: none;
        display: none;
      }
      .header-search-submit {
        display: grid;
        place-items: center;
        flex: 0 0 auto;
        width: 18px;
        height: 18px;
        padding: 0;
        border: none;
        border-radius: 999px;
        background: transparent;
        color: #94A3B8;
        cursor: pointer;
        transition: color 0.15s ease;
      }
      .header-search-submit:hover {
        color: #FFFFFF;
      }
      .header-search-submit svg {
        width: 13px;
        height: 13px;
      }

      /* Desktop Attached Dropdown */
      .header-search-dropdown {
        position: absolute;
        top: calc(100% + 12px);
        right: -60px;
        width: min(380px, 85vw);
        max-height: 420px;
        background: #0E1420;
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 16px;
        box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.05);
        overflow-y: auto;
        padding: 12px;
        z-index: 1200;
        animation: searchDropdownIn 0.18s cubic-bezier(0.16, 1, 0.3, 1);
      }
      @keyframes searchDropdownIn {
        from { transform: translateY(-6px); opacity: 0; }
        to { transform: translateY(0); opacity: 1; }
      }
      .header-search-dropdown[hidden] {
        display: none !important;
      }
      .dropdown-status {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #64748B;
        padding: 4px 8px 8px;
      }
      .dropdown-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .dropdown-item {
        display: grid;
        grid-template-columns: 60px 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 8px 10px;
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.05);
        text-decoration: none;
        color: inherit;
        transition: all 0.15s ease;
      }
      .dropdown-item:hover, .dropdown-item.is-active {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 102, 0, 0.40);
        transform: translateX(2px);
      }
      .dropdown-thumb {
        width: 60px;
        height: 40px;
        border-radius: 6px;
        overflow: hidden;
        background: #182030;
        border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .dropdown-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .dropdown-info {
        min-width: 0;
      }
      .dropdown-cat {
        font-size: 9.5px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #FF6600;
        margin-bottom: 2px;
      }
      .dropdown-title {
        font-size: 13px;
        font-weight: 700;
        color: #F8FAFC;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin: 0;
      }
      .dropdown-item:hover .dropdown-title {
        color: #FF6600;
      }
      .dropdown-desc {
        font-size: 11px;
        color: #94A3B8;
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 2px 0 0;
      }
      .dropdown-arrow {
        color: #64748B;
        padding-right: 4px;
        transition: color 0.15s ease;
      }
      .dropdown-item:hover .dropdown-arrow {
        color: #FF6600;
      }
      .dropdown-empty {
        padding: 24px 12px;
        text-align: center;
      }
      .dropdown-empty-title {
        font-size: 14px;
        font-weight: 700;
        color: #F8FAFC;
        margin: 0 0 4px;
      }
      .dropdown-empty-sub {
        font-size: 12px;
        color: #94A3B8;
        margin: 0;
      }
      .dropdown-footer {
        padding: 8px 8px 4px;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        margin-top: 8px;
        text-align: center;
      }
      .dropdown-view-all {
        font-size: 11.5px;
        font-weight: 700;
        color: #FF6600;
        text-decoration: none;
      }
      .dropdown-view-all:hover {
        opacity: 0.85;
      }

