---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ_DATA } from '../data/faqs';

const pageTitle = 'Frequently Asked Questions';
const pageDescription = 'Clear answers about Skill Foundry, its resources, recommended tools and how to use them.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://hub.skillfoundry-web.workers.dev/faq/"
>
  <main class="faq-page">
    <div class="faq-page-container">
      <header class="faq-page-header">
        <h1 class="faq-page-title">{pageTitle}</h1>
        <p class="faq-page-desc">{pageDescription}</p>
      </header>

      <section class="faq-search-section" aria-label="Search frequently asked questions">
        <div class="faq-search-field">
          <input id="faq-search-input" class="faq-search-input" type="text" placeholder="Search questions and answers..." autocomplete="off" spellcheck="false" aria-label="Search questions and answers" />
          <span class="faq-search-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg></span>
        </div>
      </section>

      <section class="faq-list-section" aria-label="Frequently asked questions">
        <div class="faq-list" id="faq-list">
          {FAQ_DATA.map((item, index) => (
            <article class="faq-item" data-faq-id={item.id}>
              <h2 class="faq-item-heading faq-question-text">{item.question}</h2>
              <div class="faq-answer-divider" aria-hidden="true"></div>
              <div class="faq-answer-inner"><p class="faq-answer-text">{item.answer}</p></div>
            </article>
          ))}
        </div>

        <div class="faq-no-results" id="faq-no-results" hidden>
          <h2 class="faq-no-results-title">We couldn’t find an answer to that.</h2>
          <p class="faq-no-results-desc">Try a different search, or contact us and describe what you need help with.</p>
          <a class="faq-no-results-link" href="/contact/">Contact Skill Foundry</a>
        </div>
      </section>

      <div class="faq-support-divider" aria-hidden="true"></div>

      <section class="faq-support-cta" aria-label="Contact Skill Foundry">
        <h3 class="faq-support-title">Still have a <span>question?</span></h3>
        <p class="faq-support-desc">Didn't find your answer? Send us a message.</p>
        <a href="/contact/" class="faq-support-button">Contact us</a>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .faq-page {
    min-height: 70vh;
    padding: clamp(42px, 5vw, 64px) 20px 18px;
    color: #F8FAFC;
    box-sizing: border-box;
  }

  .faq-page-container {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .faq-page-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .faq-page-title {
    margin: 0;
    color: var(--text-primary, #FFFFFF);
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .faq-page-desc {
    max-width: 590px;
    margin: 0;
    color: var(--text-secondary, #94A3B8);
    font-size: clamp(14px, 1.8vw, 16px);
    line-height: 1.6;
  }

  .faq-search-section {
    width: 100%;
    margin-top: 24px;
  }

  .faq-list-section {
    width: 100%;
    margin-top: 24px;
  }

  .faq-search-field {
    max-width: 620px;
    min-height: 50px;
    margin: 0 auto;
    padding: 0 10px 0 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(13, 20, 34, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    box-sizing: border-box;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .faq-search-field:focus-within {
    border-color: rgba(45, 190, 180, 0.55);
    box-shadow: 0 0 0 3px rgba(45, 190, 180, 0.10);
  }

  .faq-search-icon { width:42px;height:42px;flex:0 0 42px;display:inline-flex;align-items:center;justify-content:center;border:1px solid rgba(255,255,255,.12);border-radius:10px;background:rgba(255,255,255,.055);color:#A9B7C8; }

  .faq-search-input {
    width: 100%;
    min-width: 0;
    padding: 12px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #F8FAFC;
    font: inherit;
    font-size: 14px;
  }

  .faq-search-input::placeholder {
    color: #78869A;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-item {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 13px;
    background: linear-gradient(180deg, rgba(16, 24, 39, 0.78), rgba(10, 15, 25, 0.82));
    transition: border-color 0.18s ease;
  }

  .faq-item:hover,
  .faq-item:focus-within {
    border-color: rgba(45, 190, 180, 0.28);
  }

  .faq-item-heading { margin:0;padding:20px 20px 17px;color:#F1F5F9;font-size:16px;font-weight:700;line-height:1.45;letter-spacing:-.01em; }
  .faq-answer-divider { height:1px;margin:0 20px;background:rgba(255,255,255,.12); }
  .faq-answer-inner { padding:16px 20px 20px; }

  .faq-answer-text {
    margin: 0;
    padding-top: 1px;
    color: #B8C3D1;
    font-size: 14px;
    line-height: 1.7;
  }

  :global(.faq-match-mark) {
    padding: 0 2px;
    border-radius: 3px;
    background: rgba(45, 190, 180, 0.15);
    color: inherit;
  }

  .faq-no-results {
    padding: 30px 20px;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: 13px;
    text-align: center;
    background: rgba(13, 20, 34, 0.45);
  }

  .faq-no-results[hidden] {
    display: none;
  }

  .faq-no-results-title {
    margin: 0 0 7px;
    color: #F1F5F9;
    font-size: 16px;
    font-weight: 700;
  }

  .faq-no-results-desc {
    margin: 0 0 13px;
    color: #94A3B8;
    font-size: 13.5px;
    line-height: 1.55;
  }

  .faq-no-results-link {
    color: #55C8BE;
    font-size: 13.5px;
    font-weight: 650;
    text-decoration: none;
  }

  .faq-no-results-link:hover {
    text-decoration: underline;
  }

  .faq-page .faq-support-divider {
    width: 100%;
    height: 1px;
    margin: 14px auto 13px;
    background: rgba(255, 255, 255, 0.08);
  }

  .faq-page .faq-support-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    padding: 0 8px 8px;
    text-align: center;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-sizing: border-box;
  }

  .faq-page .faq-support-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    width: min(100%, 420px);
    margin: 0 auto 2px;
    color: #3DD6C8;
  }

  .faq-page .faq-support-mark svg {
    display: block;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    filter: drop-shadow(0 0 9px rgba(61, 214, 200, 0.24));
  }

  .faq-page .faq-support-rule {
    display: block;
    width: min(30%, 118px);
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(61, 214, 200, 0.8));
  }

  .faq-page .faq-support-rule:last-child {
    transform: rotate(180deg);
  }

  .faq-page .faq-support-title {
    margin: 0;
    color: var(--text-primary, #F5F5F5);
    font-size: clamp(18px, 2.8vw, 19px);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .faq-page .faq-support-title span {
    color: #3DD6C8;
  }

  .faq-page .faq-support-desc {
    max-width: 380px;
    margin: 0 auto;
    color: var(--text-secondary, #A7ADB8);
    font-size: 12.5px;
    line-height: 1.45;
  }

  .faq-page .faq-support-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: center;
    width: auto;
    min-width: 152px;
    min-height: 40px;
    margin-top: 2px;
    padding: 0 16px;
    border: 1px solid #A8C8DF;
    border-radius: 9px;
    background: #C5DDED;
    color: #183247;
    font-size: 12.5px;
    line-height: 1;
    font-weight: 750;
    text-align: center;
    text-decoration: none;
    white-space: nowrap;
    box-sizing: border-box;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .faq-page .faq-support-button:hover {
    background: #C5DDED;
    border-color: #A8C8DF;
    color: #183247;
    box-shadow: 0 3px 10px rgba(80, 126, 158, 0.16);
    transform: translateY(-1px);
  }

  .faq-page .faq-support-button:active {
    background: #C5DDED;
    border-color: #A8C8DF;
    color: #183247;
    transform: translateY(0);
    box-shadow: none;
  }

  .faq-page .faq-support-button:focus-visible {
    outline: 2px solid #238E8D;
    outline-offset: 3px;
  }

  :global([data-theme="light"]) .faq-page .faq-support-divider,
  :global(html.light-theme) .faq-page .faq-support-divider {
    background: rgba(15, 23, 42, 0.10);
  }

  :global([data-theme="light"]) .faq-page .faq-support-title,
  :global(html.light-theme) .faq-page .faq-support-title {
    color: #172033;
  }

  :global([data-theme="light"]) .faq-page .faq-support-title span,
  :global(html.light-theme) .faq-page .faq-support-title span {
    color: #128C87;
  }

  :global([data-theme="light"]) .faq-page .faq-support-desc,
  :global(html.light-theme) .faq-page .faq-support-desc {
    color: #64748B;
  }

  @media (max-width: 640px) {
    .faq-search-section,
    .faq-list-section {
      margin-top: 20px;
    }

    .faq-page .faq-support-divider {
      margin: 12px auto 11px;
    }

    .faq-page .faq-support-cta {
      gap: 6px;
      margin: 0 auto;
      padding: 0 8px 6px;
    }

    .faq-page .faq-support-title {
      font-size: 18px;
      line-height: 1.25;
      letter-spacing: -0.02em;
    }

    .faq-page .faq-support-desc {
      max-width: 360px;
      font-size: 12.5px;
      line-height: 1.45;
    }

    .faq-page .faq-support-button {
      min-width: 150px;
      min-height: 40px;
      margin-top: 2px;
      padding: 0 16px;
      font-size: 12.5px;
      border-radius: 9px;
    }
  }


  :global([data-theme="light"]) .faq-page,
  :global(html.light-theme) .faq-page {
    color: #0F172A;
  }

  :global([data-theme="light"]) .faq-search-field,
  :global(html.light-theme) .faq-search-field {
    background: #FFFFFF;
    border-color: #D7DEE8;
  }

  :global([data-theme="light"]) .faq-search-input,
  :global(html.light-theme) .faq-search-input {
    color: #172033;
  }

  :global([data-theme="light"]) .faq-item,
  :global(html.light-theme) .faq-item {
    background: #FFFFFF;
    border-color: #DCE3EC;
  }

  :global([data-theme="light"]) .faq-answer-text,
  :global(html.light-theme) .faq-answer-text {
    color: #526174;
  }

  :global([data-theme="light"]) .faq-no-results,
  :global(html.light-theme) .faq-no-results {
    background: #FFFFFF;
    border-color: #D7DEE8;
  }

  :global([data-theme="light"]) .faq-no-results-title,
  :global(html.light-theme) .faq-no-results-title {
    color: #172033;
  }

  :global([data-theme="light"]) .faq-no-results-desc,
  :global(html.light-theme) .faq-no-results-desc,
  :global([data-theme="light"]) .faq-contact-desc,
  :global(html.light-theme) .faq-contact-desc {
    color: #64748B;
  }

  @media (max-width: 640px) {
    .faq-page {
      padding: 34px 16px 18px;
    }

    .faq-page-container {
      gap: 20px;
    }

    .faq-page-header {
      gap: 8px;
    }

    .faq-page-title {
      font-size: clamp(30px, 8vw, 38px);
    }

    .faq-item-heading { padding:17px 15px 15px;font-size:14.5px; }
    .faq-answer-divider { margin:0 15px; }
    .faq-answer-inner { padding:14px 15px 17px; }
    .faq-search-icon { width:40px;height:40px;flex-basis:40px; }

    .faq-answer-text {
      font-size: 13.5px;
      line-height: 1.65;
    }

    .faq-contact-section {
      padding-inline: 4px;
    }
  }
</style>

<script>
  function initDedicatedFaqPage() {
    const root=document.querySelector<HTMLElement>('.faq-page');
    if(!root||root.dataset.initialized==='true')return;
    root.dataset.initialized='true';
    const input=root.querySelector<HTMLInputElement>('#faq-search-input');
    const list=root.querySelector<HTMLElement>('#faq-list');
    const empty=root.querySelector<HTMLElement>('#faq-no-results');
    if(!list)return;
    const entries=Array.from(list.querySelectorAll<HTMLElement>('.faq-item')).map(item=>({
      item,q:item.querySelector<HTMLElement>('.faq-question-text'),a:item.querySelector<HTMLElement>('.faq-answer-text'),
      rawQ:item.querySelector<HTMLElement>('.faq-question-text')?.textContent||'',
      rawA:item.querySelector<HTMLElement>('.faq-answer-text')?.textContent||''
    }));
    const escapeHtml=(s:string)=>s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
    const highlight=(s:string,terms:string[])=>{
      if(!terms.length)return escapeHtml(s);
      const safe=terms.map(t=>t.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&')).filter(Boolean);
      const re=new RegExp(`(${safe.join('|')})`,'gi');
      return s.split(re).map(p=>safe.some(t=>new RegExp(`^${t}$`,'i').test(p))?`<mark class="faq-match-mark">${escapeHtml(p)}</mark>`:escapeHtml(p)).join('');
    };
    const search=()=>{
      const terms=(input?.value||'').trim().toLowerCase().split(/\\s+/).filter(Boolean);
      let count=0;
      entries.forEach(({item,q,a,rawQ,rawA})=>{
        const show=!terms.length||terms.every(t=>(rawQ+' '+rawA).toLowerCase().includes(t));
        item.hidden=!show;if(show)count++;
        if(q)q.innerHTML=highlight(rawQ,terms);
        if(a)a.innerHTML=highlight(rawA,terms);
      });
      if(empty)empty.hidden=count>0;
    };
    input?.addEventListener('input',search);
  }
  initDedicatedFaqPage();
  document.addEventListener('astro:page-load',initDedicatedFaqPage);
</script>