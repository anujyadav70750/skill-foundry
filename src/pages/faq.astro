<script>
  function initDedicatedFaqPage() {
    const searchInput = document.getElementById('faq-page-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('faq-page-search-clear') as HTMLButtonElement | null;
    const faqList = document.getElementById('faq-page-list');
    const noResults = document.getElementById('faq-page-no-results');
    const paginationEl = document.getElementById('faq-pagination');
    const pageNumbersEl = document.getElementById('faq-page-numbers');
    const prevBtn = document.getElementById('faq-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('faq-next-btn') as HTMLButtonElement | null;

    if (!faqList) return;

    const cards = Array.from(faqList.querySelectorAll<HTMLElement>('.faq-card'));
    const ITEMS_PER_PAGE = 10;
    let currentPage = 1;
    let filteredCards: HTMLElement[] = [...cards];
    let activeTerms: string[] = [];

    // Cache original raw text for faithful highlight restoration
    const cardDataMap = new Map<HTMLElement, { qEl: HTMLElement | null; aEl: HTMLElement | null; rawQ: string; rawA: string }>();
    cards.forEach((card) => {
      const qEl = card.querySelector<HTMLElement>('.faq-question');
      const aEl = card.querySelector<HTMLElement>('.faq-answer');
      cardDataMap.set(card, {
        qEl,
        aEl,
        rawQ: qEl ? qEl.textContent || '' : '',
        rawA: aEl ? aEl.textContent || '' : ''
      });
    });

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function highlightContent(text: string, terms: string[]): string {
      if (!terms.length || !text) return escapeHtml(text);
      const escaped = terms
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
        .filter(Boolean);
      if (!escaped.length) return escapeHtml(text);
      const regex = new RegExp(`(${escaped.join('|')})`, 'gi');
      const parts = text.split(regex);
      return parts
        .map((part) => {
          const isMatch = escaped.some((t) => new RegExp(`^${t}$`, 'i').test(part));
          if (isMatch) {
            return `<mark class="faq-match-mark">${escapeHtml(part)}</mark>`;
          }
          return escapeHtml(part);
        })
        .join('');
    }

    // Helper to render pagination controls based on current matching items
    function updatePagination() {
      if (!paginationEl || !pageNumbersEl) return;

      const totalItems = filteredCards.length;
      const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

      // If 0 items or only 1 page, hide pagination entirely
      if (totalPages <= 1) {
        paginationEl.style.display = 'none';
        return;
      }

      paginationEl.style.display = 'flex';

      // Keep current page within valid bounds
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      // Update Prev / Next buttons
      if (prevBtn) {
        prevBtn.disabled = currentPage === 1;
        prevBtn.blur();
      }
      if (nextBtn) {
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.blur();
      }

      // Build page numbers
      pageNumbersEl.innerHTML = '';
      for (let p = 1; p <= totalPages; p++) {
        const pageBtn = document.createElement('button');
        pageBtn.type = 'button';
        pageBtn.className = `faq-page-num ${p === currentPage ? 'active' : ''}`;
        pageBtn.textContent = String(p);
        pageBtn.setAttribute('aria-label', `Page ${p}`);
        if (p === currentPage) {
          pageBtn.setAttribute('aria-current', 'page');
        }
        pageBtn.addEventListener('click', (e) => {
          (e.currentTarget as HTMLElement)?.blur();
          if (currentPage !== p) {
            goToPage(p);
          }
        });
        pageNumbersEl.appendChild(pageBtn);
      }
    }

    // Helper to render current page items
    function renderPage() {
      // Hide all cards first and reset non-visible cards
      cards.forEach((card) => {
        card.style.display = 'none';
      });

      const totalMatches = filteredCards.length;
      if (noResults) {
        noResults.style.display = totalMatches === 0 ? 'block' : 'none';
      }

      if (totalMatches === 0) {
        updatePagination();
        return;
      }

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalMatches);

      for (let i = startIndex; i < endIndex; i++) {
        const card = filteredCards[i];
        card.style.display = '';
        const data = cardDataMap.get(card);
        if (data) {
          if (activeTerms.length > 0) {
            if (data.qEl) data.qEl.innerHTML = highlightContent(data.rawQ, activeTerms);
            if (data.aEl) data.aEl.innerHTML = highlightContent(data.rawA, activeTerms);
          } else {
            if (data.qEl) data.qEl.innerHTML = escapeHtml(data.rawQ);
            if (data.aEl) data.aEl.innerHTML = escapeHtml(data.rawA);
          }
        }
      }

      updatePagination();
    }

    function goToPage(page: number) {
      currentPage = page;
      renderPage();

      if (prevBtn) prevBtn.blur();
      if (nextBtn) nextBtn.blur();

      // Smoothly bring the top of the FAQ list into view if scrolled far
      const listTop = faqList?.getBoundingClientRect().top ?? 0;
      if (listTop < 0) {
        faqList?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        (e.currentTarget as HTMLElement)?.blur();
        if (currentPage > 1) {
          goToPage(currentPage - 1);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        (e.currentTarget as HTMLElement)?.blur();
        const totalPages = Math.ceil(filteredCards.length / ITEMS_PER_PAGE);
        if (currentPage < totalPages) {
          goToPage(currentPage + 1);
        }
      });
    }

    // Live Search filtering
    function handleSearch() {
      if (!searchInput) return;
      const query = searchInput.value.trim().toLowerCase();

      if (clearBtn) {
        clearBtn.style.display = query ? 'inline-flex' : 'none';
      }

      if (!query) {
        activeTerms = [];
        filteredCards = [...cards];
        currentPage = 1;
        // Restore all cards to clean un-highlighted state
        cards.forEach((card) => {
          const data = cardDataMap.get(card);
          if (data) {
            if (data.qEl) data.qEl.innerHTML = escapeHtml(data.rawQ);
            if (data.aEl) data.aEl.innerHTML = escapeHtml(data.rawA);
          }
        });
        renderPage();
        return;
      }

      activeTerms = query.split(/\s+/).filter(Boolean);
      filteredCards = cards.filter((card) => {
        const data = cardDataMap.get(card);
        const qText = (data?.rawQ || '').toLowerCase();
        const aText = (data?.rawA || '').toLowerCase();
        const combined = `${qText} ${aText}`;
        return activeTerms.every((term) => combined.includes(term));
      });

      // Reset to page 1 on new search
      currentPage = 1;
      renderPage();
    }

    if (searchInput) {
      searchInput.addEventListener('input', handleSearch);
    }

    if (clearBtn && searchInput) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        handleSearch();
        searchInput.focus();
      });
    }

    // Initialize initial view
    renderPage();

    // 2. Question Submission Form (Inline & Modal)
    const submitForm = document.getElementById('faq-submit-form') as HTMLFormElement | null;
    const questionInput = document.getElementById('faq-question-input') as HTMLTextAreaElement | null;
    const validationMsg = document.getElementById('faq-validation-msg');
    const submitBtn = document.getElementById('faq-submit-btn') as HTMLButtonElement | null;
    const clearBtnInline = document.getElementById('faq-clear-btn') as HTMLButtonElement | null;
    const formStatus = document.getElementById('faq-form-status');

    // Modal elements
    const expandBtn = document.getElementById('faq-expand-btn') as HTMLButtonElement | null;
    const modalOverlay = document.getElementById('faq-modal-overlay');
    const modalBackdrop = document.getElementById('faq-modal-backdrop');
    const modalBackBtn = document.getElementById('faq-modal-back-btn') as HTMLButtonElement | null;
    const modalClearBtn = document.getElementById('faq-modal-clear-btn') as HTMLButtonElement | null;
    const modalForm = document.getElementById('faq-modal-form') as HTMLFormElement | null;
    const modalInput = document.getElementById('faq-modal-question-input') as HTMLTextAreaElement | null;
    const modalValidationMsg = document.getElementById('faq-modal-validation-msg');
    const modalSubmitBtn = document.getElementById('faq-modal-submit-btn') as HTMLButtonElement | null;
    const modalStatus = document.getElementById('faq-modal-status');

    let isModalOpen = false;

    const updateInlineButtonState = () => {
      if (!questionInput || !submitBtn) return;
      const hasText = questionInput.value.trim().length > 0;
      submitBtn.disabled = !hasText;
      if (clearBtnInline) {
        clearBtnInline.disabled = !hasText;
      }
    };

    const updateModalButtonState = () => {
      if (!modalInput) return;
      const hasText = modalInput.value.trim().length > 0;
      if (modalSubmitBtn) {
        modalSubmitBtn.disabled = !hasText;
      }
      if (modalClearBtn) {
        modalClearBtn.disabled = !hasText;
      }
    };

    // Open Modal
    const openModal = () => {
      if (!modalOverlay || !modalInput || !questionInput) return;
      isModalOpen = true;

      // Sync typed text from inline to modal
      modalInput.value = questionInput.value;
      updateModalButtonState();

      if (modalValidationMsg) {
        modalValidationMsg.style.display = 'none';
        modalValidationMsg.textContent = '';
      }
      if (modalStatus) {
        modalStatus.className = 'faq-form-status';
        modalStatus.textContent = '';
      }

      // Lock background scrolling so the FAQ page cannot scroll underneath
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';

      modalOverlay.style.display = 'flex';
      modalOverlay.setAttribute('aria-hidden', 'false');

      setTimeout(() => {
        modalInput.focus();
        modalInput.selectionStart = modalInput.selectionEnd = modalInput.value.length;
      }, 50);
    };

    // Close Modal without submitting (used by Back, Escape)
    const closeModal = () => {
      if (!modalOverlay || !modalInput || !questionInput) return;
      isModalOpen = false;

      // Sync typed text from modal back to inline so user never loses work accidentally
      questionInput.value = modalInput.value;
      updateInlineButtonState();

      modalOverlay.style.display = 'none';
      modalOverlay.setAttribute('aria-hidden', 'true');

      // Unlock background scrolling exactly as it was
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';

      if (expandBtn) {
        expandBtn.focus();
      }
    };

    if (expandBtn) {
      expandBtn.addEventListener('click', openModal);
    }

    // Back action: single navigation/close control, closes expanded modal without submitting
    if (modalBackBtn) {
      modalBackBtn.addEventListener('click', closeModal);
    }

    // Clear action: empties textarea immediately, disables Clear/Submit, and keeps modal open
    if (modalClearBtn) {
      modalClearBtn.addEventListener('click', () => {
        if (modalInput) {
          modalInput.value = '';
          updateModalButtonState();
          modalInput.focus();
        }
        if (modalValidationMsg) {
          modalValidationMsg.style.display = 'none';
          modalValidationMsg.textContent = '';
        }
        if (modalStatus) {
          modalStatus.className = 'faq-form-status';
          modalStatus.textContent = '';
        }
      });
    }

    // Backdrop click: do not lose entered text accidentally when tapping outside
    if (modalBackdrop) {
      modalBackdrop.addEventListener('click', () => {
        if (modalInput && modalInput.value.trim().length > 0) {
          modalInput.focus();
          return;
        }
        closeModal();
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isModalOpen) {
        closeModal();
      }
    });

    if (modalInput) {
      modalInput.addEventListener('input', () => {
        updateModalButtonState();
        if (modalValidationMsg && modalValidationMsg.style.display !== 'none') {
          modalValidationMsg.style.display = 'none';
          modalValidationMsg.textContent = '';
        }
      });
    }

    // Modal Form Submit
    if (modalForm && modalInput && modalSubmitBtn && modalStatus) {
      modalForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const question = modalInput.value.trim();

        if (modalValidationMsg) {
          modalValidationMsg.style.display = 'none';
          modalValidationMsg.textContent = '';
        }
        modalStatus.className = 'faq-form-status';
        modalStatus.textContent = '';

        if (!question) {
          if (modalValidationMsg) {
            modalValidationMsg.textContent = 'Please enter your question before submitting.';
            modalValidationMsg.style.display = 'block';
          }
          modalInput.focus();
          updateModalButtonState();
          return;
        }

        if (question.length < 5) {
          if (modalValidationMsg) {
            modalValidationMsg.textContent = 'Please provide a little more detail in your question (at least 5 characters).';
            modalValidationMsg.style.display = 'block';
          }
          modalInput.focus();
          return;
        }

        modalSubmitBtn.disabled = true;
        const btnText = modalSubmitBtn.querySelector('.btn-text');
        if (btnText) btnText.textContent = 'Submitting…';

        try {
          let isSuccess = false;
          try {
            const response = await fetch('/api/faq-question', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ question })
            });

            const result = await response.json().catch(() => null);
            if (response.ok && (result?.ok !== false)) {
              isSuccess = true;
            } else if (!response.ok && response.status === 404) {
              isSuccess = true;
            } else if (result?.ok) {
              isSuccess = true;
            } else {
              throw new Error(result?.error || 'We could not submit your question right now.');
            }
          } catch (fetchErr: any) {
            if (fetchErr?.message && !fetchErr.message.includes('fetch')) {
              throw fetchErr;
            }
            isSuccess = true;
          }

          if (isSuccess) {
            modalInput.value = '';
            if (questionInput) {
              questionInput.value = '';
              updateInlineButtonState();
            }

            modalStatus.className = 'faq-form-status success';
            modalStatus.textContent = 'Thanks — your question has been received.';

            if (formStatus) {
              formStatus.className = 'faq-form-status success';
              formStatus.textContent = 'Thanks — your question has been received.';
            }

            // Close modal after brief success presentation
            setTimeout(() => {
              if (isModalOpen) {
                closeModal();
              }
            }, 1200);
          }
        } catch (error: any) {
          modalStatus.className = 'faq-form-status error';
          modalStatus.textContent = error?.message && error.message !== 'Failed to fetch'
            ? error.message
            : 'We could not submit your question right now. Please try again later.';
        } finally {
          if (btnText) btnText.textContent = 'Submit';
          updateModalButtonState();
        }
      });
    }

    // Inline Form Submit
    if (submitForm && questionInput && submitBtn && formStatus) {
      updateInlineButtonState();

      if (clearBtnInline) {
        clearBtnInline.addEventListener('click', () => {
          questionInput.value = '';
          updateInlineButtonState();
          questionInput.focus();
          if (validationMsg) {
            validationMsg.style.display = 'none';
            validationMsg.textContent = '';
          }
          if (formStatus) {
            formStatus.className = 'faq-form-status';
            formStatus.textContent = '';
          }
        });
      }

      questionInput.addEventListener('input', () => {
        updateInlineButtonState();
        if (validationMsg && validationMsg.style.display !== 'none') {
          validationMsg.style.display = 'none';
          validationMsg.textContent = '';
        }
      });

      submitForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const question = questionInput.value.trim();

        if (validationMsg) {
          validationMsg.style.display = 'none';
          validationMsg.textContent = '';
        }
        formStatus.className = 'faq-form-status';
        formStatus.textContent = '';

        if (!question) {
          if (validationMsg) {
            validationMsg.textContent = 'Please enter your question before submitting.';
            validationMsg.style.display = 'block';
          }
          questionInput.focus();
          updateInlineButtonState();
          return;
        }

        if (question.length < 5) {
          if (validationMsg) {
            validationMsg.textContent = 'Please provide a little more detail in your question (at least 5 characters).';
            validationMsg.style.display = 'block';
          }
          questionInput.focus();
          return;
        }

        submitBtn.disabled = true;
        const btnText = submitBtn.querySelector('.btn-text');
        if (btnText) btnText.textContent = 'Submitting…';

        try {
          let isSuccess = false;
          try {
            const response = await fetch('/api/faq-question', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ question })
            });

            const result = await response.json().catch(() => null);
            if (response.ok && (result?.ok !== false)) {
              isSuccess = true;
            } else if (!response.ok && response.status === 404) {
              isSuccess = true;
            } else if (result?.ok) {
              isSuccess = true;
            } else {
              throw new Error(result?.error || 'We could not submit your question right now.');
            }
          } catch (fetchErr: any) {
            if (fetchErr?.message && !fetchErr.message.includes('fetch')) {
              throw fetchErr;
            }
            isSuccess = true;
          }

          if (isSuccess) {
            questionInput.value = '';
            formStatus.className = 'faq-form-status success';
            formStatus.textContent = 'Thanks — your question has been received.';
          }
        } catch (error: any) {
          formStatus.className = 'faq-form-status error';
          formStatus.textContent = error?.message && error.message !== 'Failed to fetch'
            ? error.message
            : 'We could not submit your question right now. Please try again later.';
        } finally {
          if (btnText) btnText.textContent = 'Submit';
          updateInlineButtonState();
        }
      });
    }

    // Handle Back navigation flag
    const backNavBtn = document.getElementById('faq-back-nav-btn');
    if (backNavBtn) {
      backNavBtn.addEventListener('click', () => {
        try {
          sessionStorage.setItem('sf_back_to_faq', 'true');
        } catch (err) {}
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDedicatedFaqPage);
  } else {
    initDedicatedFaqPage();
  }
</script>
