---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ_DATA } from '../data/faqs';

const pageTitle = 'Frequently Asked Questions';
const pageDescription = 'Clear answers about Skill Foundry, its resources, recommended tools and how to use them.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://hub.skillfoundry-web.workers.dev/faq/"
>
  <main class="faq-page">
    <div class="faq-page-container">
      <header class="faq-page-header">
        <h1 class="faq-page-title">{pageTitle}</h1>
        <p class="faq-page-desc">{pageDescription}</p>
      </header>

      <section class="faq-search-section" aria-label="Search frequently asked questions">
        <div class="faq-search-field">
          <span class="faq-search-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-4-4"></path>
            </svg>
          </span>
          <input
            id="faq-search-input"
            class="faq-search-input"
            type="search"
            placeholder="Search questions and answers..."
            autocomplete="off"
            spellcheck="false"
            aria-label="Search questions and answers"
          />
          <button id="faq-search-clear" class="faq-search-clear" type="button" aria-label="Clear search" hidden>
            <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
              <path d="m5 5 10 10M15 5 5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </section>

      <section class="faq-list-section" aria-label="Frequently asked questions">
        <div class="faq-list" id="faq-list">
          {FAQ_DATA.map((item, index) => (
            <article class="faq-item" data-faq-id={item.id}>
              <h2 class="faq-item-heading">
                <button
                  class="faq-question-trigger"
                  id={`faq-question-${item.id}`}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`faq-answer-${item.id}`}
                >
                  <span class="faq-question-text">{item.question}</span>
                  <span class="faq-toggle" aria-hidden="true">
                    <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                      <path class="faq-toggle-vertical" d="M10 3v14"></path>
                      <path d="M3 10h14"></path>
                    </svg>
                  </span>
                </button>
              </h2>
              <div
                class="faq-answer-panel"
                id={`faq-answer-${item.id}`}
                role="region"
                aria-labelledby={`faq-question-${item.id}`}
                hidden
              >
                <div class="faq-answer-inner">
                  <p class="faq-answer-text">{item.answer}</p>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="faq-no-results" id="faq-no-results" hidden>
          <h2 class="faq-no-results-title">We couldn’t find an answer to that.</h2>
          <p class="faq-no-results-desc">Try a different search, or contact us and describe what you need help with.</p>
          <a class="faq-no-results-link" href="/contact/">Contact Skill Foundry</a>
        </div>
      </section>

      <section class="faq-contact-section" aria-label="Contact Skill Foundry">
        <h2 class="faq-contact-title">Still have a question?</h2>
        <p class="faq-contact-desc">Send us a message and include the resource name when reporting an issue.</p>
        <a class="faq-contact-link" href="/contact/">Contact us</a>
      </section>
    </div>
  </main>
</BaseLayout>

<style>
  .faq-page {
    min-height: 70vh;
    padding: clamp(42px, 5vw, 64px) 20px 40px;
    color: #F8FAFC;
    box-sizing: border-box;
  }

  .faq-page-container {
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .faq-page-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .faq-page-title {
    margin: 0;
    color: var(--text-primary, #FFFFFF);
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 5vw, 46px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .faq-page-desc {
    max-width: 590px;
    margin: 0;
    color: var(--text-secondary, #94A3B8);
    font-size: clamp(14px, 1.8vw, 16px);
    line-height: 1.6;
  }

  .faq-search-section {
    width: 100%;
  }

  .faq-search-field {
    max-width: 620px;
    min-height: 50px;
    margin: 0 auto;
    padding: 0 14px;
    display: flex;
    align-items: center;
    gap: 11px;
    background: rgba(13, 20, 34, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 12px;
    box-sizing: border-box;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .faq-search-field:focus-within {
    border-color: rgba(45, 190, 180, 0.55);
    box-shadow: 0 0 0 3px rgba(45, 190, 180, 0.10);
  }

  .faq-search-icon {
    display: flex;
    color: #94A3B8;
    flex: 0 0 auto;
  }

  .faq-search-input {
    width: 100%;
    min-width: 0;
    padding: 12px 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: #F8FAFC;
    font: inherit;
    font-size: 14px;
  }

  .faq-search-input::placeholder {
    color: #78869A;
  }

  .faq-search-clear {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: #CBD5E1;
    cursor: pointer;
  }

  .faq-search-clear[hidden] {
    display: none;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq-item {
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 13px;
    background: linear-gradient(180deg, rgba(16, 24, 39, 0.78), rgba(10, 15, 25, 0.82));
    transition: border-color 0.18s ease;
  }

  .faq-item:hover,
  .faq-item:focus-within {
    border-color: rgba(45, 190, 180, 0.28);
  }

  .faq-item-heading {
    margin: 0;
    font: inherit;
  }

  .faq-question-trigger {
    width: 100%;
    min-height: 66px;
    padding: 17px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border: 0;
    background: transparent;
    color: #F1F5F9;
    text-align: left;
    font: inherit;
    font-size: 15px;
    font-weight: 650;
    line-height: 1.45;
    cursor: pointer;
  }

  .faq-question-trigger:focus-visible {
    outline: 2px solid #2DBEB4;
    outline-offset: -4px;
    border-radius: 12px;
  }

  .faq-toggle {
    width: 30px;
    height: 30px;
    flex: 0 0 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    color: #9FB3C8;
  }

  .faq-toggle svg {
    display: block;
  }

  .faq-toggle-vertical {
    transition: opacity 0.18s ease;
  }

  .faq-question-trigger[aria-expanded="true"] .faq-toggle-vertical {
    opacity: 0;
  }

  .faq-answer-panel[hidden] {
    display: none;
  }

  .faq-answer-inner {
    padding: 0 20px 19px;
  }

  .faq-answer-text {
    margin: 0;
    padding-top: 1px;
    color: #B8C3D1;
    font-size: 14px;
    line-height: 1.7;
  }

  :global(.faq-match-mark) {
    padding: 0 2px;
    border-radius: 3px;
    background: rgba(45, 190, 180, 0.15);
    color: inherit;
  }

  .faq-no-results {
    padding: 30px 20px;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: 13px;
    text-align: center;
    background: rgba(13, 20, 34, 0.45);
  }

  .faq-no-results[hidden] {
    display: none;
  }

  .faq-no-results-title {
    margin: 0 0 7px;
    color: #F1F5F9;
    font-size: 16px;
    font-weight: 700;
  }

  .faq-no-results-desc {
    margin: 0 0 13px;
    color: #94A3B8;
    font-size: 13.5px;
    line-height: 1.55;
  }

  .faq-no-results-link {
    color: #55C8BE;
    font-size: 13.5px;
    font-weight: 650;
    text-decoration: none;
  }

  .faq-no-results-link:hover {
    text-decoration: underline;
  }

  .faq-contact-section {
    margin-top: 4px;
    padding: 22px 12px 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.10);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .faq-contact-title {
    margin: 0;
    color: #F1F5F9;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .faq-contact-desc {
    max-width: 500px;
    margin: 0;
    color: #94A3B8;
    font-size: 13.5px;
    line-height: 1.55;
  }

  .faq-contact-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    margin-top: 4px;
    padding: 0 17px;
    border: 1px solid rgba(45, 190, 180, 0.48);
    border-radius: 9px;
    background: rgba(45, 190, 180, 0.10);
    color: #D8F4F1;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }

  .faq-contact-link:hover {
    background: rgba(45, 190, 180, 0.16);
    border-color: rgba(45, 190, 180, 0.68);
  }

  :global([data-theme="light"]) .faq-page,
  :global(html.light-theme) .faq-page {
    color: #0F172A;
  }

  :global([data-theme="light"]) .faq-search-field,
  :global(html.light-theme) .faq-search-field {
    background: #FFFFFF;
    border-color: #D7DEE8;
  }

  :global([data-theme="light"]) .faq-search-input,
  :global(html.light-theme) .faq-search-input {
    color: #172033;
  }

  :global([data-theme="light"]) .faq-item,
  :global(html.light-theme) .faq-item {
    background: #FFFFFF;
    border-color: #DCE3EC;
  }

  :global([data-theme="light"]) .faq-question-trigger,
  :global(html.light-theme) .faq-question-trigger {
    color: #172033;
  }

  :global([data-theme="light"]) .faq-toggle,
  :global(html.light-theme) .faq-toggle {
    color: #526174;
    border-color: #DCE3EC;
  }

  :global([data-theme="light"]) .faq-answer-text,
  :global(html.light-theme) .faq-answer-text {
    color: #526174;
  }

  :global([data-theme="light"]) .faq-no-results,
  :global(html.light-theme) .faq-no-results {
    background: #FFFFFF;
    border-color: #D7DEE8;
  }

  :global([data-theme="light"]) .faq-no-results-title,
  :global(html.light-theme) .faq-no-results-title,
  :global([data-theme="light"]) .faq-contact-title,
  :global(html.light-theme) .faq-contact-title {
    color: #172033;
  }

  :global([data-theme="light"]) .faq-no-results-desc,
  :global(html.light-theme) .faq-no-results-desc,
  :global([data-theme="light"]) .faq-contact-desc,
  :global(html.light-theme) .faq-contact-desc {
    color: #64748B;
  }

  :global([data-theme="light"]) .faq-contact-section,
  :global(html.light-theme) .faq-contact-section {
    border-top-color: #DCE3EC;
  }

  :global([data-theme="light"]) .faq-contact-link,
  :global(html.light-theme) .faq-contact-link {
    color: #126E69;
    border-color: rgba(18, 142, 135, 0.38);
    background: rgba(18, 142, 135, 0.08);
  }

  @media (max-width: 640px) {
    .faq-page {
      padding: 34px 16px 30px;
    }

    .faq-page-container {
      gap: 20px;
    }

    .faq-page-header {
      gap: 8px;
    }

    .faq-page-title {
      font-size: clamp(30px, 8vw, 38px);
    }

    .faq-question-trigger {
      min-height: 62px;
      padding: 15px 15px;
      gap: 12px;
      font-size: 14px;
    }

    .faq-answer-inner {
      padding: 0 15px 16px;
    }

    .faq-answer-text {
      font-size: 13.5px;
      line-height: 1.65;
    }

    .faq-contact-section {
      padding-inline: 4px;
    }
  }
</style>

<script>
  function initDedicatedFaqPage() {
    const root = document.querySelector<HTMLElement>('.faq-page');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const searchInput = root.querySelector<HTMLInputElement>('#faq-search-input');
    const clearButton = root.querySelector<HTMLButtonElement>('#faq-search-clear');
    const list = root.querySelector<HTMLElement>('#faq-list');
    const noResults = root.querySelector<HTMLElement>('#faq-no-results');
    if (!list) return;

    const items = Array.from(list.querySelectorAll<HTMLElement>('.faq-item'));
    const itemData = items.map((item) => {
      const question = item.querySelector<HTMLElement>('.faq-question-text');
      const answer = item.querySelector<HTMLElement>('.faq-answer-text');
      const trigger = item.querySelector<HTMLButtonElement>('.faq-question-trigger');
      const panel = item.querySelector<HTMLElement>('.faq-answer-panel');
      return {
        item,
        question,
        answer,
        trigger,
        panel,
        rawQuestion: question?.textContent || '',
        rawAnswer: answer?.textContent || ''
      };
    });

    const escapeHtml = (value: string) => value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

    const highlight = (value: string, terms: string[]) => {
      if (!terms.length) return escapeHtml(value);
      const escapedTerms = terms
        .map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
        .filter(Boolean);
      if (!escapedTerms.length) return escapeHtml(value);
      const pattern = new RegExp(`(${escapedTerms.join('|')})`, 'gi');
      return value.split(pattern).map((part) => {
        const isMatch = escapedTerms.some((term) => new RegExp(`^${term}$`, 'i').test(part));
        return isMatch
          ? `<mark class="faq-match-mark">${escapeHtml(part)}</mark>`
          : escapeHtml(part);
      }).join('');
    };

    const closeAll = () => {
      itemData.forEach(({ trigger, panel }) => {
        trigger?.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      });
    };

    itemData.forEach(({ trigger, panel }) => {
      trigger?.addEventListener('click', () => {
        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        closeAll();
        if (!isOpen) {
          trigger.setAttribute('aria-expanded', 'true');
          if (panel) panel.hidden = false;
        }
      });
    });

    const updateSearch = () => {
      const query = (searchInput?.value || '').trim().toLowerCase();
      const terms = query ? query.split(/\s+/).filter(Boolean) : [];
      if (clearButton) clearButton.hidden = !query;

      let visibleCount = 0;
      itemData.forEach(({ item, question, answer, trigger, panel, rawQuestion, rawAnswer }) => {
        const combinedText = `${rawQuestion} ${rawAnswer}`.toLowerCase();
        const matches = !terms.length || terms.every((term) => combinedText.includes(term));

        item.hidden = !matches;
        if (matches) visibleCount++;
        if (question) question.innerHTML = highlight(rawQuestion, terms);
        if (answer) answer.innerHTML = highlight(rawAnswer, terms);
        trigger?.setAttribute('aria-expanded', 'false');
        if (panel) panel.hidden = true;
      });

      if (noResults) noResults.hidden = visibleCount > 0;
    };

    searchInput?.addEventListener('input', updateSearch);
    clearButton?.addEventListener('click', () => {
      if (!searchInput) return;
      searchInput.value = '';
      updateSearch();
      searchInput.focus();
    });
  }

  initDedicatedFaqPage();
  document.addEventListener('astro:page-load', initDedicatedFaqPage);
</script>
