---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ_DATA } from '../data/faqs';

const pageTitle = 'Frequently Asked Questions';
const pageDescription = 'Search the complete collection of common questions about Skill Foundry, practical AI blueprints, prompt systems, and executable workflows.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://skillfoundry.dev/faq/"
  hideHeader={true}
  hideHeaderSearch={true}
  hideFooter={true}
>
  <!-- Persistent Fixed "< Back" control at top-left -->
  <aside class="faq-back-home-fixed" aria-label="Navigation back to homepage">
    <a href="/#faq-submit-card" class="faq-back-home-btn" id="faq-back-nav-btn" aria-label="Back">
      <svg class="faq-back-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13L5 8l5-5"/>
      </svg>
      <span>Back</span>
    </a>
  </aside>

  <main class="faq-page">
    <div class="faq-page-container">
      <!-- 1. Header Introduction -->
      <header class="faq-page-header">
        <div class="faq-capsule">
          <span class="capsule-dot" aria-hidden="true"></span>
          <span>KNOWLEDGE BASE</span>
        </div>
        <h1 class="faq-page-title">{pageTitle}</h1>
        <p class="faq-page-desc">{pageDescription}</p>
      </header>

      <!-- 2. Top FAQ Search Bar -->
      <section class="faq-search-section" aria-label="Search frequently asked questions">
        <div class="faq-search-wrap">
          <div class="faq-search-field">
            <span class="faq-search-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </span>
            <input
              id="faq-page-search-input"
              class="faq-search-input"
              type="search"
              placeholder="Search all questions and answers..."
              autocomplete="off"
              spellcheck="false"
              aria-label="Search all questions and answers"
            />
            <button id="faq-page-search-clear" class="faq-search-clear" type="button" aria-label="Clear search query" style="display: none;">
              <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        </div>
      </section>

      <!-- 3. FAQ Items List (10 per page) -->
      <section class="faq-list-section" aria-label="Frequently asked questions list">
        <div class="faq-list" id="faq-page-list">
          {FAQ_DATA.map((item, index) => (
            <article
              class="home-card faq-card"
              data-faq-id={item.id}
              data-index={index}
              style={index >= 10 ? 'display: none;' : ''}
            >
              <h2 class="faq-question">{item.question}</h2>
              <p class="faq-answer">{item.answer}</p>
            </article>
          ))}
        </div>

        <!-- No-result State -->
        <div class="faq-no-results" id="faq-page-no-results" style="display: none;">
          <p class="faq-no-results-title">We couldn’t find an answer to that.</p>
          <p class="faq-no-results-desc">Ask us your question below and we’ll consider adding it to the FAQ.</p>
          <a href="#faq-submit-card" class="faq-no-results-link">Go to question submission ↓</a>
        </div>

        <!-- 4. Pagination (Max 10 items per page) -->
        <nav class="faq-pagination" id="faq-pagination" aria-label="FAQ pagination">
          <button type="button" class="faq-page-btn faq-page-prev" id="faq-prev-btn" disabled aria-label="Previous page">
            <svg class="faq-page-symbol" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12.5 15l-5-5 5-5"/>
            </svg>
          </button>

          <div class="faq-page-numbers" id="faq-page-numbers">
            <button type="button" class="faq-page-num active" aria-label="Page 1" aria-current="page">1</button>
            <button type="button" class="faq-page-num" aria-label="Page 2">2</button>
          </div>

          <button type="button" class="faq-page-btn faq-page-next" id="faq-next-btn" aria-label="Next page">
            <svg class="faq-page-symbol" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.5 5l5 5-5 5"/>
            </svg>
          </button>
        </nav>
      </section>

      <!-- 5. Question Submission Card -->
      <section class="faq-submit-section" aria-label="Submit a question">
        <div class="home-card faq-submit-card" id="faq-submit-card">
          <div class="faq-submit-head">
            <h2 class="faq-submit-title">Didn’t find your question?</h2>
            <p class="faq-submit-desc">Ask us your question and we’ll consider adding it to the FAQ.</p>
          </div>
          <form id="faq-submit-form" class="faq-submit-form" novalidate>
            <div class="faq-input-group">
              <div class="faq-textarea-wrap">
                <label for="faq-question-input" class="sr-only">Type your question</label>
                <textarea
                  id="faq-question-input"
                  name="question"
                  class="faq-textarea"
                  rows="5"
                  placeholder="Type your question…"
                  required
                ></textarea>
                <button
                  type="button"
                  id="faq-expand-btn"
                  class="faq-textarea-expand-btn"
                  aria-label="Expand question editor"
                  title="Expand question editor"
                >
                  <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 3h4v4M7 17H3v-4M17 3l-6 6M3 17l6-6"/>
                  </svg>
                  <span class="sr-only">Expand editor</span>
                </button>
              </div>
              <p id="faq-validation-msg" class="faq-validation-msg" role="alert" style="display: none;"></p>
            </div>
            <div class="faq-form-footer">
              <button type="button" id="faq-clear-btn" class="faq-action-btn faq-clear-btn" disabled>
                Clear
              </button>
              <button type="submit" id="faq-submit-btn" class="faq-action-btn faq-submit-btn" disabled>
                <span class="btn-text">Submit</span>
              </button>
            </div>
            <p id="faq-form-status" class="faq-form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </div>
  </main>

  <!-- 6. Expanded Question Submission Modal -->
  <div id="faq-modal-overlay" class="faq-modal-overlay" aria-hidden="true" style="display: none;">
    <div class="faq-modal-backdrop" id="faq-modal-backdrop"></div>
    <div
      class="faq-modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="faq-modal-title"
    >
      <!-- Top Navigation Row: Back (left) only -->
      <div class="faq-modal-nav-row">
        <button
          type="button"
          id="faq-modal-back-btn"
          class="faq-modal-nav-back"
          aria-label="Back to FAQ"
        >
          <svg class="faq-modal-nav-chevron" viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M10 13L5 8l5-5"/>
          </svg>
          <span>Back</span>
        </button>
      </div>

      <!-- Title / Subtitle -->
      <div class="faq-modal-header-text">
        <h2 id="faq-modal-title" class="faq-modal-title">Ask a Question</h2>
        <p class="faq-modal-subtitle">Submit a question or workflow request to be considered for the FAQ.</p>
      </div>

      <form id="faq-modal-form" class="faq-modal-form" novalidate>
        <div class="faq-modal-body">
          <label for="faq-modal-question-input" class="sr-only">Write your question here</label>
          <textarea
            id="faq-modal-question-input"
            class="faq-modal-textarea"
            placeholder="Write your question, tool suggestion, or workflow request here in detail..."
            required
          ></textarea>
          <p id="faq-modal-validation-msg" class="faq-validation-msg" role="alert" style="display: none;"></p>
        </div>

        <div class="faq-modal-footer">
          <button type="button" id="faq-modal-clear-btn" class="faq-modal-action-btn faq-modal-clear-btn" disabled>
            Clear
          </button>
          <button type="submit" id="faq-modal-submit-btn" class="faq-modal-action-btn faq-modal-submit-btn" disabled>
            <span class="btn-text">Submit</span>
          </button>
        </div>
        <p id="faq-modal-status" class="faq-form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     DEDICATED FAQ PAGE LAYOUT & STYLES
     ========================================================================== */
  :global(body.no-header) {
    background:
      radial-gradient(1000px 500px at 50% -100px, rgba(56, 189, 248, 0.08), transparent 70%),
      radial-gradient(800px 400px at 50% 100%, rgba(255, 102, 0, 0.04), transparent 70%),
      #090D14 !important;
    padding-top: 0 !important;
    min-height: 100vh;
  }

  .faq-page {
    position: relative;
    min-height: 100vh;
    padding: clamp(92px, 12vw, 106px) 20px 60px 20px;
    background: transparent;
    color: #F8FAFC;
    box-sizing: border-box;
  }

  /* Persistent Top-Left Back to Home Control */
  .faq-back-home-fixed {
    position: fixed;
    top: max(16px, env(safe-area-inset-top, 16px));
    left: max(18px, env(safe-area-inset-left, 18px));
    z-index: 100;
    pointer-events: auto;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .faq-back-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 31px;
    padding: 5px 12px;
    border-radius: 9999px;
    background: #141D2D;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #CBD5E1;
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.40);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    white-space: nowrap;
    user-select: none;
  }

  .faq-back-home-btn:hover {
    background: #1B263B;
    border-color: rgba(56, 189, 248, 0.45);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45), 0 0 10px rgba(56, 189, 248, 0.15);
  }

  .faq-back-chevron {
    flex-shrink: 0;
    display: block;
    transition: transform 0.18s ease;
  }

  .faq-back-home-btn:hover .faq-back-chevron {
    transform: translateX(-1px);
  }

  .faq-back-home-btn:active {
    transform: scale(0.96);
  }

  .faq-page-container {
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Page Heading */
  .faq-page-header {
    text-align: center;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .faq-capsule {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 14px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.22);
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #38BDF8;
    text-transform: uppercase;
    margin-bottom: 14px;
    box-shadow: 0 2px 10px rgba(56, 189, 248, 0.12);
  }

  .capsule-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: #38BDF8;
    box-shadow: 0 0 8px #38BDF8;
  }

  .faq-page-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 4.5vw, 46px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #FFFFFF;
    margin: 0 0 12px 0;
    text-wrap: balance;
  }

  .faq-page-desc {
    color: #94A3B8;
    font-size: clamp(15px, 2vw, 17px);
    line-height: 1.6;
    margin: 0;
    max-width: 640px;
    text-wrap: balance;
  }

  /* FAQ Live Search Field */
  .faq-search-section {
    margin-bottom: 24px;
    width: 100%;
  }

  .faq-search-wrap {
    width: 100%;
  }

  .faq-search-field {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(8, 13, 22, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    padding: 0 12px 0 16px;
    min-height: 50px;
    box-sizing: border-box;
  }

  .faq-search-field:focus-within {
    border-color: rgba(56, 189, 248, 0.55);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
  }

  .faq-search-icon {
    color: #94A3B8;
    display: flex;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
  }

  .faq-search-input {
    flex: 1 1 auto;
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 15px;
    font-family: inherit;
    padding: 12px 0;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    -webkit-appearance: none;
    appearance: none;
  }

  .faq-search-input::-webkit-search-cancel-button,
  .faq-search-input::-webkit-search-decoration,
  .faq-search-input::-webkit-search-results-button,
  .faq-search-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .faq-search-input::-ms-clear,
  .faq-search-input::-ms-reveal {
    display: none;
    width: 0;
    height: 0;
  }

  .faq-search-input::placeholder {
    color: #64748B;
  }

  .faq-search-clear {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #94A3B8;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    flex-shrink: 0;
    margin-left: 8px;
  }

  .faq-search-clear:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #FFFFFF;
  }

  /* FAQ List */
  .faq-list-section {
    width: 100%;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
  }

  .home-card.faq-card {
    padding: 24px 28px;
    border-radius: 18px;
    background: rgba(13, 20, 34, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .home-card.faq-card:hover {
    border-color: rgba(56, 189, 248, 0.28);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4), 0 0 20px rgba(56, 189, 248, 0.06);
  }

  .faq-question {
    margin: 0 0 10px 0;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.4;
    color: #F8FAFC;
    letter-spacing: -0.01em;
  }

  .faq-answer {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.68;
    color: #94A3B8;
  }

  /* Search Match Highlighting (Subtle Cyan/Blue glow) */
  .faq-match-mark {
    background: rgba(56, 189, 248, 0.20);
    color: #38BDF8;
    border-bottom: 1.5px solid rgba(56, 189, 248, 0.65);
    border-radius: 3px;
    padding: 0 3px;
    margin: 0;
    font-weight: inherit;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .faq-question .faq-match-mark {
    color: #FFFFFF;
    background: rgba(56, 189, 248, 0.28);
    border-bottom: 2px solid #38BDF8;
    text-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
  }

  /* No Results State */
  .faq-no-results {
    width: 100%;
    text-align: center;
    padding: 36px 24px;
    background: rgba(13, 20, 34, 0.6);
    border: 1px dashed rgba(56, 189, 248, 0.25);
    border-radius: 18px;
    box-sizing: border-box;
    margin: 8px 0;
  }

  .faq-no-results-title {
    margin: 0 0 6px 0;
    color: #F8FAFC;
    font-size: 16px;
    font-weight: 700;
  }

  .faq-no-results-desc {
    margin: 0 0 14px 0;
    color: #94A3B8;
    font-size: 14px;
    line-height: 1.5;
  }

  .faq-no-results-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #38BDF8;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .faq-no-results-link:hover {
    color: #7DD3FC;
    text-decoration: underline;
  }

  /* ==========================================================================
     FAQ PAGINATION - UNMISTAKABLE ACTIVE-STATE & UNIFIED DESIGN SYSTEM
     ========================================================================== */
  :global(.faq-pagination) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 22px;
    margin-bottom: 6px;
    padding-top: 0;
    flex-wrap: nowrap;
    width: 100%;
  }

  :global(.faq-page-numbers) {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Base styling: Shared by inactive page numbers and navigation arrows */
  :global(.faq-page-btn),
  :global(.faq-page-num) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    padding: 0;
    border-radius: 10px;
    background: #162032; /* Clearly visible dark blue/charcoal against #090D14 */
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #94A3B8; /* Visible, quiet, readable secondary number text */
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.12s ease, box-shadow 0.15s ease;
    box-sizing: border-box;
    user-select: none;
    line-height: 1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Navigation arrow buttons - pure utility controls (NEVER mistaken for active page) */
  :global(.faq-page-btn) {
    color: #94A3B8;
  }

  /* Broad, heavy, highly visible arrow symbols */
  :global(.faq-page-symbol) {
    width: 18px;
    height: 18px;
    display: block;
    flex-shrink: 0;
  }

  /* Hover on inactive page numbers - quiet & neutral (NOT active styling) */
  :global(.faq-page-num:not(.active):hover) {
    background: #1E2B3E;
    border-color: rgba(255, 255, 255, 0.28);
    color: #F8FAFC;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
  }

  /* Hover on navigation arrows - strictly neutral slate, NO cyan border or glow */
  :global(.faq-page-btn:not(:disabled):hover) {
    background: #1E2B3E;
    border-color: rgba(255, 255, 255, 0.28);
    color: #F8FAFC;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.35);
  }

  /* Subtle pressed / tap feedback */
  :global(.faq-page-btn:not(:disabled):active),
  :global(.faq-page-num:not(.active):active) {
    transform: scale(0.95);
    background: #131A26;
    transition: transform 0.06s ease;
  }

  /* ==========================================================================
     ACTIVE PAGE NUMBER - THE STRONGEST & MOST PROMINENT VISUAL ELEMENT
     ========================================================================== */
  :global(.faq-page-num.active) {
    width: 45px;
    height: 45px;
    min-width: 45px;
    min-height: 45px;
    border-radius: 11px;
    background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%) !important;
    border: 1.5px solid #38BDF8 !important;
    color: #FFFFFF !important;
    font-size: 15.5px !important;
    font-weight: 800 !important;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.38), 0 2px 8px rgba(0, 0, 0, 0.45) !important;
    cursor: default;
    transform: none !important;
    z-index: 2;
  }

  /* Disabled navigation arrow state - muted, reduced contrast, but clearly identifiable */
  :global(.faq-page-btn:disabled) {
    background: #121824;
    border: 1px solid rgba(255, 255, 255, 0.07);
    color: #475569;
    opacity: 0.50;
    cursor: not-allowed;
    pointer-events: none;
    transform: none;
    box-shadow: none;
  }

  /* Prevent browser focus rings or sticky touch focus from making controls look selected */
  :global(.faq-page-btn:focus),
  :global(.faq-page-num:focus) {
    outline: none;
  }

  :global(.faq-page-btn:focus-visible),
  :global(.faq-page-num:focus-visible) {
    outline: 2px solid rgba(56, 189, 248, 0.6);
    outline-offset: 2px;
  }

  /* Question Submission Section */
  .faq-submit-section {
    width: 100%;
    margin-top: 24px;
  }

  .home-card.faq-submit-card {
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
    padding: 28px 32px 20px 32px;
    border-radius: 18px;
    background: rgba(13, 20, 34, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-sizing: border-box;
