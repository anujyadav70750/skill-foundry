---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FAQ_DATA } from '../data/faqs';

const pageTitle = 'Frequently Asked Questions';
const pageDescription = 'Search common questions about Skill Foundry, our free practical learning resources, recommended tools, and step-by-step workflows.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical="https://hub.skillfoundry-web.workers.dev/faq/"
>
  <main class="faq-page">
    <div class="faq-page-container">
      <!-- 1. Header Introduction -->
      <header class="faq-page-header">
        <div class="faq-capsule">
          <span class="capsule-dot" aria-hidden="true"></span>
          <span>KNOWLEDGE BASE</span>
        </div>
        <h1 class="faq-page-title">{pageTitle}</h1>
        <p class="faq-page-desc">{pageDescription}</p>
      </header>

      <!-- 2. Top FAQ Search Bar -->
      <section class="faq-search-section" aria-label="Search frequently asked questions">
        <div class="faq-search-wrap">
          <div class="faq-search-field">
            <span class="faq-search-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </span>
            <input
              id="faq-page-search-input"
              class="faq-search-input"
              type="search"
              placeholder="Search all questions and answers..."
              autocomplete="off"
              spellcheck="false"
              aria-label="Search all questions and answers"
            />
            <button id="faq-page-search-clear" class="faq-search-clear" type="button" aria-label="Clear search query" style="display: none;">
              <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
              </svg>
            </button>
          </div>
        </div>
      </section>

      <!-- 3. FAQ Items List (7 per page with PERMANENTLY OPEN Answers) -->
      <section class="faq-list-section" aria-label="Frequently asked questions list">
        <div class="faq-page-list" id="faq-page-list">
          {FAQ_DATA.map((item, index) => (
            <article
              class="home-card faq-card faq-item"
              data-faq-id={item.id}
              data-index={index}
              style={index >= 7 ? 'display: none;' : ''}
            >
              <h2 class="faq-item-question">
                <span class="faq-question-text">{item.question}</span>
              </h2>
              <div class="faq-item-answer">
                <p class="faq-answer-text">{item.answer}</p>
              </div>
            </article>
          ))}
        </div>

        <!-- No-result State -->
        <div class="faq-no-results" id="faq-page-no-results" style="display: none;">
          <p class="faq-no-results-title">We couldn’t find an answer to that.</p>
          <p class="faq-no-results-desc">Ask us your question below and we’ll consider adding it to the FAQ.</p>
          <a href="#faq-submit-card" class="faq-no-results-link">Go to question submission ↓</a>
        </div>

        <!-- 4. Pagination (7 items per page) -->
        <nav class="faq-pagination" id="faq-pagination" aria-label="FAQ pagination">
          <button type="button" class="faq-page-btn faq-page-prev" id="faq-prev-btn" disabled aria-label="Previous page">
            <svg class="faq-page-symbol" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12.5 15l-5-5 5-5"/>
            </svg>
          </button>

          <div class="faq-page-numbers" id="faq-page-numbers">
            <button type="button" class="faq-page-num active" aria-label="Page 1" aria-current="page">1</button>
            <button type="button" class="faq-page-num" aria-label="Page 2">2</button>
            <button type="button" class="faq-page-num" aria-label="Page 3">3</button>
          </div>

          <button type="button" class="faq-page-btn faq-page-next" id="faq-next-btn" aria-label="Next page">
            <svg class="faq-page-symbol" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.5 5l5 5-5 5"/>
            </svg>
          </button>
        </nav>
      </section>

      <!-- 5. Question Submission Card -->
      <section class="faq-submit-section" aria-label="Submit a question">
        <div class="home-card faq-submit-card" id="faq-submit-card">
          <div class="faq-submit-head">
            <h2 class="faq-submit-title">Didn’t find your question?</h2>
            <p class="faq-submit-desc">Ask us your question and we’ll consider adding it to the FAQ.</p>
          </div>
          <form id="faq-submit-form" class="faq-submit-form" novalidate>
            <div class="faq-input-group">
              <div class="faq-textarea-wrap">
                <label for="faq-question-input" class="sr-only">Type your question</label>
                <textarea
                  id="faq-question-input"
                  name="question"
                  class="faq-textarea"
                  rows="5"
                  placeholder="Type your question…"
                  required
                ></textarea>
                <button
                  type="button"
                  id="faq-expand-btn"
                  class="faq-textarea-expand-btn"
                  aria-label="Expand question editor"
                  title="Expand question editor"
                >
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="14" y1="10" x2="21" y2="3"></line>
                    <polyline points="9 3 3 3 3 9"></polyline>
                    <line x1="10" y1="10" x2="3" y2="3"></line>
                    <polyline points="15 21 21 21 21 15"></polyline>
                    <line x1="14" y1="14" x2="21" y2="21"></line>
                    <polyline points="9 21 3 21 3 15"></polyline>
                    <line x1="10" y1="14" x2="3" y2="21"></line>
                  </svg>
                  <span class="sr-only">Expand editor</span>
                </button>
              </div>
              <p id="faq-validation-msg" class="faq-validation-msg" role="alert" style="display: none;"></p>
            </div>
            <div class="faq-form-footer">
              <button type="button" id="faq-clear-btn" class="faq-action-btn faq-clear-btn" disabled>
                Clear
              </button>
              <button type="submit" id="faq-submit-btn" class="faq-action-btn faq-submit-btn" disabled>
                <span class="btn-text">Submit</span>
              </button>
            </div>
            <p id="faq-form-status" class="faq-form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </div>
  </main>

  <!-- 6. Expanded Question Submission Modal -->
  <div id="faq-modal-overlay" class="faq-modal-overlay" aria-hidden="true" style="display: none;">
    <div class="faq-modal-backdrop" id="faq-modal-backdrop"></div>
    <div
      class="faq-modal-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="faq-modal-title"
    >
      <!-- Top Row: Collapse Button Aligned Right -->
      <div class="faq-modal-nav-row">
        <button
          type="button"
          id="faq-modal-collapse-btn"
          class="faq-modal-collapse-btn"
          aria-label="Collapse question editor"
          title="Collapse question editor"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="4" x2="10" y2="10"></line>
            <polyline points="4 10 10 10 10 4"></polyline>
            <line x1="20" y1="4" x2="14" y2="10"></line>
            <polyline points="20 10 14 10 14 4"></polyline>
            <line x1="4" y1="20" x2="10" y2="14"></line>
            <polyline points="4 14 10 14 10 20"></polyline>
            <line x1="20" y1="20" x2="14" y2="14"></line>
            <polyline points="20 14 14 14 14 20"></polyline>
          </svg>
        </button>
      </div>

      <!-- Title / Subtitle -->
      <div class="faq-modal-header-text">
        <h2 id="faq-modal-title" class="faq-modal-title">Ask a Question</h2>
        <p class="faq-modal-subtitle">Submit a question or workflow request to be considered for the FAQ.</p>
      </div>

      <form id="faq-modal-form" class="faq-modal-form" novalidate>
        <div class="faq-modal-body">
          <label for="faq-modal-question-input" class="sr-only">Write your question here</label>
          <textarea
            id="faq-modal-question-input"
            class="faq-modal-textarea"
            placeholder="Write your question, tool suggestion, or workflow request here in detail..."
            required
          ></textarea>
          <p id="faq-modal-validation-msg" class="faq-validation-msg" role="alert" style="display: none;"></p>
        </div>

        <div class="faq-modal-footer">
          <button type="button" id="faq-modal-clear-btn" class="faq-modal-action-btn faq-modal-clear-btn" disabled>
            Clear
          </button>
          <button type="submit" id="faq-modal-submit-btn" class="faq-modal-action-btn faq-modal-submit-btn" disabled>
            <span class="btn-text">Submit</span>
          </button>
        </div>
        <p id="faq-modal-status" class="faq-form-status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     DEDICATED FAQ PAGE LAYOUT & STYLES (PERMANENTLY EXPANDED ANSWERS)
     ========================================================================== */
  .faq-page {
    position: relative;
    min-height: 80vh;
    padding: clamp(40px, 5vw, 64px) 20px 60px 20px;
    background: transparent;
    color: #F8FAFC;
    box-sizing: border-box;
  }

  .faq-page-container {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* 1. Header Section */
  .faq-page-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .faq-capsule {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.32);
    color: #38BDF8;
    border-radius: 9999px;
    padding: 3px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .capsule-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #38BDF8;
  }

  .faq-page-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: #FFFFFF;
    margin: 0;
  }

  .faq-page-desc {
    font-size: clamp(14px, 1.8vw, 16px);
    color: #94A3B8;
    max-width: 580px;
    margin: 0;
    line-height: 1.55;
  }

  /* 2. Search Section */
  .faq-search-section {
    width: 100%;
  }

  .faq-search-wrap {
    max-width: 580px;
    margin: 0 auto;
  }

  .faq-search-field {
    display: flex;
    align-items: center;
    background: rgba(13, 20, 34, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: 0 12px 0 16px;
    min-height: 50px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
    transition: all 0.2s ease;
  }

  .faq-search-field:focus-within {
    border-color: rgba(56, 189, 248, 0.6);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15), 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .faq-search-icon {
    color: #38BDF8;
    display: flex;
    align-items: center;
    margin-right: 10px;
    flex-shrink: 0;
  }

  .faq-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 15px;
    font-family: inherit;
    padding: 12px 0;
  }

  .faq-search-input::placeholder {
    color: #64748B;
  }

  .faq-search-clear {
    background: rgba(255, 255, 255, 0.08);
    border: none;
    color: #94A3B8;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    transition: all 0.15s ease;
  }

  .faq-search-clear:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
  }

  /* 3. Full FAQ Items (Permanently Open Answers) */
  .faq-list-section {
    width: 100%;
  }

  .faq-page-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .faq-card.faq-item {
    background: linear-gradient(180deg, rgba(16, 26, 44, 0.75) 0%, rgba(9, 15, 27, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 24px 26px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-card.faq-item:hover {
    border-color: rgba(56, 189, 248, 0.3);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
  }

  .faq-item-question {
    font-family: inherit;
    font-size: 17px;
    font-weight: 700;
    color: #F8FAFC;
    line-height: 1.4;
    margin: 0 0 12px 0;
    letter-spacing: -0.01em;
  }

  .faq-item-answer {
    padding: 0;
  }

  .faq-answer-text {
    margin: 0;
    color: #CBD5E1;
    font-size: 15px;
    line-height: 1.65;
  }

  :global(.faq-match-mark) {
    background: rgba(56, 189, 248, 0.25);
    border-bottom: 2px solid #38BDF8;
    color: #FFFFFF;
    padding: 0 2px;
    border-radius: 2px;
  }

  /* No Results State */
  .faq-no-results {
    width: 100%;
    text-align: center;
    padding: 36px 24px;
    background: rgba(13, 20, 34, 0.6);
    border: 1px dashed rgba(56, 189, 248, 0.25);
    border-radius: 18px;
    box-sizing: border-box;
    margin: 8px 0;
  }

  .faq-no-results-title {
    margin: 0 0 6px 0;
    color: #F8FAFC;
    font-size: 16px;
    font-weight: 700;
  }

  .faq-no-results-desc {
    margin: 0 0 14px 0;
    color: #94A3B8;
    font-size: 14px;
    line-height: 1.5;
  }

  .faq-no-results-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #38BDF8;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .faq-no-results-link:hover {
    color: #7DD3FC;
    text-decoration: underline;
  }

  /* ==========================================================================
     FAQ PAGINATION - 7 QUESTIONS PER PAGE (DISTINCT ACTIVE STATE)
     ========================================================================== */
  :global(.faq-pagination) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 28px;
    margin-bottom: 8px;
    flex-wrap: nowrap;
    width: 100%;
  }

  :global(.faq-page-numbers) {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  :global(.faq-page-btn),
  :global(.faq-page-num) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    min-width: 38px;
    min-height: 38px;
    padding: 0;
    border-radius: 10px;
    background: #141D2D;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #94A3B8;
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s ease;
    box-sizing: border-box;
    user-select: none;
    line-height: 1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    outline: none;
  }

  :global(.faq-page-symbol) {
    width: 18px;
    height: 18px;
    display: block;
    flex-shrink: 0;
  }

  :global(.faq-page-num:not(.active):hover),
  :global(.faq-page-btn:not(:disabled):hover) {
    background: #1C273A;
    border-color: rgba(56, 189, 248, 0.35);
    color: #F8FAFC;
    transform: translateY(-1px);
  }

  :global(.faq-page-btn:not(:disabled):active),
  :global(.faq-page-num:not(.active):active) {
    transform: scale(0.95);
    background: #0E1520;
  }

  /* Prominent & Slightly Larger Active Page Button */
  :global(.faq-page-num.active) {
    width: 44px !important;
    height: 44px !important;
    min-width: 44px !important;
    min-height: 44px !important;
    border-radius: 11px !important;
    background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%) !important;
    border: 1.5px solid #38BDF8 !important;
    color: #FFFFFF !important;
    font-size: 16px !important;
    font-weight: 800 !important;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.45), 0 2px 8px rgba(0, 0, 0, 0.35) !important;
    cursor: default;
    transform: none !important;
  }

  :global(.faq-page-btn:disabled) {
    background: #0D1522;
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: #334155;
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
    transform: none;
    box-shadow: none;
  }

  /* Question Submission Section */
  .faq-submit-section {
    width: 100%;
    margin-top: 10px;
  }

  .home-card.faq-submit-card {
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
    padding: 28px 32px 20px 32px;
    border-radius: 18px;
    background: rgba(13, 20, 34, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .home-card.faq-submit-card:hover {
    border-color: rgba(56, 189, 248, 0.25);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
  }

  .faq-submit-head {
    margin-bottom: 14px;
  }

  .faq-submit-title {
    margin: 0 0 6px 0;
    font-size: 18px;
    font-weight: 700;
    color: #F8FAFC;
    letter-spacing: -0.01em;
  }

  .faq-submit-desc {
    margin: 0;
    font-size: 14.5px;
    color: #94A3B8;
    line-height: 1.5;
  }

  .faq-submit-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .home-card.faq-submit-card {
    padding: 26px 26px 16px 26px;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-submit-head {
    margin-bottom: 14px;
  }

  .faq-submit-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(20px, 2.8vw, 24px);
    font-weight: 400;
    color: #FFFFFF;
    margin: 0 0 6px 0;
  }

  .faq-submit-desc {
    font-size: 14px;
    color: #94A3B8;
    margin: 0;
    line-height: 1.5;
  }

  .faq-submit-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-textarea-wrap {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 14px 44px 14px 16px;
    background: rgba(6, 11, 20, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    color: #F8FAFC;
    font-family: inherit;
    font-size: 14.5px;
    line-height: 1.6;
    resize: none;
    min-height: 110px;
    height: 115px;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .faq-textarea:focus {
    border-color: rgba(56, 189, 248, 0.6);
    background: rgba(9, 15, 27, 0.95);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.15);
  }

  .faq-textarea-expand-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #94A3B8;
    cursor: pointer;
    transition: all 0.15s ease;
    box-sizing: border-box;
    padding: 0;
  }

  .faq-textarea-expand-btn:hover {
    background: rgba(56, 189, 248, 0.16);
    border-color: rgba(56, 189, 248, 0.4);
    color: #38BDF8;
  }

  .faq-form-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
  }

  .faq-action-btn {
    min-height: 38px;
    padding: 0 18px;
    border-radius: 9999px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid transparent;
    box-sizing: border-box;
  }

  /* Clear button - Skill Foundry Blue (Active State) */
  .faq-clear-btn {
    background: rgba(14, 165, 233, 0.15);
    border-color: rgba(56, 189, 248, 0.45);
    color: #38BDF8;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.2);
  }

