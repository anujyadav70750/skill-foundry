<script>
  function initDedicatedFaqPage() {
    const searchInput = document.getElementById('faq-page-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('faq-page-search-clear') as HTMLButtonElement | null;
    const faqList = document.getElementById('faq-page-list');
    const noResults = document.getElementById('faq-page-no-results');
    const paginationEl = document.getElementById('faq-pagination');
    const pageNumbersEl = document.getElementById('faq-page-numbers');
    const prevBtn = document.getElementById('faq-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('faq-next-btn') as HTMLButtonElement | null;

    if (!faqList) return;

    const items = Array.from(faqList.querySelectorAll<HTMLElement>('.faq-item'));
    // CRITICAL: Strict 7 items per page
    const ITEMS_PER_PAGE = 7;
    let currentPage = 1;
    let filteredItems: HTMLElement[] = [...items];
    let activeTerms: string[] = [];

    // Cache original raw text for highlight restoration
    const itemDataMap = new Map<HTMLElement, { qEl: HTMLElement | null; aEl: HTMLElement | null; rawQ: string; rawA: string }>();
    items.forEach((item) => {
      const qEl = item.querySelector<HTMLElement>('.faq-question-text');
      const aEl = item.querySelector<HTMLElement>('.faq-answer-text');
      itemDataMap.set(item, {
        qEl,
        aEl,
        rawQ: qEl ? qEl.textContent || '' : '',
        rawA: aEl ? aEl.textContent || '' : ''
      });
    });

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function highlightContent(text: string, terms: string[]): string {
      if (!terms.length || !text) return escapeHtml(text);
      const escaped = terms
        .map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'))
        .filter(Boolean);
      if (!escaped.length) return escapeHtml(text);
      const regex = new RegExp(`(${escaped.join('|')})`, 'gi');
      const parts = text.split(regex);
      return parts
        .map((part) => {
          const isMatch = escaped.some((t) => new RegExp(`^${t}$`, 'i').test(part));
          if (isMatch) {
            return `<mark class="faq-match-mark">${escapeHtml(part)}</mark>`;
          }
          return escapeHtml(part);
        })
        .join('');
    }

    // Update pagination controls for 7 items per page
    function updatePagination() {
      if (!paginationEl || !pageNumbersEl) return;

      const totalItems = filteredItems.length;
      const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

      if (totalPages <= 1) {
        paginationEl.style.display = 'none';
        return;
      }

      paginationEl.style.display = 'flex';

      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;

      if (prevBtn) {
        prevBtn.disabled = currentPage === 1;
        prevBtn.onclick = () => {
          if (currentPage > 1) goToPage(currentPage - 1);
        };
      }
      if (nextBtn) {
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.onclick = () => {
          if (currentPage < totalPages) goToPage(currentPage + 1);
        };
      }

      pageNumbersEl.innerHTML = '';
      for (let p = 1; p <= totalPages; p++) {
        const pageBtn = document.createElement('button');
        pageBtn.type = 'button';
        pageBtn.className = `faq-page-num ${p === currentPage ? 'active' : ''}`;
        pageBtn.textContent = String(p);
        pageBtn.setAttribute('aria-label', `Page ${p}`);
        if (p === currentPage) {
          pageBtn.setAttribute('aria-current', 'page');
        }
        pageBtn.addEventListener('click', (e) => {
          (e.currentTarget as HTMLElement)?.blur();
          if (currentPage !== p) {
            goToPage(p);
          }
        });
        pageNumbersEl.appendChild(pageBtn);
      }
    }

    function renderPage() {
      // Hide all items first
      items.forEach((item) => {
        item.style.display = 'none';
      });

      const totalMatches = filteredItems.length;
      if (noResults) {
        noResults.style.display = totalMatches === 0 ? 'block' : 'none';
      }

      if (totalMatches === 0) {
        updatePagination();
        return;
      }

      const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
      const endIndex = Math.min(startIndex + ITEMS_PER_PAGE, totalMatches);

      for (let i = startIndex; i < endIndex; i++) {
        const item = filteredItems[i];
        item.style.display = '';
        const data = itemDataMap.get(item);
        if (data) {
          if (activeTerms.length > 0) {
            if (data.qEl) data.qEl.innerHTML = highlightContent(data.rawQ, activeTerms);
            if (data.aEl) data.aEl.innerHTML = highlightContent(data.rawA, activeTerms);
          } else {
            if (data.qEl) data.qEl.innerHTML = escapeHtml(data.rawQ);
            if (data.aEl) data.aEl.innerHTML = escapeHtml(data.rawA);
          }
        }
      }

      updatePagination();
    }

    function goToPage(page: number) {
      currentPage = page;
      renderPage();

      if (prevBtn) prevBtn.blur();
      if (nextBtn) nextBtn.blur();
    }

    function handleSearch() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      if (clearBtn) {
        clearBtn.style.display = query.length > 0 ? 'flex' : 'none';
      }

      if (!query) {
        activeTerms = [];
        filteredItems = [...items];
      } else {
        const terms = query.split(/\s+/).filter(Boolean);
        activeTerms = terms;
        filteredItems = items.filter((item) => {
          const data = itemDataMap.get(item);
          if (!data) return false;
          const qText = data.rawQ.toLowerCase();
          const aText = data.rawA.toLowerCase();
          return terms.every((t) => qText.includes(t) || aText.includes(t));
        });
      }

      currentPage = 1;
      renderPage();
    }

    searchInput?.addEventListener('input', handleSearch);

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        handleSearch();
      }
    });

    // Form Submission in Card
    const submitForm = document.getElementById('faq-submit-form') as HTMLFormElement | null;
    const questionInput = document.getElementById('faq-question-input') as HTMLTextAreaElement | null;
    const submitBtn = document.getElementById('faq-submit-btn') as HTMLButtonElement | null;
    const clearFormBtn = document.getElementById('faq-clear-btn') as HTMLButtonElement | null;
    const formStatus = document.getElementById('faq-form-status');
    const validationMsg = document.getElementById('faq-validation-msg');

    function updateSubmitState() {
      const val = (questionInput?.value || '').trim();
      const hasText = val.length > 0;
      if (submitBtn) submitBtn.disabled = !hasText;
      if (clearFormBtn) clearFormBtn.disabled = !hasText;
      if (hasText && validationMsg) validationMsg.style.display = 'none';
    }

    questionInput?.addEventListener('input', updateSubmitState);

    clearFormBtn?.addEventListener('click', () => {
      if (questionInput) {
        questionInput.value = '';
        updateSubmitState();
        questionInput.focus();
      }
    });

    submitForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (questionInput?.value || '').trim();
      if (val.length < 5) {
        if (validationMsg) {
          validationMsg.textContent = 'Please enter at least 5 characters for your question.';
          validationMsg.style.display = 'block';
        }
        return;
      }

      if (submitBtn) submitBtn.disabled = true;
      if (formStatus) {
        formStatus.className = 'faq-form-status';
        formStatus.textContent = 'Submitting question…';
      }

      try {
        const res = await fetch('/api/faq-question', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: val })
        });
        const result = await res.json().catch(() => ({}));
        if (!res.ok || !result.ok) throw new Error(result.error || 'Failed to submit.');

        if (questionInput) questionInput.value = '';
        updateSubmitState();
        if (formStatus) {
          formStatus.className = 'faq-form-status success';
          formStatus.textContent = 'Thank you! Your question was submitted for consideration.';
        }
      } catch (err: any) {
        if (submitBtn) submitBtn.disabled = false;
        if (formStatus) {
          formStatus.className = 'faq-form-status error';
          formStatus.textContent = err?.message || 'Could not submit right now. Please try again.';
        }
      }
    });

    // Expand Modal
    const expandBtn = document.getElementById('faq-expand-btn');
    const modalOverlay = document.getElementById('faq-modal-overlay');
    const modalBackdrop = document.getElementById('faq-modal-backdrop');
    const modalCollapseBtn = document.getElementById('faq-modal-collapse-btn');
    const modalTextarea = document.getElementById('faq-modal-question-input') as HTMLTextAreaElement | null;
    const modalForm = document.getElementById('faq-modal-form') as HTMLFormElement | null;
    const modalSubmitBtn = document.getElementById('faq-modal-submit-btn') as HTMLButtonElement | null;
    const modalClearBtn = document.getElementById('faq-modal-clear-btn') as HTMLButtonElement | null;
    const modalStatus = document.getElementById('faq-modal-status');
    const modalValidationMsg = document.getElementById('faq-modal-validation-msg');

    function openModal() {
      if (!modalOverlay) return;
      if (modalTextarea && questionInput) {
        modalTextarea.value = questionInput.value;
      }
      modalOverlay.style.display = 'flex';
      modalOverlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      updateModalState();
      modalTextarea?.focus();
    }

    function closeModal() {
      if (!modalOverlay) return;
      if (questionInput && modalTextarea) {
        questionInput.value = modalTextarea.value;
        updateSubmitState();
      }
      modalOverlay.style.display = 'none';
      modalOverlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function updateModalState() {
      const val = (modalTextarea?.value || '').trim();
      const hasText = val.length > 0;
      if (modalSubmitBtn) modalSubmitBtn.disabled = !hasText;
      if (modalClearBtn) modalClearBtn.disabled = !hasText;
      if (hasText && modalValidationMsg) modalValidationMsg.style.display = 'none';
    }

    expandBtn?.addEventListener('click', openModal);
    modalBackdrop?.addEventListener('click', closeModal);
    modalCollapseBtn?.addEventListener('click', closeModal);
    modalTextarea?.addEventListener('input', updateModalState);
    modalClearBtn?.addEventListener('click', () => {
      if (modalTextarea) {
        modalTextarea.value = '';
        updateModalState();
        modalTextarea.focus();
      }
    });

    modalForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = (modalTextarea?.value || '').trim();
      if (val.length < 5) {
        if (modalValidationMsg) {
          modalValidationMsg.textContent = 'Please enter at least 5 characters for your question.';
          modalValidationMsg.style.display = 'block';
        }
        return;
      }

      if (modalSubmitBtn) modalSubmitBtn.disabled = true;
      if (modalStatus) {
        modalStatus.className = 'faq-form-status';
        modalStatus.textContent = 'Submitting question…';
      }

      try {
        const res = await fetch('/api/faq-question', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ question: val })
        });
        const result = await res.json().catch(() => ({}));
        if (!res.ok || !result.ok) throw new Error(result.error || 'Failed to submit.');

        if (modalTextarea) modalTextarea.value = '';
        if (questionInput) questionInput.value = '';
        updateModalState();
        updateSubmitState();
        if (modalStatus) {
          modalStatus.className = 'faq-form-status success';
          modalStatus.textContent = 'Thank you! Your question was submitted for consideration.';
        }
        setTimeout(closeModal, 1500);
      } catch (err: any) {
        if (modalSubmitBtn) modalSubmitBtn.disabled = false;
        if (modalStatus) {
          modalStatus.className = 'faq-form-status error';
          modalStatus.textContent = err?.message || 'Could not submit right now. Please try again.';
        }
      }
    });

    // Initialize initial render
    renderPage();
  }

  document.addEventListener('DOMContentLoaded', initDedicatedFaqPage);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initDedicatedFaqPage();
  }
</script>
