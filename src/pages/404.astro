---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Skill Foundry" description="The page you requested could not be found on Skill Foundry.">
  <section class="page-heading">
    <div class="container">
      <p class="eyebrow">404 • NOT FOUND</p>
      <h1>That page doesn't exist.</h1>
      <p>The link may be outdated or the page may have moved. You can continue from the resource library or head back home.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/resources/">Explore Resources</a>
        <a class="button button-secondary" href="/">Go Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
