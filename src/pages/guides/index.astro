---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug } from '../../lib/resource';

// Use the same published-resource source and ordering as the Resource Library.
// A skill area only appears here after at least one resource is published in it.
const allResources = await getCollection('resources');
const publishedResources = allResources
  .filter((resource) => !('draft' in resource.data && resource.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const resourcesByCategory = new Map<string, typeof publishedResources>();
for (const resource of publishedResources) {
  const category = resource.data.category?.trim();
  if (!category) continue;
  const existing = resourcesByCategory.get(category) || [];
  existing.push(resource);
  resourcesByCategory.set(category, existing);
}

const preferredCategoryOrder = [
  'AI Image',
  'AI Video',
  'AI Automation',
  'Prompt Systems',
  'AI Tools',
  'Creative Workflows',
  'Productivity',
  'Other'
];

const categoryPresentation: Record<string, { description: string; icon: string; iconColor: string }> = {
  'AI Image': {
    description: 'Explore published guides for creating and refining AI-generated images and visual assets.',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>',
    iconColor: '#E5A16F'
  },
  'AI Video': {
    description: 'Explore published workflows for creating AI-assisted video scenes, maintaining character continuity and assembling clips.',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="13" height="14" rx="2"/><path d="m16 10 5-3v10l-5-3z"/></svg>',
    iconColor: '#9B8AFB'
  },
  'AI Automation': {
    description: 'Explore practical resources for connecting digital tools and reducing repetitive work.',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h6m4 0h6M7 4v6m10 4v6M4 17h6m4 0h6"/><circle cx="7" cy="7" r="2"/><circle cx="17" cy="17" r="2"/></svg>',
    iconColor: '#55B7A5'
  },
  'Prompt Systems': {
    description: 'Explore structured prompting techniques and practical ways to guide AI tools.',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16M4 12h10M4 19h16"/><circle cx="18" cy="12" r="2"/></svg>',
    iconColor: '#D2AD58'
  },
  'AI Tools': {
    description: 'Explore practical guides to tools, features and capabilities you can apply in your work.',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="3"/><path d="M9 9h6v6H9zM9 1v3m6-3v3M9 20v3m6-3v3M1 9h3m-3 6h3m16-6h3m-3 6h3"/></svg>',
    iconColor: '#78A9E8'
  },
  'Creative Workflows': {
    description: 'Explore end-to-end creative processes that connect tools, assets and production steps.',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="6" height="6" rx="1"/><rect x="15" y="15" width="6" height="6" rx="1"/><path d="M9 6h3a3 3 0 0 1 3 3v6M12 18h3"/></svg>',
    iconColor: '#72B784'
  },
  'Productivity': {
    description: 'Explore practical tools and methods for making everyday digital work more efficient.',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
    iconColor: '#D28AB3'
  },
  'Other': {
    description: 'Explore the latest practical resources in this area.',
    icon: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>',
    iconColor: '#A5AAB4'
  }
};

const skillAreas = Array.from(resourcesByCategory.entries())
  .sort(([a], [b]) => {
    const indexA = preferredCategoryOrder.indexOf(a);
    const indexB = preferredCategoryOrder.indexOf(b);
    if (indexA !== -1 && indexB !== -1) return indexA - indexB;
    if (indexA !== -1) return -1;
    if (indexB !== -1) return 1;
    return a.localeCompare(b);
  })
  .map(([name, resources]) => {
    const presentation = categoryPresentation[name] || categoryPresentation.Other;
    return {
      name,
      count: resources.length,
      description: presentation.description,
      icon: presentation.icon,
      iconColor: presentation.iconColor,
      examples: resources.slice(0, 2).map((resource) => ({
        title: resource.data.title,
        href: `/resources/${resourceSlug(resource)}/`
      })),
      href: `/resources/?category=${encodeURIComponent(name)}`
    };
  });
---

<BaseLayout
  title="Practical Guides & Skill Areas | Skill Foundry"
  description="Learn practical digital skills through beginner-friendly explanations, real workflows and resources you can adapt to your own projects."
  canonical="https://hub.skillfoundry-web.workers.dev/guides/"
>
  <main class="guides-page">
    <header class="guides-hero">
      <div class="container narrow">
        <h1 class="guides-title">Learn practical skills through real workflows</h1>
        <p class="guides-lead">
          Explore beginner-friendly guides that explain useful tools and workflows, walk you through practical examples, and help you adapt what you learn to your own projects.
        </p>
      </div>
    </header>

    <section class="guides-section methodology-section" aria-labelledby="how-you-learn-title">
      <div class="container narrow">
        <div class="section-head">
          <h2 id="how-you-learn-title">How you'll learn</h2>
          <p class="section-subcopy">
            Build understanding, practise the process, and apply what you learn independently.
          </p>
        </div>

        <div class="methodology-grid">
          <article class="home-card method-card">
            <h3 class="method-title">Understand the process</h3>
            <p class="method-description">
              Learn why particular tools, prompts, settings and techniques are used for a task.
            </p>
          </article>

          <article class="home-card method-card">
            <h3 class="method-title">Follow the workflow</h3>
            <p class="method-description">
              Work through practical instructions, follow the sequence, and check each result as you go.
            </p>
          </article>

          <article class="home-card method-card">
            <h3 class="method-title">Adapt it to your needs</h3>
            <p class="method-description">
              Adjust what you've learned to suit your goals, available tools and project requirements.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="guides-section skill-areas-section" id="skill-areas" aria-labelledby="skill-areas-title">
      <div class="container narrow">
        <div class="section-head">
          <h2 id="skill-areas-title">Explore available skill areas</h2>
          <p class="section-subcopy">
            Browse skill areas with published resources. New areas appear here as more practical guides are added.
          </p>
        </div>

        {skillAreas.length > 0 ? (
          <div class="tracks-grid">
            {skillAreas.map((area) => (
              <article class="home-card track-card skill-area-card">
                <div class="track-card-header">
                  <div class="track-icon-wrap" style={`--skill-icon-color: ${area.iconColor};`} set:html={area.icon} />
                  <span class="skill-area-count">{area.count} {area.count === 1 ? 'resource' : 'resources'}</span>
                </div>

                <h3 class="track-title">{area.name}</h3>
                <p class="track-lead">{area.description}</p>

                {area.examples.length > 0 && (
                  <ul class="skill-area-examples" aria-label={`Published resources in ${area.name}`}>
                    {area.examples.map((example) => (
                      <li><a href={example.href}>{example.title}</a></li>
                    ))}
                  </ul>
                )}

                <div class="track-card-footer">
                  <a class="track-cta-btn" href={area.href}>
                    <span>Explore resources</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="guides-empty-state">
            <p>New guides are being prepared. Explore the resource library to see what's currently available.</p>
            <a href="/resources/">Explore resources →</a>
          </div>
        )}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .guides-page {
    min-height: 60vh;
    padding-bottom: 24px;
    background: transparent;
    color: var(--sf-page-heading, #F5F5F5);
  }

  .guides-hero {
    padding: 36px 0 26px;
    border-bottom: 1px solid var(--sf-page-divider, rgba(255,255,255,.08));
    text-align: left;
  }

  .guides-title {
    max-width: 760px;
    margin: 0 0 12px;
    color: var(--sf-page-heading, #F5F5F5);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(29px, 4.2vw, 38px);
    font-weight: 750;
    line-height: 1.18;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .guides-lead {
    max-width: 700px;
    margin: 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(14px, 1.7vw, 16px);
    font-weight: 400;
    line-height: 1.65;
  }

  .guides-section {
    padding: 28px 0 20px;
  }

  .section-head {
    max-width: 700px;
    margin: 0 0 20px;
    text-align: left;
  }

  .section-head h2 {
    margin: 0 0 7px;
    color: var(--sf-page-heading, #F5F5F5);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: clamp(19px, 2.4vw, 21px);
    font-weight: 750;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .section-subcopy {
    margin: 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 14px;
    line-height: 1.6;
  }

  .methodology-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .home-card {
    min-width: 0;
    padding: 20px;
    border: 1px solid var(--sf-page-border, rgba(255,255,255,.08));
    border-radius: 14px;
    background: var(--sf-page-surface, #0B0D12);
    box-shadow: none;
  }

  .method-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .method-title,
  .track-title {
    margin: 0;
    color: var(--sf-page-heading, #F5F5F5);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .method-description,
  .track-lead {
    margin: 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .track-card {
    display: flex;
    flex-direction: column;
    gap: 13px;
    padding: 20px;
  }

  .track-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .track-icon-wrap {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 44px;
    border: 1px solid color-mix(in srgb, var(--skill-icon-color) 28%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--skill-icon-color) 10%, transparent);
    color: var(--skill-icon-color);
  }

  .skill-area-count {
    color: var(--sf-page-copy-soft, #8C92A0);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 11.5px;
    font-weight: 600;
  }

  .track-lead {
    min-height: 0;
  }

  .skill-area-examples {
    display: grid;
    gap: 8px;
    margin: 1px 0 2px;
    padding: 0;
    list-style: none;
  }

  .skill-area-examples li {
    position: relative;
    padding-left: 14px;
    color: var(--sf-page-copy, #A1A9B6);
    font-size: 12.5px;
    line-height: 1.45;
  }

  .skill-area-examples li::before {
    content: "";
    position: absolute;
    top: .57em;
    left: 1px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--sf-page-accent, #35C9C1);
  }

  .skill-area-examples a {
    color: inherit;
    text-decoration: none;
    text-underline-offset: 3px;
  }

  .skill-area-examples a:hover {
    color: var(--sf-page-heading, #F5F5F5);
    text-decoration: underline;
  }

  .track-card-footer {
    margin-top: auto;
    padding-top: 4px;
  }

  .track-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    width: 100%;
    padding: 0 15px;
    border: 1px solid var(--sf-page-border, rgba(255,255,255,.08));
    border-radius: 9px;
    background: var(--sf-page-surface-raised, #111318);
    color: var(--sf-page-heading, #F5F5F5);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: border-color .16s ease, color .16s ease;
  }

  .track-cta-btn:hover {
    border-color: var(--sf-page-focus, rgba(53,201,193,.45));
    color: var(--sf-page-accent, #35C9C1);
  }

  .btn-arrow {
    transition: transform .16s ease;
  }

  .track-cta-btn:hover .btn-arrow {
    transform: translateX(3px);
  }

  .guides-empty-state {
    padding: 22px;
    border: 1px solid var(--sf-page-border, rgba(255,255,255,.08));
    border-radius: 14px;
    background: var(--sf-page-surface, #0B0D12);
    color: var(--sf-page-copy, #A1A9B6);
    font-size: 14px;
    line-height: 1.6;
  }

  .guides-empty-state p {
    margin: 0 0 10px;
  }

  .guides-empty-state a {
    color: var(--sf-page-accent, #35C9C1);
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .methodology-grid {
      grid-template-columns: 1fr;
    }

    .tracks-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .guides-hero {
      padding: 26px 0 20px;
    }

    .guides-section {
      padding: 20px 0 16px;
    }

    .section-head {
      margin-bottom: 16px;
    }

    .home-card {
      padding: 18px 16px;
    }

    .track-card {
      padding: 18px 16px;
    }
  }
</style>
