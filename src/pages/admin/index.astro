---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Resource Builder | Skill Foundry" description="Private publishing workspace for preparing Skill Foundry resources." robots="noindex, nofollow, noarchive">
  <section class="builder-page">
    <div class="builder-shell">
      <div class="builder-heading">
        <p class="eyebrow">RESOURCE BUILDER</p>
        <h1>Create a resource without writing code.</h1>
        <p>Prepare the same structured resource used by Skill Foundry, preview it as you build, save a browser draft, and download a publish-ready Markdown file.</p>
      </div>
      <div class="notice"><strong>Manual publishing fallback</strong><span>This workspace prepares content but does not publish directly to the public site yet. It keeps the manual workflow available while the future GitHub publishing connection can use this same structure.</span></div>

      <form id="resource-form" class="builder-grid">
        <section class="panel"><div class="panel-heading"><span>01</span><h2>Core details</h2></div><div class="field-grid">
          <label>Title<input name="title" required placeholder="Premium AI Product Photography Prompt" /></label>
          <label>Slug<div class="input-action"><input name="slug" placeholder="premium-ai-product-photography-prompt" /><button class="mini-button" id="make-slug" type="button">Generate</button></div></label>
          <label>Category<input name="category" required placeholder="Image Generation" /></label>
          <label>Tool / Model<input name="tool" required placeholder="AI Image Generator" /></label>
          <label class="full">Short description<textarea name="description" required rows="3" placeholder="A concise description used on resource cards and metadata."></textarea></label>
          <label>Date<input name="date" type="date" required /></label>
          <label>Image alt text<input name="imageAlt" placeholder="Describe the main result image" /></label>
          <label class="full">Tags<div id="tags-list" class="repeat-list"></div><button class="add-button" data-add="tag" type="button">+ Add tag</button></label>
        </div></section>

        <section class="panel"><div class="panel-heading"><span>02</span><h2>Images</h2></div><p class="panel-help">Use finished image paths from <code>public/images/</code>. The website does not generate AI images.</p><div class="field-grid">
          <label>Thumbnail path<input name="thumbnail" placeholder="/images/my-resource.jpg" /></label>
          <label>Hero image path<input name="heroImage" placeholder="/images/my-resource.jpg" /></label>
          <label>Input image path<input name="inputImage" placeholder="/images/input.jpg" /></label>
          <label class="full">Result images<div id="results-list" class="repeat-list"></div><button class="add-button" data-add="result" type="button">+ Add result image</button></label>
        </div></section>

        <section class="panel"><div class="panel-heading"><span>03</span><h2>Resource content</h2></div><div class="field-grid">
          <label class="full">Introduction<textarea name="intro" rows="5" placeholder="Explain what the resource is and when to use it."></textarea></label>
          <label class="full">What this resource does<textarea name="whatItDoes" rows="5" placeholder="Explain the practical result and important details."></textarea></label>
          <label class="full">Prompt<textarea name="prompt" required rows="12" placeholder="Paste the complete prompt here."></textarea></label>
        </div></section>

        <section class="panel"><div class="panel-heading"><span>04</span><h2>Tools & resources</h2></div><p class="panel-help">Add every tool used, with its purpose and optional URL/affiliate status.</p><div id="tools-list" class="repeat-list"></div><button class="add-button" data-add="tool" type="button">+ Add tool</button></section>

        <section class="panel"><div class="panel-heading"><span>05</span><h2>Tutorial, steps & tips</h2></div><div class="field-grid">
          <label>Tutorial embed URL<input name="videoEmbedUrl" placeholder="https://www.youtube.com/embed/..." /></label>
          <label>Original tutorial URL<input name="originalVideoUrl" placeholder="https://www.youtube.com/watch?v=..." /></label>
        </div>
        <div class="subsection"><div class="subheading"><h3>Step-by-step</h3><button class="add-button" data-add="step" type="button">+ Add step</button></div><div id="steps-list" class="repeat-list"></div></div>
        <div class="subsection"><div class="subheading"><h3>Tips & customization</h3><button class="add-button" data-add="tip" type="button">+ Add tip</button></div><div id="tips-list" class="repeat-list"></div></div>
        <div class="subsection"><div class="subheading"><h3>Related resources</h3><button class="add-button" data-add="related" type="button">+ Add related</button></div><div id="related-list" class="repeat-list"></div></div></section>

        <section class="panel"><div class="panel-heading"><span>06</span><h2>SEO & publishing</h2></div><div class="field-grid">
          <label class="full">SEO title<input name="seoTitle" placeholder="Unique search title for this resource" /></label>
          <label class="full">SEO description<textarea name="seoDescription" rows="3" placeholder="Unique search description for this resource."></textarea></label>
          <label class="check"><input name="featured" type="checkbox" /> Feature this resource on the homepage</label>
        </div><div class="actions"><button class="button button-secondary" id="save-draft" type="button">Save draft</button><button class="button button-secondary" id="clear-draft" type="button">Clear draft</button><button class="button button-primary" type="submit">Download resource file</button></div><p class="status" id="status" role="status" aria-live="polite"></p></section>
      </form>

      <section class="preview panel" aria-live="polite"><div class="panel-heading"><span>07</span><h2>Live preview</h2></div><div id="preview-content" class="preview-content"><p>Start filling the form to preview your resource.</p></div></section>
    </div>
  </section>
  <style>
    .builder-page{padding:58px 0 90px}.builder-shell{width:min(1080px,calc(100% - 48px));margin:0 auto}.builder-heading{max-width:800px;margin-bottom:28px}.builder-heading h1{margin-top:0;font-size:clamp(36px,6vw,62px)}.builder-heading p:not(.eyebrow){max-width:760px;color:var(--muted);font-size:17px}.notice{display:grid;gap:5px;margin-bottom:20px;padding:15px 17px;border:1px solid rgba(61,214,208,.2);border-radius:14px;background:rgba(61,214,208,.055);color:var(--muted)}.notice strong{color:var(--text)}.builder-grid{display:grid;gap:18px}.panel{padding:22px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.025)}.panel-heading{display:flex;align-items:center;gap:11px;margin-bottom:20px}.panel-heading span{display:grid;place-items:center;width:30px;height:30px;flex:0 0 auto;border:1px solid rgba(61,214,208,.3);border-radius:9px;color:var(--accent);font-size:12px;font-weight:800}.panel-heading h2{margin:0;font-size:20px}.panel-help{margin:-7px 0 18px;color:var(--muted);font-size:13px;line-height:1.6}.field-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}label{display:grid;gap:7px;color:var(--muted);font-size:13px;font-weight:700}label.full{grid-column:1/-1}input,textarea{width:100%;box-sizing:border-box;border:1px solid var(--line);border-radius:11px;background:rgba(7,17,31,.75);color:var(--text);font:inherit;font-size:14px;line-height:1.5;outline:none}input{min-height:46px;padding:10px 12px}textarea{padding:11px 12px;resize:vertical}input:focus,textarea:focus{border-color:rgba(61,214,208,.55);box-shadow:0 0 0 3px rgba(61,214,208,.07)}.input-action{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px}.mini-button,.add-button,.remove-button{border:1px solid var(--line);border-radius:9px;background:rgba(255,255,255,.035);color:var(--muted);font:inherit;font-size:12px;font-weight:700;cursor:pointer}.mini-button{padding:0 11px}.mini-button:hover,.add-button:hover,.remove-button:hover{border-color:rgba(61,214,208,.45);color:var(--accent)}.repeat-list{display:grid;gap:10px}.repeat-item{display:grid;gap:9px;padding:12px;border:1px solid var(--line);border-radius:12px;background:rgba(7,17,31,.45)}.repeat-item.two{grid-template-columns:minmax(0,1fr) auto;align-items:start}.repeat-item.tool{grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1fr) auto}.repeat-item.step{grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr) auto}.repeat-item label{font-size:11px}.repeat-item input,.repeat-item textarea{min-height:42px;font-size:13px}.remove-button{min-height:42px;padding:0 11px}.check{display:flex;align-items:center;gap:8px;color:var(--muted)}.check input{width:17px;height:17px;min-height:0;accent-color:var(--accent)}.subsection{margin-top:22px;padding-top:20px;border-top:1px solid var(--line)}.subheading{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:11px}.subheading h3{margin:0;font-size:14px}.add-button{padding:9px 12px}.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:22px}.status{min-height:20px;margin:10px 0 0;color:var(--muted);font-size:13px}.preview{margin-top:18px}.preview-content{display:grid;gap:15px}.preview-content h3{margin:0;font-size:clamp(28px,4vw,42px);line-height:1.1}.preview-content h4{margin:8px 0 -7px;font-size:15px}.preview-meta{color:var(--muted);font-size:13px}.preview-copy{margin:0;color:var(--muted);line-height:1.7;white-space:pre-wrap}.preview-image{width:min(100%,720px);max-height:420px;object-fit:cover;border:1px solid var(--line);border-radius:14px}.preview-list{display:grid;gap:8px;margin:0;padding-left:20px;color:var(--muted);line-height:1.6}.preview-prompt{padding:16px;border:1px solid var(--line);border-radius:13px;background:rgba(7,17,31,.7);color:var(--muted);white-space:pre-wrap;overflow-wrap:anywhere}.preview-tools{display:grid;gap:9px}.preview-tool{padding:12px 14px;border:1px solid var(--line);border-radius:11px}.preview-tool strong{display:block;margin-bottom:4px;color:var(--text)}.preview-tool span{color:var(--muted);font-size:13px}
    @media(max-width:700px){.builder-shell{width:min(calc(100% - 28px),1080px)}.builder-page{padding-top:38px}.field-grid{grid-template-columns:1fr}label.full{grid-column:auto}.panel{padding:17px;border-radius:15px}.actions .button{width:100%}.repeat-item.tool,.repeat-item.step,.repeat-item.two{grid-template-columns:1fr}.remove-button{width:100%}.input-action{grid-template-columns:1fr}.mini-button{min-height:42px}}
  </style>
  <script src="/admin/resource-builder.js"></script>
</BaseLayout>
