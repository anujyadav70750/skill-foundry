</style>

<script>
  function initHomepageInteractive() {
    // 1. FAQ Accordion Click Handler (Strict Single-Open Behavior)
    const accordionTriggers = document.querySelectorAll<HTMLButtonElement>('.faq-accordion-trigger');

    accordionTriggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const panelId = btn.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;

        // Close all other open accordions so only ONE remains open
        accordionTriggers.forEach((otherBtn) => {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            const otherPanelId = otherBtn.getAttribute('aria-controls');
            const otherPanel = otherPanelId ? document.getElementById(otherPanelId) : null;
            if (otherPanel) otherPanel.hidden = true;
          }
        });

        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          if (panel) panel.hidden = true;
        } else {
          btn.setAttribute('aria-expanded', 'true');
          if (panel) panel.hidden = false;
        }
      });
    });

    // 2. FAQ Live Search Handler
    const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('faq-search-clear') as HTMLButtonElement | null;
    const accordionItems = Array.from(document.querySelectorAll<HTMLElement>('.faq-accordion-item'));
    const noResults = document.getElementById('faq-no-results');

    if (searchInput && accordionItems.length > 0) {
      const itemsData = accordionItems.map((item) => {
        const trigger = item.querySelector<HTMLButtonElement>('.faq-accordion-trigger');
        const qEl = item.querySelector<HTMLElement>('.faq-question-text');
        const aEl = item.querySelector<HTMLElement>('.faq-answer-text');
        const panel = item.querySelector<HTMLElement>('.faq-accordion-panel');
        const isDefaultPreview = item.dataset.defaultPreview === 'true';
        const rawQuestion = qEl ? qEl.textContent || '' : '';
        const rawAnswer = aEl ? aEl.textContent || '' : '';
        return { item, trigger, qEl, aEl, panel, isDefaultPreview, rawQuestion, rawAnswer };
      });

      function escapeHtml(str: string): string {
        return str
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function highlightContent(text: string, terms: string[]): string {
        if (!terms.length || !text) return escapeHtml(text);
        const escaped = terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).filter(Boolean);
        if (!escaped.length) return escapeHtml(text);
        const regex = new RegExp(`(${escaped.join('|')})`, 'gi');
        return text.split(regex).map((part) => {
          if (escaped.some((t) => new RegExp(`^${t}$`, 'i').test(part))) {
            return `<mark class="faq-match-mark">${escapeHtml(part)}</mark>`;
          }
          return escapeHtml(part);
        }).join('');
      }

      const handleSearch = () => {
        const query = searchInput.value.trim().toLowerCase();

        if (clearBtn) {
          clearBtn.style.display = query ? 'inline-flex' : 'none';
        }

        if (!query) {
          itemsData.forEach(({ item, trigger, panel, qEl, aEl, isDefaultPreview, rawQuestion, rawAnswer }) => {
            item.style.display = isDefaultPreview ? '' : 'none';
            if (qEl) qEl.innerHTML = escapeHtml(rawQuestion);
            if (aEl) aEl.innerHTML = escapeHtml(rawAnswer);
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
            if (panel) panel.hidden = true;
          });
          if (noResults) noResults.style.display = 'none';
          return;
        }

        const terms = query.split(/\s+/).filter(Boolean);
        let matchCount = 0;

        itemsData.forEach(({ item, trigger, panel, qEl, aEl, rawQuestion, rawAnswer }) => {
          const qLower = rawQuestion.toLowerCase();
          const aLower = rawAnswer.toLowerCase();
          const combined = `${qLower} ${aLower}`;
          const isMatch = terms.every((t) => combined.includes(t));

          if (isMatch) {
            item.style.display = '';
            if (qEl) qEl.innerHTML = highlightContent(rawQuestion, terms);
            if (aEl) aEl.innerHTML = highlightContent(rawAnswer, terms);
            if (trigger) trigger.setAttribute('aria-expanded', 'true');
            if (panel) panel.hidden = false;
            matchCount++;
          } else {
            item.style.display = 'none';
            if (qEl) qEl.innerHTML = escapeHtml(rawQuestion);
            if (aEl) aEl.innerHTML = escapeHtml(rawAnswer);
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
            if (panel) panel.hidden = true;
          }
        });

        if (noResults) noResults.style.display = matchCount === 0 ? 'block' : 'none';
      };

      searchInput.addEventListener('input', handleSearch);

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          handleSearch();
          searchInput.focus();
        });
      }
    }

    // 3. Question Submission Forms (Inline & Modal)
    const submitForm = document.getElementById('faq-submit-form') as HTMLFormElement | null;
    const questionInput = document.getElementById('faq-question-input') as HTMLTextAreaElement | null;
    const validationMsg = document.getElementById('faq-validation-msg');
    const inlineClearBtn = document.getElementById('faq-clear-btn') as HTMLButtonElement | null;
    const submitBtn = document.getElementById('faq-submit-btn') as HTMLButtonElement | null;
    const expandBtn = document.getElementById('faq-open-question-modal') as HTMLButtonElement | null;
    const formStatus = document.getElementById('faq-form-status');

    const modalOverlay = document.getElementById('faq-modal-overlay');
    const modalBackdrop = document.getElementById('faq-modal-backdrop');
    const modalCollapseBtn = document.getElementById('faq-modal-collapse-btn') as HTMLButtonElement | null;
    const modalBackBtn = document.getElementById('faq-modal-back-btn') as HTMLButtonElement | null;
    const modalClearBtn = document.getElementById('faq-modal-clear-btn') as HTMLButtonElement | null;
    const modalForm = document.getElementById('faq-modal-form') as HTMLFormElement | null;
    const modalInput = document.getElementById('faq-modal-question-input') as HTMLTextAreaElement | null;
    const modalValidationMsg = document.getElementById('faq-modal-validation-msg');
    const modalSubmitBtn = document.getElementById('faq-modal-submit-btn') as HTMLButtonElement | null;
    const modalStatus = document.getElementById('faq-modal-status');

    let isModalOpen = false;

    const updateInlineButtonState = () => {
      if (!questionInput) return;
      const hasText = questionInput.value.trim().length > 0;
      if (submitBtn) submitBtn.disabled = !hasText;
      if (inlineClearBtn) inlineClearBtn.disabled = !hasText;
    };

    const updateModalButtonState = () => {
      if (!modalInput) return;
      const hasText = modalInput.value.trim().length > 0;
      if (modalSubmitBtn) modalSubmitBtn.disabled = !hasText;
      if (modalClearBtn) modalClearBtn.disabled = !hasText;
    };

    updateInlineButtonState();
    updateModalButtonState();

    const openModal = () => {
      if (!modalOverlay || !modalInput) return;
      isModalOpen = true;
      modalInput.value = '';
      updateModalButtonState();
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
      modalOverlay.style.display = 'flex';
      modalOverlay.setAttribute('aria-hidden', 'false');
      setTimeout(() => {
        modalInput.focus();
        modalInput.selectionStart = modalInput.selectionEnd = modalInput.value.length;
      }, 50);
    };

    const closeModal = () => {
      if (!modalOverlay || !modalInput) return;
      isModalOpen = false;
      modalOverlay.style.display = 'none';
      modalOverlay.setAttribute('aria-hidden', 'true');
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
      if (expandBtn) expandBtn.focus();
    };

    if (expandBtn) expandBtn.addEventListener('click', openModal);
    if (modalCollapseBtn) modalCollapseBtn.addEventListener('click', closeModal);
    if (modalBackBtn) modalBackBtn.addEventListener('click', closeModal);
    if (modalBackdrop) {
      modalBackdrop.addEventListener('click', () => {
        if (!modalInput || modalInput.value.trim().length === 0) closeModal();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isModalOpen) closeModal();
    });

    if (questionInput) {
      questionInput.addEventListener('input', () => {
        updateInlineButtonState();
        if (validationMsg) {
          validationMsg.style.display = 'none';
          validationMsg.textContent = '';
        }
      });
    }

    if (modalInput) {
      modalInput.addEventListener('input', () => {
        updateModalButtonState();
        if (questionInput) {
          questionInput.value = modalInput.value;
          updateInlineButtonState();
        }
        if (modalValidationMsg) {
          modalValidationMsg.style.display = 'none';
          modalValidationMsg.textContent = '';
        }
      });
    }

    if (inlineClearBtn && questionInput) {
      inlineClearBtn.addEventListener('click', () => {
        questionInput.value = '';
        updateInlineButtonState();
        if (modalInput) {
          modalInput.value = '';
          updateModalButtonState();
        }
        if (validationMsg) {
          validationMsg.style.display = 'none';
          validationMsg.textContent = '';
        }
        questionInput.focus();
      });
    }

    if (modalClearBtn && modalInput) {
      modalClearBtn.addEventListener('click', () => {
        modalInput.value = '';
        updateModalButtonState();
        if (questionInput) {
          questionInput.value = '';
          updateInlineButtonState();
        }
        modalInput.focus();
      });
    }

    // Submit inline form
    if (submitForm && questionInput && submitBtn && formStatus) {
      submitForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const question = questionInput.value.trim();

        if (validationMsg) {
          validationMsg.style.display = 'none';
          validationMsg.textContent = '';
        }
        formStatus.className = 'faq-form-status';
        formStatus.textContent = '';

        if (!question) {
          if (validationMsg) {
            validationMsg.textContent = 'Please enter your question before submitting.';
            validationMsg.style.display = 'block';
          }
          questionInput.focus();
          return;
        }

        if (question.length < 5) {
          if (validationMsg) {
            validationMsg.textContent = 'Please provide a little more detail in your question (at least 5 characters).';
            validationMsg.style.display = 'block';
          }
          questionInput.focus();
          return;
        }

        submitBtn.disabled = true;
        if (inlineClearBtn) inlineClearBtn.disabled = true;
        const btnText = submitBtn.querySelector('.btn-text');
        if (btnText) btnText.textContent = 'Submitting…';

        try {
          const response = await fetch('/api/faq-question', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question })
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.ok) {
            throw new Error(result.error || 'We could not submit your question right now.');
          }
          questionInput.value = '';
          if (modalInput) modalInput.value = '';
          formStatus.className = 'faq-form-status success';
          formStatus.textContent = 'Thanks — your question has been received.';
        } catch (error: any) {
          formStatus.className = 'faq-form-status error';
          formStatus.textContent = error?.message && error.message !== 'Failed to fetch'
            ? error.message
            : 'We could not submit your question right now. Please try again later.';
        } finally {
          if (btnText) btnText.textContent = 'Submit';
          updateInlineButtonState();
          updateModalButtonState();
        }
      });
    }

    // Submit modal form
    if (modalForm && modalInput && modalSubmitBtn && modalStatus) {
      modalForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const question = modalInput.value.trim();

        if (modalValidationMsg) {
          modalValidationMsg.style.display = 'none';
          modalValidationMsg.textContent = '';
        }
        modalStatus.className = 'faq-form-status';
        modalStatus.textContent = '';

        if (!question || question.length < 5) {
          if (modalValidationMsg) {
            modalValidationMsg.textContent = 'Please provide at least 5 characters in your question.';
            modalValidationMsg.style.display = 'block';
          }
          modalInput.focus();
          return;
        }

        modalSubmitBtn.disabled = true;
        if (modalClearBtn) modalClearBtn.disabled = true;
        const modalBtnText = modalSubmitBtn.querySelector('.btn-text');
        if (modalBtnText) modalBtnText.textContent = 'Submitting…';

        try {
          const response = await fetch('/api/faq-question', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question })
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.ok) {
            throw new Error(result.error || 'We could not submit your question right now.');
          }
          modalInput.value = '';
          if (questionInput) questionInput.value = '';
          modalStatus.className = 'faq-form-status success';
          modalStatus.textContent = 'Thanks — your question has been received.';
          setTimeout(() => {
            if (isModalOpen) closeModal();
          }, 1200);
        } catch (error: any) {
          modalStatus.className = 'faq-form-status error';
          modalStatus.textContent = error?.message && error.message !== 'Failed to fetch'
            ? error.message
            : 'We could not submit your question right now. Please try again later.';
        } finally {
          if (modalBtnText) modalBtnText.textContent = 'Submit';
          updateModalButtonState();
          updateInlineButtonState();
        }
      });
    }
  }

  const initRecentWorkScroll = () => {
    const track = document.getElementById('recent-work-track');
    const prevBtn = document.querySelector('.recent-work-prev');
    const nextBtn = document.querySelector('.recent-work-next');
    if (!track || !prevBtn || !nextBtn) return;

    const updateButtons = () => {
      if (window.innerWidth <= 640) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
        return;
      }
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll <= 4) {
        prevBtn.style.display = 'none';
        nextBtn.style.display = 'none';
        return;
      }
      prevBtn.style.display = track.scrollLeft > 6 ? 'grid' : 'none';
      nextBtn.style.display = track.scrollLeft < maxScroll - 6 ? 'grid' : 'none';
    };

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -320, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: 320, behavior: 'smooth' });
    });
    track.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons, { passive: true });
    updateButtons();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      initHomepageInteractive();
      initRecentWorkScroll();
    });
  } else {
    initHomepageInteractive();
    initRecentWorkScroll();
  }
  document.addEventListener('astro:page-load', () => {
    initHomepageInteractive();
    initRecentWorkScroll();
  });
</script>
