<script>
  function initHomepageInteractive() {
    // 1. FAQ Accordion Click Handler (Strict Single-Open Behavior)
    const accordionTriggers = document.querySelectorAll<HTMLButtonElement>('.faq-accordion-trigger');

    accordionTriggers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        const panelId = btn.getAttribute('aria-controls');
        const panel = panelId ? document.getElementById(panelId) : null;

        accordionTriggers.forEach((otherBtn) => {
          if (otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            const otherPanelId = otherBtn.getAttribute('aria-controls');
            const otherPanel = otherPanelId ? document.getElementById(otherPanelId) : null;
            if (otherPanel) otherPanel.hidden = true;
          }
        });

        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          if (panel) panel.hidden = true;
        } else {
          btn.setAttribute('aria-expanded', 'true');
          if (panel) panel.hidden = false;
        }
      });
    });

    // 2. FAQ Live Search Handler
    const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('faq-search-clear') as HTMLButtonElement | null;
    const accordionItems = Array.from(document.querySelectorAll<HTMLElement>('.faq-accordion-item'));
    const noResults = document.getElementById('faq-no-results');
    const moreWrap = document.getElementById('faq-more-wrap');

    if (searchInput && accordionItems.length > 0) {
      const itemsData = accordionItems.map((item) => {
        const trigger = item.querySelector<HTMLButtonElement>('.faq-accordion-trigger');
        const qEl = item.querySelector<HTMLElement>('.faq-question-text');
        const aEl = item.querySelector<HTMLElement>('.faq-answer-text');
        const panel = item.querySelector<HTMLElement>('.faq-accordion-panel');
        const isDefaultPreview = item.dataset.defaultPreview === 'true';
        const rawQuestion = qEl ? qEl.textContent || '' : '';
        const rawAnswer = aEl ? aEl.textContent || '' : '';
        return { item, trigger, qEl, aEl, panel, isDefaultPreview, rawQuestion, rawAnswer };
      });

      const handleSearch = () => {
        const query = searchInput.value.trim().toLowerCase();

        if (clearBtn) {
          clearBtn.style.display = query ? 'inline-flex' : 'none';
        }

        if (!query) {
          itemsData.forEach(({ item, trigger, panel, isDefaultPreview }) => {
            item.style.display = isDefaultPreview ? '' : 'none';
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
            if (panel) panel.hidden = true;
          });
          if (noResults) noResults.style.display = 'none';
          if (moreWrap) moreWrap.style.display = 'flex';
          return;
        }

        const terms = query.split(/\s+/).filter(Boolean);
        let matchCount = 0;

        itemsData.forEach(({ item, trigger, panel, rawQuestion, rawAnswer }) => {
          const qLower = rawQuestion.toLowerCase();
          const aLower = rawAnswer.toLowerCase();
          const isMatch = terms.every((t) => qLower.includes(t) || aLower.includes(t));

          if (isMatch) {
            item.style.display = '';
            matchCount++;
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
            if (panel) panel.hidden = true;
          } else {
            item.style.display = 'none';
          }
        });

        if (noResults) noResults.style.display = matchCount === 0 ? 'block' : 'none';
        if (moreWrap) moreWrap.style.display = 'none';
      };

      searchInput.addEventListener('input', handleSearch);

      clearBtn?.addEventListener('click', () => {
        searchInput.value = '';
        handleSearch();
        searchInput.focus();
      });
    }

    // 3. Question Submission Forms & Expanded Modal
    const form = document.getElementById('faq-submit-form') as HTMLFormElement | null;
    const input = document.getElementById('faq-question-input') as HTMLTextAreaElement | null;
    const clearFormBtn = document.getElementById('faq-clear-btn') as HTMLButtonElement | null;
    const submitFormBtn = document.getElementById('faq-submit-btn') as HTMLButtonElement | null;
    const statusEl = document.getElementById('faq-form-status');
    const valMsg = document.getElementById('faq-validation-msg');
    const expandBtn = document.getElementById('faq-expand-btn') as HTMLButtonElement | null;

    const modalOverlay = document.getElementById('faq-modal-overlay');
    const modalBackdrop = document.getElementById('faq-modal-backdrop');
    const modalCollapseBtn = document.getElementById('faq-modal-collapse-btn');
    const modalForm = document.getElementById('faq-modal-form') as HTMLFormElement | null;
    const modalInput = document.getElementById('faq-modal-question-input') as HTMLTextAreaElement | null;
    const modalClearBtn = document.getElementById('faq-modal-clear-btn') as HTMLButtonElement | null;
    const modalSubmitBtn = document.getElementById('faq-modal-submit-btn') as HTMLButtonElement | null;
    const modalStatus = document.getElementById('faq-modal-status');
    const modalValMsg = document.getElementById('faq-modal-validation-msg');

    const updateBtns = () => {
      const val = input ? input.value.trim() : '';
      if (clearFormBtn) clearFormBtn.disabled = !val;
      if (submitFormBtn) submitFormBtn.disabled = !val;

      const mVal = modalInput ? modalInput.value.trim() : '';
      if (modalClearBtn) modalClearBtn.disabled = !mVal;
      if (modalSubmitBtn) modalSubmitBtn.disabled = !mVal;
    };

    input?.addEventListener('input', () => {
      updateBtns();
      if (valMsg) valMsg.style.display = 'none';
      if (statusEl) statusEl.textContent = '';
    });

    modalInput?.addEventListener('input', () => {
      updateBtns();
      if (modalValMsg) modalValMsg.style.display = 'none';
      if (modalStatus) modalStatus.textContent = '';
    });

    clearFormBtn?.addEventListener('click', () => {
      if (input) input.value = '';
      updateBtns();
      if (valMsg) valMsg.style.display = 'none';
      if (statusEl) statusEl.textContent = '';
      input?.focus();
    });

    modalClearBtn?.addEventListener('click', () => {
      if (modalInput) modalInput.value = '';
      updateBtns();
      if (modalValMsg) modalValMsg.style.display = 'none';
      if (modalStatus) modalStatus.textContent = '';
      modalInput?.focus();
    });

    const openModal = () => {
      if (modalOverlay) {
        modalOverlay.style.display = 'flex';
        modalOverlay.setAttribute('aria-hidden', 'false');
      }
      if (input && modalInput) {
        modalInput.value = input.value;
      }
      updateBtns();
      setTimeout(() => modalInput?.focus(), 50);
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      if (modalOverlay) {
        modalOverlay.style.display = 'none';
        modalOverlay.setAttribute('aria-hidden', 'true');
      }
      if (input && modalInput) {
        input.value = modalInput.value;
      }
      updateBtns();
      document.body.style.overflow = '';
    };

    expandBtn?.addEventListener('click', openModal);
    modalCollapseBtn?.addEventListener('click', closeModal);
    modalBackdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modalOverlay && modalOverlay.style.display === 'flex') {
        closeModal();
      }
    });

    // Form Submissions
    const handleFormSubmit = (
      e: Event,
      textarea: HTMLTextAreaElement | null,
      valEl: HTMLElement | null,
      statEl: HTMLElement | null,
      btn: HTMLButtonElement | null,
      isModal = false
    ) => {
      e.preventDefault();
      const value = textarea ? textarea.value.trim() : '';

      if (!value) {
        if (valEl) {
          valEl.textContent = 'Please enter a question or topic before submitting.';
          valEl.style.display = 'block';
        }
        return;
      }

      if (btn) btn.disabled = true;
      if (statEl) {
        statEl.textContent = 'Submitting your question...';
        statEl.className = 'faq-form-status';
      }

      setTimeout(() => {
        if (statEl) {
          statEl.textContent = 'Thank you! Your question has been submitted and will be reviewed for the FAQ.';
          statEl.className = 'faq-form-status success';
        }
        if (textarea) textarea.value = '';
        if (input) input.value = '';
        if (modalInput) modalInput.value = '';
        updateBtns();

        if (isModal) {
          setTimeout(() => closeModal(), 1800);
        }
      }, 600);
    };

    form?.addEventListener('submit', (e) => handleFormSubmit(e, input, valMsg, statusEl, submitFormBtn));
    modalForm?.addEventListener('submit', (e) => handleFormSubmit(e, modalInput, modalValMsg, modalStatus, modalSubmitBtn, true));

    updateBtns();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHomepageInteractive);
  } else {
    initHomepageInteractive();
  }
</script>
