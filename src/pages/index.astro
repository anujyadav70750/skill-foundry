---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../lib/resource';
import { FAQ_DATA } from '../data/faqs';

// 1. DYNAMIC PUBLISHED RESOURCES (Newest first)
const allResources = await getCollection('resources');
const publishedResources = allResources
  .filter((r) => !('draft' in r.data && r.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const recentWorkResources = publishedResources.slice(0, 4);

// 2. DISCIPLINE / SKILL TRACKS
const learningTracks = [
  {
    title: 'AI & Emerging Tools',
    desc: 'Generative prompt architectures, model parameters, LLM systems, and emerging tool stacks.',
    categoryName: 'AI Tools',
    iconSvg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>'
  },
  {
    title: 'Content Creation',
    desc: 'Structured storytelling, visual messaging, brand assets, and multi-format media production.',
    categoryName: 'Content Creation',
    iconSvg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>'
  },
  {
    title: 'Video & Visuals',
    desc: 'Multi-clip video assembly, character continuity, motion pacing, and visual editing pipelines.',
    categoryName: 'AI Video',
    iconSvg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>'
  },
  {
    title: 'Design',
    desc: 'Layout hierarchy, visual balance, UI component patterns, and digital design systems.',
    categoryName: 'Design',
    iconSvg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l7.5 14.5L13 18l5-5z"></path><path d="M2 2l7.58 7.58"></path><circle cx="11" cy="11" r="2"></circle></svg>'
  },
  {
    title: 'Automation',
    desc: 'Workflow orchestration, tool API connections, automated triggers, and repeatable production.',
    categoryName: 'AI Automation',
    iconSvg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>'
  },
  {
    title: 'Productivity',
    desc: 'Execution systems, smart organization shortcuts, knowledge management, and task efficiency.',
    categoryName: 'Productivity',
    iconSvg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>'
  },
  {
    title: 'Digital Skills',
    desc: 'Practical web tools, asset pipelines, prompt engineering, and independent digital capability.',
    categoryName: 'Prompt Systems',
    iconSvg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3z"></path><path d="M6 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3z"></path></svg>'
  }
];

const formatUploadDate = (d: Date | string | undefined) => {
  if (!d) return '';
  const date = new Date(d);
  const day = date.getDate();
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
};
---

<BaseLayout
  title="Skill Foundry — Learn Practical Skills. Make Them Your Own."
  description="Skill Foundry helps people understand modern tools, workflows, and practical skills so they can use them independently, adapt them to their own needs, and create with them."
>
  <div class="home-page">
    <!-- 1. HERO — WHAT SKILL FOUNDRY IS & WHY IT EXISTS -->
    <section class="home-hero">
      <div class="container narrow hero-content">
        <div class="hero-capsule-row">
          <span class="home-capsule">PRACTICAL SKILLS PLATFORM</span>
        </div>
        
        <h1 class="hero-title">
          Learn practical skills. Make them your own.
        </h1>

        <p class="hero-lead">
          Skill Foundry helps people understand modern tools, workflows, and practical skills so they can use them for their own ideas — whether they are starting from zero or already know the basics.
        </p>

        <p class="hero-subline">
          Understand it. Try it. Adapt it. Create with it.
        </p>

        <div class="hero-actions">
          <a class="home-button home-button-primary" href="/resources/">
            <span>Explore Resources</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- 2. RECENT WORK — MOVED DIRECTLY AFTER HERO -->
    <section class="home-section recent-work-section" id="recent-work">
      <div class="container narrow">
        <div class="section-head section-head-flex">
          <div>
            <p class="home-capsule">RECENT WORK</p>
            <h2>SEE WHAT WE'RE BUILDING.</h2>
            <p class="section-subcopy">
              Real projects, experiments, and practical workflows.
            </p>
          </div>
          <a class="view-all-link-btn" href="/resources/">
            <span>View all recent work</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        {recentWorkResources.length > 0 ? (
          <div class="recent-work-scroll-wrapper">
            {recentWorkResources.map((resource) => {
              const slug = resourceSlug(resource);
              const thumbnail = resourceThumbnail(resource);
              const alt = resourceImageAlt(resource);

              return (
                <a
                  class="home-card recent-work-card"
                  href={`/resources/${slug}/`}
                  aria-label={`Open ${resource.data.title}`}
                >
                  <div class="recent-thumb-wrap">
                    <img class="recent-thumb-img" src={thumbnail} alt={alt} loading="lazy" />
                  </div>

                  <div class="recent-card-body">
                    <div class="recent-card-meta">
                      <span class="recent-meta-category">{resource.data.category}</span>
                      <span class="recent-meta-date">{formatUploadDate(resource.data.date)}</span>
                    </div>

                    <h3 class="recent-card-title">{resource.data.title}</h3>
                    <p class="recent-card-desc">{resource.data.description}</p>
                  </div>
                </a>
              );
            })}
          </div>
        ) : (
          <div class="empty-state-box">
            <p class="empty-state-title">No published work yet</p>
            <p class="empty-state-text">New step-by-step tutorials and verified workflows are currently being crafted. Check back soon.</p>
          </div>
        )}
      </div>
    </section>

    <!-- 3. WHY WE ARE DIFFERENT — REBUILD -->
    <section class="home-section why-different-section" id="why-different">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">OUR APPROACH</p>
          <h2>Not another copy-paste resource site.</h2>
          <p class="section-subcopy">
            We do not simply give visitors something to copy and paste. We explain what they are doing, how it works, and why it works. Once they understand the idea, they can use it for their own project, solve their own problem, or take it somewhere different.
          </p>
        </div>

        <div class="different-editorial-grid">
          <!-- Featured Principle Card (Large Lead) -->
          <article class="home-card editorial-card editorial-card-hero">
            <div class="editorial-card-header">
              <span class="editorial-number">01</span>
              <span class="editorial-tag">FOUNDATION</span>
            </div>
            <h3 class="card-title">UNDERSTAND</h3>
            <p class="card-description">
              Learn the core logic, tool mechanics, and prompt principles behind each workflow. When you understand why something works, you gain a reusable skill rather than a one-time shortcut.
            </p>
          </article>

          <!-- Standard Principle Cards Stack -->
          <div class="editorial-cards-stack">
            <article class="home-card editorial-card">
              <div class="editorial-card-header">
                <span class="editorial-number">02</span>
                <span class="editorial-tag">PRACTICE</span>
              </div>
              <h3 class="card-title">APPLY</h3>
              <p class="card-description">
                Put what you learn directly into practice on real examples, guided blueprints, and real-world projects.
              </p>
            </article>

            <article class="home-card editorial-card">
              <div class="editorial-card-header">
                <span class="editorial-number">03</span>
                <span class="editorial-tag">CUSTOMIZE</span>
              </div>
              <h3 class="card-title">ADAPT</h3>
              <p class="card-description">
                Change and tailor proven workflows to your specific goals, different software stacks, or unique project situations.
              </p>
            </article>

            <article class="home-card editorial-card">
              <div class="editorial-card-header">
                <span class="editorial-number">04</span>
                <span class="editorial-tag">INNOVATE</span>
              </div>
              <h3 class="card-title">CREATE</h3>
              <p class="card-description">
                Take the idea further. Combine tools, build new workflows, and create original work that is entirely your own.
              </p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. WHAT YOU CAN LEARN — ONE MERGED SECTION -->
    <section class="home-section learn-section" id="what-you-can-learn">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">KNOWLEDGE &amp; SKILLS</p>
          <h2>What you can learn</h2>
          <p class="section-subcopy">
            Explore practical capabilities across emerging tech, creative software, video production, design, automation, and productivity.
          </p>
        </div>

        <div class="learn-grid">
          {learningTracks.map((track) => (
            <a
              class="home-card learn-track-card"
              href={`/resources/?category=${encodeURIComponent(track.categoryName)}`}
            >
              <div class="track-icon-box" set:html={track.iconSvg} />
              <div class="track-content">
                <h3 class="card-title track-title">{track.title}</h3>
                <p class="card-description track-desc">{track.desc}</p>
              </div>
              <span class="track-link-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. HOW WE TEACH — REBUILD (Understand -> Apply -> Adapt -> Create) -->
    <section class="home-section method-section" id="how-we-teach">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">THE LEARNING JOURNEY</p>
          <h2>How We Teach</h2>
          <p class="section-subcopy">
            A clear progression designed to take you from foundational understanding to creative independence.
          </p>
        </div>

        <div class="method-timeline-grid">
          <article class="home-card method-step-card">
            <div class="method-step-num">01</div>
            <div class="method-step-capsule">UNDERSTAND</div>
            <h3 class="card-title">Learn the reasoning</h3>
            <p class="card-description">
              Learn the idea, tool mechanics, prompt logic, and workflow reasoning behind each practical deliverable.
            </p>
          </article>

          <article class="home-card method-step-card">
            <div class="method-step-num">02</div>
            <div class="method-step-capsule">APPLY</div>
            <h3 class="card-title">Try it on a real project</h3>
            <p class="card-description">
              Execute step-by-step blueprints on a concrete example to verify the output and master the workflow.
            </p>
          </article>

          <article class="home-card method-step-card">
            <div class="method-step-num">03</div>
            <div class="method-step-capsule">ADAPT</div>
            <h3 class="card-title">Tailor to your goals</h3>
            <p class="card-description">
              Modify prompts, settings, and step sequences to solve your own specific problems and fit your software stack.
            </p>
          </article>

          <article class="home-card method-step-card">
            <div class="method-step-num">04</div>
            <div class="method-step-capsule">CREATE</div>
            <h3 class="card-title">Build something original</h3>
            <p class="card-description">
              Take the idea further, synthesize multiple techniques, and create unique, independent projects.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- 6. RESOURCE LIBRARY — REFRAME, DO NOT BREAK -->
    <section class="home-section library-section" id="resource-library">
      <div class="container narrow">
        <div class="section-head section-head-flex">
          <div>
            <p class="home-capsule">RESOURCE LIBRARY</p>
            <h2>Start with an idea.</h2>
            <p class="section-subcopy">
              Explore practical learning materials that explain the process behind real results. Browse blueprints, workflows, and prompts ready to execute and adapt.
            </p>
          </div>
          <a class="view-all-link-btn" href="/resources/">
            <span>Browse full library</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="library-preview-banner home-card">
          <div class="banner-text">
            <h3 class="banner-title">Executable Blueprints &amp; Guided Workflows</h3>
            <p class="banner-desc">
              Search by tool, filter by category, or discover verified prompt blueprints designed for hands-on learning.
            </p>
          </div>
          <div class="banner-action">
            <a class="home-button home-button-secondary" href="/resources/">
              <span>Search &amp; Filter Resources</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. WHY TRUST US -->
    <section class="home-section trust-section" id="why-trust-us">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">QUALITY &amp; INTEGRITY</p>
          <h2>Why Trust Us</h2>
          <p class="section-subcopy">
            Built for execution. Every guide in our library is created for reliable, reproducible learning.
          </p>
        </div>

        <div class="trust-grid">
          <article class="home-card trust-card">
            <div class="trust-card-capsule">01 • HANDS-ON TESTING</div>
            <h3 class="card-title">Tested before publication</h3>
            <p class="card-description">
              Every workflow and blueprint is tested end-to-end through actual execution before release so steps, prompts, and settings work reliably.
            </p>
          </article>

          <article class="home-card trust-card">
            <div class="trust-card-capsule">02 • FULL TRANSPARENCY</div>
            <h3 class="card-title">Tool transparency</h3>
            <p class="card-description">
              We clearly show which tools are used, where they fit in the process, free tier availability, and recommended software alternatives upfront.
            </p>
          </article>

          <article class="home-card trust-card">
            <div class="trust-card-capsule">03 • ACTIONABLE FOCUS</div>
            <h3 class="card-title">No unnecessary fluff</h3>
            <p class="card-description">
              Zero filler or vague claims. Direct, practical instructions designed to help you genuinely understand and build real deliverables.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- 8. FAQ SECTION (REINFORCING POSITIONING) -->
    <section class="home-section faq-section" id="faq">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">FREQUENTLY ASKED</p>
          <h2>Frequently Asked Questions</h2>
          <p class="section-subcopy">
            Quick answers about Skill Foundry, beginner friendliness, prompt adaptation, and practical learning.
          </p>
        </div>

        <!-- FAQ Search Input -->
        <div class="faq-search-wrap">
          <label for="faq-search-input" class="sr-only">Search for a question or topic</label>
          <div class="faq-search-field">
            <span class="faq-search-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="9" r="6"></circle>
                <line x1="13.5" y1="13.5" x2="18" y2="18"></line>
              </svg>
            </span>
            <input
              type="search"
              id="faq-search-input"
              class="faq-search-input"
              placeholder="Search for a question or topic…"
              autocomplete="off"
              spellcheck="false"
            />
            <button
              type="button"
              id="faq-search-clear"
              class="faq-search-clear"
              aria-label="Clear search query"
              style="display: none;"
            >
              <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="5" x2="15" y2="15"></line>
                <line x1="15" y1="5" x2="5" y2="15"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- FAQ Accordion List -->
        <div class="faq-accordion-list" id="faq-list">
          {FAQ_DATA.map((faq, index) => {
            const isDefaultPreview = index < 10;
            return (
              <div
                class="faq-accordion-item"
                data-faq-id={faq.id}
                data-default-preview={isDefaultPreview ? "true" : "false"}
                style={isDefaultPreview ? "" : "display: none;"}
              >
                <button
                  type="button"
                  class="faq-accordion-trigger"
                  id={`faq-btn-${index}`}
                  aria-expanded="false"
                  aria-controls={`faq-content-${index}`}
                >
                  <span class="faq-question-text">{faq.question}</span>
                  <span class="faq-plus-control" aria-hidden="true">
                    <svg class="faq-plus-icon" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <line class="plus-v" x1="10" y1="4" x2="10" y2="16"></line>
                      <line class="plus-h" x1="4" y1="10" x2="16" y2="10"></line>
                    </svg>
                  </span>
                </button>
                <div
                  id={`faq-content-${index}`}
                  class="faq-accordion-panel"
                  role="region"
                  aria-labelledby={`faq-btn-${index}`}
                  hidden
                >
                  <div class="faq-answer-inner">
                    <p class="faq-answer-text">{faq.answer}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- More FAQs Button -->
        <div class="faq-more-wrap" id="faq-more-wrap">
          <a href="/faq/" class="home-button home-button-secondary faq-more-btn">
            <span>More FAQs</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Compact No-results -->
        <div class="faq-no-results" id="faq-no-results" style="display: none;">
          <p class="faq-no-results-title">We couldn’t find an answer to that.</p>
          <p class="faq-no-results-desc">Ask us your question and we’ll consider adding it to the FAQ.</p>
          <a href="#faq-submit-card" class="faq-no-results-link">Go to question submission ↓</a>
        </div>

        <!-- Question Submission Card -->
        <div class="home-card faq-submit-card" id="faq-submit-card">
          <div class="faq-submit-head">
            <h3 class="faq-submit-title">Didn’t find your question?</h3>
            <p class="faq-submit-desc">Ask us your question and we’ll consider adding it to the FAQ.</p>
          </div>
          <form id="faq-submit-form" class="faq-submit-form" novalidate>
            <div class="faq-input-group">
              <div class="faq-textarea-wrap">
                <label for="faq-question-input" class="sr-only">Type your question</label>
                <textarea
                  id="faq-question-input"
                  name="question"
                  class="faq-textarea"
                  rows="4"
                  placeholder="Type your question…"
                  required
                ></textarea>
                <button
                  type="button"
                  id="faq-expand-btn"
                  class="faq-textarea-expand-btn"
                  aria-label="Expand question editor"
                  title="Expand question editor"
                >
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="14" y1="10" x2="21" y2="3"></line>
                    <polyline points="9 3 3 3 3 9"></polyline>
                    <line x1="10" y1="10" x2="3" y2="3"></line>
                    <polyline points="15 21 21 21 21 15"></polyline>
                    <line x1="14" y1="14" x2="21" y2="21"></line>
                    <polyline points="9 21 3 21 3 15"></polyline>
                    <line x1="10" y1="14" x2="3" y2="21"></line>
                  </svg>
                </button>
              </div>
              <p id="faq-validation-msg" class="faq-validation-msg" role="alert" style="display: none;"></p>
            </div>
            <div class="faq-form-footer">
              <button type="button" id="faq-clear-btn" class="faq-action-btn faq-clear-btn" disabled>
                Clear
              </button>
              <button type="submit" id="faq-submit-btn" class="faq-action-btn faq-submit-btn" disabled>
                <span class="btn-text">Submit</span>
              </button>
            </div>
            <p id="faq-form-status" class="faq-form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- 9. FINAL CTA -->
    <section class="home-section final-cta-section">
      <div class="container narrow">
        <div class="home-cta-card">
          <div class="cta-text-content">
            <p class="home-capsule cta-capsule">START BUILDING</p>
            <h2 class="cta-title">Don’t just use the tools. Learn how to use them.</h2>
            <p class="cta-desc">
              Technology will keep changing. The valuable skill is knowing how to understand it, adapt to it, and create with it.
            </p>
          </div>
          <div class="cta-action-wrap">
            <a class="home-button home-button-cta" href="/resources/">
              <span>Explore Resources</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Expanded Question Submission Modal -->
    <div id="faq-modal-overlay" class="faq-modal-overlay" aria-hidden="true" style="display: none;">
      <div class="faq-modal-backdrop" id="faq-modal-backdrop"></div>
      <div
        class="faq-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="faq-modal-title"
      >
        <div class="faq-modal-nav-row">
          <button
            type="button"
            id="faq-modal-collapse-btn"
            class="faq-modal-collapse-btn"
            aria-label="Collapse question editor"
            title="Collapse question editor"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="4" x2="10" y2="10"></line>
              <polyline points="4 10 10 10 10 4"></polyline>
              <line x1="20" y1="4" x2="14" y2="10"></line>
              <polyline points="20 10 14 10 14 4"></polyline>
              <line x1="4" y1="20" x2="10" y2="14"></line>
              <polyline points="4 14 10 14 10 20"></polyline>
              <line x1="20" y1="20" x2="14" y2="14"></line>
              <polyline points="20 14 14 14 14 20"></polyline>
            </svg>
          </button>
        </div>

        <div class="faq-modal-header-text">
