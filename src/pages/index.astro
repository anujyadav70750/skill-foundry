---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../lib/resource';
import { FAQ_DATA } from '../data/faqs';

// Show only the selected homepage FAQs, in the requested order.
// The complete FAQ_DATA collection remains available on the dedicated FAQ page.
const homepageFaqIds = ['faq-1', 'faq-3', 'faq-9', 'faq-5', 'faq-2', 'faq-8'];
const homepageFaqs = homepageFaqIds
  .map((id) => FAQ_DATA.find((faq) => faq.id === id))
  .filter((faq): faq is (typeof FAQ_DATA)[number] => Boolean(faq));

// 1. DYNAMIC PUBLISHED RESOURCES (Show all published resources in horizontal carousel)
const allResources = await getCollection('resources');
const displayResources = allResources
  .filter((r) => !('draft' in r.data && r.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const resources = displayResources;

// 2. SKILLS & DISCIPLINES (Broad evergreen learning taxonomy based on content)
const skillsDisciplines = [
  {
    name: 'AI Video',
    filterCategory: 'AI Video',
    description: 'Generating cinematic motion, camera dynamics, and visual character continuity.',
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>`
  },
  {
    name: 'AI Image Creation',
    filterCategory: 'AI Image',
    description: 'Crafting consistent character references, visual styling, and asset generation.',
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>`
  },
  {
    name: 'Prompt Systems',
    filterCategory: 'Prompt Engineering',
    description: 'Structuring reusable prompt blueprints, model parameters, and scene directions.',
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>`
  },
  {
    name: 'Creative Workflows',
    filterCategory: 'Workflows',
    description: 'Connecting multi-stage pipelines from raw concept to final media deliverable.',
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="6" height="6" rx="1"></rect><rect x="16" y="3" width="6" height="6" rx="1"></rect><rect x="9" y="15" width="6" height="6" rx="1"></rect><path d="M5 9v3a2 2 0 0 0 2 2h5m0 0h5a2 2 0 0 0 2-2V9"></path><path d="M12 14v1"></path></svg>`
  },
  {
    name: 'AI Tools & Setup',
    filterCategory: 'AI Tools',
    description: 'Selecting and configuring verified creative software stacks and production environments.',
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>`
  },
  {
    name: 'Automation & Productivity',
    filterCategory: 'Projects',
    description: 'Streamlining repeatable production tasks and accelerating creative output.',
    iconSvg: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>`
  }
];

const formatUploadDate = (d: Date | string | undefined) => {
  if (!d) return '';
  const date = new Date(d);
  const day = date.getDate();
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
};
---

<BaseLayout 
  title="Skill Foundry — Learn Practical Skills, Workflows & Tools"
  description="Skill Foundry is a practical learning platform for building useful skills through structured resources, tutorials, and real-world workflows."
>
  <div class="home-page">
    <!-- SECTION 1 — WHAT SKILL FOUNDRY IS (HERO) -->
    <section class="home-hero">
      <div class="container narrow hero-content">
        <h1 class="hero-title">
          Build practical skills that work in the <span class="hero-highlight">real world.</span>
        </h1>
        <p class="hero-lead">
          Skill Foundry is a practical learning platform for building useful skills through structured resources, tutorials, and real-world workflows.
        </p>
        <div class="hero-actions">
          <a class="home-button home-button-primary" href="/resources/">Explore Resources</a>
        </div>
        <div class="hero-pillars-strip" aria-label="Key highlights">
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Beginner friendly</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Step-by-step blueprints</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Direct tool access</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item" title="All resources are tested and verified before publication"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Verified resources</span>
        </div>
      </div>
    </section>

    <!-- SECTION 2 — RECENT WORK -->
    <section class="home-section featured-section recent-work-section" id="recent-work">
      <div class="recent-work-container">
        <div class="recent-works-header">
          <a class="recent-works-header-link" href="/resources/" aria-label="View all resources">
            <h2 class="recent-works-title">Recent</h2>
            <svg class="recent-works-chevron" aria-hidden="true" viewBox="0 0 16 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 5L10 12L3 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>

        {displayResources.length > 0 ? (
          <div class="recent-work-carousel-wrapper">
            <button
              type="button"
              class="recent-work-nav-btn recent-work-prev"
              aria-label="Scroll recent works left"
              tabindex="-1"
            >
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </button>

            <div class="recent-work-carousel-track" id="recent-work-track" role="region" aria-label="Recent resources carousel">
              {displayResources.map((resource) => {
                const slug = resourceSlug(resource);
                const thumbnail = resourceThumbnail(resource);
                const alt = resourceImageAlt(resource);
                const dateStr = formatUploadDate(resource.data.date);

                return (
                  <a class="recent-work-card" href={`/resources/${slug}/`} aria-label={`Open ${resource.data.title}`}>
                    <div class="recent-work-thumb-wrap">
                      <img class="recent-work-thumb-img" src={thumbnail} alt={alt} loading="eager" decoding="async" />
                    </div>

                    <div class="recent-work-card-body">
                      <div class="recent-work-meta-row">
                        <span class="recent-work-meta-category">{resource.data.category}</span>
                        <span class="recent-work-meta-date">{dateStr}</span>
                      </div>
                      <h3 class="recent-work-card-title">{resource.data.title}</h3>
                    </div>
                  </a>
                );
              })}
            </div>

            <button
              type="button"
              class="recent-work-nav-btn recent-work-next"
              aria-label="Scroll recent works right"
              tabindex="-1"
            >
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        ) : (
          <div class="empty-state-box">
            <p class="empty-state-title">No published resources yet</p>
            <p class="empty-state-text">New step-by-step tutorials and verified workflows are currently being crafted. Check back soon.</p>
          </div>
        )}
      </div>
    </section>

    <!-- SECTION 3 — WHY SKILL FOUNDRY & WHY IT EXISTS -->
    <section class="home-section why-section" id="why-it-exists">
      <div class="container narrow">
        <div class="section-head">
          <h2>Skills you can understand, apply, and make your own</h2>
          <p class="section-subcopy">
            Skill Foundry exists to help people learn useful skills, apply those skills in real projects, and make work and life easier. We teach practical workflows that you can genuinely understand and adapt — not simply copy-paste without knowing how they work.
          </p>
        </div>

        <div class="promise-grid">
          <article class="home-card promise-card">
              <div class="promise-card-title-wrap"><h3 class="card-title">Understand how it works</h3></div>
            <p class="card-description">
              Learn the core principles, tool mechanics, and prompt logic behind each workflow so you gain genuine, reusable skills.
            </p>
          </article>

          <article class="home-card promise-card">
              <div class="promise-card-title-wrap"><h3 class="card-title">Apply in everyday work</h3></div>
            <p class="card-description">
              Put what you learn directly into practice on real projects, creative deliverables, and daily tasks to make work easier.
            </p>
          </article>

          <article class="home-card promise-card">
              <div class="promise-card-title-wrap"><h3 class="card-title">Adapt to your own needs</h3></div>
            <p class="card-description">
              Take proven workflows and customize them to your specific goals, different tools, and unique project requirements.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 4 — SKILLS & DISCIPLINES -->
    <section class="home-section skills-section" id="what-you-can-build">
      <div class="container narrow">
        <div class="section-head">
          <h2>What you can learn and build</h2>
          <p class="section-subcopy">
            Understand the core capabilities and skill sets you can master and apply across digital disciplines, from motion to automation.
          </p>
        </div>

        <div class="skills-tracks-grid">
          <a class="home-card skill-track-card" href="/resources/?category=AI%20Video" aria-label="Explore Video Editing & Motion resources">
            <div class="skill-track-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            </div>
            <div class="home-inner-title-wrap"><h3 class="card-title">Video Editing &amp; Motion</h3></div>
            <p class="card-description">
              Multi-clip assembly, pacing, audio synchronization, motion control, and professional editing workflows.
            </p>
          </a>

          <a class="home-card skill-track-card" href="/resources/?category=AI%20Image" aria-label="Explore Content Creation & Visuals resources">
            <div class="skill-track-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
            <div class="home-inner-title-wrap"><h3 class="card-title">Content Creation &amp; Visuals</h3></div>
            <p class="card-description">
              Consistent character styling, visual assets, brand imagery, and multi-format digital media production.
            </p>
          </a>

          <a class="home-card skill-track-card" href="/resources/?category=Prompt%20Engineering" aria-label="Explore AI Workflows & Prompting resources">
            <div class="skill-track-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83"/>
              </svg>
            </div>
            <div class="home-inner-title-wrap"><h3 class="card-title">AI Workflows &amp; Prompting</h3></div>
            <p class="card-description">
              Structured prompt blueprints, model parameters, generative tools, and connected creative pipelines.
            </p>
          </a>

          <a class="home-card skill-track-card" href="/resources/?category=Workflows" aria-label="Explore Automation & Productivity resources">
            <div class="skill-track-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <div class="home-inner-title-wrap"><h3 class="card-title">Automation &amp; Productivity</h3></div>
            <p class="card-description">
              Workflow orchestration, tool integration, execution shortcuts, and repeatable digital production systems.
            </p>
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 5 — HOW IT WORKS -->
    <section class="home-section method-section" id="how-it-works">
      <div class="container narrow">
        <div class="section-head">
          <h2>A clear path from idea to result</h2>
          <p class="section-subcopy">
            Follow a simple, beginner-friendly process designed to help you learn, execute, and adapt any workflow.
          </p>
        </div>

        <div class="steps-grid">
          <article class="home-card method-card">
            <div class="method-step-badge">01</div>
            <div class="home-inner-title-wrap"><h3 class="card-title">Find a practical topic or workflow</h3></div>
            <p class="card-description">
              Find a practical topic, skill or workflow relevant to what you want to create.
            </p>
          </article>

          <article class="home-card method-card">
            <div class="method-step-badge">02</div>
            <div class="home-inner-title-wrap"><h3 class="card-title">Follow the instructions</h3></div>
            <p class="card-description">
              Follow clear instructions, examples, prompts, and tool settings.
            </p>
          </article>

          <article class="home-card method-card">
            <div class="method-step-badge">03</div>
            <div class="home-inner-title-wrap"><h3 class="card-title">Apply and create a real result</h3></div>
            <p class="card-description">
              Apply what you learned and create a real, practical result for your own project.
            </p>
          </article>
        </div>
      </div>
    </section>



    <!-- SECTION 7 — WHY TRUST THE RESOURCES -->
    <section class="home-section trust-section" id="why-trust-the-resources">
      <div class="container narrow">
        <div class="section-head">
          <h2>Why trust Skill Foundry resources</h2>
          <p class="section-subcopy">
            Every blueprint and tutorial in our library is built for reliable, reproducible execution.
          </p>
        </div>

        <div class="promise-grid">
          <article class="home-card trust-card">
            <div class="home-inner-title-wrap"><h3 class="card-title">Tested before publication</h3></div>
            <p class="card-description">
              Every blueprint is tested end-to-end to ensure prompts, settings, and step sequences work as described.
            </p>
          </article>

          <article class="home-card trust-card">
            <div class="home-inner-title-wrap"><h3 class="card-title">Clear tool access</h3></div>
            <p class="card-description">
              We clearly specify required tools, free tiers, and alternatives so you know exact requirements upfront.
            </p>
          </article>

          <article class="home-card trust-card">
            <div class="home-inner-title-wrap"><h3 class="card-title">Built for execution</h3></div>
            <p class="card-description">
              No filler or endless theory. Clean, actionable instructions designed to help you finish real projects.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 8 — FREQUENTLY ASKED QUESTIONS (ACCORDION LAYOUT WITH PLUS CONTROLS) -->
    <section class="home-section faq-section" id="faq">
      <div class="container narrow">
        <div class="section-head faq-section-head">
          <div class="faq-section-heading-group">
            <a class="recent-works-header-link faq-section-title-link" href="/faq/" aria-label="View all frequently asked questions">
              <h2 class="recent-works-title">FAQs</h2>
              <svg class="recent-works-chevron" aria-hidden="true" viewBox="0 0 16 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 5L10 12L3 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </a>
            <p class="faq-section-desc">Find answers to common questions about Skill Foundry, its resources, and the tools we recommend.</p>
          </div>
        </div>

        <!-- FAQ Accordion List (Selected homepage questions only) -->
        <div class="faq-accordion-list" id="faq-list">
          {homepageFaqs.map((faq, index) => {
            const isDefaultPreview = true;
            return (
              <div
                class="faq-accordion-item"
                data-faq-id={faq.id}
                data-default-preview={isDefaultPreview ? "true" : "false"}
                style={isDefaultPreview ? "" : "display: none;"}
              >
                <button
                  type="button"
                  class="faq-accordion-trigger"
                  id={`faq-btn-${index}`}
                  aria-expanded="false"
                  aria-controls={`faq-content-${index}`}
                >
                  <span class="faq-question-text">{faq.question}</span>
                  <span class="faq-plus-control" aria-hidden="true">
                    <svg class="faq-plus-icon" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <line class="plus-v" x1="10" y1="4" x2="10" y2="16"></line>
                      <line class="plus-h" x1="4" y1="10" x2="16" y2="10"></line>
                    </svg>
                  </span>
                </button>
                <div
                  id={`faq-content-${index}`}
                  class="faq-accordion-panel"
                  role="region"
                  aria-labelledby={`faq-btn-${index}`}
                  hidden
                >
                  <div class="faq-answer-inner">
                    <p class="faq-answer-text">{faq.answer}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- Question submission CTA -->
        <div class="faq-support-cta">
          <h3 class="faq-support-title">Still have a question?</h3>
          <p class="faq-support-desc">If you couldn't find the answer you're looking for, contact our team. We're happy to help.</p>
          <button type="button" id="faq-open-question-modal" class="faq-support-button">Ask a Question</button>
        </div>
      </div>
    </section>

    <!-- SECTION 9 — FINAL CTA -->
    <section class="home-section final-cta-section">
      <div class="container narrow">
        <div class="home-cta-card">
          <div class="cta-text-content">
              <h2 class="cta-title">Build the skill, then make it your own.</h2>
            <p class="cta-desc">
              Explore practical resources, build useful skills, and put what you learn into practice.
            </p>
          </div>
          <div class="cta-action-wrap">
            <a class="home-button home-button-cta" href="/resources/">Explore resources →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Expanded Question Submission Modal (Tall Vertical Writing Panel) -->
    <div id="faq-modal-overlay" class="faq-modal-overlay" aria-hidden="true" style="display: none;">
      <div class="faq-modal-backdrop" id="faq-modal-backdrop"></div>
      <div
        class="faq-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="faq-modal-title"
      >
        <!-- Top Row: Collapse Button Aligned Right -->
        <div class="faq-modal-nav-row">
          <button
            type="button"
            id="faq-modal-collapse-btn"
            class="faq-modal-collapse-btn"
            aria-label="Collapse question editor"
            title="Collapse question editor"
          >
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="4" x2="10" y2="10"></line>
              <polyline points="4 10 10 10 10 4"></polyline>
              <line x1="20" y1="4" x2="14" y2="10"></line>
              <polyline points="20 10 14 10 14 4"></polyline>
              <line x1="4" y1="20" x2="10" y2="14"></line>
              <polyline points="4 14 10 14 10 20"></polyline>
              <line x1="20" y1="20" x2="14" y2="14"></line>
              <polyline points="20 14 14 14 14 20"></polyline>
            </svg>
          </button>
        </div>

        <!-- Title / Subtitle -->
        <div class="faq-modal-header-text">
          <h2 id="faq-modal-title" class="faq-modal-title">Ask a Question</h2>
          <p class="faq-modal-subtitle">Submit a question or workflow request to be considered for the FAQ.</p>
        </div>

        <form id="faq-modal-form" class="faq-modal-form" novalidate>
          <div class="faq-modal-body">
            <label for="faq-modal-question-input" class="sr-only">Write your question here</label>
            <textarea
              id="faq-modal-question-input"
              class="faq-modal-textarea"
              placeholder="Write your question, tool suggestion, or workflow request here in detail..."
              required
            ></textarea>
            <p id="faq-modal-validation-msg" class="faq-validation-msg" role="alert" style="display: none;"></p>
          </div>

          <div class="faq-modal-footer">
            <button type="button" id="faq-modal-clear-btn" class="faq-modal-action-btn faq-modal-clear-btn" disabled>
              Clear
            </button>
            <button type="submit" id="faq-modal-submit-btn" class="faq-modal-action-btn faq-modal-submit-btn" disabled>
              <span class="btn-text">Submit</span>
            </button>
          </div>
          <p id="faq-modal-status" class="faq-form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
