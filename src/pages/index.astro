---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../lib/resource';
import { FAQ_DATA } from '../data/faqs';

// Show approximately 10 important questions on the homepage
const homepageFaqs = FAQ_DATA.slice(0, 10);

// 1. DYNAMIC PUBLISHED RESOURCES
const resources = (await getCollection('resources')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = resources.filter((item) => item.data.featured);
const displayResources = resources;

// 2. DYNAMIC CATEGORIES (Display ONLY categories containing at least ONE published resource)
const categoryDescriptions = new Map<string, string>([
  ['AI Video', 'Character continuity, scene motion, multi-clip generation, and video assembly.'],
  ['AI Image', 'Character references, styling, outfit modification, and asset generation.'],
  ['Prompt Engineering', 'Step-by-step prompt structures, camera parameters, and scene directions.'],
  ['AI Tools', 'Verified official tools, recommended setups, and direct access links.'],
  ['Workflows', 'Connected end-to-end pipelines from raw input to final deliverable.'],
  ['Projects', 'Real-world creative assets and practical outputs built with modern digital stacks.']
]);

const categoryColors = new Map<string, { bg: string; border: string; text: string; lightBg: string; lightBorder: string; lightText: string }>([
  ['AI Video', { bg: 'rgba(6, 182, 212, 0.12)', border: 'rgba(6, 182, 212, 0.35)', text: '#38BDF8', lightBg: 'rgba(2, 132, 199, 0.08)', lightBorder: 'rgba(2, 132, 199, 0.28)', lightText: '#0284C7' }],
  ['AI Image', { bg: 'rgba(129, 140, 248, 0.12)', border: 'rgba(129, 140, 248, 0.35)', text: '#A5B4FC', lightBg: 'rgba(99, 102, 241, 0.08)', lightBorder: 'rgba(99, 102, 241, 0.28)', lightText: '#4F46E5' }],
  ['Prompt Engineering', { bg: 'rgba(245, 158, 11, 0.12)', border: 'rgba(245, 158, 11, 0.35)', text: '#FBBF24', lightBg: 'rgba(217, 119, 6, 0.08)', lightBorder: 'rgba(217, 119, 6, 0.28)', lightText: '#D97706' }],
  ['AI Tools', { bg: 'rgba(16, 185, 129, 0.12)', border: 'rgba(16, 185, 129, 0.35)', text: '#34D399', lightBg: 'rgba(16, 185, 129, 0.08)', lightBorder: 'rgba(16, 185, 129, 0.28)', lightText: '#059669' }],
  ['Workflows', { bg: 'rgba(56, 189, 248, 0.12)', border: 'rgba(56, 189, 248, 0.35)', text: '#38BDF8', lightBg: 'rgba(2, 132, 199, 0.08)', lightBorder: 'rgba(2, 132, 199, 0.28)', lightText: '#0284C7' }],
  ['Projects', { bg: 'rgba(244, 63, 94, 0.12)', border: 'rgba(244, 63, 94, 0.35)', text: '#FB7185', lightBg: 'rgba(225, 29, 72, 0.08)', lightBorder: 'rgba(225, 29, 72, 0.28)', lightText: '#E11D48' }]
]);

const defaultColor = { bg: 'rgba(56, 189, 248, 0.12)', border: 'rgba(56, 189, 248, 0.35)', text: '#38BDF8', lightBg: 'rgba(2, 132, 199, 0.08)', lightBorder: 'rgba(2, 132, 199, 0.28)', lightText: '#0284C7' };

const categoryCounts = new Map<string, number>();
resources.forEach((resource) => {
  const cat = resource.data.category?.trim();
  if (cat) {
    categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
  }
});

const dynamicCategories = Array.from(categoryCounts.entries())
  .filter(([_, count]) => count > 0)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, count]) => {
    let description = categoryDescriptions.get(name);
    if (!description) {
      const sample = resources.find((r) => r.data.category?.trim() === name);
      description = sample?.data.description || `Practical skills and workflows for ${name}.`;
    }
    const color = categoryColors.get(name) || defaultColor;
    return { name, count, description, color };
  });

const formatUploadDate = (d: Date | string | undefined) => {
  if (!d) return '';
  const date = new Date(d);
  const day = date.getDate();
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
};
---

<BaseLayout 
  title="Skill Foundry — Learn Practical Skills, Workflows & Tools"
  description="Skill Foundry is a practical learning platform for building useful skills through structured resources, tutorials, and real-world workflows."
>
  <div class="home-page">
    <!-- SECTION 1 — WHAT SKILL FOUNDRY IS (HERO) -->
    <section class="home-hero">
      <div class="container narrow hero-content">
        <div class="hero-capsule-row">
          <span class="home-capsule">PRACTICAL SKILLS PLATFORM</span>
        </div>
        <h1 class="hero-title">
          Build practical skills that work in the <span class="hero-highlight">real world.</span>
        </h1>
        <p class="hero-lead">
          Skill Foundry is a practical learning platform for building useful skills through structured resources, tutorials, and real-world workflows.
        </p>
        <div class="hero-actions">
          <a class="home-button home-button-primary" href="/resources/">Explore Resources</a>
        </div>
        <div class="hero-pillars-strip" aria-label="Key highlights">
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Beginner friendly</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Step-by-step blueprints</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Direct tool access</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item" title="All resources are tested and verified before publication"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Verified resources</span>
        </div>
      </div>
    </section>

    <!-- SECTION 2 — RECENT WORK -->
    <section class="home-section featured-section recent-work-section" id="recent-work">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">RECENT WORK</p>
          <h2>What we're currently building</h2>
          <p class="section-subcopy">
            Real, practical resources and workflows recently built and verified by Skill Foundry.
          </p>
        </div>

        {displayResources.length > 0 ? (
          <div class="featured-wrap">
            <div class="featured-grid">
              {displayResources.map((resource) => {
                const slug = resourceSlug(resource);
                const thumbnail = resourceThumbnail(resource);
                const alt = resourceImageAlt(resource);

                return (
                  <a class="home-card resource-display-card resource-card-clickable" href={`/resources/${slug}/`} aria-label={`Open ${resource.data.title}`}>
                    <div class="resource-thumb-wrap">
                      <img class="resource-thumb-img" src={thumbnail} alt={alt} loading="lazy" />
                    </div>

                    <div class="resource-card-body">
                      <div class="resource-card-meta">
                        <span class="resource-meta-category">{resource.data.category}</span>
                        <span class="resource-meta-date">{formatUploadDate(resource.data.date)}</span>
                      </div>

                      <h3 class="resource-card-title">
                        {resource.data.title}
                      </h3>
                      <p class="resource-card-desc">{resource.data.description}</p>
                    </div>
                  </a>
                );
              })}
            </div>

            <!-- Right-aligned "View all recent work →" capsule button -->
            <div class="featured-bottom-bar">
              <a class="all-resources-capsule-btn" href="/resources/">
                <span>View all recent work</span>
                <span class="btn-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </div>
        ) : (
          <div class="empty-state-box">
            <p class="empty-state-title">No published resources yet</p>
            <p class="empty-state-text">New step-by-step tutorials and verified workflows are currently being crafted. Check back soon.</p>
          </div>
        )}
      </div>
    </section>

    <!-- SECTION 3 — WHY SKILL FOUNDRY & WHY IT EXISTS -->
    <section class="home-section why-section" id="why-it-exists">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">WHY IT EXISTS</p>
          <h2>Skills you can understand, apply, and make your own</h2>
          <p class="section-subcopy">
            Skill Foundry exists to help people learn useful skills, apply those skills in real projects, and make work and life easier. We teach practical workflows that you can genuinely understand and adapt — not simply copy-paste without knowing how they work.
          </p>
        </div>

        <div class="promise-grid">
          <article class="home-card promise-card">
            <div class="promise-card-capsule">01 • UNDERSTAND THE LOGIC</div>
            <h3 class="card-title">Understand how it works</h3>
            <p class="card-description">
              Learn the core principles, tool mechanics, and prompt logic behind each workflow so you gain genuine, reusable skills.
            </p>
          </article>

          <article class="home-card promise-card">
            <div class="promise-card-capsule">02 • REAL APPLICATION</div>
            <h3 class="card-title">Apply in everyday work</h3>
            <p class="card-description">
              Put what you learn directly into practice on real projects, creative deliverables, and daily tasks to make work easier.
            </p>
          </article>

          <article class="home-card promise-card">
            <div class="promise-card-capsule">03 • FLEXIBLE ADAPTATION</div>
            <h3 class="card-title">Adapt to your own needs</h3>
            <p class="card-description">
              Take proven workflows and customize them to your specific goals, different tools, and unique project requirements.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 4 — WHAT YOU CAN LEARN / BUILD -->
    <section class="home-section skills-section" id="what-you-can-build">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">SKILLS &amp; DISCIPLINES</p>
          <h2>What you can learn and build</h2>
          <p class="section-subcopy">
            Understand the core capabilities and practical skill sets you can master and apply across digital disciplines, from video and motion to content creation and automation.
          </p>
        </div>

        <div class="skills-tracks-grid">
          <div class="home-card skill-track-card">
            <div class="skill-track-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            </div>
            <h3 class="card-title">Video Editing &amp; Motion</h3>
            <p class="card-description">
              Multi-clip assembly, pacing, audio synchronization, motion control, and professional editing workflows.
            </p>
          </div>

          <div class="home-card skill-track-card">
            <div class="skill-track-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
            <h3 class="card-title">Content Creation &amp; Visuals</h3>
            <p class="card-description">
              Consistent character styling, visual assets, brand imagery, and multi-format digital media production.
            </p>
          </div>

          <div class="home-card skill-track-card">
            <div class="skill-track-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
              </svg>
            </div>
            <h3 class="card-title">AI Workflows &amp; Prompting</h3>
            <p class="card-description">
              Structured prompt blueprints, model parameters, generative tools, and connected creative pipelines.
            </p>
          </div>

          <div class="home-card skill-track-card">
            <div class="skill-track-icon">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
            </div>
            <h3 class="card-title">Automation &amp; Productivity</h3>
            <p class="card-description">
              Workflow orchestration, tool integration, execution shortcuts, and repeatable digital production systems.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 5 — HOW IT WORKS -->
    <section class="home-section method-section" id="how-it-works">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">HOW IT WORKS</p>
          <h2>A clear path from idea to result</h2>
          <p class="section-subcopy">
            Follow a simple, beginner-friendly process designed to help you learn, execute, and adapt any workflow.
          </p>
        </div>

        <div class="steps-grid">
          <article class="home-card method-card">
            <div class="method-step-badge">01</div>
            <div class="method-subcapsule">FIND</div>
            <h3 class="card-title">Find a practical topic or workflow</h3>
            <p class="card-description">
              Find a practical topic, skill or workflow relevant to what you want to create.
            </p>
          </article>

          <article class="home-card method-card">
            <div class="method-step-badge">02</div>
            <div class="method-subcapsule">FOLLOW</div>
            <h3 class="card-title">Follow the instructions</h3>
            <p class="card-description">
              Follow clear instructions, examples, prompts, and tool settings.
            </p>
          </article>

          <article class="home-card method-card">
            <div class="method-step-badge">03</div>
            <div class="method-subcapsule">BUILD</div>
            <h3 class="card-title">Apply and create a real result</h3>
            <p class="card-description">
              Apply what you learned and create a real, practical result for your own project.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 6 — EXPLORE BY CATEGORY (Capsule Tags) -->
    {dynamicCategories.length > 0 && (
      <section class="home-section categories-section" id="categories">
        <div class="container narrow">
          <div class="section-head">
            <p class="home-capsule">EXPLORE BY CATEGORY</p>
            <h2>Find what you want to build</h2>
            <p class="section-subcopy">
              Browse practical resources, tutorials, and blueprints organized by creative domain and production discipline.
            </p>
          </div>

          <div class="categories-grid">
            {dynamicCategories.map((cat) => (
              <a class="home-card category-card" href={`/resources/?category=${encodeURIComponent(cat.name)}`}>
                <div class="category-card-top">
                  <span
                    class="category-capsule-tag"
                    style={`--cat-bg: ${cat.color.bg}; --cat-border: ${cat.color.border}; --cat-text: ${cat.color.text}; --cat-light-bg: ${cat.color.lightBg}; --cat-light-border: ${cat.color.lightBorder}; --cat-light-text: ${cat.color.lightText};`}
                  >
                    {cat.name}
                  </span>
                  <span class="category-tag-count">{cat.count} resource{cat.count === 1 ? '' : 's'}</span>
                </div>
                <p class="category-desc">{cat.description}</p>
                <div class="category-card-bottom">
                  <span class="category-explore-capsule-btn">
                    <span>Explore category</span>
                    <span class="btn-arrow" aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- SECTION 7 — WHY TRUST THE RESOURCES -->
    <section class="home-section trust-section" id="why-trust-the-resources">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">VERIFIED QUALITY</p>
          <h2>Why trust Skill Foundry resources</h2>
          <p class="section-subcopy">
            Every blueprint and tutorial in our library is built for reliable, reproducible execution.
          </p>
        </div>

        <div class="promise-grid">
          <article class="home-card trust-card">
            <div class="trust-card-capsule">01 • HANDS-ON VERIFIED</div>
            <h3 class="card-title">Tested before publication</h3>
            <p class="card-description">
              Every blueprint is tested end-to-end to ensure prompts, settings, and step sequences work as described.
            </p>
          </article>

          <article class="home-card trust-card">
            <div class="trust-card-capsule">02 • TOOL TRANSPARENCY</div>
            <h3 class="card-title">Clear tool access</h3>
            <p class="card-description">
              We clearly specify required tools, free tiers, and alternatives so you know exact requirements upfront.
            </p>
          </article>

          <article class="home-card trust-card">
            <div class="trust-card-capsule">03 • ZERO FLUFF</div>
            <h3 class="card-title">Built for execution</h3>
            <p class="card-description">
              No filler or endless theory. Clean, actionable instructions designed to help you finish real projects.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 8 — FREQUENTLY ASKED QUESTIONS (ACCORDION LAYOUT WITH PLUS CONTROLS) -->
    <section class="home-section faq-section" id="faq">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">FREQUENTLY ASKED</p>
          <h2>Questions you might have</h2>
          <p class="section-subcopy">
            Quick answers to common questions about Skill Foundry, our resources, and how to use them.
          </p>
        </div>

        <!-- FAQ Search -->
        <div class="faq-search-wrap">
          <label for="faq-search-input" class="sr-only">Search for a question or topic</label>
          <div class="faq-search-field">
            <span class="faq-search-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="9" r="6"></circle>
                <line x1="13.5" y1="13.5" x2="18" y2="18"></line>
              </svg>
            </span>
            <input
              type="search"
              id="faq-search-input"
              class="faq-search-input"
              placeholder="Search for a question or topic…"
              autocomplete="off"
              spellcheck="false"
            />
            <button
              type="button"
              id="faq-search-clear"
              class="faq-search-clear"
              aria-label="Clear search query"
              style="display: none;"
            >
              <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="5" x2="15" y2="15"></line>
                <line x1="15" y1="5" x2="5" y2="15"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- FAQ Accordion List (Complete FAQ dataset: first 10 shown by default, all searchable) -->
        <div class="faq-accordion-list" id="faq-list">
          {FAQ_DATA.map((faq, index) => {
            const isDefaultPreview = index < 10;
            return (
              <div
                class="faq-accordion-item"
                data-faq-id={faq.id}
                data-default-preview={isDefaultPreview ? "true" : "false"}
                style={isDefaultPreview ? "" : "display: none;"}
              >
                <button
                  type="button"
                  class="faq-accordion-trigger"
                  id={`faq-btn-${index}`}
                  aria-expanded="false"
                  aria-controls={`faq-content-${index}`}
                >
                  <span class="faq-question-text">{faq.question}</span>
                  <span class="faq-plus-control" aria-hidden="true">
                    <svg class="faq-plus-icon" viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <line class="plus-v" x1="10" y1="4" x2="10" y2="16"></line>
                      <line class="plus-h" x1="4" y1="10" x2="16" y2="10"></line>
                    </svg>
                  </span>
                </button>
                <div
                  id={`faq-content-${index}`}
                  class="faq-accordion-panel"
                  role="region"
                  aria-labelledby={`faq-btn-${index}`}
                  hidden
                >
                  <div class="faq-answer-inner">
                    <p class="faq-answer-text">{faq.answer}</p>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- More FAQs Link -->
        <div class="faq-more-wrap" id="faq-more-wrap">
          <a href="/faq/" class="home-button home-button-secondary faq-more-btn">
            <span>More FAQs</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Compact No-result State -->
        <div class="faq-no-results" id="faq-no-results" style="display: none;">
          <p class="faq-no-results-title">We couldn’t find an answer to that.</p>
          <p class="faq-no-results-desc">Ask us your question and we’ll consider adding it to the FAQ.</p>
          <a href="#faq-submit-card" class="faq-no-results-link">Go to question submission ↓</a>
        </div>

        <!-- Question Submission Card -->
        <div class="home-card faq-submit-card" id="faq-submit-card">
          <div class="faq-submit-head">
            <h3 class="faq-submit-title">Didn’t find your question?</h3>
            <p class="faq-submit-desc">Ask us your question and we’ll consider adding it to the FAQ.</p>
          </div>
          <form id="faq-submit-form" class="faq-submit-form" novalidate>
            <div class="faq-input-group">
              <div class="faq-textarea-wrap">
                <label for="faq-question-input" class="sr-only">Type your question</label>
                <textarea
                  id="faq-question-input"
                  name="question"
                  class="faq-textarea"
                  rows="5"
                  placeholder="Type your question…"
                  required
                ></textarea>
                <button
                  type="button"
                  id="faq-expand-btn"
                  class="faq-textarea-expand-btn"
                  aria-label="Expand question editor"
                  title="Expand question editor"
                >
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="14" y1="10" x2="21" y2="3"></line>
                    <polyline points="9 3 3 3 3 9"></polyline>
                    <line x1="10" y1="10" x2="3" y2="3"></line>
                    <polyline points="15 21 21 21 21 15"></polyline>
                    <line x1="14" y1="14" x2="21" y2="21"></line>
                    <polyline points="9 21 3 21 3 15"></polyline>
                    <line x1="10" y1="14" x2="3" y2="21"></line>
