---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../lib/resource';
import { FAQ_DATA } from '../data/faqs';

const homepageFaqs = FAQ_DATA.slice(0, 4);

// 1. DYNAMIC PUBLISHED RESOURCES
const resources = (await getCollection('resources')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = resources.filter((item) => item.data.featured);
const displayResources = featured.length > 0 ? featured : resources.slice(0, 3);

// 2. DYNAMIC CATEGORIES (Display ONLY categories containing at least ONE published resource)
const categoryDescriptions = new Map<string, string>([
  ['AI Video', 'Character continuity, scene motion, multi-clip generation, and video assembly.'],
  ['AI Image', 'Character references, styling, outfit modification, and asset generation.'],
  ['Prompt Engineering', 'Step-by-step prompt structures, camera parameters, and scene directions.'],
  ['AI Tools', 'Verified official tools, recommended setups, and direct access links.'],
  ['Workflows', 'Connected end-to-end pipelines from raw input to final deliverable.'],
  ['Projects', 'Real-world creative assets and practical outputs built with modern AI stacks.']
]);

const categoryCounts = new Map<string, number>();
resources.forEach((resource) => {
  const cat = resource.data.category?.trim();
  if (cat) {
    categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
  }
});

const dynamicCategories = Array.from(categoryCounts.entries())
  .filter(([_, count]) => count > 0)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, count]) => {
    let description = categoryDescriptions.get(name);
    if (!description) {
      const sample = resources.find((r) => r.data.category?.trim() === name);
      description = sample?.data.description || `Practical AI skills and workflows for ${name}.`;
    }
    return { name, count, description };
  });

const formatUploadDate = (d: Date | string | undefined) => {
  if (!d) return '';
  const date = new Date(d);
  const day = date.getDate();
  const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const month = months[date.getMonth()];
  const year = date.getFullYear();
  return `${day} ${month} ${year}`;
};

const toolLogo = (name: string) => {
  const raw = (name || '').toLowerCase();
  if (raw.includes('flow')) return '/google-flow-icon.svg';
  if (raw.includes('capcut')) return '/capcut-icon.svg';
  return '/skill-foundry-resource-icon.svg';
};
---

<BaseLayout 
  title="Skill Foundry — Learn Practical AI Skills, Workflows & Tools"
  description="Learn practical AI skills through clear, beginner-friendly tutorials, step-by-step workflows, and direct access to the tools you need."
>
  <div class="home-page">
    <!-- SECTION 1 — HERO -->
    <section class="home-hero">
      <div class="container narrow hero-content">
        <div class="hero-capsule-row">
          <span class="home-capsule">PRACTICAL AI LEARNING</span>
        </div>
        <h1 class="hero-title">
          Build practical AI skills that work in the <span class="hero-highlight">real world.</span>
        </h1>
        <p class="hero-lead">
          Learn practical AI skills through clear, beginner-friendly tutorials, step-by-step workflows, and direct access to the tools you need.
        </p>
        <div class="hero-actions">
          <a class="home-button home-button-primary" href="/resources/">Explore Resources</a>
        </div>
        <div class="hero-pillars-strip" aria-label="Key highlights">
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Beginner friendly</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Step-by-step blueprints</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Direct tool access</span>
          <span class="pillar-dot" aria-hidden="true">•</span>
          <span class="pillar-item"><svg class="pillar-check" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M13.78 4.22a.75.75 0 010 1.06l-7.25 7.25a.75.75 0 01-1.06 0L2.22 9.28a.75.75 0 011.06-1.06L6 10.94l6.72-6.72a.75.75 0 011.06 0z"/></svg> Real examples</span>
        </div>
      </div>
    </section>

    <!-- SECTION 2 — WHY SKILL FOUNDRY / THE PROMISE -->
    <section class="home-section promise-section">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">THE PROMISE</p>
          <h2>Learn and actually use AI</h2>
          <p class="section-subcopy">
            No complicated theory or guesswork. Everything is structured so you know exactly where to begin and how to finish.
          </p>
        </div>

        <div class="promise-grid">
          <article class="home-card promise-card">
            <div class="promise-card-capsule">01 • CLARITY FIRST</div>
            <h3 class="card-title">Learn step by step</h3>
            <p class="card-description">
              Complex workflows are broken into clear beginner-friendly steps.
            </p>
          </article>

          <article class="home-card promise-card">
            <div class="promise-card-capsule">02 • DIRECT ACCESS</div>
            <h3 class="card-title">Use the right tools</h3>
            <p class="card-description">
              Each resource identifies the tools required for that workflow and provides direct access where appropriate.
            </p>
          </article>

          <article class="home-card promise-card">
            <div class="promise-card-capsule">03 • REAL OUTPUTS</div>
            <h3 class="card-title">Build real projects</h3>
            <p class="card-description">
              Users learn through practical workflows and projects rather than only theory.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 3 — FEATURED / LATEST RESOURCES -->
    <section class="home-section featured-section" id="featured">
      <div class="container narrow">
        <div class="section-head">
          <div class="section-head-split">
            <div>
              <p class="home-capsule">CURATED BLUEPRINTS</p>
              <h2>Featured resources</h2>
              <p class="section-subcopy">
                Complete workflows with exact prompts, tool parameters, and verified outputs.
              </p>
            </div>
            {resources.length > 0 && <a class="head-view-all" href="/resources/">View all resources →</a>}
          </div>
        </div>

        {displayResources.length > 0 ? (
          <div class="featured-grid">
            {displayResources.map((resource) => {
              const slug = resourceSlug(resource);
              const thumbnail = resourceThumbnail(resource);
              const alt = resourceImageAlt(resource);

              return (
                <article class="home-card resource-display-card">
                  <a class="resource-thumb-wrap" href={`/resources/${slug}/`} aria-label={`Open ${resource.data.title}`}>
                    <img class="resource-thumb-img" src={thumbnail} alt={alt} loading="lazy" />
                  </a>

                  <div class="resource-card-body">
                    <div class="resource-card-meta">
                      <span class="resource-meta-category">{resource.data.category}</span>
                      <span class="resource-meta-date">{formatUploadDate(resource.data.date)}</span>
                    </div>

                    <h3 class="resource-card-title">
                      <a href={`/resources/${slug}/`}>{resource.data.title}</a>
                    </h3>
                    <p class="resource-card-desc">{resource.data.description}</p>

                    <div class="resource-card-footer">
                      <a class="resource-cta-btn" href={`/resources/${slug}/`}>
                        View Resource
                        <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                        </svg>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="empty-state-box">
            <p class="empty-state-title">No published resources yet</p>
            <p class="empty-state-text">New step-by-step tutorials and verified workflows are currently being crafted. Check back soon.</p>
          </div>
        )}
      </div>
    </section>

    <!-- SECTION 4 — HOW IT WORKS -->
    <section class="home-section method-section" id="how-it-works">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">HOW IT WORKS</p>
          <h2>A clear path from idea to result</h2>
          <p class="section-subcopy">
            Follow a simple, repeatable process designed specifically for beginners and creators.
          </p>
        </div>

        <div class="steps-grid">
          <article class="home-card method-card">
            <div class="method-step-badge">01</div>
            <div class="method-subcapsule">FIND</div>
            <h3 class="card-title">Find a practical AI topic or workflow</h3>
            <p class="card-description">
              Choose a practical topic or guided workflow matched to what you want to create.
            </p>
          </article>

          <article class="home-card method-card">
            <div class="method-step-badge">02</div>
            <div class="method-subcapsule">FOLLOW</div>
            <h3 class="card-title">Follow the instructions</h3>
            <p class="card-description">
              Follow the beginner-friendly instructions, prompts and settings.
            </p>
          </article>

          <article class="home-card method-card">
            <div class="method-step-badge">03</div>
            <div class="method-subcapsule">BUILD</div>
            <h3 class="card-title">Apply and create a real result</h3>
            <p class="card-description">
              Apply the workflow and create a real result.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- SECTION 5 — EXPLORE BY CATEGORY (Dynamic: Display category ONLY when at least one published resource belongs to it) -->
    {dynamicCategories.length > 0 && (
      <section class="home-section categories-section" id="categories">
        <div class="container narrow">
          <div class="section-head">
            <p class="home-capsule">EXPLORE BY CATEGORY</p>
            <h2>Find what you want to build</h2>
            <p class="section-subcopy">
              Browse practical AI resources organized by creative domain and production discipline.
            </p>
          </div>

          <div class="categories-grid">
            {dynamicCategories.map((cat) => (
              <a class="home-card category-card" href={`/resources/?category=${encodeURIComponent(cat.name)}`}>
                <div class="category-card-top">
                  <span class="category-tag-name">{cat.name}</span>
                  <span class="category-tag-count">{cat.count} resource{cat.count === 1 ? '' : 's'}</span>
                </div>
                <p class="category-desc">{cat.description}</p>
                <div class="category-card-bottom">
                  <span class="category-explore-link">Explore category →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- SECTION 6 — FREQUENTLY ASKED QUESTIONS -->
    <section class="home-section faq-section" id="faq">
      <div class="container narrow">
        <div class="section-head">
          <p class="home-capsule">FREQUENTLY ASKED</p>
          <h2>Questions you might have</h2>
          <p class="section-subcopy">
            Quick answers to common questions about Skill Foundry, its resources, and how to use them.
          </p>
        </div>

        <!-- FAQ Search (Order: label → heading → description → search field → FAQ cards) -->
        <div class="faq-search-wrap">
          <label for="faq-search-input" class="sr-only">Search for a question or topic</label>
          <div class="faq-search-field">
            <span class="faq-search-icon" aria-hidden="true">
              <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="9" r="6"></circle>
                <line x1="13.5" y1="13.5" x2="18" y2="18"></line>
              </svg>
            </span>
            <input
              type="search"
              id="faq-search-input"
              class="faq-search-input"
              placeholder="Search for a question or topic…"
              autocomplete="off"
              spellcheck="false"
            />
            <button
              type="button"
              id="faq-search-clear"
              class="faq-search-clear"
              aria-label="Clear search query"
              style="display: none;"
            >
              <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="5" x2="15" y2="15"></line>
                <line x1="15" y1="5" x2="5" y2="15"></line>
              </svg>
            </button>
          </div>
        </div>

        <!-- FAQ Cards List (Fully visible static cards from canonical FAQ dataset) -->
        <div class="faq-list" id="faq-list">
          {homepageFaqs.map((faq) => (
            <article class="home-card faq-card">
              <h3 class="faq-question">{faq.question}</h3>
              <p class="faq-answer">{faq.answer}</p>
            </article>
          ))}
        </div>

        <!-- More FAQs CTA Button (opens dedicated FAQ page) -->
        <div class="faq-more-wrap" id="faq-more-wrap">
          <a href="/faq/" class="home-button home-button-secondary faq-more-btn">
            <span>More FAQs</span>
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <!-- Compact No-result State -->
        <div class="faq-no-results" id="faq-no-results" style="display: none;">
          <p class="faq-no-results-title">We couldn’t find an answer to that.</p>
          <p class="faq-no-results-desc">Ask us your question and we’ll consider adding it to the FAQ.</p>
          <a href="#faq-submit-card" class="faq-no-results-link">Go to question submission ↓</a>
        </div>

        <!-- Question Submission Card (Separate professional card before START BUILDING CTA) -->
        <div class="home-card faq-submit-card" id="faq-submit-card">
          <script is:inline>
            (function() {
              function positionFaqImmediately() {
                var isFaqReturn = false;
                try {
                  if (sessionStorage.getItem('sf_back_to_faq') === 'true') isFaqReturn = true;
                } catch (e) {}
                if (typeof window !== 'undefined' && (window.location.hash === '#faq-submit-card' || window.location.hash === '#faq')) {
                  isFaqReturn = true;
                }
                if (!isFaqReturn) return;

                var targetCard = document.getElementById('faq-submit-card') || document.getElementById('faq');
                if (targetCard) {
                  targetCard.scrollIntoView({ behavior: 'auto', block: 'center' });
                }
                try {
                  sessionStorage.removeItem('sf_back_to_faq');
                } catch (e) {}
                document.documentElement.classList.remove('jump-to-faq-pending');
              }

              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', positionFaqImmediately, { once: true });
              } else {
                positionFaqImmediately();
              }
            })();
          </script>
          <div class="faq-submit-head">
            <h3 class="faq-submit-title">Didn’t find your question?</h3>
            <p class="faq-submit-desc">Ask us your question and we’ll consider adding it to the FAQ.</p>
          </div>
          <form id="faq-submit-form" class="faq-submit-form" novalidate>
            <div class="faq-input-group">
              <div class="faq-textarea-wrap">
                <label for="faq-question-input" class="sr-only">Type your question</label>
                <textarea
                  id="faq-question-input"
                  name="question"
                  class="faq-textarea"
                  rows="5"
                  placeholder="Type your question…"
                  required
                ></textarea>
                <button
                  type="button"
                  id="faq-expand-btn"
                  class="faq-textarea-expand-btn"
                  aria-label="Expand question editor"
                  title="Expand question editor"
                >
                  <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M13 3h4v4M7 17H3v-4M17 3l-6 6M3 17l6-6"/>
                  </svg>
                  <span class="sr-only">Expand editor</span>
                </button>
              </div>
              <p id="faq-validation-msg" class="faq-validation-msg" role="alert" style="display: none;"></p>
            </div>
            <div class="faq-form-footer">
              <button type="button" id="faq-clear-btn" class="faq-action-btn faq-clear-btn" disabled>
                Clear
              </button>
              <button type="submit" id="faq-submit-btn" class="faq-action-btn faq-submit-btn" disabled>
                <span class="btn-text">Submit</span>
              </button>
            </div>
            <p id="faq-form-status" class="faq-form-status" role="status" aria-live="polite"></p>
          </form>
        </div>
      </div>
    </section>

    <!-- SECTION 7 — FINAL CTA -->
    <section class="home-section final-cta-section">
      <div class="container narrow">
        <div class="home-cta-card">
          <div class="cta-text-content">
            <p class="home-capsule cta-capsule">START BUILDING</p>
            <h2 class="cta-title">Build the skill. Then make it your own.</h2>
            <p class="cta-desc">
              Explore practical AI resources, follow clear workflows, and start building.
            </p>
          </div>
          <div class="cta-action-wrap">
            <a class="home-button home-button-cta" href="/resources/">Explore Resources →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Expanded Question Submission Modal (Exact same modal as FAQ page) -->
    <div id="faq-modal-overlay" class="faq-modal-overlay" aria-hidden="true" style="display: none;">
      <div class="faq-modal-backdrop" id="faq-modal-backdrop"></div>
      <div
        class="faq-modal-dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="faq-modal-title"
      >
        <!-- Top Navigation Row: Back (left) only -->
        <div class="faq-modal-nav-row">
          <button
            type="button"
            id="faq-modal-back-btn"
            class="faq-modal-nav-back"
            aria-label="Back to FAQ"
          >
            <svg class="faq-modal-nav-chevron" viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10 13L5 8l5-5"/>
            </svg>
            <span>Back</span>
          </button>
        </div>

        <!-- Title / Subtitle -->
        <div class="faq-modal-header-text">
          <h2 id="faq-modal-title" class="faq-modal-title">Ask a Question</h2>
          <p class="faq-modal-subtitle">Submit a question or workflow request to be considered for the FAQ.</p>
        </div>

        <form id="faq-modal-form" class="faq-modal-form" novalidate>
          <div class="faq-modal-body">
            <label for="faq-modal-question-input" class="sr-only">Write your question here</label>
            <textarea
              id="faq-modal-question-input"
              class="faq-modal-textarea"
              placeholder="Write your question, tool suggestion, or workflow request here in detail..."
              required
            ></textarea>
            <p id="faq-modal-validation-msg" class="faq-validation-msg" role="alert" style="display: none;"></p>
          </div>

          <div class="faq-modal-footer">
            <button type="button" id="faq-modal-clear-btn" class="faq-modal-action-btn faq-modal-clear-btn" disabled>
              Clear
            </button>
            <button type="submit" id="faq-modal-submit-btn" class="faq-modal-action-btn faq-modal-submit-btn" disabled>
              <span class="btn-text">Submit</span>
            </button>
          </div>
          <p id="faq-modal-status" class="faq-form-status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     SKILL FOUNDRY HOME PAGE STYLES — Scoped exclusively to .home-page
     Design language matches the established Resource Detail dark luxury aesthetic:
     - Serif display headings (Newsreader)
     - JetBrains Mono badges/capsules
     - Deep navy cards with subtle cyan glow & 1px borders
     - Exact capsule -> 16px -> title -> 12px -> description spacing rhythm
     ========================================================================== */

  .home-page {
    /* Keep the navigation surroundings and hero on one continuous visual surface. */
    background:
      radial-gradient(ellipse 80% 55% at 50% -10%, rgba(56, 189, 248, 0.15) 0%, transparent 60%),
      radial-gradient(circle at 80% 20%, rgba(255, 102, 0, 0.08) 0%, transparent 40%),
      #080D14;
    color: #F8FAFC;
    min-height: 100vh;
    padding-top: var(--header-height);
    margin-top: calc(-1 * var(--header-height));
    padding-bottom: 0;
  }

  /* Shared Section Layout */
  .home-section {
    padding: 64px 0;
  }

  @media (max-width: 640px) {
    .home-section {
      padding: 44px 0;
    }
  }

  /* Shared Capsule Eyebrow */
  .home-capsule {
    display: inline-flex;
    align-items: center;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38BDF8;
    border-radius: 9999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 14px;
    margin: 0 0 16px 0;
    line-height: 1;
    user-select: none;
  }

  /* Shared Section Head Typography (Adheres strictly to the precision spacing rhythm) */
  .section-head {
    margin-bottom: 32px;
  }

  .section-head h2 {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.8vw, 38px);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 12px 0;
  }

  .section-subcopy {
    color: #CBD5E1;
    font-size: 16px;
    line-height: 1.65;
    margin: 0;
    max-width: 680px;
  }

  .section-head-split {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .head-view-all {
    color: #38BDF8;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .head-view-all:hover {
    color: #7DD3FC;
    transform: translateX(2px);
  }

  /* Shared Card Styling */
  .home-card {
    background: linear-gradient(180deg, rgba(16, 26, 44, 0.75) 0%, rgba(9, 15, 27, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 32px 28px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    box-sizing: border-box;
  }

  .home-card:hover {
    border-color: rgba(56, 189, 248, 0.3);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65), 0 0 30px rgba(56, 189, 248, 0.08);
  }

  .card-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 500;
    color: #FFFFFF;
    margin: 0 0 12px 0;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .card-description {
    color: #CBD5E1;
    font-size: 15px;
    line-height: 1.65;
    margin: 0;
  }

  /* Empty State */
  .empty-state-box {
    background: linear-gradient(180deg, rgba(16, 26, 44, 0.5) 0%, rgba(9, 15, 27, 0.7) 100%);
    border: 1px dashed rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 40px 24px;
    text-align: center;
  }

  .empty-state-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: 22px;
    font-weight: 500;
    color: #FFFFFF;
    margin: 0 0 8px 0;
  }

  .empty-state-text {
    color: #94A3B8;
    font-size: 15px;
    margin: 0;
  }

  /* ==========================================================================
     SECTION 1 — HERO
     ========================================================================== */
  .home-hero {
    position: relative;
    padding: clamp(56px, 7vw, 84px) 0 clamp(36px, 4.2vw, 48px);
    /* Background is inherited from .home-page so it continues seamlessly behind the fixed header. */
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .hero-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero-capsule-row {
    margin-bottom: 4px;
  }

  .hero-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(34px, 5.2vw, 56px);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: #FFFFFF;
    margin: 0 0 16px 0;
    max-width: 820px;
    text-wrap: balance;
  }

  .hero-highlight {
    background: linear-gradient(180deg, #FF9E44 0%, #FF6600 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
  }

  .hero-lead {
    color: #CBD5E1;
    font-size: clamp(16px, 2.1vw, 18.5px);
    line-height: 1.65;
    max-width: 680px;
    margin: 0 0 30px 0;
    text-wrap: balance;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 32px;
  }

  .home-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    cursor: pointer;
    box-sizing: border-box;
  }

  .home-button-primary {
    background: linear-gradient(180deg, #FF7711 0%, #EA5500 100%);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 13px 30px;
    box-shadow: 0 8px 24px rgba(234, 85, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.3);
  }

  .home-button-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(234, 85, 0, 0.55), 0 0 24px rgba(255, 102, 0, 0.4);
    color: #FFFFFF;
  }

  .home-button-secondary {
    background: rgba(255, 255, 255, 0.05);
    color: #F8FAFC;
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 13px 26px;
  }

  .home-button-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
    color: #FFFFFF;
  }


  .hero-pillars-strip {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
    color: #94A3B8;
    font-size: 13.5px;
    font-weight: 500;
  }

  .pillar-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .pillar-check {
    color: #38BDF8;
    flex-shrink: 0;
  }

  .pillar-dot {
    color: rgba(255, 255, 255, 0.2);
    user-select: none;
  }

  /* ==========================================================================
     SECTION 2 — THE SKILL FOUNDRY PROMISE
     ========================================================================== */
  .promise-section {
    padding-top: 36px;
    padding-bottom: 24px;
  }

  .promise-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .promise-card {
    display: flex;
    flex-direction: column;
  }

  .promise-card-capsule {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #38BDF8;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  /* ==========================================================================
     SECTION 3 — FEATURED RESOURCES
     ========================================================================== */
  .featured-section {
    padding-top: 36px;
    padding-bottom: 28px;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 24px;
  }

  .home-card.resource-display-card {
    padding: 20px 20px 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .resource-thumb-wrap {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #04070D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
  }

  .resource-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .resource-display-card:hover .resource-thumb-img {
    transform: scale(1.03);
  }

  .resource-card-body {
    padding: 16px 0 0 0;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .resource-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .resource-meta-category {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.28);
    padding: 3px 9px;
    border-radius: 9999px;
    line-height: 1.2;
  }

  .resource-meta-date {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    font-weight: 500;
    color: #94A3B8;
    white-space: nowrap;
  }

  .resource-card-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: 21px;
    font-weight: 500;
    color: #FFFFFF;
    margin: 0 0 10px 0;
    line-height: 1.25;
    letter-spacing: -0.015em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .resource-card-title a {
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .resource-card-title a:hover {
    color: #38BDF8;
  }

  .resource-card-desc {
    color: #94A3B8;
    font-size: 14px;
    line-height: 1.55;
    margin: 0 0 18px 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1 1 auto;
  }

  .resource-card-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .resource-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: #38BDF8;
    font-size: 13px;
    font-weight: 700;
    padding: 8px 16px;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .resource-cta-btn:hover {
    background: rgba(56, 189, 248, 0.16);
    border-color: rgba(56, 189, 248, 0.45);
    color: #7DD3FC;
    transform: translateX(2px);
  }

  /* ==========================================================================
     SECTION 4 — HOW IT WORKS
     ========================================================================== */
  .method-section {
    padding-top: 32px;
    padding-bottom: 28px;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .method-card {
    position: relative;
    padding: 36px 28px 30px;
  }

  .method-step-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 38px;
    font-weight: 800;
    line-height: 1;
    color: rgba(56, 189, 248, 0.2);
    margin-bottom: 12px;
  }

  .method-subcapsule {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #38BDF8;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  /* ==========================================================================
     SECTION 5 — EXPLORE BY CATEGORY (Dynamic)
     ========================================================================== */
  .categories-section {
    padding-top: 32px;
    padding-bottom: 28px;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 18px;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    padding: 24px 22px;
    border-radius: 20px;
  }

  .category-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .category-tag-name {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: 21px;
    font-weight: 500;
    color: #FFFFFF;
  }

  .category-tag-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 700;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 3px 8px;
    border-radius: 9999px;
  }

  .category-desc {
    color: #94A3B8;
    font-size: 13.5px;
    line-height: 1.55;
    margin: 0 0 16px 0;
    flex: 1 1 auto;
  }

  .category-card-bottom {
    display: flex;
    align-items: center;
  }

  .category-explore-link {
    font-size: 13px;
    font-weight: 700;
    color: #38BDF8;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .category-card:hover .category-explore-link {
    transform: translateX(3px);
    color: #7DD3FC;
  }

  /* ==========================================================================
     SECTION 6 — FREQUENTLY ASKED QUESTIONS (Static, fully visible)
     ========================================================================== */
  .faq-section {
    scroll-margin-top: calc(var(--header-height, 94px) + 20px);
    padding-top: 28px;
    padding-bottom: 10px;
  }

  .faq-section .section-head {
    margin-bottom: 20px;
  }

  .faq-section .home-capsule {
    margin-bottom: 10px;
  }

  .faq-section .section-head h2 {
    margin: 0 0 8px 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
  }

  .home-card.faq-card {
    padding: 20px 24px;
    border-radius: 16px;
    background: rgba(13, 20, 34, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .home-card.faq-card:hover {
    border-color: rgba(56, 189, 248, 0.28);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.4), 0 0 20px rgba(56, 189, 248, 0.06);
  }

  .faq-question {
    margin: 0 0 8px 0;
    font-size: 16.5px;
    font-weight: 700;
    line-height: 1.4;
    color: #F8FAFC;
    letter-spacing: -0.01em;
  }

  .faq-answer {
    margin: 0;
    font-size: 14px;
    line-height: 1.62;
    color: #94A3B8;
  }

  /* FAQ Live Search Field */
  .faq-search-wrap {
    max-width: 820px;
    margin: 0 auto 16px auto;
    width: 100%;
  }

  .faq-search-field {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(8, 13, 22, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    padding: 0 12px 0 16px;
    min-height: 48px;
    box-sizing: border-box;
  }

  .faq-search-field:focus-within {
    border-color: rgba(56, 189, 248, 0.55);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
  }

  .faq-search-icon {
    color: #94A3B8;
    display: flex;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
  }

  .faq-search-input {
    flex: 1 1 auto;
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 15px;
    font-family: inherit;
    padding: 12px 0;
    min-width: 0;
    width: 100%;
    box-sizing: border-box;
    -webkit-appearance: none;
    appearance: none;
  }

  /* Completely remove native browser clear/cancel X button */
  .faq-search-input::-webkit-search-cancel-button,
  .faq-search-input::-webkit-search-decoration,
  .faq-search-input::-webkit-search-results-button,
  .faq-search-input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .faq-search-input::-ms-clear,
  .faq-search-input::-ms-reveal {
    display: none;
    width: 0;
    height: 0;
  }

  .faq-search-input::placeholder {
    color: #64748B;
  }

  .faq-search-clear {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #94A3B8;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    flex-shrink: 0;
    margin-left: 8px;
  }

  .faq-search-clear:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #FFFFFF;
  }

  /* More FAQs Button (Aligned to the right underneath FAQ item 4) */
  .faq-more-wrap {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    margin: 12px auto 0 auto;
    max-width: 820px;
    width: 100%;
    box-sizing: border-box;
  }

  .faq-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 7px 16px;
    font-size: 13px;
    font-weight: 700;
    gap: 7px;
    border-radius: 9999px;
  }

  /* Search Match Highlighting (Subtle Cyan/Blue glow) */
  .faq-match-mark {
    background: rgba(56, 189, 248, 0.20);
    color: #38BDF8;
    border-bottom: 1.5px solid rgba(56, 189, 248, 0.65);
    border-radius: 3px;
    padding: 0 3px;
    margin: 0;
    font-weight: inherit;
    display: inline;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .faq-question .faq-match-mark {
    color: #FFFFFF;
    background: rgba(56, 189, 248, 0.28);
    border-bottom: 2px solid #38BDF8;
    text-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
  }

  /* Compact No-result State */
  .faq-no-results {
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
    text-align: center;
    padding: 26px 20px;
    background: rgba(13, 20, 34, 0.6);
    border: 1px dashed rgba(56, 189, 248, 0.25);
    border-radius: 16px;
    box-sizing: border-box;
  }

  .faq-no-results-title {
    margin: 0 0 6px 0;
    color: #F8FAFC;
    font-size: 15.5px;
    font-weight: 700;
  }

  .faq-no-results-desc {
    margin: 0 0 12px 0;
    color: #94A3B8;
    font-size: 13.5px;
    line-height: 1.5;
  }

  .faq-no-results-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #38BDF8;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .faq-no-results-link:hover {
    color: #7DD3FC;
    text-decoration: underline;
  }

  /* Question Submission Card */
  .home-card.faq-submit-card {
    max-width: 820px;
    margin: 18px auto 0 auto;
    width: 100%;
    padding: 28px 32px 20px 32px;
    border-radius: 18px;
    background: rgba(13, 20, 34, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .home-card.faq-submit-card:hover {
    border-color: rgba(56, 189, 248, 0.25);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.35);
  }

  .faq-submit-head {
    margin-bottom: 14px;
  }

  .faq-submit-title {
    margin: 0 0 6px 0;
    font-size: 18px;
    font-weight: 700;
    color: #F8FAFC;
    letter-spacing: -0.01em;
  }

  .faq-submit-desc {
    margin: 0;
    font-size: 14.5px;
    color: #94A3B8;
    line-height: 1.5;
  }

  .faq-submit-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .faq-input-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 100%;
  }

  .faq-textarea-wrap {
    position: relative;
    width: 100%;
  }

  .faq-textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 13px;
    background: rgba(7, 17, 31, 0.75);
    color: #F8FAFC;
    font-family: inherit;
    font-size: 14.5px;
    line-height: 1.55;
    padding: 16px 46px 16px 16px;
    min-height: clamp(150px, 18vw, 175px);
    height: 165px;
    resize: none !important;
    overflow-y: auto;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-textarea:focus {
    border-color: rgba(56, 189, 248, 0.55);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
  }

  .faq-textarea::placeholder {
    color: #64748B;
  }

  .faq-textarea-expand-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 28px;
    height: 28px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 7px;
    color: #64748B;
    cursor: pointer;
    transition: all 0.15s ease;
    z-index: 2;
  }

  .faq-textarea-expand-btn:hover {
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.35);
    color: #38BDF8;
  }

  .faq-validation-msg {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: #F87171;
    line-height: 1.4;
  }

  .faq-form-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    width: 100%;
    margin-top: 2px;
  }

  .faq-action-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    min-width: 88px;
    padding: 0 18px;
    border-radius: 10px;
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    box-sizing: border-box;
    transition: all 0.18s ease;
    user-select: none;
    white-space: nowrap;
  }

  .faq-clear-btn {
    background: #141D2D;
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #CBD5E1;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .faq-clear-btn:not(:disabled):hover {
    background: #1B263B;
    border-color: rgba(255, 255, 255, 0.28);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .faq-clear-btn:not(:disabled):active {
    transform: scale(0.97);
  }

  /* Disabled Clear keeps its own muted blue identity; it must not look identical to Submit. */
  .faq-clear-btn:disabled {
    background: rgba(30, 64, 100, 0.28);
    border: 1px solid rgba(56, 189, 248, 0.16);
    color: rgba(125, 211, 252, 0.42);
    opacity: 1;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
    pointer-events: none;
  }

  .faq-submit-btn {
    background: linear-gradient(135deg, #0284C7 0%, #0369A1 100%);
    border: 1.5px solid #38BDF8;
    color: #FFFFFF;
    font-weight: 700;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.32), 0 2px 8px rgba(0, 0, 0, 0.4);
