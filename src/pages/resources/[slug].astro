---
import yaml from 'js-yaml';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceHeroImage, resourceImageAlt, resourceResultImages, resourceSlug, resourceThumbnail } from '../../lib/resource';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resourceSlug(resource) }, props: { resource } }));
}

const { resource } = Astro.props;
// data will be initialized after checking GitHub
const slug = resourceSlug(resource);
const isTesting1 = slug === 'testing-1';
let data = resource.data;
let body = resource.body;

if (isTesting1) {
  try {
    const ghRes = await fetch('https://raw.githubusercontent.com/anujyadav70750/skill-foundry/main/src/content/resources/testing-1.md', {
      headers: { 'Cache-Control': 'no-cache' }
    });
    if (ghRes.ok) {
      const rawText = await ghRes.text();
      const match = rawText.match(/^---\r?\n([\s\S]+?)\r?\n---(?:\r?\n([\s\S]*))?$/);
      if (match) {
        const parsed = yaml.load(match[1]);
        if (parsed) {
          data = {
            ...parsed,
            ...data,
            date: data.date || (parsed.date ? new Date(parsed.date) : data.date),
            toolsUsed: data.toolsUsed?.length ? data.toolsUsed : (Array.isArray(parsed.toolsUsed) ? parsed.toolsUsed : data.toolsUsed),
            steps: data.steps?.length ? data.steps : (Array.isArray(parsed.steps) ? parsed.steps : data.steps),
            tips: data.tips?.length ? data.tips : (Array.isArray(parsed.tips) ? parsed.tips : data.tips),
            tags: data.tags?.length ? data.tags : (Array.isArray(parsed.tags) ? parsed.tags : data.tags),
            relatedResources: data.relatedResources?.length ? data.relatedResources : (Array.isArray(parsed.relatedResources) ? parsed.relatedResources : data.relatedResources),
          };
          if (match[2] && !body) {
            body = match[2];
          }
        }
      }
    }
  } catch (err) {
    console.error('Failed to fetch testing-1 from GitHub, using local fallback:', err);
  }
}

const resultImages = resourceResultImages(resource);

const parseLegacy = (value) => {
  const marker = '[[SF_INPUTS]]';
  const raw = String(value || '').trim();
  if (!raw.startsWith(marker)) return { inputs: [], settings: [], toolPurpose: '' };
  try {
    const parsed = JSON.parse(raw.slice(marker.length));
    return {
      inputs: Array.isArray(parsed.inputs) ? parsed.inputs : [],
      settings: Array.isArray(parsed.settings) ? parsed.settings : [],
      toolPurpose: String(parsed.toolPurpose || '').trim()
    };
  } catch {
    return { inputs: [], settings: [], toolPurpose: '' };
  }
};

const findTool = (name) => data.toolsUsed.find((tool) => tool.name.trim().toLowerCase() === String(name || '').trim().toLowerCase());

const inferActionType = (step) => {
  if (step.actionType) return step.actionType;
  const process = String(step.process || '');
  if (/^\s*(import|arrange|trim|combine|merge|export|upload|download|organize)/i.test(process)) return 'instructions';
  return 'prompt';
};
const inferOutputType = (step) => {
  if (step.outputType) return step.outputType;
  const value = String(step.output || '').toLowerCase();
  if (value.includes('video')) return 'video';
  if (value.includes('image')) return 'image';
  if (value.includes('audio')) return 'audio';
  if (value.includes('document') || value.includes('pdf')) return 'document';
  return 'text';
};
const workflowSteps = data.steps.map((step) => {
  const legacy = parseLegacy(step.input);
  const toolName = String(step.tool || data.tool || '').trim();
  const toolMeta = findTool(toolName);
  const actionType = inferActionType(step);
  const outputType = inferOutputType(step);
  return {
    ...step,
    tool: toolName,
    toolPurpose: String(step.toolPurpose || legacy.toolPurpose || toolMeta?.purpose || '').trim(),
    inputs: step.inputs?.length ? step.inputs : legacy.inputs,
    settings: (step.settings?.length ? step.settings : legacy.settings).filter((setting) => String(setting?.label || '').trim().toLowerCase() !== 'output'),
    actionType,
    outputType,
    outputLabel: String(step.outputLabel || step.output || 'Output from this step').trim(),
    outputDescription: String(step.outputDescription || 'Output from this step').trim(),
    outputSrc: String(step.outputSrc || '').trim(),
    instructionItems: actionType === 'instructions'
      ? String(step.process || step.description || '').split(/\n+/).map((item) => item.trim()).filter(Boolean)
      : [],
    toolMeta
  };
});

// Tools & Resources is derived from the workflow itself: every unique tool used by a step appears once.
const tools = workflowSteps
  .map((step) => step.toolMeta || (step.tool ? { name: step.tool, purpose: step.toolPurpose, url: '' } : null))
  .filter(Boolean)
  .filter((tool, index, list) => list.findIndex((candidate) => candidate.name.trim().toLowerCase() === tool.name.trim().toLowerCase()) === index);

const toolLogo = (tool) => {
  try {
    const rawUrl = String(tool?.url || '').trim();
    if (!rawUrl) return '/skill-foundry-resource-icon.svg';
    const host = new URL(rawUrl).hostname;
    return host ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=128` : '/skill-foundry-resource-icon.svg';
  } catch {
    return '/skill-foundry-resource-icon.svg';
  }
};

const mediaTypeFromUrl = (src) => {
  const value = String(src || '').toLowerCase();
  if (/\.(mp4|webm|mov|m4v)(?:\?|$)/.test(value)) return 'video';
  if (/\.(mp3|wav|ogg|m4a|aac)(?:\?|$)/.test(value)) return 'audio';
  if (/\.(pdf|doc|docx|txt)(?:\?|$)/.test(value)) return 'document';
  return 'image';
};

const outputVisual = (step, index) => {
  const raw = String(step.output || '').trim();
  const type = step.outputType || mediaTypeFromUrl(String(step.outputSrc || '')) || (
    /video/i.test(raw) ? 'video' :
    /image/i.test(raw) ? 'image' :
    /audio/i.test(raw) ? 'audio' :
    /document|pdf/i.test(raw) ? 'document' : 'text'
  );
  if (step.outputSrc) {
    const isEmbedUrl = /instagram\.com|youtube\.com|vimeo\.com|tiktok\.com|\/embed/i.test(step.outputSrc);
    return {
      type: isEmbedUrl ? 'video' : type,
      src: step.outputSrc,
      previewSrc: step.outputPreviewSrc || (isEmbedUrl ? (resultImages[0] || heroImage || '') : ''),
      label: step.outputLabel || raw || 'Output from this step'
    };
  }
  if (step.outputPreviewSrc) return { type, src: '', previewSrc: step.outputPreviewSrc, label: step.outputLabel || raw || 'Output from this step' };
  if (/^https?:\/\//i.test(raw)) return { type: mediaTypeFromUrl(raw), src: raw, previewSrc: '', label: raw };
  const next = workflowSteps[index + 1];
  const linked = next?.inputs?.find((input) => input?.src && step.outputLabel && input?.label?.toLowerCase().includes(step.outputLabel.toLowerCase()));
  if (linked?.src) return { type: linked.type || type, src: linked.src, previewSrc: '', label: step.outputLabel || raw || linked.label || 'Step output' };
  const previewSrc = index === workflowSteps.length - 1 && resultImages[0] ? resultImages[0] : '';
  return { type, src: '', previewSrc, label: step.outputLabel || raw || 'Output produced by this step' };
};

const isRealVideo = (src) => mediaTypeFromUrl(src) === 'video';
const isRealAudio = (src) => mediaTypeFromUrl(src) === 'audio';

const getHandoffText = (currentStep, nextStep, stepIndex) => {
  if (currentStep.handoff) return String(currentStep.handoff).trim();
  if (currentStep.next) return String(currentStep.next).trim();
  if (currentStep.transition) return String(currentStep.transition).trim();
  if (currentStep.transitionInstruction) return String(currentStep.transitionInstruction).trim();
  if (!nextStep) return '';

  const outVisual = outputVisual(currentStep, stepIndex);
  const rawLabel = String(currentStep.outputLabel || currentStep.output || outVisual.label || '').trim();
  const cleanLabel = rawLabel
    .replace(/^Output(?:\s+produced\s+by\s+this\s+step)?/i, '')
    .replace(/^Output\s*[:\-]\s*/i, '')
    .trim();

  const nextStepNum = String(stepIndex + 2).padStart(2, '0');

  const matchingInput = nextStep?.inputs?.find((inp) => {
    const inpLabel = String(inp.label || inp.role || inp.value || '').toLowerCase();
    const cl = cleanLabel.toLowerCase();
    return inpLabel && (cl.includes(inpLabel) || inpLabel.includes(cl));
  });

  if (matchingInput) {
    const roleName = String(matchingInput.role || matchingInput.label || matchingInput.value || cleanLabel).trim();
    return `Use this ${cleanLabel || 'output'} as ${roleName} in Step ${nextStepNum}`;
  }

  if (cleanLabel && cleanLabel.length <= 36) {
    return `Use this ${cleanLabel.toLowerCase()} in Step ${nextStepNum}`;
  }

  return `Use this output in Step ${nextStepNum}`;
};

const allResources = await getCollection('resources');
const related = (data.relatedResources.length > 0
  ? data.relatedResources.flatMap((relatedSlug) => {
      const normalizedSlug = relatedSlug.trim().toLowerCase();
      const item = allResources.find((candidate) => resourceSlug(candidate).trim().toLowerCase() === normalizedSlug);
      return item && item.id !== resource.id ? [item] : [];
    })
  : allResources
      .filter((item) => item.id !== resource.id)
      .map((item) => ({ item, score: (item.data.category === data.category ? 3 : 0) + item.data.tags.filter((tag) => data.tags.includes(tag)).length }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .map(({ item }) => item)
).slice(0, 3);

const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`/resources/${slug}/`, site).href;
const seoTitle = data.seoTitle ?? `${data.title} | Skill Foundry`;
const seoDescription = data.seoDescription ?? data.description;
const heroImage = resourceHeroImage(resource);
const imageAlt = resourceImageAlt(resource);
const absoluteImage = new URL(heroImage, site).href;

const rawReel = (data as any).instagramReelUrl || (data as any).finalReelUrl || (data as any).videoEmbedUrl || '';
const isInstagramReel = typeof rawReel === 'string' && rawReel.includes('instagram.com');
const finalReelCleanUrl = isInstagramReel
  ? rawReel.split('?')[0].replace(/\/embed\/?$/, '').replace(/\/+$/, '') + '/'
  : '';
const finalReelEmbedUrl = finalReelCleanUrl;

const finalWorkflowStep = workflowSteps[workflowSteps.length - 1];
const finalWorkflowOutput = finalWorkflowStep ? outputVisual(finalWorkflowStep, workflowSteps.length - 1) : null;
const finalWorkflowMediaUrl = (finalWorkflowOutput?.src && isRealVideo(finalWorkflowOutput.src))
  ? finalWorkflowOutput.src
  : (isTesting1 ? (resultImages[0] || heroImage) : '');
const isFinalWorkflowVideoDirect = finalWorkflowOutput?.src ? isRealVideo(finalWorkflowOutput.src) : false;
const isFinalWorkflowVideo = finalWorkflowOutput?.type === 'video' || isFinalWorkflowVideoDirect || isTesting1;
const introText = isTesting1
  ? "Start with the character and clothing references, then follow the workflow in order to create three connected clips and assemble the final video."
  : data.intro;
const whatItDoesText = isTesting1
  ? "Keep character identity, outfit, framing, and visual continuity consistent from the first image to the final video."
  : data.whatItDoes;
const authorName = (data as any).author || 'Skill Foundry';
const authorAvatar = (data as any).authorAvatar || (data as any).authorImage || (data as any).authorDp || '/favicon.svg';
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', headline: data.title, description: data.description, datePublished: data.date.toISOString(), dateModified: data.date.toISOString(), articleSection: data.category, url: canonicalUrl, mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl }, image: [absoluteImage], author: { '@type': 'Organization', name: 'Skill Foundry' }, publisher: { '@type': 'Organization', name: 'Skill Foundry' }, keywords: data.tags.join(', ') },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', site).href },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl }
  ] }
] };
---
<BaseLayout title={seoTitle} description={seoDescription} canonical={canonicalUrl} image={heroImage} imageAlt={imageAlt} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Playfair+Display:ital,wght@0,400..800;1,400..800&display=swap');

    html:has(.testing-1-theme),
    body:has(.testing-1-theme) {
      background-color: #060911 !important;
      background-image:
        radial-gradient(ellipse 85% 50% at 50% -10%, rgba(28, 75, 145, 0.35) 0%, rgba(13, 27, 52, 0.15) 50%, transparent 80%),
        radial-gradient(circle at 50% 55%, rgba(20, 50, 95, 0.1) 0%, transparent 65%),
        linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px) !important;
      background-size: 100% auto, 100% auto, 40px 40px, 40px 40px !important;
      background-repeat: no-repeat, no-repeat, repeat, repeat !important;
      background-position: center top, center top, center top, center top !important;
      color: #CBD5E1 !important;
      padding-top: 0 !important;
      margin: 0 !important;
      min-height: 100vh !important;
    }
    @media (max-width: 700px) {
      html:has(.testing-1-theme),
      body:has(.testing-1-theme) {
        padding-top: 0 !important;
      }
    }
    body:has(.testing-1-theme) .site-footer {
      background: #04070D !important;
      border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
      color: #94A3B8 !important;
      padding: 84px 0 52px !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-brand span.brand-name {
      color: #FFFFFF !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-descriptors .descriptor-item {
      color: #CBD5E1 !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-nav a {
      color: #FFFFFF !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-nav a:hover {
      color: #FF6600 !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-legal a {
      color: #94A3B8 !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-legal a:hover {
      color: #FF6600 !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-copyright {
      color: #64748B !important;
    }

    /* ==========================================================================
       TESTING-1 EDITORIAL LUXURY SYSTEM (AWESMOS INSPIRATION)
       ========================================================================== */
    .testing-1-theme,
    .testing-1-theme .resource-page {
      color: #CBD5E1 !important;
      background: transparent !important;
      background-image: none !important;
      border: none !important;
      box-shadow: none !important;
      padding-top: 0 !important;
    }

    .testing-1-theme .resource-hero-unified-section,
    .testing-1-theme .resource-section,
    .testing-1-theme .blueprint-workflow-container,
    .testing-1-theme .blueprint-step-container,
    .testing-1-theme .tips-section,
    .testing-1-theme .resource-cta,
    .resource-page .resource-section,
    .resource-page .blueprint-workflow-container,
    .resource-page .blueprint-step-container {
      contain: layout style;
      isolation: isolate;
      transform: translateZ(0);
      backface-visibility: hidden;
    }

    .media-backdrop,
    .testing-1-theme .media-backdrop,
    .blueprint-result-media-center .media-backdrop {
      transform: scale(1.18) translateZ(0) !important;
      will-change: transform !important;
      backface-visibility: hidden !important;
      pointer-events: none !important;
    }

    /* 1. HERO SECTION — CONTINUOUS BACKGROUND */
    .testing-1-theme .resource-hero-unified-section {
      position: relative !important;
      padding-top: 76px !important;
      padding-bottom: 0 !important;
      background: transparent !important;
      background-image: none !important;
      border: none !important;
      border-bottom: none !important;
      box-shadow: none !important;
    }
    @media (max-width: 700px) {
      .testing-1-theme .resource-hero-unified-section {
        padding-top: 60px !important;
        padding-bottom: 0 !important;
      }
    }
    .testing-1-theme .hero-unified-header {
      text-align: center !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
    }
    .testing-1-theme .hero-unified-header .breadcrumbs {
      display: inline-flex !important;
      align-items: center !important;
      gap: 8px !important;
      color: #94A3B8 !important;
      font-size: 13px !important;
      margin-bottom: 14px !important;
    }
    .testing-1-theme .hero-unified-header .breadcrumbs a {
      color: #94A3B8 !important;
      text-decoration: none !important;
      transition: color 0.15s ease !important;
    }
    .testing-1-theme .hero-unified-header .breadcrumbs a:hover {
      color: #F8FAFC !important;
    }
    .testing-1-theme .hero-unified-header .eyebrow {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
      background: rgba(255, 255, 255, 0.05) !important;
      border: 1px solid rgba(255, 255, 255, 0.14) !important;
      color: #94A3B8 !important;
      border-radius: 9999px !important;
      font-size: 11px !important;
      font-weight: 700 !important;
      letter-spacing: 0.12em !important;
      text-transform: uppercase !important;
      padding: 6px 16px !important;
      margin-bottom: 18px !important;
      backdrop-filter: blur(12px) !important;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
    }
    .testing-1-theme .hero-unified-header h1 {
      font-family: 'Newsreader', 'Playfair Display', Georgia, serif !important;
      font-size: clamp(34px, 5.2vw, 56px) !important;
      font-weight: 500 !important;
      line-height: 1.12 !important;
      letter-spacing: -0.025em !important;
      color: #FFFFFF !important;
      text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6) !important;
      max-width: 900px !important;
      margin: 0 auto 20px !important;
      text-align: center !important;
    }
    /* Google AI Studio reference — author capsule */
    .testing-1-theme .hero-unified-header h1 {
      margin: 0 auto 18px !important;
    }
    .testing-1-theme .publisher-identity {
      display: inline-flex !important;
      align-items: center !important;
      gap: 12px !important;
      width: max-content !important;
      max-width: calc(100vw - 32px) !important;
      height: auto !important;
      min-height: 0 !important;
      max-height: none !important;
      flex: 0 0 auto !important;
      align-self: center !important;
      box-sizing: border-box !important;
      background: rgba(14, 22, 38, 0.85) !important;
      border: 1px solid rgba(255, 255, 255, 0.1) !important;
      border-radius: 9999px !important;
      padding: 5px 18px 5px 6px !important;
      backdrop-filter: blur(12px) !important;
      -webkit-backdrop-filter: blur(12px) !important;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45) !important;
      margin: 0 !important;
      position: relative !important;
      text-align: left !important;
    }
    .testing-1-theme .publisher-identity::before {
      content: none !important;
      display: none !important;
    }
    .testing-1-theme .publisher-avatar-box {
      width: 36px !important;
      height: 36px !important;
      flex: 0 0 36px !important;
      border-radius: 50% !important;
      overflow: hidden !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      background: rgba(255, 255, 255, 0.05) !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .testing-1-theme .publisher-avatar-box img,
    .testing-1-theme .publisher-avatar {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
      border-radius: 50% !important;
    }
    .testing-1-theme .publisher-details {
      display: flex !important;
      flex-direction: column !important;
      gap: 2px !important;
      min-width: 0 !important;
      justify-content: center !important;
    }
    .testing-1-theme .publisher-name-row {
      display: flex !important;
      align-items: center !important;
      gap: 6px !important;
      line-height: 1.2 !important;
    }
    .testing-1-theme .publisher-name-row strong {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      color: #FFFFFF !important;
      font-size: 13.5px !important;
      font-weight: 600 !important;
      letter-spacing: -0.01em !important;
      white-space: nowrap !important;
    }
    .testing-1-theme .publisher-verification {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      vertical-align: middle !important;
      line-height: 1 !important;
    }
    .testing-1-theme .publisher-verification svg {
      width: 15px !important;
      height: 15px !important;
      display: block !important;
    }
    .testing-1-theme .publisher-verification svg circle {
      fill: #38BDF8 !important;
    }
    .testing-1-theme .publisher-verification svg path {
      fill: none !important;
      stroke: #FFFFFF !important;
      stroke-width: 2.2 !important;
      stroke-linecap: round !important;
      stroke-linejoin: round !important;
    }
    .testing-1-theme .publisher-meta {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
      color: #94A3B8 !important;
      font-size: 11.5px !important;
      line-height: 1.2 !important;
      font-weight: 400 !important;
      white-space: nowrap !important;
    }
    @media (max-width: 768px) {
      .testing-1-theme .publisher-identity {
        width: max-content !important;
        max-width: calc(100vw - 32px) !important;
        height: auto !important;
        min-height: 0 !important;
        max-height: none !important;
        flex: 0 0 auto !important;
        align-self: center !important;
        padding: 5px 18px 5px 6px !important;
        margin: 0 !important;
        gap: 12px !important;
      }
      .testing-1-theme .publisher-avatar-box {
        width: 36px !important;
        height: 36px !important;
        flex-basis: 36px !important;
      }
      .testing-1-theme .publisher-name-row strong {
        font-size: 13.5px !important;
      }
      .testing-1-theme .publisher-verification svg {
        width: 15px !important;
        height: 15px !important;
        flex-basis: 15px !important;
      }
      .testing-1-theme .publisher-meta {
        font-size: 11.5px !important;
      }
    }
    .testing-1-theme .hero-image-wrap {
      background: rgba(14, 22, 36, 0.6) !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
      border-radius: 24px !important;
      padding: 10px !important;
      box-shadow: 0 28px 70px rgba(0, 0, 0, 0.7), 0 0 50px rgba(30, 80, 165, 0.16) !important;
      backdrop-filter: blur(20px) !important;
      max-width: 1080px !important;
      margin: 24px auto 24px !important;
      box-sizing: border-box !important;
    }
    .testing-1-theme .hero-image {
      border-radius: 16px !important;
      width: 100% !important;
      aspect-ratio: 16/9 !important;
      object-fit: cover !important;
      display: block !important;
      border: none !important;
      box-shadow: none !important;
    }
