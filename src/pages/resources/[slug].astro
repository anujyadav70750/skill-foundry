---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);
const data = resource.data;
---
<BaseLayout title={data.title} description={data.description}>
  <article class="resource-page">
    <div class="container narrow">
      <div class="breadcrumbs"><a href="/resources/">Resources</a><span>/</span><span>{data.category}</span></div>
      <p class="eyebrow">{data.tool} • {data.category}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <div class="meta">Published {data.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}</div>
    </div>

    <div class="container content-wide">
      <img class="hero-image" src={data.heroImage} alt={data.title} />
    </div>

    <div class="container narrow article-layout">
      <div class="article-content"><Content /></div>

      <section class="prompt-section" id="prompt">
        <div class="section-heading prompt-heading"><div><p class="eyebrow">PROMPT SOURCE</p><h2>Copy the full prompt</h2></div><button class="button button-secondary" type="button" data-expand>Expand</button></div>
        <div class="prompt-shell">
          <pre id="prompt-text">{data.prompt}</pre>
          <button class="copy-button" type="button" data-copy>Copy prompt</button>
        </div>
        <p class="copy-status" data-status aria-live="polite"></p>
      </section>

      <section class="tutorial-section">
        <div class="section-heading"><div><p class="eyebrow">TUTORIAL</p><h2>Watch it in action</h2></div></div>
        {data.videoEmbedUrl ? <div class="video-frame"><iframe src={data.videoEmbedUrl} title={`Tutorial: ${data.title}`} loading="lazy" allowfullscreen></iframe></div> : <div class="video-placeholder">Tutorial video will appear here.</div>}
        {data.originalVideoUrl && <a class="text-link" href={data.originalVideoUrl} target="_blank" rel="noopener">Open original video →</a>}
      </section>

      <div class="tags">{data.tags.map((tag) => <span>#{tag}</span>)}</div>
    </div>
  </article>

  <dialog class="prompt-dialog" data-dialog>
    <div class="dialog-card">
      <div class="section-heading"><div><p class="eyebrow">FULL PROMPT</p><h2>{data.title}</h2></div><button type="button" class="dialog-close" data-close aria-label="Close">×</button></div>
      <pre>{data.prompt}</pre>
      <button class="button button-primary" type="button" data-copy>Copy full prompt</button>
    </div>
  </dialog>

  <script>
    const promptText = document.querySelector('#prompt-text')?.textContent || '';
    const status = document.querySelector('[data-status]');
    const dialog = document.querySelector('[data-dialog]');
    document.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(promptText);
        if (status) status.textContent = 'Prompt copied successfully.';
        setTimeout(() => { if (status) status.textContent = ''; }, 2200);
      } catch { if (status) status.textContent = 'Copy failed — select the prompt and copy it manually.'; }
    }));
    document.querySelector('[data-expand]')?.addEventListener('click', () => dialog?.showModal());
    document.querySelector('[data-close]')?.addEventListener('click', () => dialog?.close());
  </script>
</BaseLayout>
