      font-size: 14px;
      font-weight: 400;
      line-height: 1.55;
    }

    /* 1. TOOL (Standardized square logo 3D button matching Tools used + tool name) */
    .step-tool-inline {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 2px 0;
      color: inherit;
    }

    .step-tool-logo-link {
      display: inline-flex;
      text-decoration: none;
      border-radius: 9px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    .step-tool-logo-box {
      width: 36px;
      height: 36px;
      min-width: 36px;
      min-height: 36px;
      border-radius: 9px;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      padding: 0 !important;
      box-sizing: border-box;
      background: #0B0E14;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 
        inset 0 1px 0 rgba(255, 255, 255, 0.28),
        inset 0 -2px 0 rgba(0, 0, 0, 0.5),
        0 2px 0 rgba(0, 0, 0, 0.4),
        0 4px 10px -2px rgba(0, 0, 0, 0.5);
      transform: translateY(0);
      transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.15s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.15s ease;
      cursor: pointer;
