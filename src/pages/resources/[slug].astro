    /* ==========================================================================
       MEDIA PREVIEW LIGHTBOX MODAL (Blur effect backdrop, no text on buttons)
       ========================================================================== */
    .media-lightbox {
      position: fixed;
      inset: 0;
      z-index: 999999;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.22s ease;
      box-sizing: border-box;
      padding: 16px;
    }

    .media-lightbox.is-active {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    /* Background resource page is visible with blur effect */
    .media-lightbox-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(3, 7, 15, 0.78);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      cursor: pointer;
    }

    .media-lightbox-container {
      position: relative;
      z-index: 2;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      width: min(90vw, 720px);
      max-width: 720px;
      max-height: 86vh;
      padding: 14px;
      box-sizing: border-box;
      border: 1px solid rgba(148, 163, 184, 0.22);
      border-radius: 18px;
      background: #0B1019;
      box-shadow: 0 24px 70px rgba(0, 0, 0, 0.58);
      transform: scale(0.96);
      transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .media-lightbox.is-active .media-lightbox-container {
      transform: scale(1);
    }

    /* Actions sit inside the preview card, aligned at its top-right. */
    .media-lightbox-toolbar {
      position: static;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      width: 100%;
      z-index: 10;
      flex: 0 0 auto;
    }

    /* Keep both lightbox actions visually equal; only their fills differ. */
    #media-lightbox .media-lightbox-toolbar .lightbox-icon-btn {
      width: 40px !important;
      height: 40px !important;
      min-width: 40px !important;
      min-height: 40px !important;
      flex: 0 0 40px !important;
      border-radius: 12px !important;
      padding: 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
    }

    #media-lightbox .media-lightbox-toolbar .lightbox-download-btn {
      background: #263449 !important;
      border: 1px solid #34465F !important;
      color: #EAF2FF !important;
      box-shadow: 0 3px 0 #151E2D, 0 6px 12px rgba(0,0,0,.24) !important;
    }

    #media-lightbox .media-lightbox-toolbar .lightbox-close-btn {
      background: #171C25 !important;
      border: 1px solid #465164 !important;
      color: #E8EDF4 !important;
      box-shadow: none !important;
    }

    #media-lightbox .media-lightbox-toolbar .lightbox-close-btn svg {
      width: 20px !important;
      height: 20px !important;
      flex: 0 0 20px !important;
    }

    #media-lightbox .media-lightbox-toolbar .lightbox-download-btn:hover {
      background: #30435B !important;
    }

    #media-lightbox .media-lightbox-toolbar .lightbox-close-btn:hover {
      background: #222A35 !important;
      border-color: #64748B !important;
      color: #FFFFFF !important;
    }

    .lightbox-icon-btn {
      width: 46px;
      height: 46px;
      min-width: 46px;
      min-height: 46px;
      border-radius: 12px;
      background: rgba(17, 24, 39, 0.88);
