---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resource.id }, props: { resource } }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);
const data = resource.data;
const allResources = await getCollection('resources');
const related = allResources
  .filter((item) => item.id !== resource.id)
  .map((item) => ({
    item,
    score: (item.data.category === data.category ? 3 : 0) + item.data.tags.filter((tag) => data.tags.includes(tag)).length
  }))
  .filter(({ score }) => score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(({ item }) => item);

const canonicalUrl = new URL(`/resources/${resource.id}/`, Astro.site ?? Astro.url).href;
const pageUrl = canonicalUrl;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: data.title,
      description: data.description,
      datePublished: data.date.toISOString(),
      dateModified: data.date.toISOString(),
      mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
      image: new URL(data.heroImage, Astro.site ?? Astro.url).href,
      author: { '@type': 'Organization', name: 'Skill Foundry' },
      publisher: { '@type': 'Organization', name: 'Skill Foundry' },
      keywords: data.tags.join(', ')
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site ?? Astro.url).href },
        { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', Astro.site ?? Astro.url).href },
        { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl }
      ]
    }
  ]
};
---
<BaseLayout title={data.title} description={data.description} canonical={canonicalUrl} image={data.heroImage} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <article class="resource-page">
    <div class="container narrow">
      <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span>{data.category}</span></div>
      <p class="eyebrow">{data.tool} • {data.category}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <div class="resource-top-meta">
        <span>Published {data.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        <span>•</span>
        <span>{data.tool}</span>
      </div>
      <div class="quick-actions">
        <a class="button button-primary" href="#prompt">Get the prompt ↓</a>
        {data.videoEmbedUrl && <a class="button button-secondary" href="#tutorial">Watch tutorial</a>}
      </div>
    </div>

    <div class="container content-wide">
      <img class="hero-image" src={data.heroImage} alt={data.title} />
    </div>

    <div class="container narrow article-layout">
      <section class="prompt-section resource-first-section" id="prompt">
        <div class="section-heading prompt-heading"><div><p class="eyebrow">PROMPT SOURCE</p><h2>Copy the full prompt</h2><p class="section-subcopy">Scroll inside the box to review it. Copy or expand when you're ready to use it.</p></div><button class="button button-secondary" type="button" data-expand>Expand prompt</button></div>
        <div class="prompt-shell">
          <pre id="prompt-text">{data.prompt}</pre>
          <button class="copy-button" type="button" data-copy>Copy prompt</button>
        </div>
        <p class="copy-status" data-status aria-live="polite"></p>
      </section>

      <section class="tutorial-section" id="tutorial">
        <div class="section-heading"><div><p class="eyebrow">TUTORIAL</p><h2>Watch it in action</h2><p class="section-subcopy">Follow the original walkthrough, then return here to copy and adapt the prompt.</p></div></div>
        {data.videoEmbedUrl ? <div class="video-frame"><iframe src={data.videoEmbedUrl} title={`Tutorial: ${data.title}`} loading="lazy" allowfullscreen></iframe></div> : <div class="video-placeholder">Tutorial video will appear here.</div>}
        {data.originalVideoUrl && <a class="text-link" href={data.originalVideoUrl} target="_blank" rel="noopener noreferrer">Open original video →</a>}
      </section>

      <section class="explanation-section">
        <div class="section-heading"><div><p class="eyebrow">LEARN & ADAPT</p><h2>How to use this resource</h2></div></div>
        <div class="article-content"><Content /></div>
      </section>

      <div class="tags" aria-label="Resource tags">{data.tags.map((tag) => <a href={`/resources/?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>
    </div>
  </article>

  {related.length > 0 && <section class="section section-muted related-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Related resources</h2></div><a href="/resources/">View library →</a></div>
      <div class="resource-grid">
        {related.map((item) => <a class="resource-card" href={`/resources/${item.id}/`}>
          <img src={item.data.thumbnail} alt={item.data.title} loading="lazy" />
          <div class="card-body"><span class="tag">{item.data.category}</span><h3>{item.data.title}</h3><p>{item.data.description}</p><span class="card-link">Open resource →</span></div>
        </a>)}
      </div>
    </div>
  </section>}

  <dialog class="prompt-dialog" data-dialog>
    <div class="dialog-card">
      <div class="section-heading"><div><p class="eyebrow">FULL PROMPT</p><h2>{data.title}</h2></div><button type="button" class="dialog-close" data-close aria-label="Close">×</button></div>
      <pre>{data.prompt}</pre>
      <button class="button button-primary" type="button" data-copy>Copy full prompt</button>
    </div>
  </dialog>

  <script>
    const promptText = document.querySelector('#prompt-text')?.textContent || '';
    const status = document.querySelector('[data-status]');
    const dialog = document.querySelector('[data-dialog]');
    document.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(promptText);
        if (status) status.textContent = 'Prompt copied successfully.';
        setTimeout(() => { if (status) status.textContent = ''; }, 2200);
      } catch { if (status) status.textContent = 'Copy failed — select the prompt and copy it manually.'; }
    }));
    document.querySelector('[data-expand]')?.addEventListener('click', () => dialog?.showModal());
    document.querySelector('[data-close]')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</BaseLayout>
