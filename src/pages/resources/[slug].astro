                      <span class="related-work-meta-date">
                        <svg class="related-work-meta-calendar" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                          <line x1="16" y1="2" x2="16" y2="6"></line>
                          <line x1="8" y1="2" x2="8" y2="6"></line>
                          <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>{dateStr}</span>
                      </span>
                    )}
                  </div>
                  <h3 class="related-work-card-title">{item.data.title}</h3>
                </div>
              </a>
            );
          })}
        </div>
        </section>
        <div class="resource-related-divider resource-related-divider-after" aria-hidden="true"></div>
      </div>
    )}

  </div>

  {/* MEDIA PREVIEW LIGHTBOX MODAL */}
  <div id="media-lightbox" class="media-lightbox" role="dialog" aria-modal="true" aria-hidden="true" tabindex="-1">
    <div class="media-lightbox-backdrop" data-close-lightbox></div>
    <div class="media-lightbox-container">
      <div class="media-lightbox-toolbar">
        <a
          id="lightbox-download-btn"
          class="lightbox-icon-btn lightbox-download-btn"
          href="#"
          download=""
          aria-label="Download"
          title="Download"
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
        </a>
        <button
          type="button"
          id="lightbox-close-btn"
          class="lightbox-icon-btn lightbox-close-btn"
          aria-label="Close"
          title="Close"
          data-close-lightbox
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="3" x2="21" y2="21"></line>
            <line x1="21" y1="3" x2="3" y2="21"></line>
          </svg>
        </button>
      </div>
      <div class="media-lightbox-body">
        <img id="lightbox-img" class="lightbox-img" src="" alt="Resource Preview" style="display: none;" />
        <video id="lightbox-video" class="lightbox-video" src="" controls playsinline preload="auto" style="display: none;"></video>
        <iframe id="lightbox-pdf" class="lightbox-pdf" title="PDF preview" style="display: none;"></iframe>
      </div>

    </div>
  </div>

  <script>
    // Resource-page selection copy: clone the selection, then remove non-visible content and media metadata.
    (() => {
      const resourcePage = document.querySelector(".resource-editorial-layout .resource-page");
      if (!resourcePage) return;

      const getVisibleSelectionText = (ranges) => {
        const sandbox = document.createElement("div");
        sandbox.className = "testing-1-theme resource-editorial-layout";
        const pageClone = document.createElement("article");
        pageClone.className = "resource-page";
        const contentClone = document.createElement("div");
        contentClone.className = "resource-copy-fragment";

        const pageWidth = Math.max(280, Math.round(resourcePage.getBoundingClientRect().width || window.innerWidth));
        sandbox.style.cssText = "position:fixed;left:-100000px;top:0;z-index:-1;pointer-events:none;width:" + pageWidth + "px;max-width:100vw;";
        pageClone.appendChild(contentClone);
        sandbox.appendChild(pageClone);

        ranges.forEach((range, index) => {
          if (index > 0) contentClone.appendChild(document.createElement("br"));
          contentClone.appendChild(range.cloneContents());
        });

        document.body.appendChild(sandbox);

        try {
          // Images and embedded media contribute no text to a normal visible-text copy.
          contentClone.querySelectorAll("img,picture,svg,video,audio,iframe,canvas,object,embed,script,style,noscript,template").forEach((element) => {
            element.remove();
          });

          // Remove content hidden by HTML attributes or computed CSS, including inactive workflow tabs.
          Array.from(contentClone.querySelectorAll("*")).forEach((element) => {
            const style = window.getComputedStyle(element);
            const isHidden = element.hidden ||
              style.display === "none" ||
              style.visibility === "hidden" ||
              style.visibility === "collapse" ||
              style.contentVisibility === "hidden" ||
              Number(style.opacity) === 0;

            if (isHidden) element.remove();
          });

          return (contentClone.innerText || contentClone.textContent || "")
            .replace(/\u00A0/g, " ")
            .replace(/\r\n?/g, "\n")
            .trim();
        } finally {
          sandbox.remove();
        }
      };

      document.addEventListener("copy", (event) => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0 || !event.clipboardData) return;

        const resourceRanges = [];
        for (let index = 0; index < selection.rangeCount; index += 1) {
          const range = selection.getRangeAt(index);
          try {
            if (range.intersectsNode(resourcePage)) resourceRanges.push(range.cloneRange());
          } catch {
            return;
          }
        }

        if (!resourceRanges.length) return;

        const visibleText = getVisibleSelectionText(resourceRanges);
        // Preserve native image-only copying and avoid replacing an empty selection.
        if (!visibleText) return;

        const escapeHtml = (value) => value
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
        const htmlText = "<div>" + escapeHtml(visibleText).replace(/\n/g, "<br>") + "</div>";

        event.preventDefault();
        event.clipboardData.clearData();
        event.clipboardData.setData("text/plain", visibleText);
        event.clipboardData.setData("text/html", htmlText);
      }, true);
    })();

    const makePdf = (text, name) => {
      const cp1252Extra = new Map([
        [0x20AC, 0x80], [0x201A, 0x82], [0x0192, 0x83], [0x201E, 0x84],
        [0x2026, 0x85], [0x2020, 0x86], [0x2021, 0x87], [0x02C6, 0x88],
        [0x2030, 0x89], [0x0160, 0x8A], [0x2039, 0x8B], [0x0152, 0x8C],
        [0x017D, 0x8E], [0x2018, 0x91], [0x2019, 0x92], [0x201C, 0x93],
        [0x201D, 0x94], [0x2022, 0x95], [0x2013, 0x96], [0x2014, 0x97],
        [0x02DC, 0x98], [0x2122, 0x99], [0x0161, 0x9A], [0x203A, 0x9B],
        [0x0153, 0x9C], [0x017E, 0x9E], [0x0178, 0x9F]
      ]);
      const ascii = (value) => new TextEncoder().encode(value);
      const concatBytes = (parts) => {
        const total = parts.reduce((sum, part) => sum + part.length, 0);
        const output = new Uint8Array(total);
        let offset = 0;
        for (const part of parts) {
          output.set(part, offset);
          offset += part.length;
        }
        return output;
      };
      const winAnsiByte = (character) => {
        const code = character.codePointAt(0);
        if (code >= 0x20 && code <= 0x7E) return code;
        if (code >= 0xA0 && code <= 0xFF) return code;
        return cp1252Extra.get(code) ?? 0x3F;
      };
      const encodePdfText = (line) => {
        const bytes = [];
        for (const character of Array.from(line)) {
          const byte = winAnsiByte(character);
          if (byte === 0x28 || byte === 0x29 || byte === 0x5C) bytes.push(0x5C);
          bytes.push(byte);
        }
        return Uint8Array.from(bytes);
      };

      const wrappedLines = [];
      String(text ?? '').replace(/\r\n?/g, '\n').split('\n').forEach((sourceLine) => {
        let remaining = Array.from(sourceLine.replace(/\t/g, '    '));
        if (!remaining.length) {
          wrappedLines.push('');
          return;
        }
        while (remaining.length > 90) {
          let breakAt = -1;
          for (let index = 90; index > 0; index -= 1) {
            if (/\s/.test(remaining[index])) {
              breakAt = index;
              break;
            }
          }
          if (breakAt < 1) breakAt = 90;
          wrappedLines.push(remaining.slice(0, breakAt).join(''));
          remaining = remaining.slice(breakAt);
          while (remaining.length && remaining[0] === ' ') remaining.shift();
        }
        wrappedLines.push(remaining.join(''));
      });

      const linesPerPage = 54;
      const pages = [];
      for (let start = 0; start < wrappedLines.length; start += linesPerPage) {
        pages.push(wrappedLines.slice(start, start + linesPerPage));
      }
      if (!pages.length) pages.push(['']);

      const fontId = 3 + pages.length * 2;
      const objects = new Map();
      objects.set(1, ascii('<< /Type /Catalog /Pages 2 0 R >>'));
      const pageIds = pages.map((_, index) => 3 + index * 2);
      objects.set(2, ascii('<< /Type /Pages /Kids [' + pageIds.map((id) => id + ' 0 R').join(' ') + '] /Count ' + pages.length + ' >>'));

      pages.forEach((pageLines, index) => {
        const pageId = pageIds[index];
        const contentId = pageId + 1;
        objects.set(pageId, ascii('<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 ' + fontId + ' 0 R >> >> /Contents ' + contentId + ' 0 R >>'));

        const streamParts = [ascii('BT\n/F1 9 Tf\n50 750 Td\n12.8 TL\n')];
        pageLines.forEach((line, lineIndex) => {
          streamParts.push(ascii('('), encodePdfText(line), ascii(') Tj\n'));
          if (lineIndex < pageLines.length - 1) streamParts.push(ascii('T*\n'));
        });
        streamParts.push(ascii('ET\n'));

        const stream = concatBytes(streamParts);
        objects.set(contentId, concatBytes([
          ascii('<< /Length ' + stream.length + ' >>\nstream\n'),
          stream,
          ascii('endstream')
        ]));
      });

      objects.set(fontId, ascii('<< /Type /Font /Subtype /Type1 /BaseFont /Courier /Encoding /WinAnsiEncoding >>'));

      const header = ascii('%PDF-1.4\n');
      const fileParts = [header];
      const offsets = new Map();
      let fileLength = header.length;

      for (const [id, body] of [...objects.entries()].sort((a, b) => a[0] - b[0])) {
        const objectBytes = concatBytes([
          ascii(id + ' 0 obj\n'),
          body,
          ascii('\nendobj\n')
        ]);
        offsets.set(id, fileLength);
        fileParts.push(objectBytes);
        fileLength += objectBytes.length;
      }

      const xrefOffset = fileLength;
      const maxObjectId = fontId;
      let xref = 'xref\n0 ' + (maxObjectId + 1) + '\n0000000000 65535 f \n';
      for (let id = 1; id <= maxObjectId; id += 1) {
        xref += String(offsets.get(id)).padStart(10, '0') + ' 00000 n \n';
      }
      xref += 'trailer\n<< /Size ' + (maxObjectId + 1) + ' /Root 1 0 R >>\nstartxref\n' + xrefOffset + '\n%%EOF';

      fileParts.push(ascii(xref));
      const pdfBytes = concatBytes(fileParts);
      const blob = new Blob([pdfBytes], { type: 'application/pdf' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = (name || 'prompt') + '.pdf';
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 10000);
    };

    // Copy Prompt Button: Strictly fixed 82px width in both states so zero shift
    document.querySelectorAll("[data-copy-prompt]").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        e.preventDefault();
        const box = btn.closest(".tutorial-prompt-box") || btn.closest(".tutorial-step-card");
        const pre = box?.querySelector("[data-prompt-content]");
        const text = pre?.textContent?.trim() || "";
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = "Copied!";
          btn.classList.add("is-copied");
          setTimeout(() => {
            btn.textContent = "Copy";
            btn.classList.remove("is-copied");
          }, 1500);
        } catch {}
      });
    });

    // Download Prompt as PDF Button
    document.querySelectorAll("[data-download-prompt]").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        const box = btn.closest(".tutorial-prompt-box") || btn.closest(".tutorial-step-card");
        const pre = box?.querySelector("[data-prompt-content]");
        const text = pre?.textContent?.trim() || "";
        const name = btn.getAttribute("data-prompt-name") || "prompt";
        if (text) {
          try {
            makePdf(text, name);
            btn.classList.add("is-downloaded");
            window.setTimeout(() => btn.classList.remove("is-downloaded"), 1500);
          } catch {
            btn.classList.remove("is-downloaded");
          }
        }
      });
    });

    // Media Lightbox Modal Logic (No text on buttons, blur backdrop, locked background scrolling)
    (() => {
      const lightbox = document.getElementById("media-lightbox");
      const lightboxImg = document.getElementById("lightbox-img");
      const lightboxVideo = document.getElementById("lightbox-video");
      const lightboxPdf = document.getElementById("lightbox-pdf");
      const lightboxDownloadBtn = document.getElementById("lightbox-download-btn");

      const openLightbox = (src, type, name) => {
        if (!lightbox || !src) return;

        // Reset media
        if (lightboxImg) {
          lightboxImg.src = "";
          lightboxImg.style.display = "none";
        }
        if (lightboxVideo) {
          lightboxVideo.pause();
          lightboxVideo.removeAttribute("src");
          lightboxVideo.load();
          lightboxVideo.style.display = "none";
        }
        if (lightboxPdf) {
          lightboxPdf.removeAttribute("src");
          lightboxPdf.style.display = "none";
        }

        const isPdf = /\.pdf(?:[?#]|$)/i.test(src);
        const isVideo = type === "video" || /\.(mp4|webm)/i.test(src);
        if (isPdf && lightboxPdf) {
          lightboxPdf.src = src;
          lightboxPdf.style.display = "block";
        } else if (isVideo && lightboxVideo) {
          lightboxVideo.src = src;
          lightboxVideo.style.display = "block";
        } else if (lightboxImg) {
          lightboxImg.src = src;
          lightboxImg.alt = name || "Preview";
          lightboxImg.style.display = "block";
        }

        if (lightboxDownloadBtn) {
          lightboxDownloadBtn.setAttribute("href", src);
          const ext = isPdf ? "pdf" : (isVideo ? "mp4" : (src.split(".").pop()?.split(/[?#]/)[0] || "png"));
          const safeName = (name || "resource-asset").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
          lightboxDownloadBtn.setAttribute("download", `${safeName || "asset"}.${ext}`);
        }

        lightbox.classList.add("is-active");
        lightbox.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
      };

      const closeLightbox = () => {
        if (!lightbox) return;
        lightbox.classList.remove("is-active");
        lightbox.setAttribute("aria-hidden", "true");
        if (lightboxVideo) {
          lightboxVideo.pause();
          lightboxVideo.removeAttribute("src");
          lightboxVideo.load();
          lightboxVideo.style.display = "none";
        }
        if (lightboxPdf) {
          lightboxPdf.removeAttribute("src");
          lightboxPdf.style.display = "none";
        }
        if (lightboxImg) {
          lightboxImg.src = "";
          lightboxImg.style.display = "none";
        }
        document.body.style.overflow = "";
        document.documentElement.style.overflow = "";
      };

      // Open on click / keyboard for all media triggers
      document.querySelectorAll("[data-media-trigger]").forEach((trigger) => {
        const handleTrigger = (e) => {
          e.preventDefault();
          const src = trigger.getAttribute("data-media-src");
          const type = trigger.getAttribute("data-media-type") || "image";
          const name = trigger.getAttribute("data-media-name") || "resource-media";
          if (src) {
            openLightbox(src, type, name);
          }
        };

        trigger.addEventListener("click", handleTrigger);
        trigger.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            handleTrigger(e);
          }
        });
      });

      // Close buttons and backdrop click
      document.querySelectorAll("[data-close-lightbox]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          closeLightbox();
        });
      });

      // Close on Escape key
      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && lightbox?.classList.contains("is-active")) {
          closeLightbox();
        }
      });

      // Direct download trigger for the lightbox download button
      if (lightboxDownloadBtn) {
        lightboxDownloadBtn.addEventListener("click", async (e) => {
          const url = lightboxDownloadBtn.getAttribute("href");
          const filename = lightboxDownloadBtn.getAttribute("download") || "resource-download";
          if (!url || url === "#") return;

          try {
            e.preventDefault();
            const response = await fetch(url);
            if (!response.ok) throw new Error("Fetch failed");
            const blob = await response.blob();
            const blobUrl = URL.createObjectURL(blob);
            const tempA = document.createElement("a");
            tempA.href = blobUrl;
            tempA.download = filename;
            document.body.appendChild(tempA);
            tempA.click();
            tempA.remove();
            setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
          } catch (err) {
            window.location.href = url;
          }
        });
      }

      // Step navigation: show only the selected workflow card.
      const workflowStepNav = document.querySelector("[data-workflow-step-nav]");
      if (workflowStepNav) {
        const stepButtons = Array.from(workflowStepNav.querySelectorAll("[data-workflow-step-button]"));
        const stepCards = Array.from(document.querySelectorAll("[data-workflow-step-card]"));
        const visibleStepCount = Math.min(4, stepButtons.length);
        workflowStepNav.dataset.stepCount = String(stepButtons.length);

        // Keep four consecutive steps visible. The window advances until the
        // final four steps are reached, then stays in place for later selections.
        const syncWorkflowStepNav = (selectedIndex, behavior = "smooth") => {
          const lastWindowStart = Math.max(0, stepButtons.length - visibleStepCount);
          const firstVisibleIndex = Math.min(selectedIndex, lastWindowStart);
          const firstVisibleButton = stepButtons[firstVisibleIndex];
          if (!firstVisibleButton) return;
          const navRect = workflowStepNav.getBoundingClientRect();
          const buttonRect = firstVisibleButton.getBoundingClientRect();
          const targetLeft = workflowStepNav.scrollLeft + buttonRect.left - navRect.left;
          workflowStepNav.scrollTo({ left: Math.max(0, targetLeft), behavior });
        };

        const activateWorkflowStep = (index, moveFocus = false) => {
          if (index < 0 || index >= stepButtons.length || !stepCards[index]) return;
          stepButtons.forEach((button, i) => {
            const active = i === index;
            button.setAttribute("aria-selected", active ? "true" : "false");
            button.tabIndex = active ? 0 : -1;
          });
          stepCards.forEach((card, i) => {
            const active = i === index;
            card.hidden = !active;
            card.setAttribute("aria-hidden", active ? "false" : "true");
            card.classList.toggle("is-active", active);
          });
          requestAnimationFrame(() => syncWorkflowStepNav(index, moveFocus ? "smooth" : "auto"));
          if (moveFocus) stepButtons[index].focus();
        };
        const selectedIndex = stepButtons.findIndex((button) => button.getAttribute("aria-selected") === "true");
        activateWorkflowStep(selectedIndex < 0 ? 0 : selectedIndex);
        stepButtons.forEach((button,index) => {
          button.addEventListener("click", () => activateWorkflowStep(index));
          button.addEventListener("keydown", (event) => {
            let next = index;
            if (event.key === "ArrowRight") next = (index + 1) % stepButtons.length;
            else if (event.key === "ArrowLeft") next = (index - 1 + stepButtons.length) % stepButtons.length;
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = stepButtons.length - 1;
            else return;
            event.preventDefault();
            activateWorkflowStep(next,true);
          });
        });
      }

      // Guide / Details tabs within each step.
      document.querySelectorAll("[data-step-disclosure]").forEach((disclosure) => {
        const tabButtons = Array.from(disclosure.querySelectorAll('[role="tab"][data-step-panel-toggle]'));
        const panels = Array.from(disclosure.querySelectorAll("[data-step-panel]"));
        if (!tabButtons.length) return;
        const activateInfoTab = (selectedButton, moveFocus = false) => {
          const name = selectedButton.getAttribute("data-panel");
          const activePanel = panels.find((panel) => panel.getAttribute("data-step-panel") === name);
          if (!activePanel) return;
          tabButtons.forEach((button) => {
            const active = button === selectedButton;
            button.setAttribute("aria-selected", active ? "true" : "false");
            button.tabIndex = active ? 0 : -1;
          });
          panels.forEach((panel) => {
            const active = panel === activePanel;
            panel.setAttribute("aria-hidden", active ? "false" : "true");
            if (active) {
              panel.removeAttribute("inert");
              panel.setAttribute("tabindex","0");
            } else {
              panel.setAttribute("inert","");
              panel.setAttribute("tabindex","-1");
            }
          });
          if (moveFocus) selectedButton.focus();
        };
        const selected = tabButtons.find((button) => button.getAttribute("aria-selected") === "true") || tabButtons[0];
        activateInfoTab(selected);
        tabButtons.forEach((button,index) => {
          button.addEventListener("click", () => activateInfoTab(button));
          button.addEventListener("keydown", (event) => {
            let next=index;
            if(event.key==="ArrowRight") next=(index+1)%tabButtons.length;
            else if(event.key==="ArrowLeft") next=(index-1+tabButtons.length)%tabButtons.length;
            else if(event.key==="Home") next=0;
            else if(event.key==="End") next=tabButtons.length-1;
            else return;
            event.preventDefault();
            activateInfoTab(tabButtons[next],true);
          });
        });
      });
    })();
  </script>

  <style>
    /* ==========================================================================
       EDITORIAL VISUAL HIERARCHY — PURE BLACK (#050505), SUBTLE BORDERS, COMPACT
       ========================================================================== */

    /* Core container: use the shared theme canvas so this page follows day/night mode. */
    .resource-editorial-layout {
      width: 100%;
      background-color: var(--sf-page-bg, #050505);
      color: var(--sf-page-heading, #F5F5F5);
      box-sizing: border-box;
      overflow-x: hidden;
      padding-bottom: 0;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .container {
      width: 100%;
      margin: 0 auto;
      box-sizing: border-box;
      padding: 0 18px;
    }

    .container.narrow {
      max-width: 780px;
    }

    .container.content-wide {
      max-width: 920px;
    }

    /* Major Section Headings — Controlled, crisp hierarchy */
    .editorial-heading-title {
      font-size: clamp(17px, 2.2vw, 19px);
      line-height: 1.3;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -0.01em;
      margin: 0;
    }

    .section-title-wrap {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 8px;
    }

    /* Small Accent Bar: professional vertical indicator preceding section title */
    .section-accent-bar {
      display: inline-block;
      width: 3.5px;
      height: 16px;
      background: #FACC15;
      border-radius: 2px;
      flex-shrink: 0;
    }

    .section-heading-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }

    /* Subtle Yellow Accent Bar: used selectively on workflow title and final result */
    .yellow-accent-bar {
      display: inline-block;
      width: 4px;
      height: 20px;
      background: #FACC15;
      border-radius: 2px;
      flex-shrink: 0;
    }

    /* Internal Step Section Headings (TOOL, UPLOAD, PROMPT, OUTPUT, INSTRUCTIONS) — consistent subsection labels */
    .step-subheading-label {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.05em;
