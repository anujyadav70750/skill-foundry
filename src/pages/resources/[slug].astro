      transform: translate(4px, 1px);
      opacity: 1;
    }

    .related-horizontal-row {
      display: flex;
      gap: 18px;
      overflow-x: auto;
      padding: 3px 1px 8px;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .related-horizontal-row::-webkit-scrollbar {
      display: none;
    }

    .related-work-card {
      flex: 0 0 calc((100% - 40px) / 3.25);
      width: calc((100% - 40px) / 3.25);
      min-width: 250px;
      max-width: 380px;
      background: #0B0D12;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      overflow: hidden;
      text-decoration: none;
      display: flex;
      flex-direction: column;
      padding: 14px;
      color: inherit;
      scroll-snap-align: start;
      transition: border-color 0.2s ease;
    }

    .related-work-card:hover {
      border-color: rgba(255, 255, 255, 0.18);
    }

    .related-work-thumb-wrap {
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: #04070D;
      border-radius: 10px;
    }

    .related-work-thumb-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .related-work-card:hover .related-work-thumb-img {
      transform: scale(1.03);
    }

    .related-work-card-body {
      padding: 12px 0 0;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .related-work-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 9px;
      font-size: 11px;
    }

    .related-work-meta-category {
      color: #CBD5E1;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 9999px;
      padding: 3px 9px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.08em;
      line-height: 1.2;
      text-transform: uppercase;
      white-space: nowrap;
