      display: block;
    }

    .meta-date-text {
      font-size: 13px;
      color: #8C92A0;
      line-height: 1.2;
    }

    /* Resource Description: Quieter supporting text below metadata */
    .resource-header-description {
      margin: 0 0 18px;
    }

    .resource-description-lead {
      font-size: 14.5px;
      font-weight: 400;
      line-height: 1.6;
      color: #A6ABB6;
      margin: 0;
      max-width: 720px;
    }

    /* Professional Informational Section Containers (Cards above workflow) */
    .article-layout .resource-editorial-section {
      background: #0B0D12;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 18px 16px;
      margin-top: 0;
      margin-bottom: 14px;
      box-sizing: border-box;
      width: 100%;
    }

    @media (min-width: 641px) {
      .article-layout .resource-editorial-section {
        padding: 22px 20px;
        margin-bottom: 16px;
        border-radius: 16px;
      }
    }

    /* Tools Used (Clean compact 2-column mobile grid: square logo box + tool name underneath) */
    .tools-compact-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
      width: 100%;
      box-sizing: border-box;
    }

    @media (min-width: 641px) {
      .tools-compact-grid {
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }
    }

    .tool-grid-card {
      background: #111318;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 12px;
      padding: 14px 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
      text-align: center;
      transition: background 0.15s ease, border-color 0.15s ease;
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    .tool-grid-card:hover {
      background: #141720;
      border-color: rgba(255, 255, 255, 0.16);
    }

    /* 3D Physical Button for App Logo: surface fills full rounded square with subtle depth & highlight */
    .tool-logo-box {
      width: 48px;
      height: 48px;
      min-width: 48px;
      min-height: 48px;
      border-radius: 12px;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      padding: 0 !important;
      box-sizing: border-box;
      background: #0B0E14;
      border: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 
        inset 0 1px 0 rgba(255, 255, 255, 0.28),
        inset 0 -2px 0 rgba(0, 0, 0, 0.5),
        0 3px 0 rgba(0, 0, 0, 0.4),
        0 6px 12px -2px rgba(0, 0, 0, 0.55);
      transform: translateY(0);
      transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.15s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.15s ease;
      cursor: pointer;
    }

    .tool-grid-card:hover .tool-logo-box,
    .tool-logo-box:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 255, 255, 0.25);
      box-shadow: 
        inset 0 1px 0 rgba(255, 255, 255, 0.35),
        inset 0 -2px 0 rgba(0, 0, 0, 0.55),
        0 5px 0 rgba(0, 0, 0, 0.45),
        0 10px 18px -2px rgba(0, 0, 0, 0.65);
    }

    .tool-grid-card:active .tool-logo-box,
    .tool-logo-box:active {
      transform: translateY(1px);
      box-shadow: 
        inset 0 1px 0 rgba(255, 255, 255, 0.15),
        inset 0 -1px 0 rgba(0, 0, 0, 0.4),
        0 1px 0 rgba(0, 0, 0, 0.4),
        0 2px 4px rgba(0, 0, 0, 0.45);
    }

    .tool-grid-logo {
      width: 100% !important;
      height: 100% !important;
      min-width: 100% !important;
      min-height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      object-fit: cover !important;
      display: block !important;
      border-radius: 0 !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      pointer-events: none;
    }

    .tool-grid-name {
      color: #F5F5F5;
      font-size: 13px;
      font-weight: 600;
      line-height: 1.25;
    }

    /* ==========================================================================
       TUTORIAL WORKFLOW SECTION
       ========================================================================== */
    /* ==========================================================================
       LIGHT TRANSPARENT BLUE WORKFLOW INTRODUCTION CALLOUT
       Frameless light transparent blue callout that creates visual boundary
       purely through its contrasting color fill without any outline border.
       ========================================================================== */
    .blueprint-callout-box.workflow-intro-open {
      background: transparent !important;
      background-image: none !important;
      border: none !important;
      border-radius: 0;
      padding: 12px 8px 0;
      margin-top: 4px;
      margin-bottom: 22px;
      box-sizing: border-box;
      width: 100%;
      box-shadow: none !important;
      text-align: center;
    }

    @media (min-width: 641px) {
      .blueprint-callout-box.workflow-intro-open {
        padding: 16px 12px 0;
        margin-bottom: 24px;
      }
    }

    .blueprint-callout-box.workflow-intro-open .section-title-wrap {
      justify-content: center;
      margin-bottom: 5px;
    }

    .blueprint-callout-box.workflow-intro-open .section-accent-bar {
      display: none;
    }

     .blueprint-callout-title {
      font-size: 21px;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -0.02em;
      margin: 0;
      line-height: 1.3;
      text-align: center;
    }

    .blueprint-callout-title span { color: #35C9C1; }

    @media (min-width: 641px) {
      .blueprint-callout-title { font-size: 23px; }
    }

    .blueprint-callout-desc {
      color: #A1A9B6;
      font-size: 13px;
