  <script is:inline>
    (() => {
      const keepAnchor = () => window.location.hash;
      const navigationType = () => {
        try {
          return performance.getEntriesByType('navigation')[0]?.type || 'navigate';
        } catch {
          return 'navigate';
        }
      };
      const resetFreshResourcePosition = () => {
        if (keepAnchor()) return;
        if (navigationType() === 'back_forward') return;
        window.scrollTo(0, 0);
      };
      try {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      } catch {}
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', resetFreshResourcePosition, { once: true });
      } else {
        resetFreshResourcePosition();
      }
      window.addEventListener('pageshow', resetFreshResourcePosition);
    })();
  </script>
