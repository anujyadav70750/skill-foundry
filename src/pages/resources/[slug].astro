---
import yaml from 'js-yaml';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceHeroImage, resourceImageAlt, resourceResultImages, resourceSlug, resourceThumbnail } from '../../lib/resource';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resourceSlug(resource) }, props: { resource } }));
}

const { resource } = Astro.props;
// data will be initialized after checking GitHub
const slug = resourceSlug(resource);
const isTesting1 = slug === 'testing-1';
let data = resource.data;
let body = resource.body;

if (isTesting1) {
  try {
    const ghRes = await fetch('https://raw.githubusercontent.com/anujyadav70750/skill-foundry/main/src/content/resources/testing-1.md', {
      headers: { 'Cache-Control': 'no-cache' }
    });
    if (ghRes.ok) {
      const rawText = await ghRes.text();
      const match = rawText.match(/^---\r?\n([\s\S]+?)\r?\n---(?:\r?\n([\s\S]*))?$/);
      if (match) {
        const parsed = yaml.load(match[1]);
        if (parsed) {
          data = {
            ...data,
            ...parsed,
            date: parsed.date ? new Date(parsed.date) : data.date,
            toolsUsed: Array.isArray(parsed.toolsUsed) ? parsed.toolsUsed : data.toolsUsed,
            steps: Array.isArray(parsed.steps) ? parsed.steps : data.steps,
            tips: Array.isArray(parsed.tips) ? parsed.tips : data.tips,
            tags: Array.isArray(parsed.tags) ? parsed.tags : data.tags,
            relatedResources: Array.isArray(parsed.relatedResources) ? parsed.relatedResources : data.relatedResources,
          };
          if (match[2]) {
            body = match[2];
          }
        }
      }
    }
  } catch (err) {
    console.error('Failed to fetch testing-1 from GitHub, using local fallback:', err);
  }
}

const resultImages = resourceResultImages(resource);

const parseLegacy = (value) => {
  const marker = '[[SF_INPUTS]]';
  const raw = String(value || '').trim();
  if (!raw.startsWith(marker)) return { inputs: [], settings: [], toolPurpose: '' };
  try {
    const parsed = JSON.parse(raw.slice(marker.length));
    return {
      inputs: Array.isArray(parsed.inputs) ? parsed.inputs : [],
      settings: Array.isArray(parsed.settings) ? parsed.settings : [],
      toolPurpose: String(parsed.toolPurpose || '').trim()
    };
  } catch {
    return { inputs: [], settings: [], toolPurpose: '' };
  }
};

const findTool = (name) => data.toolsUsed.find((tool) => tool.name.trim().toLowerCase() === String(name || '').trim().toLowerCase());

const inferActionType = (step) => {
  if (step.actionType) return step.actionType;
  const process = String(step.process || '');
  if (/^\s*(import|arrange|trim|combine|merge|export|upload|download|organize)/i.test(process)) return 'instructions';
  return 'prompt';
};
const inferOutputType = (step) => {
  if (step.outputType) return step.outputType;
  const value = String(step.output || '').toLowerCase();
  if (value.includes('video')) return 'video';
  if (value.includes('image')) return 'image';
  if (value.includes('audio')) return 'audio';
  if (value.includes('document') || value.includes('pdf')) return 'document';
  return 'text';
};
const workflowSteps = data.steps.map((step) => {
  const legacy = parseLegacy(step.input);
  const toolName = String(step.tool || data.tool || '').trim();
  const toolMeta = findTool(toolName);
  const actionType = inferActionType(step);
  const outputType = inferOutputType(step);
  return {
    ...step,
    tool: toolName,
    toolPurpose: String(step.toolPurpose || legacy.toolPurpose || toolMeta?.purpose || '').trim(),
    inputs: step.inputs?.length ? step.inputs : legacy.inputs,
    settings: (step.settings?.length ? step.settings : legacy.settings).filter((setting) => String(setting?.label || '').trim().toLowerCase() !== 'output'),
    actionType,
    outputType,
    outputLabel: String(step.outputLabel || step.output || 'Output from this step').trim(),
    outputDescription: String(step.outputDescription || 'Output from this step').trim(),
    outputSrc: String(step.outputSrc || '').trim(),
    instructionItems: actionType === 'instructions'
      ? String(step.process || step.description || '').split(/\n+/).map((item) => item.trim()).filter(Boolean)
      : [],
    toolMeta
  };
});

// Tools & Resources is derived from the workflow itself: every unique tool used by a step appears once.
const tools = workflowSteps
  .map((step) => step.toolMeta || (step.tool ? { name: step.tool, purpose: step.toolPurpose, url: '' } : null))
  .filter(Boolean)
  .filter((tool, index, list) => list.findIndex((candidate) => candidate.name.trim().toLowerCase() === tool.name.trim().toLowerCase()) === index);

const toolLogo = (tool) => {
  try {
    const rawName = String(tool?.name || '').toLowerCase();
    const rawUrl = String(tool?.url || '').toLowerCase();
    if (rawName.includes('flow') || rawUrl.includes('flow.google')) return '/google-flow-icon.svg';
    if (rawName.includes('capcut') || rawUrl.includes('capcut.com')) return '/capcut-icon.svg';
    const host = new URL(tool?.url || '').hostname;
    return host ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=128` : '/skill-foundry-resource-icon.svg';
  } catch {
    return '/skill-foundry-resource-icon.svg';
  }
};

const mediaTypeFromUrl = (src) => {
  const value = String(src || '').toLowerCase();
  if (/\.(mp4|webm|mov|m4v)(?:\?|$)/.test(value)) return 'video';
  if (/\.(mp3|wav|ogg|m4a|aac)(?:\?|$)/.test(value)) return 'audio';
  if (/\.(pdf|doc|docx|txt)(?:\?|$)/.test(value)) return 'document';
  return 'image';
};

const outputVisual = (step, index) => {
  const raw = String(step.output || '').trim();
  const type = step.outputType || mediaTypeFromUrl(String(step.outputSrc || '')) || (
    /video/i.test(raw) ? 'video' :
    /image/i.test(raw) ? 'image' :
    /audio/i.test(raw) ? 'audio' :
    /document|pdf/i.test(raw) ? 'document' : 'text'
  );
  if (step.outputSrc) return { type, src: step.outputSrc, previewSrc: '', label: step.outputLabel || raw || 'Output from this step' };
  if (/^https?:\/\//i.test(raw)) return { type: mediaTypeFromUrl(raw), src: raw, previewSrc: '', label: raw };
  const next = workflowSteps[index + 1];
  const linked = next?.inputs?.find((input) => input?.src && ((step.outputLabel && input?.label?.toLowerCase() === step.outputLabel.toLowerCase()) || (input.type === type || !type)));
  if (linked?.src) return { type: linked.type || type, src: linked.src, previewSrc: '', label: step.outputLabel || raw || linked.label || 'Step output' };
  const previewSrc = step.outputPreviewSrc || (index === workflowSteps.length - 1 && resultImages[0] ? resultImages[0] : '');
  return { type, src: '', previewSrc, label: step.outputLabel || raw || 'Output produced by this step' };
};

const isRealVideo = (src) => mediaTypeFromUrl(src) === 'video';
const isRealAudio = (src) => mediaTypeFromUrl(src) === 'audio';

const getHandoffText = (currentStep, nextStep, stepIndex) => {
  if (currentStep.handoff) return String(currentStep.handoff).trim();
  if (currentStep.transition) return String(currentStep.transition).trim();
  if (currentStep.transitionInstruction) return String(currentStep.transitionInstruction).trim();

  const outVisual = outputVisual(currentStep, stepIndex);
  const rawLabel = String(currentStep.outputLabel || currentStep.output || outVisual.label || 'generated result').trim();
  const cleanLabel = rawLabel
    .replace(/^Output(?:\s+produced\s+by\s+this\s+step)?/i, '')
    .replace(/^Output\s*[:\-]\s*/i, '')
    .trim() || 'result';

  const nextStepNum = String(stepIndex + 2).padStart(2, '0');

  const matchingInput = nextStep?.inputs?.find((inp) => {
    const inpLabel = String(inp.label || inp.role || '').toLowerCase();
    const cl = cleanLabel.toLowerCase();
    return inpLabel && (cl.includes(inpLabel) || inpLabel.includes(cl));
  });

  if (matchingInput) {
    const roleName = String(matchingInput.role || matchingInput.label || 'input').trim();
    return `Use this ${cleanLabel} as the ${roleName} for Step ${nextStepNum}.`;
  }

  return `Use this generated ${cleanLabel} as the reference for Step ${nextStepNum}.`;
};

const allResources = await getCollection('resources');
const related = (data.relatedResources.length > 0
  ? data.relatedResources.flatMap((relatedSlug) => {
      const normalizedSlug = relatedSlug.trim().toLowerCase();
      const item = allResources.find((candidate) => resourceSlug(candidate).trim().toLowerCase() === normalizedSlug);
      return item && item.id !== resource.id ? [item] : [];
    })
  : allResources
      .filter((item) => item.id !== resource.id)
      .map((item) => ({ item, score: (item.data.category === data.category ? 3 : 0) + item.data.tags.filter((tag) => data.tags.includes(tag)).length }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .map(({ item }) => item)
).slice(0, 3);

const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`/resources/${slug}/`, site).href;
const seoTitle = data.seoTitle ?? `${data.title} | Skill Foundry`;
const seoDescription = data.seoDescription ?? data.description;
const heroImage = resourceHeroImage(resource);
const imageAlt = resourceImageAlt(resource);
const absoluteImage = new URL(heroImage, site).href;
const authorName = (data as any).author || 'Skill Foundry';
const authorAvatar = (data as any).authorAvatar || (data as any).authorImage || (data as any).authorDp || '/favicon.svg';
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', headline: data.title, description: data.description, datePublished: data.date.toISOString(), dateModified: data.date.toISOString(), articleSection: data.category, url: canonicalUrl, mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl }, image: [absoluteImage], author: { '@type': 'Organization', name: 'Skill Foundry' }, publisher: { '@type': 'Organization', name: 'Skill Foundry' }, keywords: data.tags.join(', ') },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', site).href },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl }
  ] }
] };
---
<BaseLayout title={seoTitle} description={seoDescription} canonical={canonicalUrl} image={heroImage} imageAlt={imageAlt} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <style is:global>
    body:has(.testing-1-theme) {
        background: #EEF4F9 !important;
        color: #0F172A !important;
        padding-top: 0 !important;
      }
      @media (max-width: 700px) {
        body:has(.testing-1-theme) {
          padding-top: 0 !important;
        }
      }
      body:has(.testing-1-theme) .site-header {
        position: fixed !important;
        top: 16px !important;
        left: 50% !important;
        right: auto !important;
        transform: translateX(-50%) !important;
        width: min(calc(100% - 36px), 1160px) !important;
        border-radius: 9999px !important;
        border: 1px solid rgba(255, 255, 255, 0.12) !important;
        background: rgba(11, 17, 26, 0.95) !important;
        backdrop-filter: blur(16px) !important;
        -webkit-backdrop-filter: blur(16px) !important;
        box-shadow: 0 12px 36px -4px rgba(0, 0, 0, 0.2), 0 4px 12px rgba(0, 0, 0, 0.1) !important;
        z-index: 1000 !important;
        overflow: visible !important;
      }
      @media (max-width: 700px) {
        body:has(.testing-1-theme) .site-header {
          top: 8px !important;
          left: 50% !important;
          right: auto !important;
          transform: translateX(-50%) !important;
          width: min(calc(100% - 20px), 520px) !important;
          border-radius: 9999px !important;
          background: rgba(8, 12, 20, 0.96) !important;
          backdrop-filter: blur(20px) !important;
          -webkit-backdrop-filter: blur(20px) !important;
          border: 1px solid rgba(255, 255, 255, 0.12) !important;
          box-shadow: 0 10px 28px -4px rgba(0, 0, 0, 0.35), 0 2px 8px rgba(0, 0, 0, 0.2) !important;
        }
      }
      body:has(.testing-1-theme) .site-header .nav-wrap {
        min-height: 62px !important;
        padding: 0 20px !important;
        gap: 16px !important;
      }
      @media (max-width: 700px) {
        body:has(.testing-1-theme) .site-header .nav-wrap {
          min-height: 42px !important;
          height: 42px !important;
          padding: 0 6px 0 10px !important;
          gap: 8px !important;
        }
      }
      body:has(.testing-1-theme) .site-header .brand span:last-child {
        color: #FFFFFF !important;
        font-weight: 800 !important;
        letter-spacing: 0.12em !important;
      }
      @media (max-width: 700px) {
        body:has(.testing-1-theme) .site-header .brand {
          font-size: 10px !important;
          gap: 6px !important;
          flex-shrink: 0 !important;
        }
        body:has(.testing-1-theme) .site-header .brand span:last-child {
          font-size: 9.5px !important;
          letter-spacing: 0.06em !important;
          line-height: 1.1 !important;
        }
        body:has(.testing-1-theme) .site-header .brand-mark {
          width: 26px !important;
          height: 26px !important;
          min-width: 26px !important;
          border-radius: 8px !important;
          font-size: 9.5px !important;
        }
      }
      body:has(.testing-1-theme) .site-header .brand-mark {
        background: rgba(255, 102, 0, 0.15) !important;
        border-color: rgba(255, 102, 0, 0.55) !important;
        color: #FF6600 !important;
        font-weight: 800 !important;
      }
      body:has(.testing-1-theme) .site-header .header-search-form {
        background: rgba(255, 255, 255, 0.08) !important;
        border: 1px solid rgba(255, 255, 255, 0.14) !important;
        color: #94A3B8 !important;
        border-radius: 9999px !important;
      }
      @media (max-width: 700px) {
        body:has(.testing-1-theme) .site-header .header-search-form {
          flex: 1 1 auto !important;
          min-width: 0 !important;
          width: auto !important;
          max-width: 220px !important;
          min-height: 30px !important;
          height: 30px !important;
          padding: 0 3px 0 10px !important;
          gap: 4px !important;
        }
        body:has(.testing-1-theme) .site-header .header-search-form input {
          font-size: 11.5px !important;
        }
        body:has(.testing-1-theme) .site-header .header-search-form input::placeholder {
          font-size: 11px !important;
        }
        body:has(.testing-1-theme) .site-header .header-search-submit {
          width: 24px !important;
          height: 24px !important;
          min-width: 24px !important;
          background: transparent !important;
          border: none !important;
        }
        body:has(.testing-1-theme) .site-header .header-search-submit .search-svg {
          width: 13px !important;
          height: 13px !important;
        }
        body:has(.testing-1-theme) .site-header .nav-actions {
          gap: 6px !important;
          flex: 1 1 auto !important;
          justify-content: flex-end !important;
          min-width: 0 !important;
        }
        body:has(.testing-1-theme) .site-header .menu-toggle {
          width: 30px !important;
          height: 30px !important;
          min-width: 30px !important;
          gap: 3px !important;
        }
        body:has(.testing-1-theme) .site-header .menu-toggle span {
          width: 12px !important;
          height: 1.5px !important;
        }
      }
      body:has(.testing-1-theme) .site-header .header-search-form input {
        color: #FFFFFF !important;
      }
      body:has(.testing-1-theme) .site-header .header-search-form input::placeholder {
        color: #94A3B8 !important;
      }
      body:has(.testing-1-theme) .site-header .header-search-submit {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: rgba(255, 255, 255, 0.14) !important;
        color: #E2E8F0 !important;
        border-radius: 9999px !important;
      }
      body:has(.testing-1-theme) .site-header .header-search-submit:hover {
        background: rgba(255, 102, 0, 0.2) !important;
        border-color: #FF6600 !important;
        color: #FF6600 !important;
      }
      body:has(.testing-1-theme) .site-header .menu-toggle {
        background: rgba(255, 255, 255, 0.08) !important;
        border-color: rgba(255, 255, 255, 0.14) !important;
        border-radius: 9999px !important;
      }
      body:has(.testing-1-theme) .site-header .menu-toggle span {
        background: #E2E8F0 !important;
      }
      body:has(.testing-1-theme) .site-header .menu-toggle:hover span,
      body:has(.testing-1-theme) .site-header .menu-toggle[aria-expanded="true"] span {
        background: #FF6600 !important;
      }
      body:has(.testing-1-theme) .site-menu {
        background: rgba(13, 21, 32, 0.98) !important;
        border-color: #1E293B !important;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.45) !important;
        border-radius: 16px !important;
      }
      body:has(.testing-1-theme) .site-menu a {
        color: #CBD5E1 !important;
      }
      body:has(.testing-1-theme) .site-menu a:hover {
        background: rgba(255, 102, 0, 0.12) !important;
        color: #FF6600 !important;
      }
      body:has(.testing-1-theme) .site-footer {
        background: #0A100E !important;
        border-top: 1px solid rgba(255, 255, 255, 0.08) !important;
        color: #94A3B8 !important;
      }
      body:has(.testing-1-theme) .site-footer .footer-brand span.brand-name {
        color: #FFFFFF !important;
      }
      body:has(.testing-1-theme) .site-footer .footer-descriptors .descriptor-item {
        color: #CBD5E1 !important;
      }
      body:has(.testing-1-theme) .site-footer .footer-nav a {
        color: #FFFFFF !important;
      }
      body:has(.testing-1-theme) .site-footer .footer-nav a:hover {
        color: #FF6600 !important;
      }
      body:has(.testing-1-theme) .site-footer .footer-legal a {
        color: #94A3B8 !important;
      }
      body:has(.testing-1-theme) .site-footer .footer-legal a:hover {
        color: #FF6600 !important;
      }
      body:has(.testing-1-theme) .site-footer .footer-copyright {
        color: #64748B !important;
      }
    </style>
  <div class={isTesting1 ? "testing-1-theme" : ""}>
    <article class="resource-page">
    {isTesting1 ? (
      <section class="resource-hero-unified-section">
        <div class="container narrow hero-unified-header">
          <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span>{data.category}</span></div>
          <p class="eyebrow">{data.tool} • {data.category}</p>
          <h1>{data.title}</h1>
          <div class="publisher-identity">
            <div class="publisher-avatar-box">
              <img class="publisher-avatar" src={authorAvatar} alt={authorName} width="44" height="44" />
            </div>
            <div class="publisher-details">
              <div class="publisher-name-row"><strong>{authorName}</strong><span class="publisher-verification" aria-label="Verified publisher"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10"/><path d="M5.3 10.2 8.3 13.1 14.8 6.7"/></svg></span></div>
              <span class="publisher-meta">Published {data.date.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' })}</span>
            </div>
          </div>
        </div>

        <div class="container content-wide hero-image-wrap">
          <img class="hero-image" src={heroImage} alt={imageAlt}/>
        </div>

        <div class="container narrow resource-hero-description">
          <section class="resource-description">
            <p class="lead">{data.description}</p>
          </section>
        </div>
      </section>
    ) : (
      <>
        <div class="container narrow resource-intro">
          <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span>{data.category}</span></div>
          <p class="eyebrow">{data.tool} • {data.category}</p>
          <h1>{data.title}</h1>
          <div class="publisher-identity">
            <div class="publisher-avatar-box">
              <img class="publisher-avatar" src={authorAvatar} alt={authorName} width="44" height="44" />
            </div>
            <div class="publisher-details">
              <div class="publisher-name-row"><strong>{authorName}</strong><span class="publisher-verification" aria-label="Verified publisher"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10"/><path d="M5.3 10.2 8.3 13.1 14.8 6.7"/></svg></span></div>
              <span class="publisher-meta">Published {data.date.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' })}</span>
            </div>
          </div>
        </div>
        <div class="container content-wide resource-hero-media"><img class="hero-image" src={heroImage} alt={imageAlt}/></div>
        <div class="container narrow resource-hero-description"><section class="resource-description"><p class="lead">{data.description}</p></section></div>
      </>
    )}

    <div class="container narrow article-layout resource-content">
      <a href={data.intro ? "#intro" : "#workflow"} class="guide-cue" aria-label="Follow the step-by-step workflow blueprint below">
        <svg class="guide-cue-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6L8 10.5L12.5 6"/></svg>
        <span class="guide-cue-text">START HERE • FOLLOW THE WORKFLOW IN ORDER</span>
        <svg class="guide-cue-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6L8 10.5L12.5 6"/></svg>
      </a>

      {data.intro && <section class="resource-section intro-section" id="intro"><div class="section-heading"><div><p class="eyebrow">INTRODUCTION</p><h2>Start here</h2></div></div><p class="section-lead">{data.intro}</p></section>}

      {data.whatItDoes && <section class="resource-section"><div class="section-heading"><div><p class="eyebrow">AT A GLANCE</p><h2>What this resource does</h2></div></div><p class="section-lead">{data.whatItDoes}</p></section>}

      {tools.length > 0 && <section class="resource-section tools-section" id="tools"><div class="section-heading"><div><p class="eyebrow">TOOLS &amp; RESOURCES</p><h2>Tools used</h2><p class="section-subcopy">Every app and AI tool used throughout this resource.</p></div></div><div class="tools-list">{tools.map((tool) => <a class="tool-card" href={tool.url || '#'} target={tool.url ? '_blank' : undefined} rel={tool.url ? 'noopener noreferrer' : undefined} aria-label={`Open ${tool.name}`} title={tool.name}><img class="tool-logo" src={toolLogo(tool)} alt={`${tool.name} logo`} width="64" height="64" loading="lazy"/></a>)}</div></section>}

      {workflowSteps.length > 0 && <section class="resource-section workflow-section blueprint-workflow-section" id="workflow">
        <div class="section-heading">
          <div>
            <p class="eyebrow">WORKFLOW BLUEPRINT</p>
            <h2>From input to final result</h2>
            <p class="section-subcopy">Follow the creation sequence from the starting resources to the final result.</p>
          </div>
        </div>

        <div class="blueprint-workflow-container" aria-label="Connected Workflow Blueprint">
          <div class="blueprint-header-capsule">
            <span class="blueprint-capsule-label">
              <svg class="blueprint-stack-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
