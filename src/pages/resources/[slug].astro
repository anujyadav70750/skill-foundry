  {related.length > 0 && <section class="section section-muted related-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Related resources</h2></div><a href="/resources/">View library →</a></div><div class="resource-grid">{related.map((item)=>{const relatedSlug=resourceSlug(item);return <a class="resource-card" href={`/resources/${relatedSlug}/`}><img src={resourceThumbnail(item)} alt={resourceImageAlt(item)}/><div class="card-body"><span class="tag">{item.data.category}</span><h3>{item.data.title}</h3><p>{item.data.description}</p><span class="card-link">Open resource →</span></div></a>})}</div></div></section>}
  <section class="section section-cta resource-cta"><div class="container"><div class="cta-card"><div><h2>Build the skill, then make it your own.</h2><p>Explore practical resources, build useful skills, and put what you learn into practice.</p></div><a class="button button-primary" href="/resources/">Explore resources →</a></div></div></section>
  </div>

  <script>
    const makePdf = (text, name) => {
      const clean = (s) => String(s).replace(/[^\x20-\x7E]/g, '?').replace(/\\/g, '\\\\').replace(/\(/g, '\\(').replace(/\)/g, '\\)');
      const lines = [];
      String(text).split(/\r?\n/).forEach((line) => {
        let value = clean(line);
        while (value.length > 88) { lines.push(value.slice(0, 88)); value = value.slice(88); }
        lines.push(value);
      });
      const content = ['BT','/F1 10 Tf','50 760 Td','13 TL',...lines.map((line, i) => `(${line}) Tj${i < lines.length - 1 ? ' T*' : ''}`),'ET'].join('\n');
      const pdf = `%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Count 1/Kids[3 0 R]>>endobj\n3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 4 0 R>>>>/Contents 5 0 R>>endobj\n4 0 obj<</Type/Font/Subtype/Type1/BaseFont/Courier>>endobj\n5 0 obj<</Length ${content.length}>>stream\n${content}\nendstream\nendobj\nxref\n0 6\n0000000000 65535 f \ntrailer<</Size 6/Root 1 0 R>>\nstartxref\n0\n%%EOF`;
      const blob = new Blob([pdf], { type:'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `${name}.pdf`; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    };

    // Step expand/collapse toggle interaction (Single-Open Accordion across all 5 steps)
    document.querySelectorAll('[data-step-toggle]').forEach((toggleBtn) => {
      toggleBtn.addEventListener('click', () => {
        const container = toggleBtn.closest('.blueprint-step-container');
        if (!container) return;
        const body = container.querySelector('.blueprint-step-body');
        if (!body) return;

        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        const nextState = !isExpanded;

        // If expanding this step, close all other steps across the workflow
        if (nextState) {
          document.querySelectorAll('.blueprint-step-container').forEach((otherContainer) => {
            if (otherContainer !== container) {
              const otherToggle = otherContainer.querySelector('[data-step-toggle]');
              const otherBody = otherContainer.querySelector('.blueprint-step-body');
              if (otherToggle) otherToggle.setAttribute('aria-expanded', 'false');
              otherContainer.classList.remove('is-expanded');
              otherContainer.classList.add('is-collapsed');
              if (otherBody) otherBody.hidden = true;
            }
          });
        }

        toggleBtn.setAttribute('aria-expanded', String(nextState));
        container.classList.toggle('is-expanded', nextState);
        container.classList.toggle('is-collapsed', !nextState);

        if (nextState) {
          body.hidden = false;
          // Synchronize prompt box button widths when newly visible
          body.querySelectorAll('.workflow-prompt').forEach((box) => {
            const copy = box.querySelector('[data-copy-step]');
            const expand = box.querySelector('[data-expand-step]');
            if (copy && expand) {
              requestAnimationFrame(() => {
                const w = expand.getBoundingClientRect().width;
                if (w > 0) {
                  copy.style.width = w + 'px';
                  copy.style.minWidth = w + 'px';
                }
              });
            }
          });
        } else {
          body.hidden = true;
        }
      });
    });

    // Board expand/collapse all steps toggle
    const boardExpandBtn = document.getElementById('blueprint-board-expand-toggle');
    if (boardExpandBtn) {
      boardExpandBtn.addEventListener('click', () => {
        const stepContainers = document.querySelectorAll('.blueprint-step-container');
        const anyCollapsed = Array.from(stepContainers).some((c) => c.classList.contains('is-collapsed'));
        const shouldExpandAll = anyCollapsed;

        stepContainers.forEach((container) => {
          const toggle = container.querySelector('[data-step-toggle]');
          const body = container.querySelector('.blueprint-step-body');
          if (shouldExpandAll) {
            container.classList.remove('is-collapsed');
            container.classList.add('is-expanded');
            if (toggle) toggle.setAttribute('aria-expanded', 'true');
            if (body) body.hidden = false;
          } else {
            container.classList.remove('is-expanded');
            container.classList.add('is-collapsed');
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
            if (body) body.hidden = true;
          }
        });
      });
    }

    document.querySelectorAll('.workflow-prompt').forEach((box) => {
      const pre = box.querySelector('[data-step-prompt]');
      const copy = box.querySelector('[data-copy-step]');
      const expand = box.querySelector('[data-expand-step]');
      const download = box.querySelector('[data-download-step]');

      const syncWidth = () => {
        if (copy && expand) {
          requestAnimationFrame(() => {
            const w = expand.getBoundingClientRect().width;
            if (w > 0) {
              copy.style.width = w + 'px';
              copy.style.minWidth = w + 'px';
            }
          });
        }
      };
      syncWidth();
      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(syncWidth, 150);
      }, { passive: true });

      copy?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre?.textContent?.trim() || '');
          const old = copy.textContent;
          copy.textContent = 'Copied!';
          setTimeout(() => { copy.textContent = old; }, 1400);
        } catch {}
      });
      expand?.addEventListener('click', () => {
        const existing = document.querySelector('[data-prompt-modal]');
        if (existing) existing.remove();
        const modal = document.createElement('div');
        modal.setAttribute('data-prompt-modal','');
        modal.innerHTML = '<div class="prompt-modal-backdrop"></div><div class="prompt-modal-dialog" role="dialog" aria-modal="true" aria-label="Expanded prompt"><div class="prompt-modal-head"><span>FULL PROMPT</span><button type="button" data-close-prompt>Close</button></div><pre>' + String(pre?.textContent || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') + '</pre><div class="prompt-modal-actions"><button type="button" data-modal-copy>Copy</button><button type="button" data-modal-download>Download PDF</button></div></div>';
        document.body.appendChild(modal);
        const close = modal.querySelector('[data-close-prompt]');
        const modalCopy = modal.querySelector('[data-modal-copy]');
        close?.addEventListener('click', () => modal.remove());
        modal.querySelector('.prompt-modal-backdrop')?.addEventListener('click', () => modal.remove());
        modalCopy?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre?.textContent?.trim() || '');
            const old = modalCopy.textContent;
            modalCopy.textContent = 'Copied!';
            setTimeout(() => { modalCopy.textContent = old; }, 1400);
          } catch {}
        });
        modal.querySelector('[data-modal-download]')?.addEventListener('click', () => makePdf(pre?.textContent || '', 'skill-foundry-prompt'));
        close?.focus();
      });
      download?.addEventListener('click', () => makePdf(pre?.textContent || '', 'skill-foundry-prompt'));
    });
  </script>

