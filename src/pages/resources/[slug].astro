        <script is:inline>
          (() => {
            // Static Instagram blockquotes are parsed by embed.js. Run the explicit
            // parser once after the async embed script has loaded, not at DOMContentLoaded
            // and again at window.load.
            let embedsProcessed = false;
            const processEmbedsOnce = () => {
              if (embedsProcessed) return;
              try {
                if (window.instgrm && window.instgrm.Embeds) {
                  embedsProcessed = true;
                  window.instgrm.Embeds.process();
                }
              } catch (err) {}
            };

            if (document.readyState === "complete") {
              processEmbedsOnce();
            } else {
              window.addEventListener("load", processEmbedsOnce, { once: true });
            }

            // Instagram sends separate height messages for each embed. Resize only
            // the iframe whose contentWindow sent the message; never apply one post's
            // height to every Instagram iframe on the page.
            window.addEventListener("message", (event) => {
              if (!event.origin || !event.origin.includes("instagram.com")) return;

              try {
                const payload = typeof event.data === "string" ? JSON.parse(event.data) : event.data;
                if (!payload) return;

                const detailsHeight = payload.details && payload.details.height;
                const rawHeight = detailsHeight ?? payload.height;
                const reportedHeight = Number(rawHeight);
                if (!Number.isFinite(reportedHeight) || reportedHeight <= 200 || reportedHeight > 3000) return;

                const targetIframe = Array.from(
                  document.querySelectorAll(".resource-instagram-embed-shell iframe")
                ).find((iframe) => iframe.contentWindow === event.source);

                if (!targetIframe) return;

                const targetHeight = Math.ceil(reportedHeight);
                const currentHeight = Number.parseFloat(targetIframe.style.height || "");
                if (!Number.isFinite(currentHeight) || Math.abs(currentHeight - targetHeight) > 1) {
                  targetIframe.style.setProperty("height", targetHeight + "px", "important");
                  targetIframe.style.setProperty("max-height", "none", "important");
                }
              } catch (err) {}
            });
          })();
