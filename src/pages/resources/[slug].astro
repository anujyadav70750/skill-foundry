---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceHeroImage, resourceImageAlt, resourceResultImages, resourceSlug, resourceThumbnail } from '../../lib/resource';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resourceSlug(resource) }, props: { resource } }));
}

const { resource } = Astro.props;
const data = resource.data;
const slug = resourceSlug(resource);
const resultImages = resourceResultImages(resource);
const hasInputImage = Boolean(data.inputImage?.trim());
const hasResults = hasInputImage || resultImages.length > 0;
const allResources = await getCollection('resources');
const related = (data.relatedResources.length > 0
  ? data.relatedResources.flatMap((relatedSlug) => {
      const normalizedSlug = relatedSlug.trim().toLowerCase();
      const item = allResources.find((candidate) => resourceSlug(candidate).trim().toLowerCase() === normalizedSlug);
      return item && item.id !== resource.id ? [item] : [];
    })
  : allResources
      .filter((item) => item.id !== resource.id)
      .map((item) => ({ item, score: (item.data.category === data.category ? 3 : 0) + item.data.tags.filter((tag) => data.tags.includes(tag)).length }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .map(({ item }) => item)
).slice(0, 3);

const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`/resources/${slug}/`, site).href;
const seoTitle = data.seoTitle ?? `${data.title} | Skill Foundry`;
const seoDescription = data.seoDescription ?? data.description;
const heroImage = resourceHeroImage(resource);
const imageAlt = resourceImageAlt(resource);
const absoluteImage = new URL(heroImage, site).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: data.title,
      description: data.description,
      datePublished: data.date.toISOString(),
      dateModified: data.date.toISOString(),
      articleSection: data.category,
      url: canonicalUrl,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
      image: [absoluteImage],
      author: { '@type': 'Organization', name: 'Skill Foundry' },
      publisher: { '@type': 'Organization', name: 'Skill Foundry' },
      keywords: data.tags.join(', ')
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', site).href },
        { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl }
      ]
    }
  ]
};
---
<BaseLayout title={seoTitle} description={seoDescription} canonical={canonicalUrl} image={heroImage} imageAlt={imageAlt} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <article class="resource-page">
    <div class="container narrow resource-intro">
      <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span>{data.category}</span></div>
      <p class="eyebrow">{data.tool} • {data.category}</p>
      <h1>{data.title}</h1>
      <p class="lead">{data.description}</p>
      <div class="resource-top-meta"><span>Published {data.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}</span><span>•</span><span>{data.tool}</span></div>
      <div class="quick-actions">
        <a class="button button-primary" href="#prompt">Get the prompt ↓</a>
        {(data.videoEmbedUrl || data.originalVideoUrl) && <a class="button button-secondary" href="#tutorial">Watch tutorial</a>}
      </div>
    </div>

    <div class="container content-wide">
      <img class="hero-image" src={heroImage} alt={imageAlt} />
    </div>

    <div class="container narrow article-layout">
      {data.intro && <section class="resource-section intro-section">
        <div class="section-heading"><div><p class="eyebrow">INTRODUCTION</p><h2>Start here</h2></div></div>
        <p class="section-lead">{data.intro}</p>
      </section>}

      {data.whatItDoes && <section class="resource-section">
        <div class="section-heading"><div><p class="eyebrow">AT A GLANCE</p><h2>What this resource does</h2></div></div>
        <p class="section-lead">{data.whatItDoes}</p>
      </section>}

      {hasResults && <section class="resource-section results-section">
        <div class="section-heading"><div><p class="eyebrow">RESULTS</p><h2>{hasInputImage ? 'From input to result' : 'See the result'}</h2><p class="section-subcopy">{hasInputImage ? 'Compare the starting image with the result created using this resource.' : 'See the visual output created with this resource.'}</p></div></div>
        <div class:list={['results-gallery', hasInputImage ? 'has-input' : '', resultImages.length + (hasInputImage ? 1 : 0) === 1 ? 'single-result' : '']}>
          {hasInputImage && <figure class="result-card input-result"><img src={data.inputImage!} alt={`${imageAlt} input image`} loading="lazy" /><figcaption><span>INPUT</span><strong>Starting image</strong></figcaption></figure>}
          {resultImages.map((image, index) => <figure class="result-card"><img src={image} alt={`${imageAlt} output result ${index + 1}`} loading="lazy" /><figcaption><span>OUTPUT{resultImages.length > 1 ? ` ${index + 1}` : ''}</span><strong>{resultImages.length > 1 ? `Result ${index + 1}` : 'Generated result'}</strong></figcaption></figure>)}
        </div>
      </section>}

      <section class="resource-section prompt-section" id="prompt">
        <div class="section-heading prompt-heading">
          <div>
            <p class="eyebrow">PROMPT SOURCE</p>
            <h2>Copy the full prompt</h2>
            <p class="section-subcopy">Review the prompt in the scrollable box. Copy it, expand it, or download it as a PDF when you're ready to use it.</p>
          </div>
        </div>

        <div class="prompt-shell">
          <div class="prompt-toolbar" role="toolbar" aria-label="Prompt actions">
            <button class="prompt-control prompt-copy" type="button" data-copy>Copy</button>
            <div class="prompt-label">Full Prompt</div>
            <button class="prompt-control prompt-expand" type="button" data-expand>Expand</button>
          </div>
          <pre id="prompt-text">{data.prompt}</pre>
        </div>
        <div class="prompt-download-row">
          <button class="button button-secondary prompt-download" type="button" data-download>Download PDF</button>
        </div>
        <p class="copy-status" data-status aria-live="polite"></p>
      </section>

      {(data.videoEmbedUrl || data.originalVideoUrl) && <section class="resource-section tutorial-section" id="tutorial">
        <div class="section-heading"><div><p class="eyebrow">TUTORIAL</p><h2>Watch it in action</h2><p class="section-subcopy">Follow the walkthrough, then return here to copy and adapt the prompt.</p></div></div>
        {data.videoEmbedUrl && <div class="video-frame"><iframe src={data.videoEmbedUrl} title={`Tutorial: ${data.title}`} loading="lazy" allowfullscreen></iframe></div>}
        {data.originalVideoUrl && <a class="text-link" href={data.originalVideoUrl} target="_blank" rel="noopener noreferrer">Watch the original video →</a>}
      </section>}

      {data.steps.length > 0 && <section class="resource-section steps-section">
        <div class="section-heading"><div><p class="eyebrow">STEP BY STEP</p><h2>How to use it</h2></div></div>
        <div class="steps-grid resource-steps">
          {data.steps.map((step, index) => <article class="step-card"><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}
        </div>
      </section>}

      {data.tips.length > 0 && <section class="resource-section tips-section">
        <div class="section-heading"><div><p class="eyebrow">CUSTOMIZE</p><h2>Tips for better results</h2></div></div>
        <ul class="tips-list">
          {data.tips.map((tip) => <li>{tip}</li>)}
        </ul>
      </section>}

      {data.tags.length > 0 && <div class="tags" aria-label="Resource tags">{data.tags.map((tag) => <a href={`/resources/?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>}
    </div>
  </article>

  {related.length > 0 && <section class="section section-muted related-section">
    <div class="container">
      <div class="section-heading"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Related resources</h2></div><a href="/resources/">View library →</a></div>
      <div class="resource-grid">{related.map((item) => { const relatedSlug = resourceSlug(item); return <a class="resource-card" href={`/resources/${relatedSlug}/`}><img src={resourceThumbnail(item)} alt={resourceImageAlt(item)} /><div class="card-body"><span class="tag">{item.data.category}</span><h3>{item.data.title}</h3><p>{item.data.description}</p><span class="card-link">Open resource →</span></div></a>; })}</div>
    </div>
  </section>}

  <section class="section section-cta resource-cta">
    <div class="container">
      <div class="cta-card">
        <div>
          <p class="eyebrow">SKILL FOUNDRY</p>
          <h2>Build the skill, then make it your own.</h2>
          <p>Explore more practical AI resources and keep building with prompts, workflows and tutorials.</p>
        </div>
        <a class="button button-primary" href="/resources/">Explore resources →</a>
      </div>
    </div>
  </section>

  <dialog class="prompt-dialog" data-dialog aria-labelledby="prompt-dialog-title">
    <div class="dialog-card">
      <div class="section-heading"><div><p class="eyebrow">FULL PROMPT</p><h2 id="prompt-dialog-title">{data.title}</h2></div><button type="button" class="dialog-close" data-close aria-label="Close prompt">×</button></div>
      <pre>{data.prompt}</pre>
      <button class="button button-primary" type="button" data-copy>Copy full prompt</button>
    </div>
  </dialog>

  <style>
    .results-gallery { align-items: start; }
    .result-card { min-width: 0; margin: 0; overflow: hidden; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
    .result-card img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: var(--surface-2); }
    .result-card figcaption { display: grid; gap: 3px; padding: 12px 14px 14px; }
    .result-card figcaption span { color: var(--accent); font-size: 10px; font-weight: 850; letter-spacing: .14em; }
    .result-card figcaption strong { color: var(--text); font-size: 14px; }
    .results-gallery.has-input { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .results-gallery.has-input .result-card.input-result { border-color: rgba(124,140,255,.28); }
    .results-gallery.single-result { display: block; }
    .results-gallery.single-result .result-card img { aspect-ratio: 16 / 9; }
    .prompt-shell { overflow: hidden; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); }
    .prompt-toolbar { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: stretch; min-height: 56px; overflow: hidden; border: 0; border-radius: 13px 13px 0 0; background: rgba(16,34,56,.55); }
    .prompt-control, .prompt-label { min-width: 0; min-height: 56px; display: flex; align-items: center; justify-content: center; border: 0; border-radius: 0; font: inherit; }
    .prompt-control { padding: 0 20px; color: var(--text); background: rgba(16,34,56,.68); cursor: pointer; font-size: 12px; font-weight: 800; letter-spacing: .01em; transition: background .18s ease, color .18s ease; }
    .prompt-control:hover, .prompt-control:focus-visible { background: rgba(54,216,218,.12); color: var(--accent); outline: none; }
    .prompt-copy { border-right: 1px solid var(--line); }
    .prompt-expand { border-left: 1px solid var(--line); }
    .prompt-label { color: var(--muted); background: transparent; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
    .prompt-shell pre { max-height: 306px; margin: 0; border: 0; border-radius: 0 0 13px 13px; padding: 20px 22px; background: #07111f; }
    .prompt-download-row { display: flex; justify-content: flex-end; margin-top: 12px; }
    .prompt-download { min-height: 42px; }
    .tips-list { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; }
    .tips-list li { position: relative; padding: 16px 18px 16px 42px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); color: #d5dfeb; }
    .tips-list li::before { content: '✓'; position: absolute; left: 17px; top: 15px; color: var(--accent); font-weight: 900; }
    .resource-cta { padding-top: 18px; }
    @media (max-width: 600px) {
      .results-gallery.has-input { grid-template-columns: 1fr; }
      .prompt-toolbar { min-height: 52px; }
      .prompt-control, .prompt-label { min-height: 52px; }
      .prompt-control { padding: 0 14px; font-size: 11px; }
      .prompt-label { font-size: 10px; letter-spacing: .12em; }
      .prompt-shell pre { max-height: 300px; padding: 18px; }
      .prompt-download-row { justify-content: stretch; }
      .prompt-download { width: 100%; }
      .cta-card { align-items: flex-start; flex-direction: column; }
    }
  </style>

  <script>
    const promptText = document.querySelector('#prompt-text')?.textContent || '';
    const status = document.querySelector('[data-status]');
    const dialog = document.querySelector('[data-dialog]');
    const setStatus = (message) => { if (status) { status.textContent = message; window.setTimeout(() => { if (status) status.textContent = ''; }, 2200); } };
    document.querySelectorAll('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(promptText); setStatus('Prompt copied successfully.'); }
      catch { setStatus('Copy failed — select the prompt and copy it manually.'); }
    }));

    const makePdf = (title, text) => {
      const escapePdf = (value) => value.replace(/\\/g, '\\\\').replace(/\(/g, '\\(').replace(/\)/g, '\\)').replace(/[^\x20-\x7E\n\r]/g, '?');
      const lines = [];
      const maxChars = 92;
      let line = '';
      text.replace(/\r/g, '').split('\n').forEach((paragraph) => {
        if (!paragraph.trim()) { if (line) { lines.push(line); line = ''; } lines.push(''); return; }
        paragraph.split(/\s+/).filter(Boolean).forEach((word) => {
          if ((line ? line.length + 1 : 0) + word.length > maxChars) { if (line) lines.push(line); line = word; }
          else line = line ? `${line} ${word}` : word;
        });
        if (line) { lines.push(line); line = ''; }
      });
      if (line) lines.push(line);

      const pageHeight = 792;
      const top = 750;
      const bottom = 52;
      const lineHeight = 14;
      const linesPerPage = Math.floor((top - bottom) / lineHeight);
      const pages = [];
      for (let i = 0; i < lines.length; i += linesPerPage) pages.push(lines.slice(i, i + linesPerPage));
      if (!pages.length) pages.push(['']);

      const objects = [];
      const add = (body) => { objects.push(body); return objects.length; };
      const catalog = add('<< /Type /Catalog /Pages 2 0 R >>');
      const pagesObj = add('');
      const font = add('<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>');
      const pageIds = [];
      pages.forEach((pageLines) => {
        const commands = ['BT', '/F1 16 Tf', '50 750 Td', `(${escapePdf(title)}) Tj`, '/F1 10 Tf', '0 -26 Td'];
        pageLines.forEach((pageLine, index) => {
          if (index > 0) commands.push(`0 -${lineHeight} Td`);
          commands.push(`(${escapePdf(pageLine)}) Tj`);
        });
        commands.push('ET');
        const stream = commands.join('\n');
        const contentId = add(`<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`);
        const pageId = add(`<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 ${pageHeight}] /Resources << /Font << /F1 ${font} 0 R >> >> /Contents ${contentId} 0 R >>`);
        pageIds.push(pageId);
      });
      objects[pagesObj - 1] = `<< /Type /Pages /Kids [${pageIds.map((id) => `${id} 0 R`).join(' ')}] /Count ${pageIds.length} >>`;

      let pdf = '%PDF-1.4\n';
      const offsets = [0];
      objects.forEach((object, index) => {
        offsets[index + 1] = pdf.length;
        pdf += `${index + 1} 0 obj\n${object}\nendobj\n`;
      });
      const xref = pdf.length;
      pdf += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`;
      offsets.slice(1).forEach((offset) => { pdf += `${String(offset).padStart(10, '0')} 00000 n \n`; });
      pdf += `trailer\n<< /Size ${objects.length + 1} /Root ${catalog} 0 R >>\nstartxref\n${xref}\n%%EOF`;
      return new Blob([pdf], { type: 'application/pdf' });
    };

    document.querySelector('[data-download]')?.addEventListener('click', () => {
      const resourceTitle = document.querySelector('.resource-intro h1')?.textContent?.trim() || 'Skill Foundry Prompt';
      const blob = makePdf(`${resourceTitle} — Full Prompt`, promptText);
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = `${resourceTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'skill-foundry-prompt'}.pdf`;
      document.body.appendChild(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 1000);
      setStatus('Prompt PDF downloaded.');
    });

    document.querySelector('[data-expand]')?.addEventListener('click', () => dialog?.showModal());
    document.querySelector('[data-close]')?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  </script>
</BaseLayout>
