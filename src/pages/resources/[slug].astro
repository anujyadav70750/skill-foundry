    /* Upper Resource Header Section: Comfortable professional breathing gap */
    .resource-header-section {
      padding-top: 18px;
      margin-bottom: 16px;
      box-sizing: border-box;
      width: 100%;
    }

    @media (min-width: 641px) {
      .resource-header-section {
        padding-top: 24px;
        margin-bottom: 20px;
      }
    }

    /* Main Resource Title: restrained editorial heading that lets the hero image lead */
    .resource-main-title {
      font-size: 25px;
      font-weight: 600;
      line-height: 1.3;
      letter-spacing: -0.015em;
      color: #FFFFFF;
      margin: 0 0 16px;
      text-align: left;
    }

    /* Hero Image: Clean, integrated, NO outer card or heavy border */
    /* The resource cover has one visible source only. Never paint a second image or loading backdrop. */
    .resource-header-section .hero-image-wrap {
      position: relative !important;
      width: 100%;
      border-radius: 12px;
      overflow: hidden;
      margin: 0 0 12px;
      background: #080A0E !important;
      background-image: none !important;
      filter: none !important;
      box-shadow: none !important;
    }

    .resource-header-section .hero-image-wrap::before,
    .resource-header-section .hero-image-wrap::after {
      content: none !important;
      display: none !important;
      background: none !important;
      background-image: none !important;
    }

    .resource-header-section .hero-image-wrap > :not(.hero-image) {
      display: none !important;
    }

    .resource-header-section .hero-image {
      width: 100%;
      height: auto;
      max-height: 520px;
      object-fit: cover;
      display: block;
      border-radius: 12px;
      content-visibility: visible !important;
      background: transparent !important;
      background-image: none !important;
      filter: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
      animation: none !important;
      transition: none !important;
      transform: none !important;
      mix-blend-mode: normal !important;
    }

    .resource-header-section .hero-image.is-image-ready {
      opacity: 1 !important;
      visibility: visible !important;
    }

    /* Clean Horizontal Metadata Row Below Hero Image (Left: Author, Right: Date) */
    .resource-metadata-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      margin: 12px 0 16px;
      box-sizing: border-box;
    }

    .metadata-item {
      display: inline-flex;
      align-items: center;
      gap: 7px;
    }

    .meta-author-avatar {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      display: block;
      background: #111318;
    }

    .meta-author-name {
      color: #F5F5F5;
      font-size: 13.5px;
      font-weight: 600;
      line-height: 1.2;
    }

    .meta-author-profile-link {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: inherit;
      text-decoration: none;
