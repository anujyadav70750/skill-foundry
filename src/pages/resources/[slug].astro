---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceHeroImage, resourceImageAlt, resourceResultImages, resourceSlug, resourceThumbnail } from '../../lib/resource';

export async function getStaticPaths() {
  const resources = await getCollection('resources');
  return resources.map((resource) => ({ params: { slug: resourceSlug(resource) }, props: { resource } }));
}

const { resource } = Astro.props;
const data = resource.data;
const slug = resourceSlug(resource);
const resultImages = resourceResultImages(resource);

const parseLegacy = (value) => {
  const marker = '[[SF_INPUTS]]';
  const raw = String(value || '').trim();
  if (!raw.startsWith(marker)) return { inputs: [], settings: [], toolPurpose: '' };
  try {
    const parsed = JSON.parse(raw.slice(marker.length));
    return {
      inputs: Array.isArray(parsed.inputs) ? parsed.inputs : [],
      settings: Array.isArray(parsed.settings) ? parsed.settings : [],
      toolPurpose: String(parsed.toolPurpose || '').trim()
    };
  } catch {
    return { inputs: [], settings: [], toolPurpose: '' };
  }
};

const findTool = (name) => data.toolsUsed.find((tool) => tool.name.trim().toLowerCase() === String(name || '').trim().toLowerCase());

const inferActionType = (step) => {
  if (step.actionType) return step.actionType;
  const process = String(step.process || '');
  if (/^\s*(import|arrange|trim|combine|merge|export|upload|download|organize)/i.test(process)) return 'instructions';
  return 'prompt';
};
const inferOutputType = (step) => {
  if (step.outputType) return step.outputType;
  const value = String(step.output || '').toLowerCase();
  if (value.includes('video')) return 'video';
  if (value.includes('image')) return 'image';
  if (value.includes('audio')) return 'audio';
  if (value.includes('document') || value.includes('pdf')) return 'document';
  return 'text';
};
const workflowSteps = data.steps.map((step) => {
  const legacy = parseLegacy(step.input);
  const toolName = String(step.tool || data.tool || '').trim();
  const toolMeta = findTool(toolName);
  const actionType = inferActionType(step);
  const outputType = inferOutputType(step);
  return {
    ...step,
    tool: toolName,
    toolPurpose: String(step.toolPurpose || legacy.toolPurpose || toolMeta?.purpose || '').trim(),
    inputs: step.inputs?.length ? step.inputs : legacy.inputs,
    settings: (step.settings?.length ? step.settings : legacy.settings).filter((setting) => String(setting?.label || '').trim().toLowerCase() !== 'output'),
    actionType,
    outputType,
    outputLabel: String(step.outputLabel || step.output || 'Output from this step').trim(),
    outputDescription: String(step.outputDescription || 'Output from this step').trim(),
    outputSrc: String(step.outputSrc || '').trim(),
    instructionItems: actionType === 'instructions'
      ? String(step.process || step.description || '').split(/\n+/).map((item) => item.trim()).filter(Boolean)
      : [],
    toolMeta
  };
});

// Tools & Resources is derived from the workflow itself: every unique tool used by a step appears once.
const tools = workflowSteps
  .map((step) => step.toolMeta || (step.tool ? { name: step.tool, purpose: step.toolPurpose, url: '' } : null))
  .filter(Boolean)
  .filter((tool, index, list) => list.findIndex((candidate) => candidate.name.trim().toLowerCase() === tool.name.trim().toLowerCase()) === index);

const toolLogo = (tool) => tool?.url
  ? `/api/tool-logo-image?url=${encodeURIComponent(tool.url)}&v=20260916-4`
  : '/skill-foundry-resource-icon.svg';

const mediaTypeFromUrl = (src) => {
  const value = String(src || '').toLowerCase();
  if (/\.(mp4|webm|mov|m4v)(?:\?|$)/.test(value)) return 'video';
  if (/\.(mp3|wav|ogg|m4a|aac)(?:\?|$)/.test(value)) return 'audio';
  if (/\.(pdf|doc|docx|txt)(?:\?|$)/.test(value)) return 'document';
  return 'image';
};

const outputVisual = (step, index) => {
  const raw = String(step.output || '').trim();
  const type = step.outputType || mediaTypeFromUrl(String(step.outputSrc || '')) || (
    /video/i.test(raw) ? 'video' :
    /image/i.test(raw) ? 'image' :
    /audio/i.test(raw) ? 'audio' :
    /document|pdf/i.test(raw) ? 'document' : 'text'
  );
  if (step.outputSrc) return { type, src: step.outputSrc, label: step.outputLabel || raw || 'Output from this step' };
  if (/^https?:\/\//i.test(raw)) return { type: mediaTypeFromUrl(raw), src: raw, label: raw };
  const next = workflowSteps[index + 1];
  const linked = next?.inputs?.find((input) => input?.src && (input.type === type || !type));
  if (linked?.src) return { type: linked.type || type, src: linked.src, label: raw || linked.label || 'Step output' };
  return { type, src: '', label: step.outputLabel || raw || 'Output produced by this step' };
};

const isRealVideo = (src) => mediaTypeFromUrl(src) === 'video';
const isRealAudio = (src) => mediaTypeFromUrl(src) === 'audio';

const allResources = await getCollection('resources');
const related = (data.relatedResources.length > 0
  ? data.relatedResources.flatMap((relatedSlug) => {
      const normalizedSlug = relatedSlug.trim().toLowerCase();
      const item = allResources.find((candidate) => resourceSlug(candidate).trim().toLowerCase() === normalizedSlug);
      return item && item.id !== resource.id ? [item] : [];
    })
  : allResources
      .filter((item) => item.id !== resource.id)
      .map((item) => ({ item, score: (item.data.category === data.category ? 3 : 0) + item.data.tags.filter((tag) => data.tags.includes(tag)).length }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .map(({ item }) => item)
).slice(0, 3);

const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`/resources/${slug}/`, site).href;
const seoTitle = data.seoTitle ?? `${data.title} | Skill Foundry`;
const seoDescription = data.seoDescription ?? data.description;
const heroImage = resourceHeroImage(resource);
const imageAlt = resourceImageAlt(resource);
const absoluteImage = new URL(heroImage, site).href;
const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', headline: data.title, description: data.description, datePublished: data.date.toISOString(), dateModified: data.date.toISOString(), articleSection: data.category, url: canonicalUrl, mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl }, image: [absoluteImage], author: { '@type': 'Organization', name: 'Skill Foundry' }, publisher: { '@type': 'Organization', name: 'Skill Foundry' }, keywords: data.tags.join(', ') },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', site).href },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl }
  ] }
] };
---
<BaseLayout title={seoTitle} description={seoDescription} canonical={canonicalUrl} image={heroImage} imageAlt={imageAlt} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  <article class="resource-page">
    <div class="container narrow resource-intro">
      <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span>{data.category}</span></div>
      <p class="eyebrow">{data.tool} • {data.category}</p>
      <h1>{data.title}</h1>
      <div class="publisher-identity">
        <img class="publisher-avatar" src="/favicon.svg" alt="" width="40" height="40" />
        <div class="publisher-details">
          <div class="publisher-name-row"><strong>Skill Foundry</strong><span class="publisher-verification" aria-label="Verified publisher"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10"/><path d="M5.3 10.2 8.3 13.1 14.8 6.7"/></svg></span></div>
          <span class="publisher-meta">Published {data.date.toLocaleDateString('en-IN', { day:'numeric', month:'long', year:'numeric' })}</span>
        </div>
      </div>
    </div>

    <div class="container content-wide resource-hero-media"><img class="hero-image" src={heroImage} alt={imageAlt}/></div>

    <div class="container narrow article-layout resource-content">
      {data.intro && <section class="resource-section intro-section"><div class="section-heading"><div><p class="eyebrow">INTRODUCTION</p><h2>Start here</h2></div></div><p class="section-lead">{data.intro}</p></section>}

      <div class="guide-cue" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M2.5 4.5l8 7.5-8 7.5h4.5l8-7.5-8-7.5H2.5zm9 0l8 7.5-8 7.5H24l-8-7.5 8-7.5h-4.5z"/></svg>
        <span>FOLLOW THE FULL GUIDE BELOW</span>
        <svg viewBox="0 0 24 24"><path d="M2.5 4.5l8 7.5-8 7.5h4.5l8-7.5-8-7.5H2.5zm9 0l8 7.5-8 7.5H24l-8-7.5 8-7.5h-4.5z"/></svg>
      </div>

      <section class="resource-description"><p class="lead">{data.description}</p></section>

      {data.whatItDoes && <section class="resource-section"><div class="section-heading"><div><p class="eyebrow">AT A GLANCE</p><h2>What this resource does</h2></div></div><p class="section-lead">{data.whatItDoes}</p></section>}

      {tools.length > 0 && <section class="resource-section tools-section"><div class="section-heading"><div><p class="eyebrow">TOOLS &amp; RESOURCES</p><h2>Tools used</h2><p class="section-subcopy">Every app and AI tool used throughout this resource.</p></div></div><div class="tools-list">{tools.map((tool) => <a class="tool-card" href={tool.url || '#'} target={tool.url ? '_blank' : undefined} rel={tool.url ? 'noopener noreferrer' : undefined} aria-label={`Open ${tool.name}`}><img class="tool-logo" src={toolLogo(tool)} alt={`${tool.name} logo`} width="72" height="72" loading="lazy"/></a>)}</div></section>}

      {workflowSteps.length > 0 && <section class="resource-section workflow-section" id="workflow"><div class="section-heading"><div><p class="eyebrow">RESULTS WORKFLOW</p><h2>From input to result</h2><p class="section-subcopy">Follow the creation sequence from the starting resources to the final result.</p></div></div><div class="workflow-list">
        {workflowSteps.map((step,index) => {
          const output = outputVisual(step, index);
          const actionText = String(step.process || '').trim();
          const isInstructionStep = step.toolPurpose.toLowerCase().includes('editing') || (!actionText && String(step.description || '').trim());
          return <>
            <article class="workflow-card" data-step={index + 1}>
              <div class="workflow-step-head"><span class="workflow-number">{String(index + 1).padStart(2,'0')}</span><div><span class="workflow-label">STEP {String(index + 1).padStart(2,'0')}</span><h3>{step.title}</h3></div></div>

              {step.tool && <div class="workflow-tool-block"><span class="workflow-mini-label">TOOL USED</span><div class="workflow-tool-row"><a class="workflow-tool-logo" href={step.toolMeta?.url || '#'} target={step.toolMeta?.url ? '_blank' : undefined} rel={step.toolMeta?.url ? 'noopener noreferrer' : undefined} aria-label={`Open ${step.tool}`}><img src={toolLogo(step.toolMeta)} alt={`${step.tool} logo`} width="72" height="72"/></a><span class="workflow-tool-purpose">{(step.toolPurpose || '').toUpperCase()}</span></div></div>}

              {step.settings.length > 0 && <div class="workflow-settings-block"><span class="workflow-mini-label">SETTINGS</span><div class="workflow-settings">{step.settings.map((setting) => <div class="workflow-setting"><b>{setting.label}</b><span>{setting.value}</span></div>)}</div></div>}

              <div class="workflow-section-block"><div class="workflow-block-heading"><span class="workflow-block-title">START WITH</span><span class="workflow-block-help">What you provide to this step</span></div><div class="workflow-input-rail">
                {step.inputs.length > 0 ? step.inputs.map((input) => <article class={`workflow-media-card input-card input-${input.type}`}>
                  <span class="media-type">{input.type.toUpperCase()}</span>
                  <div class="media-frame">
                    {input.src && input.type === 'image' && <><img class="media-backdrop" src={input.src} alt="" aria-hidden="true"/><img class="media-main" src={input.src} alt={input.label || input.role || 'Input'} loading="lazy"/></>}
                    {input.src && input.type === 'video' && (isRealVideo(input.src) ? <video class="media-main" src={input.src} muted playsinline controls preload="metadata"/> : <><img class="media-backdrop" src={input.src} alt="" aria-hidden="true"/><img class="media-main" src={input.src} alt={input.label || input.role || 'Video input'} loading="lazy"/><span class="media-play" aria-hidden="true">▶</span></>)}
                    {input.src && input.type === 'audio' && (isRealAudio(input.src) ? <audio class="media-audio" src={input.src} controls preload="metadata"/> : <div class="media-placeholder">AUDIO</div>)}
                    {!input.src && input.type === 'text' && <div class="media-text">{input.value || input.label || 'Text input'}</div>}
                    {!input.src && input.type === 'document' && <div class="media-placeholder">DOCUMENT</div>}
                    {!input.src && !['text','document'].includes(input.type) && <div class="media-placeholder">{input.value || 'INPUT'}</div>}
                  </div>
                  <div class="media-caption"><strong>{input.label || input.role || 'Input'}</strong>{input.role && <small>{input.role}</small>}</div>
                </article>) : <div class="workflow-empty-input">No structured input was provided for this step.</div>}
              </div></div>

              <div class="workflow-section-block action-block"><div class="workflow-block-heading"><span class="workflow-block-title">DO THIS</span><span class="workflow-block-help">{isInstructionStep ? 'Follow these instructions' : 'Use this prompt'}</span></div>
                {isInstructionStep ? <div class="instruction-card">{String(step.description || step.process || '').split(/\n+/).filter(Boolean).map((line, instructionIndex) => <div class="instruction-line"><span>{instructionIndex + 1}</span><p>{line.replace(/^\d+[.)]\s*/, '')}</p></div>)}</div> : <div class="workflow-prompt">
                  <div class="workflow-prompt-head"><button type="button" data-copy-step>Copy</button><span>FULL PROMPT</span><button type="button" data-expand-step>Expand</button></div>
                  <pre data-step-prompt>{actionText}</pre>
                  <button class="workflow-download" type="button" data-download-step>Download PDF</button>
                </div>}
              </div>

              <div class="workflow-section-block"><div class="workflow-block-heading"><span class="workflow-block-title">YOU GET</span><span class="workflow-block-help">What this step produces</span></div><article class={`workflow-media-card output-card ${output.type ? `output-${output.type}` : ''}`}>
                {output.type && <span class="media-type">{output.type.toUpperCase()}</span>}
                {output.src ? <div class="media-frame">
                  {output.type === 'video' && isRealVideo(output.src) ? <video class="media-main" src={output.src} muted playsinline controls preload="metadata"/> : <><img class="media-backdrop" src={output.src} alt="" aria-hidden="true"/><img class="media-main" src={output.src} alt={output.label} loading="lazy"/>{output.type === 'video' && <span class="media-play" aria-hidden="true">▶</span>}</>}
                </div> : <div class="output-text">{output.label}</div>}
                <div class="media-caption"><strong>{output.label}</strong>{step.output && <small>Output from this step</small>}</div>
              </article></div>
            </article>

            {index < workflowSteps.length - 1 && <div class="workflow-next-connector" aria-label="Next step"><div class="connector-line"></div><div class="connector-cue"><svg viewBox="0 0 24 24"><path d="M12 4v15m0 0 6-6m-6 6-6-6"/></svg><div><span>NEXT STEP</span><p>{step.next}</p></div></div><div class="connector-line"></div></div>}
          </>;
        })}
      </div>
      {workflowSteps.length > 0 && (() => { const finalOutput = outputVisual(workflowSteps[workflowSteps.length - 1], workflowSteps.length - 1); return <div class="workflow-final-result"><div class="workflow-final-label">FINAL RESULT</div><h3>{finalOutput.label}</h3><div class="final-result-type">{finalOutput.type ? finalOutput.type.toUpperCase() : 'RESULT'}</div>{finalOutput.src && finalOutput.type === 'image' && <div class="final-result-media"><img src={finalOutput.src} alt={finalOutput.label} loading="lazy"/></div>}{finalOutput.src && finalOutput.type === 'video' && <div class="final-result-media"><video src={finalOutput.src} muted playsinline controls preload="metadata"></video></div>}{!finalOutput.src && <div class="final-result-placeholder">Final output is produced by the completed workflow.</div>}<p>Complete output after all workflow steps.</p></div>; })()}
      </section>}

      {(data.videoEmbedUrl || data.originalVideoUrl) && <section class="resource-section tutorial-section" id="tutorial"><div class="section-heading"><div><p class="eyebrow">TUTORIAL</p><h2>Watch it in action</h2><p class="section-subcopy">Follow the walkthrough, then return here to use the workflow.</p></div></div>{data.videoEmbedUrl && <div class="video-frame"><iframe src={data.videoEmbedUrl} title={`Tutorial: ${data.title}`} loading="lazy" allowfullscreen></iframe></div>}{data.originalVideoUrl && <a class="text-link" href={data.originalVideoUrl} target="_blank" rel="noopener noreferrer">Watch the original video →</a>}</section>}

      {data.tips.length > 0 && <section class="resource-section tips-section"><div class="section-heading"><div><p class="eyebrow">CUSTOMIZE</p><h2>Tips for better results</h2></div></div><ul class="tips-list">{data.tips.map((tip)=><li>{tip}</li>)}</ul></section>}
      {data.tags.length > 0 && <div class="tags" aria-label="Resource tags">{data.tags.map((tag)=><a href={`/resources/?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>}
    </div>
  </article>

  {related.length > 0 && <section class="section section-muted related-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Related resources</h2></div><a href="/resources/">View library →</a></div><div class="resource-grid">{related.map((item)=>{const relatedSlug=resourceSlug(item);return <a class="resource-card" href={`/resources/${relatedSlug}/`}><img src={resourceThumbnail(item)} alt={resourceImageAlt(item)}/><div class="card-body"><span class="tag">{item.data.category}</span><h3>{item.data.title}</h3><p>{item.data.description}</p><span class="card-link">Open resource →</span></div></a>})}</div></div></section>}
  <section class="section section-cta resource-cta"><div class="container"><div class="cta-card"><div><p class="eyebrow">SKILL FOUNDRY</p><h2>Build the skill, then make it your own.</h2><p>Explore more practical AI resources and keep building with prompts, workflows and tutorials.</p></div><a class="button button-primary" href="/resources/">Explore resources →</a></div></div></section>

  <script>
    const makePdf = (text, name) => {
      const clean = (s) => String(s).replace(/[^\x20-\x7E]/g, '?').replace(/\\/g, '\\\\').replace(/\(/g, '\\(').replace(/\)/g, '\\)');
      const lines = [];
      String(text).split(/\r?\n/).forEach((line) => {
        let value = clean(line);
        while (value.length > 88) { lines.push(value.slice(0, 88)); value = value.slice(88); }
        lines.push(value);
      });
      const content = ['BT','/F1 10 Tf','50 760 Td','13 TL',...lines.map((line, i) => `(${line}) Tj${i < lines.length - 1 ? ' T*' : ''}`),'ET'].join('\n');
      const pdf = `%PDF-1.4\n1 0 obj<</Type/Catalog/Pages 2 0 R>>endobj\n2 0 obj<</Type/Pages/Count 1/Kids[3 0 R]>>endobj\n3 0 obj<</Type/Page/Parent 2 0 R/MediaBox[0 0 612 792]/Resources<</Font<</F1 4 0 R>>>>/Contents 5 0 R>>endobj\n4 0 obj<</Type/Font/Subtype/Type1/BaseFont/Courier>>endobj\n5 0 obj<</Length ${content.length}>>stream\n${content}\nendstream\nendobj\nxref\n0 6\n0000000000 65535 f \ntrailer<</Size 6/Root 1 0 R>>\nstartxref\n0\n%%EOF`;
      const blob = new Blob([pdf], { type:'application/pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `${name}.pdf`; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    };

    document.querySelectorAll('.workflow-prompt').forEach((box) => {
      const pre = box.querySelector('[data-step-prompt]');
      const copy = box.querySelector('[data-copy-step]');
      const expand = box.querySelector('[data-expand-step]');
      const download = box.querySelector('[data-download-step]');
      copy?.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(pre?.textContent?.trim() || ''); const old = copy.textContent; copy.textContent = 'Copied'; setTimeout(() => copy.textContent = old, 1200); } catch {}
      });
      expand?.addEventListener('click', () => box.classList.toggle('is-expanded'));
      download?.addEventListener('click', () => makePdf(pre?.textContent || '', 'skill-foundry-prompt'));
    });
  </script>

  <style>
    .resource-page{--sf-bg:#050911;--sf-panel:#0e1729;--sf-panel2:#09111e;--sf-line:rgba(255,255,255,.1);--sf-cyan:#00e5ff;--sf-muted:#94a3b8;color:#e2e8f0}.resource-content{display:flex;flex-direction:column;gap:28px}.resource-hero-media{margin-top:26px}.resource-intro h1{max-width:1000px}.resource-description{margin:0}.resource-description .lead{max-width:820px;margin:0;color:#d5dfeb;font-size:18px;line-height:1.6}.guide-cue{display:flex;align-items:center;justify-content:center;gap:14px;padding:4px 0;color:#7ee7f2;text-align:center;user-select:none}.guide-cue span{font:700 11px/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.14em;color:#67e8f9}.guide-cue svg{width:18px;height:18px;fill:#22d3ee;opacity:.42;transform:rotate(90deg)}.tools-list{display:flex;gap:16px;overflow-x:auto;overflow-y:hidden;padding:2px 2px 10px;scroll-snap-type:x proximity;scrollbar-width:none}.tools-list::-webkit-scrollbar,.workflow-input-rail::-webkit-scrollbar{display:none}.tool-card{position:relative;display:block;flex:0 0 76px;width:76px;height:76px;padding:0!important;border:1px solid rgba(255,255,255,.14)!important;border-radius:16px!important;background:#0c162b!important;overflow:hidden;scroll-snap-align:start}.tool-logo{display:block;width:100%!important;height:100%!important;max-width:none!important;max-height:none!important;padding:0!important;object-fit:contain;background:#0c162b}.workflow-list{display:flex;flex-direction:column;gap:0}.workflow-card{position:relative;padding:20px 16px;border:1px solid rgba(148,163,184,.18);border-radius:20px;background:linear-gradient(180deg,rgba(12,27,43,.96),rgba(7,20,34,.94));overflow:hidden;box-shadow:0 0 24px -8px rgba(0,229,255,.12)}.workflow-step-head{display:flex;align-items:center;gap:12px}.workflow-number{display:grid;place-items:center;width:38px;height:38px;flex:0 0 38px;border:1px solid rgba(0,229,255,.35);border-radius:11px;background:rgba(0,196,204,.12);color:#00e5ff;font:700 12px ui-monospace,SFMono-Regular,Menlo,m