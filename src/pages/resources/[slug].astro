      border-color: rgba(59, 130, 246, 0.6) !important;
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.5), 0 0 32px rgba(59, 130, 246, 0.35) !important;
    }
    .testing-1-theme .guide-cue-icon {
      color: #38BDF8 !important;
    }

    /* 3. SECTION WRAPPERS (INTRODUCTION, AT A GLANCE, TOOLS & RESOURCES) */
    .testing-1-theme .resource-section {
      background: linear-gradient(180deg, rgba(16, 26, 44, 0.7) 0%, rgba(9, 15, 27, 0.85) 100%) !important;
      border: 1px solid rgba(255, 255, 255, 0.08) !important;
      border-radius: 24px !important;
      padding: 36px 40px !important;
      box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.08) !important;
      backdrop-filter: blur(16px) !important;
      margin-bottom: 24px !important;
      box-sizing: border-box !important;
    }
    @media (max-width: 640px) {
      .testing-1-theme .resource-section {
        padding: 24px 20px !important;
        border-radius: 20px !important;
      }
    }
    .testing-1-theme .resource-section .section-heading {
      margin-bottom: 0 !important;
    }
    .testing-1-theme .section-heading .eyebrow {
      display: inline-flex !important;
      background: rgba(255, 255, 255, 0.05) !important;
      border: 1px solid rgba(255, 255, 255, 0.12) !important;
      color: #94A3B8 !important;
      border-radius: 9999px !important;
      font-size: 10.5px !important;
      font-weight: 700 !important;
      letter-spacing: 0.14em !important;
      text-transform: uppercase !important;
      padding: 4px 14px !important;
      margin-bottom: 16px !important;
