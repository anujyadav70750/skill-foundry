      margin: 0;
      text-align: center;
    }

    @media (min-width: 641px) {
      .blueprint-callout-desc { font-size: 14px; }
    }

    .workflow-step-nav {
      display: flex;
      flex-wrap: nowrap;
      gap: 6px;
      width: 100%;
      margin: 0 0 12px;
      position: sticky;
      top: var(--header-height, 94px);
      z-index: 40;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-behavior: smooth;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .workflow-step-nav::-webkit-scrollbar { display: none; }

    .workflow-step-nav-button {
      flex: 0 0 calc((100% - 18px) / 4);
      width: calc((100% - 18px) / 4);
      min-width: 0;
      min-height: 36px;
      padding: 7px 4px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      scroll-snap-align: start;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 999px;
      background: #0D1016;
      color: #929BAA;
      font: 650 10px/1.1 sans-serif;
      letter-spacing: 0.035em;
      white-space: nowrap;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      transition: background 0.16s ease, border-color 0.16s ease, color 0.16s ease;
    }

    .workflow-step-nav[data-step-count="1"] .workflow-step-nav-button {
      flex-basis: 100%;
      width: 100%;
    }

    .workflow-step-nav[data-step-count="2"] .workflow-step-nav-button {
      flex-basis: calc((100% - 6px) / 2);
      width: calc((100% - 6px) / 2);
    }

    .workflow-step-nav[data-step-count="3"] .workflow-step-nav-button {
      flex-basis: calc((100% - 12px) / 3);
      width: calc((100% - 12px) / 3);
    }

    .workflow-step-nav-button[aria-selected="true"] {
      background: #344252;
      border-color: rgba(173, 190, 210, 0.32);
      color: #FFFFFF;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .workflow-step-nav-button:focus-visible {
      outline: 2px solid #94A3B8;
      outline-offset: 2px;
    }

    .tutorial-steps-list {
      display: block;
      width: 100%;
      margin-top: 0;
    }

    .tutorial-step-card[hidden] {
      display: none !important;
    }

    .tutorial-result-section {
      width: 100%;
      margin: 0 0 18px;
    }

    /* Step Card: Matches the Tools used section background, border, radius, shadow, and padding */
    .tutorial-step-card {
      position: relative;
      background: #0B0D12;
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 14px;
      padding: 18px 16px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
    }

    @media (min-width: 641px) {
      .tutorial-step-card {
        padding: 22px 20px;
        border-radius: 16px;
      }
    }

    /* Step Title & Short Lead Description — Matches upper sections exactly */
    .tutorial-step-header {
      display: flex;
      flex-direction: column;
      gap: 7px;
      margin-bottom: 14px;
    }

    .step-header-divider {
      width: 100%;
      height: 1px;
      background: rgba(255, 255, 255, 0.08);
      margin: 0 0 18px;
    }

    .step-title-wrap {
      display: flex;
      align-items: center;
      gap: 9px;
      margin: 0;
    }

    /* Step Title: Matches upper section headings exactly */
    .tutorial-step-title {
      font-size: clamp(17px, 2.2vw, 19px);
      line-height: 1.3;
      font-weight: 700;
      color: #FFFFFF;
      letter-spacing: -0.01em;
      margin: 0;
    }

    /* Step Description: Matches upper section descriptions exactly */
    .tutorial-step-desc {
      color: #8C92A0;
      font-size: 13.5px;
      font-weight: 400;
      line-height: 1.55;
      margin: 0;
    }

    /* Step Sub-Sections (TOOL, UPLOAD, PROMPT, OUTPUT, INSTRUCTIONS) — 20px vertical rhythm */
    .tutorial-step-section {
      display: flex;
      flex-direction: column;
      width: 100%;
      margin-bottom: 20px;
    }

    .tutorial-step-section:last-child {
      margin-bottom: 0;
    }

    /* Subsection Headings: smaller than Step main title, neutral gray/white, clearly larger/bolder than content */
    .step-subheading-label {
