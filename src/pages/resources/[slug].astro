      padding: 18px 0 4px;
    }
    .resource-hero-description .resource-description .lead {
      max-width: 860px;
      margin: 0;
      color: var(--muted);
      font-size: 18px;
      line-height: 1.6;
    }

    /* Guide Cue */
    .guide-cue {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 14px 22px;
      min-height: 50px;
      width: auto;
      max-width: calc(100% - 32px);
      text-align: center;
      user-select: none;
      text-decoration: none;
      cursor: pointer;
      white-space: nowrap;
      box-sizing: border-box;
    }
    .guide-cue span,
    .guide-cue .guide-cue-text {
      font: 700 12.5px/1 var(--font-mono);
      letter-spacing: 0.08em;
      color: var(--accent);
      white-space: nowrap;
    }
    .guide-cue svg {
      width: 13.5px;
      height: 13.5px;
      fill: none;
      stroke: var(--accent);
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.85;
      transform: none;
      flex-shrink: 0;
    }

    /* Tools Rail */
    .tools-list {
      display: flex;
      gap: 14px;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 4px 2px 12px;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }
    .tools-list::-webkit-scrollbar,
    .workflow-input-rail::-webkit-scrollbar {
      display: none;
    }
    .tool-card {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 64px;
      height: 64px;
      min-width: 64px;
      min-height: 64px;
      padding: 8px;
      border: 1px solid #1E293B;
      border-radius: 14px;
      background: #070C14;
      overflow: hidden;
      scroll-snap-align: start;
      box-sizing: border-box;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    .tool-card:hover {
      border-color: #38BDF8;
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(56, 189, 248, 0.2);
    }
    .tool-card .tool-logo {
      display: block;
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      border-radius: 6px;
    }

    /* Workflow Cards */
    .workflow-list {
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .workflow-card {
      position: relative;
      padding: 24px 20px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--surface);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.28);
      overflow: hidden;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .workflow-card:hover {
      border-color: rgba(var(--accent-rgb), 0.3);
    }
    .workflow-step-head {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .workflow-number {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      border: 1px solid rgba(var(--accent-rgb), 0.35);
      border-radius: 12px;
      background: rgba(var(--accent-rgb), 0.1);
      color: var(--accent);
      font: 800 13px/1 var(--font-mono);
    }
    .workflow-label,
    .workflow-mini-label {
      display: block;
      font: 700 10px/1.2 var(--font-mono);
      letter-spacing: 0.12em;
      color: var(--muted);
      text-transform: uppercase;
    }
    .workflow-step-head h3 {
      margin: 4px 0 0;
      font-size: 16px;
      line-height: 1.3;
      color: var(--text);
    }

    /* Tool Row Inside Step */
    .workflow-tool-block,
    .workflow-settings-block {
      margin-top: 20px;
    }
    .workflow-tool-row {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-top: 8px;
    }
    .workflow-tool-logo {
      display: grid;
      place-items: center;
      width: 64px;
      height: 64px;
      flex: 0 0 64px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--surface-2);
      overflow: hidden;
      padding: 0;
      box-sizing: border-box;
    }
    .workflow-tool-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .workflow-tool-purpose {
      font: 700 11px/1.3 var(--font-mono);
      letter-spacing: 0.09em;
      color: var(--accent);
    }

    /* Settings Matrix */
    .workflow-settings {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
    }
    .workflow-setting {
      min-width: 110px;
      padding: 8px 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: var(--surface-2);
      box-sizing: border-box;
    }
    .workflow-setting b {
      display: block;
      font: 700 9px/1.2 var(--font-mono);
      letter-spacing: 0.08em;
      color: var(--muted);
      text-transform: uppercase;
    }
    .workflow-setting span {
      display: block;
      margin-top: 3px;
      font-size: 12px;
      font-weight: 500;
      color: var(--text);
    }

    /* Section Headings inside Workflow */
    .workflow-section-block {
      margin-top: 22px;
    }
    .workflow-block-heading {
      margin-bottom: 10px;
    }
    .workflow-block-title {
      display: block;
      font: 700 10px/1.2 var(--font-mono);
      letter-spacing: 0.12em;
      color: var(--accent);
    }
    .workflow-block-help {
      display: block;
      margin-top: 2px;
      font-size: 11px;
      color: var(--muted);
    }

    /* Input & Output Media Cards — 1:1 Aspect Ratio Precision */
    .workflow-input-rail {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      overflow-y: hidden;
      padding: 2px 2px 10px;
      margin: 0 -2px;
      scroll-snap-type: x proximity;
      overscroll-behavior-x: contain;
    }
    .workflow-media-card {
      position: relative;
      flex: 0 0 196px;
      width: 196px;
      min-width: 196px;
      display: flex;
      flex-direction: column;
      padding: 12px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--surface-2);
      scroll-snap-align: start;
      box-sizing: border-box;
      transition: border-color 0.15s ease;
    }
    .workflow-media-card:hover {
      border-color: rgba(var(--accent-rgb), 0.35);
    }
    .output-card {
      margin-top: 2px;
    }
    .media-type {
      align-self: flex-start;
      padding: 3px 8px;
      border: 1px solid rgba(var(--accent-rgb), 0.3);
      border-radius: 6px;
      background: rgba(var(--accent-rgb), 0.1);
      color: var(--accent);
      font: 700 9px/1 var(--font-mono);
      letter-spacing: 0.08em;
    }
    .input-video .media-type,
    .output-video .media-type {
      border-color: rgba(var(--accent-2-rgb), 0.35);
      background: rgba(var(--accent-2-rgb), 0.12);
      color: var(--accent-2);
    }

    /* Strict Horizontal Media Frames */
    .media-frame {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      height: auto;
      margin: 10px 0 8px;
      border-radius: 12px;
      overflow: hidden;
      background: #05080E;
      border: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .media-backdrop {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(20px) brightness(0.35) saturate(0.7);
      transform: scale(1.25);
      opacity: 0.8;
      pointer-events: none;
    }
    .media-backdrop-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.35);
      pointer-events: none;
      z-index: 1;
    }
    .media-main {
      position: relative;
      z-index: 2;
      display: block;
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: 100%;
      object-fit: contain;
      border-radius: 6px;
    }
    .media-frame video.media-main {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .media-play {
      position: absolute;
      z-index: 3;
      width: 34px;
      height: 34px;
      border: 1px solid rgba(var(--accent-rgb), 0.45);
      border-radius: 50%;
      background: rgba(9, 13, 20, 0.78);
      backdrop-filter: blur(4px);
      display: grid;
      place-items: center;
      color: var(--accent);
      font-size: 11px;
      padding-left: 2px;
    }

    /* Audio Container Inside 1:1 Frame */
    .media-audio-wrap {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 12px;
      box-sizing: border-box;
    }
    .audio-wave-icon {
      width: 32px;
      height: 32px;
      fill: none;
      stroke: var(--accent);
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .media-audio {
      width: 100%;
      max-width: 160px;
      height: 32px;
    }

    /* Structured Non-Visual Container Inside 1:1 Frame */
    .media-frame-nonvisual {
      background: linear-gradient(145deg, #0d1522 0%, #070c14 100%);
      border: 1px solid rgba(var(--accent-rgb), 0.18);
      padding: 12px;
      box-sizing: border-box;
    }
    .nonvisual-content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      width: 100%;
      height: 100%;
      text-align: center;
    }
    .nonvisual-icon {
      display: grid;
      place-items: center;
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: rgba(var(--accent-rgb), 0.1);
      border: 1px solid rgba(var(--accent-rgb), 0.25);
      color: var(--accent);
    }
    .nonvisual-icon svg {
      width: 18px;
      height: 18px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .nonvisual-badge {
      font: 700 9px/1 var(--font-mono);
      letter-spacing: 0.1em;
      color: var(--muted);
    }
    .nonvisual-title {
      font-size: 11px;
      font-weight: 700;
      line-height: 1.35;
      color: var(--text);
      max-width: 100%;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .nonvisual-desc {
      font-size: 10px;
      line-height: 1.35;
      color: var(--muted);
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .nonvisual-snippet {
      font: 10px/1.35 var(--font-mono);
      color: var(--muted);
      max-height: 32px;
      overflow: hidden;
      background: rgba(0, 0, 0, 0.35);
      padding: 2px 6px;
      border-radius: 4px;
      max-width: 100%;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Media Captions */
    .media-caption {
      min-width: 0;
      margin-top: 2px;
    }
    .media-caption strong {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 12px;
      font-weight: 600;
      color: var(--text);
    }
    .media-caption small {
      display: block;
      margin-top: 2px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-size: 10px;
      color: var(--muted);
    }

    /* Action Block: Prompts & Instructions */
    .workflow-prompt {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-height: 240px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: #070B12;
      overflow: hidden;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    }
    .workflow-prompt-head {
      display: grid;
      grid-template-columns: minmax(78px, 92px) 1fr minmax(78px, 92px);
      height: 46px;
      min-height: 46px;
      max-height: 46px;
      width: 100%;
      padding: 0;
      margin: 0;
      border-bottom: 1px solid #263449;
      background: #0D1726;
      box-sizing: border-box;
    }
    .workflow-prompt-head button {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      width: 100%;
      padding: 0 12px;
      border: 0;
      background: linear-gradient(180deg, #163B63 0%, #102B49 100%);
      color: #F8FAFC;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      user-select: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.10);
      transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
    }
    .workflow-prompt-head button[data-copy-step] {
      border-right: 1px solid #263449;
    }
    .workflow-prompt-head button[data-expand-step] {
      border-left: 1px solid #263449;
    }
    .workflow-prompt-head span {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      width: 100%;
      padding: 0 8px;
      background: transparent;
      color: #8EA2BD;
      font: 700 11px/1 var(--font-mono);
      letter-spacing: 0.12em;
      text-align: center;
      user-select: none;
    }
    .workflow-prompt-head button:hover {
      background: linear-gradient(180deg, #1D4D7E 0%, #153B61 100%);
      color: #FFFFFF;
    }
    .workflow-prompt-head button:active {
      background: #0E2742;
      box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.35);
    }
    .workflow-prompt pre {
      flex: 1 1 auto;
      min-height: 48px;
      max-height: 148px;
      width: 100%;
      aspect-ratio: auto;
      height: auto;
      overflow-y: auto;
      overflow-x: hidden;
      margin: 0;
      padding: 14px 16px;
      background: #050A11;
      color: #F1F5F9;
      font: 13px/1.6 var(--font-mono);
      white-space: pre-wrap;
      word-break: break-word;
      overflow-wrap: anywhere;
      box-sizing: border-box;
      scrollbar-width: thin;
      scrollbar-color: #334155 #06090F;
    }
    .workflow-download {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 46px;
      min-height: 46px;
      max-height: 46px;
      width: 100%;
      margin: 0;
      padding: 0 16px;
      border: 0;
      border-top: 1px solid #263449;
      background: linear-gradient(180deg, #12395E 0%, #0D2945 100%);
      color: #DCEEFF;
      font-size: 13.5px;
      font-weight: 700;
      cursor: pointer;
      user-select: none;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
      transition: background 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
    }
    .workflow-download:hover {
      background: linear-gradient(180deg, #1A4C79 0%, #123654 100%);
      color: #FFFFFF;
    }
    .workflow-download:active {
      background: #0A2035;
      box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.35);
    }

    /* Instructions Mode */
    .instruction-card {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 14px 16px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--surface-2);
    }
    .instruction-line {
      display: grid;
      grid-template-columns: 24px 1fr;
      gap: 10px;
      align-items: start;
    }
    .instruction-line span {
      display: grid;
      place-items: center;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 1px solid rgba(var(--accent-rgb), 0.35);
      background: rgba(var(--accent-rgb), 0.1);
      color: var(--accent);
      font: 700 11px/1 var(--font-mono);
    }
    .instruction-line p {
      margin: 2px 0 0;
      font-size: 12px;
      line-height: 1.55;
      color: var(--text);
    }

    /* Step Transition Connector */
    .workflow-next-connector {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 12px 0;
    }
    .connector-line {
      width: 2px;
      height: 18px;
      background: rgba(var(--accent-rgb), 0.35);
    }
    .connector-cue {
      display: flex;
      align-items: center;
      gap: 10px;
      max-width: 92%;
      padding: 6px 12px;
      border-radius: 10px;
      background: transparent;
      text-align: left;
    }
    .connector-cue svg {
      width: 20px;
      height: 20px;
      flex: 0 0 20px;
      fill: none;
      stroke: var(--accent);
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
      opacity: 0.85;
    }
    .connector-cue span {
      display: block;
      font: 700 9px/1.2 var(--font-mono);
      letter-spacing: 0.1em;
      color: var(--accent);
    }
    .connector-cue p {
      margin: 2px 0 0;
      font-size: 12px;
      line-height: 1.4;
      color: var(--text);
    }

    /* Final Result Block */
    .workflow-final-result {
      margin-top: 28px;
      padding: 24px;
      border: 1px solid rgba(var(--accent-rgb), 0.3);
      border-radius: 20px;
      background: radial-gradient(circle at 90% 10%, rgba(var(--accent-rgb), 0.08), transparent 50%), var(--surface);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.35);
    }
    .workflow-final-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .workflow-final-badge {
      font: 800 11px/1 var(--font-mono);
      letter-spacing: 0.14em;
      color: var(--accent);
    }
    .final-result-type {
      padding: 3px 8px;
      border: 1px solid rgba(var(--accent-rgb), 0.3);
      border-radius: 6px;
      background: rgba(var(--accent-rgb), 0.1);
      color: var(--accent);
      font: 700 9px/1 var(--font-mono);
      letter-spacing: 0.08em;
    }
    .workflow-final-result h3 {
      margin: 8px 0 0;
      color: var(--text);
      font-size: 18px;
      font-weight: 700;
    }
    .final-result-caption {
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 12px;
    }
    .final-result-media {
      margin-top: 16px;
      border-radius: 14px;
      overflow: hidden;
      background: #050911;
      border: 1px solid var(--line);
    }
    .final-media-frame {
      position: relative;
      width: 100%;
      max-height: 480px;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    .final-backdrop {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: blur(20px);
      transform: scale(1.2);
      opacity: 0.35;
      pointer-events: none;
    }
    .final-main {
      position: relative;
      z-index: 1;
      display: block;
      width: 100%;
      max-height: 480px;
      object-fit: contain;
    }
    .final-result-play {
      position: absolute;
      z-index: 3;
      width: 44px;
      height: 44px;
      border: 1px solid rgba(var(--accent-rgb), 0.45);
      border-radius: 50%;
      background: rgba(9, 13, 20, 0.8);
      backdrop-filter: blur(4px);
      display: grid;
      place-items: center;
      color: var(--accent);
      font-size: 14px;
      padding-left: 2px;
    }
    .final-result-placeholder {
      margin-top: 16px;
      padding: 28px 20px;
      border-radius: 14px;
      border: 1px solid var(--line);
      background: var(--surface-2);
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    .final-placeholder-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: rgba(var(--accent-rgb), 0.1);
      border: 1px solid rgba(var(--accent-rgb), 0.25);
      color: var(--accent);
      display: grid;
      place-items: center;
    }
    .final-placeholder-icon svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
    }
    .final-result-placeholder strong {
      font-size: 14px;
      color: var(--text);
    }
    .final-result-placeholder span {
      font-size: 12px;
      color: var(--muted);
      max-width: 320px;
    }

    /* Modal Styling */
    [data-prompt-modal] {
      position: fixed !important;
      inset: 0 !important;
      z-index: 2147483000 !important;
      display: grid !important;
      place-items: center !important;
      padding: 20px !important;
      box-sizing: border-box !important;
    }
    [data-prompt-modal] .prompt-modal-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(2, 6, 12, 0.85);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
    }
    [data-prompt-modal] .prompt-modal-dialog {
      position: relative;
      z-index: 1;
      width: min(880px, calc(100vw - 32px));
      height: min(740px, calc(100vh - 40px));
      max-height: calc(100vh - 40px);
      display: grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      overflow: hidden;
      border: 1px solid rgba(var(--accent-rgb), 0.3);
      border-radius: 20px;
      background: var(--surface);
      box-shadow: 0 28px 90px rgba(0, 0, 0, 0.65), 0 0 36px rgba(var(--accent-rgb), 0.08);
    }
    [data-prompt-modal] .prompt-modal-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
