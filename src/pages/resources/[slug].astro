---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceHeroImage, resourceImageAlt, resourceResultImages, resourceSlug, resourceDisplayImage, resourceDisplaySrcSet, resourceThumbnail, formatResourceDate } from '../../lib/resource';

export async function getStaticPaths() {
  const resources = (await getCollection('resources'))
    .filter((resource) => !('draft' in resource.data && resource.data.draft === true));
  return resources.map((resource) => ({ params: { slug: resourceSlug(resource) }, props: { resource } }));
}

const { resource } = Astro.props;
const slug = resourceSlug(resource);
const data = resource.data;

const resultImages = resourceResultImages(resource);

const parseLegacy = (value) => {
  const marker = '[[SF_INPUTS]]';
  const raw = String(value || '').trim();
  if (!raw.startsWith(marker)) return { inputs: [], settings: [], toolPurpose: '' };
  try {
    const parsed = JSON.parse(raw.slice(marker.length));
    return {
      inputs: Array.isArray(parsed.inputs) ? parsed.inputs : [],
      settings: Array.isArray(parsed.settings) ? parsed.settings : [],
      toolPurpose: String(parsed.toolPurpose || '').trim()
    };
  } catch {
    return { inputs: [], settings: [], toolPurpose: '' };
  }
};

const findTool = (name) => data.toolsUsed.find((tool) => tool.name.trim().toLowerCase() === String(name || '').trim().toLowerCase());

const inferActionType = (step) => {
  if (step.actionType) return step.actionType;
  const process = String(step.process || '');
  if (/^\s*(import|arrange|trim|combine|merge|export|upload|download|organize)/i.test(process)) return 'instructions';
  return 'prompt';
};
const inferOutputType = (step) => {
  if (step.outputType) return step.outputType;
  const value = String(step.output || '').toLowerCase();
  if (value.includes('video')) return 'video';
  if (value.includes('image')) return 'image';
  if (value.includes('audio')) return 'audio';
  if (value.includes('document') || value.includes('pdf')) return 'document';
  return 'text';
};
const workflowSteps = data.steps.map((step) => {
  const legacy = parseLegacy(step.input);
  const toolName = String(step.tool || data.tool || '').trim();
  const toolMeta = findTool(toolName);
  const actionType = inferActionType(step);
  const outputType = inferOutputType(step);
  return {
    ...step,
    tool: toolName,
    toolPurpose: String(step.toolPurpose || legacy.toolPurpose || toolMeta?.purpose || '').trim(),
    inputs: step.inputs?.length ? step.inputs : legacy.inputs,
    settings: (step.settings?.length ? step.settings : legacy.settings).filter((setting) => String(setting?.label || '').trim().toLowerCase() !== 'output'),
    actionType,
    outputType,
    outputLabel: String(step.outputLabel || step.output || 'Output from this step').trim(),
    outputDescription: String(step.outputDescription || '').trim(),
    outputSrc: String(step.outputSrc || '').trim(),
    instructionItems: actionType === 'instructions'
      ? String(step.process || step.description || '').split(/\n+/).map((item) => item.trim()).filter(Boolean)
      : [],
    toolMeta
  };
});

// Tools & Resources is derived from the workflow itself: every unique tool used by a step appears once.
const tools = workflowSteps
  .map((step) => step.toolMeta || (step.tool ? { name: step.tool, purpose: step.toolPurpose, url: '' } : null))
  .filter(Boolean)
  .filter((tool, index, list) => list.findIndex((candidate) => candidate.name.trim().toLowerCase() === tool.name.trim().toLowerCase()) === index);

const toolLogo = (tool) => {
  try {
    const name = String(tool?.name || '').trim().toLowerCase();
    const rawUrl = String(tool?.url || '').trim().toLowerCase();
    if (name.includes('google flow') || name.includes('flow') || name.includes('google labs') || rawUrl.includes('flow.google') || rawUrl.includes('labs.google')) {
      return '/logos/google-flow.png';
    }
    if (name.includes('capcut') || rawUrl.includes('capcut.com')) {
      return '/logos/capcut.png';
    }
    if (name.includes('chatgpt') || name.includes('chat gpt') || name.includes('openai') || rawUrl.includes('chatgpt.com') || rawUrl.includes('openai.com')) {
      return '/logos/chatgpt.png';
    }
    if (name.includes('instagram') || rawUrl.includes('instagram.com')) {
      return '/logos/instagram.png';
    }
    if (!rawUrl) return '/skill-foundry-resource-icon.svg';
    const host = new URL(rawUrl).hostname;
    return host ? `https://www.google.com/s2/favicons?domain=${encodeURIComponent(host)}&sz=128` : '/skill-foundry-resource-icon.svg';
  } catch {
    return '/skill-foundry-resource-icon.svg';
  }
};

const mediaTypeFromUrl = (src) => {
  const value = String(src || '').toLowerCase();
  if (/\.(mp4|webm|mov|m4v)(?:\?|$)/.test(value)) return 'video';
  if (/\.(mp3|wav|ogg|m4a|aac)(?:\?|$)/.test(value)) return 'audio';
  if (/\.(pdf|doc|docx|txt)(?:\?|$)/.test(value)) return 'document';
  return 'image';
};

const outputVisual = (step, index) => {
  const raw = String(step.output || '').trim();
  const type = step.outputType || mediaTypeFromUrl(String(step.outputSrc || '')) || (
    /video/i.test(raw) ? 'video' :
    /image/i.test(raw) ? 'image' :
    /audio/i.test(raw) ? 'audio' :
    /document|pdf/i.test(raw) ? 'document' : 'text'
  );

  if (step.outputSrc) {
    const isEmbedUrl = /instagram\.com|youtube\.com|vimeo\.com|tiktok\.com|\/embed/i.test(step.outputSrc);
    return {
      type: isEmbedUrl ? 'video' : type,
      src: step.outputSrc,
      previewSrc: step.outputPreviewSrc || '',
      label: step.outputLabel || raw || 'Output from this step'
    };
  }

  let previewSrc = typeof step.outputPreviewSrc === 'string' ? step.outputPreviewSrc.trim() : '';
  if (!previewSrc && typeof step.process === 'string') {
    const match = step.process.match(/outputPreviewSrc:\s*["']?([^"'\n\r]+)["']?/);
    if (match) {
      previewSrc = match[1].replace(/["']/g, '').trim();
    }
  }

  if (previewSrc) {
    return {
      type,
      src: '',
      previewSrc,
      label: step.outputLabel || raw || 'Output from this step'
    };
  }

  if (step.outputPreviewSrc === '' || step.hasOutput === false) {
    return { type, src: '', previewSrc: '', label: step.outputLabel || raw || '' };
  }

  if (/^https?:\/\//i.test(raw)) return { type: mediaTypeFromUrl(raw), src: raw, previewSrc: '', label: raw };

  for (let i = index + 1; i < workflowSteps.length; i++) {
    const futureStep = workflowSteps[i];
    const linked = futureStep?.inputs?.find((input: any) => input?.src && (
      (step.outputLabel && input?.label?.toLowerCase().includes(step.outputLabel.toLowerCase())) ||
      (step.outputLabel && step.outputLabel.toLowerCase().includes(input?.label?.toLowerCase() || ''))
    ));
    if (linked?.src && !/video/i.test(step.outputType || '')) {
      return { type: linked.type || type, src: linked.src, previewSrc: '', label: step.outputLabel || raw || linked.label || 'Step output' };
    }
  }

  return { type, src: '', previewSrc: '', label: step.outputLabel || raw || '' };
};

const isRealVideo = (src) => mediaTypeFromUrl(src) === 'video';
const isRealAudio = (src) => mediaTypeFromUrl(src) === 'audio';

const getHandoffText = (currentStep, nextStep, stepIndex) => {
  if (currentStep.handoff) return String(currentStep.handoff).trim();
  if (currentStep.next) return String(currentStep.next).trim();
  if (currentStep.transition) return String(currentStep.transition).trim();
  if (currentStep.transitionInstruction) return String(currentStep.transitionInstruction).trim();
  if (!nextStep) return '';

  const outVisual = outputVisual(currentStep, stepIndex);
  const rawLabel = String(currentStep.outputLabel || currentStep.output || outVisual.label || '').trim();
  const cleanLabel = rawLabel
    .replace(/^Output(?:\s+produced\s+by\s+this\s+step)?/i, '')
    .replace(/^Output\s*[:\-]\s*/i, '')
    .trim();

  const nextStepNum = String(stepIndex + 2).padStart(2, '0');

  const matchingInput = nextStep?.inputs?.find((inp) => {
    const inpLabel = String(inp.label || inp.role || inp.value || '').toLowerCase();
    const cl = cleanLabel.toLowerCase();
    return inpLabel && (cl.includes(inpLabel) || inpLabel.includes(cl));
  });

  if (matchingInput) {
    const roleName = String(matchingInput.role || matchingInput.label || matchingInput.value || cleanLabel).trim();
    return `Use this ${cleanLabel || 'output'} as ${roleName} in Step ${nextStepNum}`;
  }

  if (cleanLabel && cleanLabel.length <= 36) {
    return `Use this ${cleanLabel.toLowerCase()} in Step ${nextStepNum}`;
  }

  return `Use this output in Step ${nextStepNum}`;
};

const allResources = await getCollection('resources');
const related = (data.relatedResources.length > 0
  ? data.relatedResources.flatMap((relatedSlug) => {
      const normalizedSlug = relatedSlug.trim().toLowerCase();
      const item = allResources.find((candidate) => resourceSlug(candidate).trim().toLowerCase() === normalizedSlug);
      return item && item.id !== resource.id ? [item] : [];
    })
  : allResources
      .filter((item) => item.id !== resource.id)
      .map((item) => ({ item, score: (item.data.category === data.category ? 3 : 0) + item.data.tags.filter((tag) => data.tags.includes(tag)).length }))
      .filter(({ score }) => score > 0)
      .sort((a, b) => b.score - a.score)
      .map(({ item }) => item)
).slice(0, 6);

const getRelatedThumbnail = (item: any) => {
  const thumb = resourceThumbnail(item);
  if (thumb && thumb !== '/images/placeholder.svg' && !thumb.includes('placeholder')) {
    return thumb;
  }
  const hero = item.data?.heroImage || item.data?.thumbnail || item.data?.inputImage;
  if (hero && hero !== '/images/placeholder.svg' && !hero.includes('placeholder')) {
    return hero;
  }
  return resourceSlug(item) === 'testing-1'
    ? '/images/1000069055-thumbnail-16x9-1788985430602.jpg'
    : '/images/knight-poppies-thumbnail.png';
};

const getConciseToolPurpose = (tool: any) => {
  const name = String(tool?.name || '').trim().toLowerCase();
  if (name.includes('chatgpt') || name.includes('openai')) return 'Planning & prompt preparation';
  if (name.includes('flow') || name.includes('google flow')) return 'Image and video generation';
  if (name.includes('instagram')) return 'Final editing / publishing';
  if (name.includes('capcut')) return 'Timeline assembly & editing';
  if (tool?.purpose) {
    const raw = String(tool.purpose).trim();
    if (raw.length <= 42) return raw;
    const firstSentence = raw.split('.')[0].trim();
    return firstSentence.length <= 45 ? firstSentence : firstSentence.slice(0, 42) + '…';
  }
  return '';
};

const site = Astro.site ?? Astro.url;
const canonicalUrl = new URL(`/resources/${slug}/`, site).href;
const seoTitle = data.seoTitle ?? `${data.title} | Skill Foundry`;
const seoDescription = data.seoDescription ?? data.description;
const heroImage = resourceDisplayImage(resourceHeroImage(resource), 1280);
const imageAlt = resourceImageAlt(resource);
const absoluteImage = new URL(heroImage, site).href;

const rawReel = (data as any).instagramReelUrl || (data as any).finalReelUrl || (data as any).videoEmbedUrl || '';
const isInstagramReel = typeof rawReel === 'string' && rawReel.includes('instagram.com');
const finalReelCleanUrl = isInstagramReel
  ? rawReel.split('?')[0].replace(/\/embed\/?$/, '').replace(/\/+$/, '') + '/'
  : '';
const resultEmbedUrl = (data.videoEmbedUrl || (finalReelCleanUrl ? `${finalReelCleanUrl}embed` : '')) as string;
const finalReelEmbedUrl = finalReelCleanUrl;
const getInstaPermalink = (url: string) => {
  if (!url || typeof url !== 'string') return '';
  const clean = url.split('?')[0].replace(/\/embed\/?.*$/, '').replace(/\/+$/, '') + '/';
  return `${clean}?utm_source=ig_embed&utm_campaign=loading`;
};

const isInstagramTutorial = Boolean(
  isInstagramReel ||
  (data.videoEmbedUrl && data.videoEmbedUrl.includes('instagram.com')) ||
  (data as any).instagramReelUrl ||
  (data as any).finalReelUrl
);
const igReelUrl = finalReelCleanUrl || (data as any).instagramReelUrl || (data as any).finalReelUrl || (data.originalVideoUrl || '');
const igTutorialThumbnail = (data as any).outputPreviewSrc || heroImage || data.thumbnail || '/images/knight-poppies-thumbnail.png';

const introText = String(data.intro || '').trim();
const introPoints = introText
  .split(/\r?\n|(?<=[.!?])\s+/u)
  .map((point) => point.trim())
  .filter(Boolean);
const whatItDoesText = String(data.whatItDoes || '').trim();
const authorName = (data as any).author || 'Skill Foundry';
const authorAvatar = (data as any).authorAvatar || (data as any).authorImage || (data as any).authorDp || '/images/skill-foundry-author.jpg';
const formatResourceTag = (tag: string) => tag
  .split(/[-_\\s]+/)
  .filter(Boolean)
  .map((part) => {
    const upper = part.toUpperCase();
    if (['AI', '3D', 'API', 'UI', 'UX', 'SEO'].includes(upper)) return upper;
    return part.charAt(0).toUpperCase() + part.slice(1).toLowerCase();
  })
  .join(' ');

const schema = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Article', headline: data.title, description: data.description, datePublished: data.date.toISOString(), dateModified: data.date.toISOString(), articleSection: data.category, url: canonicalUrl, mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl }, image: [absoluteImage], author: { '@type': 'Person', name: authorName, url: new URL('/author/', site).href, image: new URL('/images/skill-foundry-author.jpg', site).href, sameAs: 'https://www.instagram.com/skillfoundry.ai/' }, publisher: { '@type': 'Organization', name: 'Skill Foundry' }, keywords: data.tags.join(', ') },
  { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: new URL('/resources/', site).href },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonicalUrl }
  ] }
] };

const getDownloadableAssets = () => {
  if (slug === 'cinematic-medieval-knight-video-google-flow') {
    return [
      { label: 'Face Reference', filename: 'knight-face-reference.png', src: '/images/knight-face-reference.png', type: 'Starter Image' },
      { label: 'Character Sheet', filename: 'knight-character-sheet.png', src: '/images/knight-character-sheet.png', type: 'Character Reference' },
      { label: 'Helmet & Sword', filename: 'knight-props.png', src: '/images/knight-props.png', type: 'Prop Reference' },
      { label: 'Location Reference', filename: 'misty-poppy-location.png', src: '/images/misty-poppy-location.png', type: 'Location Reference' }
    ];
  }
  if (data.inputImages && data.inputImages.length > 0) {
    return data.inputImages
      .filter((img: string) => img && !img.startsWith('http'))
      .map((img: string, idx: number) => {
        const filename = img.split('/').pop() || `reference-${idx + 1}.png`;
        const label = filename.replace(/[-_]/g, ' ').replace(/\.[a-z0-9]+$/i, '').replace(/^\w/, c => c.toUpperCase());
        return { label, filename, src: img, type: 'Reference Image' };
      });
  }
  return [];
};
const downloadableAssets = getDownloadableAssets();
const hasDownloadableResources = Boolean(
  (downloadableAssets && downloadableAssets.length > 0) ||
  workflowSteps.some((step: any, index: number) => {
    const hasInputs = step.inputs && step.inputs.some((inp: any) => inp.src && !inp.src.startsWith('http'));
    const output = outputVisual(step, index);
    const mediaUrl = output?.src || '';
    const hasOutput = mediaUrl && !mediaUrl.startsWith('http');
    return hasInputs || hasOutput;
  })
);

const formatCompactInputTitle = (rawLabel: string) => {
  let s = String(rawLabel || '').trim();
  s = s.replace(/^Step\s*\d+\s*[-—:]*\s*/i, '');
  s = s.replace(/\s*\(@[A-Z0-9_]+\)/i, '');
  s = s.replace(/\s+output$/i, '');
  if (/original\s+person|person.*ref/i.test(s)) return 'Character';
  if (/character\s+sheet/i.test(s)) return 'Character Sheet';
  if (/helmet\s*(?:&|and)?\s*sword|helmet|props/i.test(s)) return 'Helmet & Sword';
  if (/location|environment|popp/i.test(s)) return 'Environment';
  if (/downloaded\s*1080p\s*video|final.*video/i.test(s)) return 'Video';
  if (/clip\s*0?(\d+)/i.test(s)) return s.replace(/.*clip\s*0?(\d+).*/i, 'Clip $1');
  if (/dressed\s*character/i.test(s)) return 'Character';
  const words = s.split(/\s+/).filter(Boolean);
  return words.slice(0, 2).join(' ') || 'Reference';
};

const formatCompactResultTitle = (rawLabel: string, stepTitle: string) => {
  const t = String(stepTitle || '').toLowerCase();
  const raw = String(rawLabel || '').toLowerCase();
  if (t.includes('character sheet') || raw.includes('character reference') || raw.includes('character sheet')) return 'Character Sheet';
  if (t.includes('helmet') || t.includes('sword') || t.includes('prop') || raw.includes('helmet') || raw.includes('sword') || raw.includes('prop')) return 'Helmet & Sword';
  if (t.includes('location') || t.includes('poppy') || raw.includes('location') || raw.includes('poppy')) return 'Location Reference';
  if (t.includes('generate video') || (t.includes('video') && !t.includes('instagram')) || raw.includes('generated video')) return 'Generated Video';
  if (t.includes('instagram') || t.includes('finish') || raw.includes('final edited') || raw.includes('reel')) return 'Final Reel';

  let s = String(rawLabel || '').trim();
  s = s.replace(/^Output(?:\s+produced\s+by\s+this\s+step)?/i, '').replace(/^Output\s*[:\-]\s*/i, '').trim();
  s = s.replace(/^\d+[:\-]\d+\s*/i, '');
  return s || 'Step Output';
};

const getCleanToolPurpose = (purpose: string, category: string, name: string) => {
  const p = String(purpose || '').trim();
  const c = String(category || '').trim();
  const n = String(name || '').trim();
  if (!p) return '';
  if (p.toLowerCase() === c.toLowerCase()) return '';
  if (p.toLowerCase() === n.toLowerCase()) return '';
  if (c.toLowerCase().includes(p.toLowerCase())) return '';
  return p;
};
---
<BaseLayout title={seoTitle} description={seoDescription} canonical={canonicalUrl} image={heroImage} imageAlt={imageAlt} type="article" hideBackButton={true}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=Playfair+Display:ital,wght@0,400..800;1,400..800&display=swap');

    /* Permanently remove top back button on resource page */
    .site-back-bar,
    #site-back-bar,
    .site-back-container,
    #site-global-back-btn {
      display: none !important;
      height: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      pointer-events: none !important;
      visibility: hidden !important;
    }

    /* Global Page Colour System: Pure Black / Near-Black #050505 */
    html:has(.testing-1-theme),
    body:has(.testing-1-theme) {
      background-color: #050505 !important;
      background-image: none !important;
      color: #F5F5F5 !important;
      padding-top: 0 !important;
      margin: 0 !important;
      min-height: 100vh !important;
    }

    html[data-theme="light"]:has(.testing-1-theme),
    body[data-theme="light"]:has(.testing-1-theme),
    html.light-theme:has(.testing-1-theme),
    body.light-theme:has(.testing-1-theme),
    html:has(.testing-1-theme.theme-light),
    body:has(.testing-1-theme.theme-light) {
      background-color: #F8FAFC !important;
      background-image: none !important;
      color: #0F172A !important;
    }

    body:has(.testing-1-theme) .site-footer {
      background: #050505 !important;
      border-top: 1px solid rgba(255, 255, 255, 0.10) !important;
      color: #9A9FAA !important;
      padding: 56px 0 40px !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-brand span.brand-name {
      color: #F5F5F5 !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-nav a {
      color: #F5F5F5 !important;
    }
    body:has(.testing-1-theme) .site-footer .footer-nav a:hover {
      color: #FACC15 !important;
    }
  </style>

  <!-- Native browser scroll restoration is preserved; no delayed resource-page scroll reset. -->

  <div class="testing-1-theme resource-editorial-layout" data-resource-slug={slug}>
    <article class="resource-page">
      {/* 1. UPPER RESOURCE HEADER */}
      <section class="resource-header-section">
        <div class="container narrow">
          {/* 1. Resource Title */}
          <h1 class="resource-main-title">{data.title}</h1>

          {/* 2. Hero Image / Thumbnail (No outer frame/card/border, clean rounded image) */}
          <div class="hero-image-wrap">
            <img class="hero-image" src={heroImage} srcset={resourceDisplaySrcSet(resourceHeroImage(resource), [960, 1280])} sizes="(max-width: 600px) 100vw, 1200px" alt={imageAlt} loading="eager" fetchpriority="high" decoding="async" />
          </div>
          <script is:inline>
            (() => {
              const image = document.querySelector('.resource-header-section .hero-image');
              if (!image) return;

              const revealAfterFullLoad = async () => {
                if (!image.complete || image.naturalWidth === 0) return;
                try {
                  if (typeof image.decode === 'function') await image.decode();
                } catch {}
                if (image.naturalWidth > 0) image.classList.add('is-image-ready');
              };

              if (image.complete) {
                void revealAfterFullLoad();
              } else {
                image.addEventListener('load', () => { void revealAfterFullLoad(); }, { once: true });
                image.addEventListener('error', () => image.classList.add('is-image-failed'), { once: true });
              }
            })();
          </script>


          {/* 3. Horizontal Metadata Row (Author & Published Date) */}
          <div class="resource-metadata-row" aria-label="Resource metadata">
            <div class="metadata-item meta-author">
              <a class="meta-author-profile-link" href="/author/" aria-label={`About ${authorName}, resource author`}>
                <img class="meta-author-avatar" src={authorAvatar} alt="" width="22" height="22" loading="eager" decoding="async" />
                <span class="meta-author-name">{authorName}</span>
              </a>
              <span class="meta-verification-badge" aria-label="Verified publisher">
                <svg viewBox="0 0 20 20" width="14" height="14" aria-hidden="true">
                  <circle cx="10" cy="10" r="10" fill="#00D4E5"/>
                  <path d="M5.3 10.2 8.3 13.1 14.8 6.7" fill="none" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>

            <div class="metadata-item meta-date">
              <svg class="meta-calendar-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span class="meta-date-text">{formatResourceDate(data.date)}</span>
            </div>
          </div>

          {/* 4. Resource Description */}
          <div class="resource-header-description">
            <p class="resource-description-lead">{data.description}</p>
          </div>
        </div>
      </section>

      {/* 2. EDITORIAL CONTENT BODY */}
      <div class="container narrow article-layout resource-content">

        {/* WHAT’S INCLUDED */}
        <section class="resource-editorial-section what-you-get-section" id="what-you-get">
          <div class="section-title-wrap">
            <span class="section-accent-bar" aria-hidden="true"></span>
            <h2 class="editorial-heading-title">What’s Included</h2>
          </div>
          <ul class="what-you-get-list">
