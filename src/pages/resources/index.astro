---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../../lib/resource';

// 1. SINGLE SOURCE OF TRUTH: Published resources sorted by date descending (Newest first)
const allResources = await getCollection('resources');
const publishedResources = allResources
  .filter((r) => !('draft' in r.data && r.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 2. DYNAMIC CATEGORIES: Display ONLY categories containing at least ONE published resource
const categoryCounts = new Map<string, number>();
publishedResources.forEach((resource) => {
  const cat = resource.data.category?.trim();
  if (cat) {
    categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
  }
});

const PREFERRED_CATEGORY_ORDER = [
  'AI Image',
  'AI Video',
  'AI Automation',
  'Prompt Systems',
  'AI Tools',
  'Creative Workflows',
  'Productivity',
  'Other'
];

const dynamicCategories = Array.from(categoryCounts.entries())
  .filter(([_, count]) => count > 0)
  .sort(([a], [b]) => {
    const idxA = PREFERRED_CATEGORY_ORDER.indexOf(a);
    const idxB = PREFERRED_CATEGORY_ORDER.indexOf(b);
    if (idxA !== -1 && idxB !== -1) return idxA - idxB;
    if (idxA !== -1) return -1;
    if (idxB !== -1) return 1;
    return a.localeCompare(b);
  })
  .map(([name]) => ({ name }));

// 3. LATEST RESOURCE: Strictly determined from publication date (Newest first)
const latestResource = publishedResources[0] || null;
const latestSlug = latestResource ? resourceSlug(latestResource) : null;
---

<BaseLayout
  title="Explore Resources & AI Workflows | Skill Foundry"
  description="Browse, search, and discover practical AI workflows, tutorials, and step-by-step blueprints from Skill Foundry."
  canonical="https://skillfoundry.dev/resources/"
  hideHeader={true}
  hideHeaderSearch={true}
  hideFooter={true}
>
  <!-- Persistent Fixed "< Back" control at top-left -->
  <aside class="resources-back-home-fixed" aria-label="Navigation back to homepage">
    <a href="/" class="resources-back-home-btn" id="resources-back-nav-btn" aria-label="Back">
      <svg class="resources-back-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13L5 8l5-5"/>
      </svg>
      <span>Back</span>
    </a>
  </aside>

  <div class="explore-page">
    <!-- 1. COMPACT PAGE INTRO / HERO -->
    <header class="explore-hero">
      <div class="container narrow explore-hero-inner">
        <span class="explore-capsule">EXPLORE RESOURCES</span>
        <h1 class="explore-title">
          Find practical AI workflows, prompts, and tutorials
        </h1>
        <p class="explore-lead">
          Discover step-by-step blueprints designed for real-world projects. Search by keyword or tool, filter by category, and jump straight into building.
        </p>
      </div>
    </header>

    <!-- 2. REFINED SEARCH BAR WITH EXACTLY 3 AREAS: [ circular Filter ] [ search input ] [ circular Search ] -->
    <section class="explore-toolbar-section">
      <div class="container narrow">
        <div class="search-bar-wrapper">
          <form class="search-form" id="resource-search-form" role="search" onsubmit="return false;">
            <!-- LEFT: Permanent Circular Filter/Sliders Control -->
            <button
              class="search-bar-circle-btn filter-toggle-btn"
              id="filter-toggle-btn"
              type="button"
              aria-label="Filter and Sort Options"
              aria-expanded="false"
              aria-haspopup="dialog"
              title="Filter & Sort"
            >
              <svg class="filter-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="4" y1="6" x2="20" y2="6"></line>
                <circle cx="9" cy="6" r="2.5" fill="#0D1628"></circle>
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <circle cx="16" cy="12" r="2.5" fill="#0D1628"></circle>
                <line x1="4" y1="18" x2="20" y2="18"></line>
                <circle cx="8" cy="18" r="2.5" fill="#0D1628"></circle>
              </svg>
            </button>

            <!-- CENTER: Search Input Field (No extra clear/X controls) -->
            <label class="sr-only" for="resource-search-input">Search workflows, tools, or topics</label>
            <input
              id="resource-search-input"
              name="q"
              type="text"
              inputmode="search"
              placeholder="Search workflows, tools, or topics…"
              autocomplete="off"
              spellcheck="false"
              enterkeyhint="search"
            />

            <!-- RIGHT: Permanent Circular Search Control -->
            <button
              class="search-bar-circle-btn search-submit-btn"
              id="search-submit-btn"
              type="button"
              aria-label="Submit Search"
              title="Search"
            >
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
            </button>
          </form>

          <!-- ANCHORED FILTER & SORT DROPDOWN / POPOVER -->
          <div class="filter-backdrop" id="filter-backdrop" hidden></div>
          <div
            class="filter-dialog"
            id="filter-dialog"
            role="dialog"
            aria-modal="true"
            aria-label="Filter and Sort Resources"
            hidden
          >
            <div class="filter-dialog-header">
              <h3 class="filter-dialog-title">Filter &amp; Sort</h3>
              <button class="filter-dialog-close-btn" id="filter-dialog-close-btn" type="button" aria-label="Close filters without applying">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>

            <div class="filter-dialog-content">
              <!-- CATEGORIES (Clean names ONLY, NO resource count numbers) -->
              <div class="filter-section">
                <span class="filter-section-title">Categories</span>
                <div class="filter-chips-grid">
                  <button
                    class="filter-chip-option is-selected"
                    type="button"
                    data-category="all"
                  >
                    <span>All</span>
                  </button>
                  {dynamicCategories.map((cat) => (
                    <button
                      class="filter-chip-option"
                      type="button"
                      data-category={cat.name}
                    >
                      <span>{cat.name}</span>
                    </button>
                  ))}
                </div>
              </div>

              <!-- SORT BY -->
              <div class="filter-section">
                <span class="filter-section-title">Sort by</span>
                <div class="sort-options-list">
                  <button class="sort-option-btn is-selected" type="button" data-sort="newest">
                    <span class="sort-radio-circle"></span>
                    <span class="sort-label-text">Newest first</span>
                  </button>
                  <button class="sort-option-btn" type="button" data-sort="oldest">
                    <span class="sort-radio-circle"></span>
                    <span class="sort-label-text">Oldest first</span>
                  </button>
                  <button class="sort-option-btn" type="button" data-sort="title">
                    <span class="sort-radio-circle"></span>
                    <span class="sort-label-text">Alphabetical (A–Z)</span>
                  </button>
                </div>
              </div>
            </div>

            <div class="filter-dialog-footer">
              <button class="filter-reset-action-btn" id="filter-reset-action-btn" type="button" disabled>
                Reset
              </button>
              <button class="filter-apply-action-btn" id="filter-apply-action-btn" type="button" disabled>
                Apply
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. RESOURCE LIBRARY CONTAINER -->
    <section class="explore-section library-grid-section">
      <div class="container narrow">

        <!-- ==================================================================
             VIEW A: CURATED CATEGORY-BASED VIEW (Default when "All" & no search)
             ================================================================== -->
        <div id="curated-library-view" class="curated-library-view">
          {publishedResources.length > 0 ? (
            <>
              <!-- 1. RECENT SECTION WITH REFINED CAPSULE HEADING -->
              <section class="curated-section recent-curated-section">
                <div class="curated-section-header">
                  <h2 class="category-capsule capsule-recent">Recent</h2>
                </div>

                <!-- A. 1 newest resource: large vertical 16:9 featured card (Thumbnail + Title + Short Description ONLY) -->
                {latestResource && (
                  <a
                    class="resource-card resource-card-prominent"
                    href={`/resources/${latestSlug}/`}
                    aria-label={`Open ${latestResource.data.title}`}
                  >
                    <div class="prominent-thumb-wrap">
                      <img
                        class="prominent-thumb-img"
                        src={resourceThumbnail(latestResource)}
                        alt={resourceImageAlt(latestResource)}
                        loading="eager"
                      />
                    </div>

                    <div class="prominent-content">
                      <h3 class="prominent-title">{latestResource.data.title}</h3>
                      <p class="prominent-desc">{latestResource.data.description}</p>
                    </div>
                  </a>
                )}

                <!-- B. 2-3 additional recent resources: compact horizontal cards (Thumbnail + Title + Short Description ONLY) -->
                {publishedResources.length > 1 && (
                  <div class="curated-h-cards-stack">
                    {publishedResources.slice(1, 4).map((resource) => {
                      const slug = resourceSlug(resource);
                      return (
                        <a
                          class="resource-card resource-card-horizontal"
                          href={`/resources/${slug}/`}
                          aria-label={`Open ${resource.data.title}`}
                        >
                          <div class="h-thumb-wrap">
                            <img
                              class="h-thumb-img"
                              src={resourceThumbnail(resource)}
                              alt={resourceImageAlt(resource)}
                              loading="lazy"
                            />
                          </div>

                          <div class="h-content">
                            <h3 class="h-title">{resource.data.title}</h3>
                            <p class="h-desc">{resource.data.description}</p>
                          </div>
                        </a>
                      );
                    })}
                  </div>
                )}

                <!-- C. Small rectangular bordered More > button aligned to the RIGHT -->
                {publishedResources.length > 4 && (
                  <div class="category-more-row">
                    <button class="category-more-btn" type="button" data-target-category="all">
                      <span>More &gt;</span>
                    </button>
                  </div>
                )}
              </section>

              <!-- 2. POPULATED CATEGORY SECTIONS WITH REFINED CAPSULE HEADINGS -->
              {dynamicCategories.map((cat) => {
                const catResources = publishedResources.filter((r) => r.data.category?.trim() === cat.name);
                const previewCatResources = catResources.slice(0, 3);
                const categoryClass = `capsule-${cat.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
                return (
                  <section class="curated-section category-curated-section" data-section-category={cat.name}>
                    <div class="curated-section-header">
                      <h2 class={`category-capsule ${categoryClass}`}>
                        {cat.name}
                      </h2>
                    </div>

                    <div class="curated-h-cards-stack">
                      {previewCatResources.map((resource) => {
                        const slug = resourceSlug(resource);
                        return (
                          <a
                            class="resource-card resource-card-horizontal"
                            href={`/resources/${slug}/`}
                            aria-label={`Open ${resource.data.title}`}
                          >
                            <div class="h-thumb-wrap">
                              <img
                                class="h-thumb-img"
                                src={resourceThumbnail(resource)}
                                alt={resourceImageAlt(resource)}
                                loading="lazy"
                              />
                            </div>

                            <div class="h-content">
                              <h3 class="h-title">{resource.data.title}</h3>
                              <p class="h-desc">{resource.data.description}</p>
                            </div>
                          </a>
                        );
                      })}
                    </div>

                    <!-- Small rectangular bordered More > button aligned to the RIGHT -->
                    <div class="category-more-row">
                      <button class="category-more-btn" type="button" data-target-category={cat.name}>
                        <span>More &gt;</span>
                      </button>
                    </div>
                  </section>
                );
              })}
            </>
          ) : (
            <div class="empty-state-box">
              <h3 class="empty-state-title">No published resources yet</h3>
              <p class="empty-state-text">New step-by-step tutorials and verified workflows are currently being crafted. Check back soon.</p>
            </div>
          )}
        </div>

        <!-- ==================================================================
             VIEW B: FULL FILTERED / CATEGORY / SEARCH VIEW (When filtering or searching)
             ================================================================== -->
        <div id="flat-library-view" class="flat-library-view" hidden>
          <div class="section-heading-row" id="flat-heading-row">
            <div class="flat-heading-capsule-wrap">
              <span class="category-capsule capsule-recent" id="flat-view-capsule">All Resources</span>
              <p class="section-subcopy" id="flat-view-subcopy">
                Explore step-by-step blueprints, workflows, and prompts ready for production.
              </p>
            </div>
          </div>

          <div class="resources-list" id="resources-grid">
            {publishedResources.map((resource, index) => {
              const slug = resourceSlug(resource);
              const thumbnail = resourceThumbnail(resource);
              const alt = resourceImageAlt(resource);
              const isLatest = index === 0;
              const toolsList = Array.isArray(resource.data.toolsUsed)
                ? resource.data.toolsUsed.map((t) => t.name).join(' ')
                : '';
              const searchBlob = [
                resource.data.title,
                resource.data.description,
                resource.data.category,
                resource.data.tool,
                toolsList,
                ...(resource.data.tags || [])
              ]
                .filter(Boolean)
                .join(' ')
                .toLowerCase();

              const timestamp = new Date(resource.data.date).getTime();

              return (
                <a
                  class="resource-card resource-card-horizontal"
                  href={`/resources/${slug}/`}
                  aria-label={`Open ${resource.data.title}`}
                  data-category={resource.data.category}
                  data-search={searchBlob}
                  data-date={timestamp}
                  data-title={resource.data.title.toLowerCase()}
                  data-slug={slug}
                  data-is-latest={isLatest ? "true" : "false"}
                >
                  <div class="h-thumb-wrap">
                    <img class="h-thumb-img" src={thumbnail} alt={alt} loading="lazy" />
                  </div>

                  <div class="h-content">
                    <h3 class="h-title">
                      <span class="searchable-target">{resource.data.title}</span>
                    </h3>
                    <p class="h-desc">
                      <span class="searchable-target">{resource.data.description}</span>
                    </p>
                  </div>
                </a>
              );
            })}
          </div>

          <!-- 4. INTENTIONAL SEARCH EMPTY STATE (Shown ONLY inside filtered view when 0 results match) -->
          <div class="empty-state-box" id="empty-search-state" hidden>
            <div class="empty-icon-box" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="8" y1="11" x2="14" y2="11"></line>
              </svg>
            </div>
            <h3 class="empty-state-title">No matching resources found</h3>
            <p class="empty-state-text" id="empty-state-desc">
              We couldn't find any resources matching your search. Try different keywords or reset your filters.
            </p>
            <button class="empty-reset-btn" id="empty-reset-btn" type="button">
              Clear all filters &amp; search
            </button>
          </div>
        </div>

      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     SKILL FOUNDRY CURATED RESOURCE LIBRARY STYLES
     ========================================================================== */

  :global(body.no-header) {
    background:
      radial-gradient(ellipse 80% 55% at 50% -10%, rgba(56, 189, 248, 0.12) 0%, transparent 60%),
      radial-gradient(circle at 80% 20%, rgba(255, 102, 0, 0.06) 0%, transparent 40%),
      #080D14 !important;
    padding-top: 0 !important;
    min-height: 100vh;
  }

  .explore-page {
    background: transparent;
    color: #F8FAFC;
    min-height: 100vh;
    padding-top: 0;
    margin-top: 0;
    padding-bottom: 48px;
  }

  /* Persistent Top-Left Back to Home Control */
  .resources-back-home-fixed {
    position: fixed;
    top: max(16px, env(safe-area-inset-top, 16px));
    left: max(18px, env(safe-area-inset-left, 18px));
    z-index: 100;
    pointer-events: auto;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .resources-back-home-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 31px;
    padding: 5px 12px;
    border-radius: 9999px;
    background: #141D2D;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #CBD5E1;
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.40);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    white-space: nowrap;
    user-select: none;
  }

  .resources-back-home-btn:hover {
    background: #1B263B;
    border-color: rgba(56, 189, 248, 0.45);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45), 0 0 10px rgba(56, 189, 248, 0.15);
  }

  .resources-back-chevron {
    flex-shrink: 0;
    display: block;
    transition: transform 0.18s ease;
  }

  .resources-back-home-btn:hover .resources-back-chevron {
    transform: translateX(-1px);
  }

  .resources-back-home-btn:active {
    transform: scale(0.96);
  }

  /* Tightened Section Spacing */
  .explore-section {
    padding: 14px 0 22px;
  }

  @media (max-width: 640px) {
    .explore-section {
      padding: 10px 0 18px;
    }
  }

  /* Hero Capsule Eyebrow */
  .explore-capsule {
    display: inline-flex;
    align-items: center;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38BDF8;
    border-radius: 9999px;
    padding: 3px 10px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 12px;
    box-shadow: 0 0 14px rgba(56, 189, 248, 0.12);
  }

  /* 1. COMPACT PAGE INTRO */
  .explore-hero {
    padding: clamp(48px, 6.5vw, 64px) 0 clamp(14px, 2vw, 20px);
    text-align: center;
  }

  .explore-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 780px;
    margin: 0 auto;
  }

  .explore-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.8vw, 42px);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 10px 0;
  }

  .explore-lead {
    font-size: clamp(13.5px, 1.6vw, 15.5px);
    line-height: 1.5;
    color: #CBD5E1;
    max-width: 600px;
    margin: 0 auto;
  }

  /* 2. REFINED SINGLE-ROW SEARCH BAR: [ circular Filter ] [ search input ] [ circular Search ] */
  .explore-toolbar-section {
    padding: 6px 0 14px;
  }

  .search-bar-wrapper {
    position: relative;
    max-width: 580px;
    margin: 0 auto;
    width: 100%;
  }

  .search-form {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(13, 22, 38, 0.92);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    padding: 4px 5px;
    min-height: 42px;
    height: 42px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .search-form:focus-within {
    border-color: rgba(56, 189, 248, 0.55);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.14), 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  /* SHARED CIRCULAR BUTTON CONTROLS (Permanent circular boundary in subdued cyan/blue family) */
  .search-bar-circle-btn {
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    background: rgba(56, 189, 248, 0.05);
    border: 1px solid rgba(56, 189, 248, 0.22);
    color: #7DD3FC;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    box-sizing: border-box;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    outline: none;
    user-select: none;
  }

  .search-bar-circle-btn:hover {
    background: rgba(56, 189, 248, 0.12);
    border-color: rgba(56, 189, 248, 0.45);
    color: #38BDF8;
  }

  .search-bar-circle-btn:active {
    transform: scale(0.95);
  }

  /* ACTIVE / GLOWING STATE: Increased brightness + subtle cyan glow */
  .filter-toggle-btn.is-active,
  .search-submit-btn:active,
  .search-submit-btn.is-active {
    background: rgba(56, 189, 248, 0.18);
    border-color: rgba(56, 189, 248, 0.65);
    color: #38BDF8;
    box-shadow: 0 0 12px rgba(56, 189, 248, 0.45);
  }

  /* CENTER: Search Input (Remove all browser clear buttons & extra decorations) */
  .search-form input {
    flex: 1 1 auto;
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 14px;
    font-family: inherit;
    padding: 0 10px;
    min-width: 0;
    height: 100%;
    box-sizing: border-box;
  }

  .search-form input::placeholder {
    color: #64748B;
  }

  /* Suppress native search clear (X) buttons across Webkit/Blink browsers */
  .search-form input::-webkit-search-cancel-button,
  .search-form input::-webkit-search-decoration,
  .search-form input::-webkit-search-results-button,
  .search-form input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  /* FILTER BACKDROP & ANCHORED DROPDOWN / POPOVER */
  .filter-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(3px);
    z-index: 140;
  }

  /* The panel is anchored directly beneath the search bar container */
  .filter-dialog {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    width: 100%;
    background: #0D1628;
    border: 1px solid rgba(56, 189, 248, 0.32);
    border-radius: 16px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.75), 0 0 20px rgba(56, 189, 248, 0.1);
    z-index: 150;
    padding: 16px 18px;
    box-sizing: border-box;
  }

  .filter-dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding-bottom: 10px;
