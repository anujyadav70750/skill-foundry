---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail } from '../../lib/resource';

const resources = (await getCollection('resources')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = [...new Set(resources.map((resource) => resource.data.category))].sort((a, b) => a.localeCompare(b));
---
<BaseLayout title="AI Resources & Prompts | Skill Foundry" description="Browse practical AI prompts, tutorials and workflows from Skill Foundry.">
  <section class="page-heading">
    <div class="container">
      <p class="eyebrow">RESOURCE LIBRARY</p>
      <h1>AI prompts & tutorials</h1>
      <p>Practical resources you can discover, understand, copy and use. Search the library or browse by category.</p>
    </div>
  </section>

  <section class="section library-section">
    <div class="container">
      <div class="library-toolbar">
        <form class="search-box" id="resource-search-form" role="search">
          <label class="sr-only" for="resource-search">Search resources</label>
          <input id="resource-search" name="q" type="search" placeholder="Search prompts, tools or topics…" autocomplete="off" spellcheck="false" enterkeyhint="search" />
          <button class="resource-search-action" id="resource-search-action" type="button" aria-label="Search resources">
            <span class="resource-search-icon" aria-hidden="true"></span>
            <span class="resource-search-x" aria-hidden="true">×</span>
          </button>
        </form>
        <div class="filter-row" role="group" aria-label="Filter by category">
          <button class="filter-chip is-active" type="button" data-filter="all">All</button>
          {categories.map((category) => <button class="filter-chip" type="button" data-filter={category}>{category}</button>)}
        </div>
      </div>

      <div class="library-meta"><span><strong>{resources.length}</strong> resource{resources.length === 1 ? '' : 's'}</span><span id="results-count" aria-live="polite"></span></div>

      <div class="resource-grid library-grid" id="resource-grid">
        {resources.map((resource) => {
          const slug = resourceSlug(resource);
          const thumbnail = resourceThumbnail(resource);
          const searchText = [resource.data.title, resource.data.description, resource.data.category, resource.data.tool, ...resource.data.tags].join(' ').toLowerCase();
          return <a class="resource-card resource-item" data-category={resource.data.category} data-search={searchText} href={`/resources/${slug}/`}>
            <img src={thumbnail} alt={resource.data.title} loading="lazy" />
            <div class="card-body">
              <span class="tag searchable-text">{resource.data.category}</span>
              <h2 class="searchable-text">{resource.data.title}</h2>
              <p class="searchable-text">{resource.data.description}</p>
              <div class="card-meta"><span class="searchable-text">{resource.data.tool}</span><span>Open →</span></div>
            </div>
          </a>;
        })}
      </div>

      <div class="empty-state" id="no-results" hidden>
        <strong>No matching resources</strong>
        <span>Try another keyword or choose a different category.</span>
      </div>
    </div>
  </section>

  <style>
    .search-box {
      position: relative;
      min-height: 62px;
      padding: 0 8px 0 20px;
      gap: 14px;
      border-radius: 14px;
      background: linear-gradient(180deg, rgba(16,34,56,.94), rgba(12,24,41,.94));
    }

    .search-box input { min-width: 0; }
    .search-box input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; display: none; }
    .search-box input::-ms-clear { display: none; }

    .resource-search-action {
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 11px;
      background: #16243a;
      color: var(--muted);
      cursor: pointer;
      transition: border-color .2s ease, color .2s ease, background .2s ease, box-shadow .2s ease;
    }

    .resource-search-action:hover,
    .resource-search-action:focus-visible {
      border-color: rgba(61,214,208,.55);
      background: rgba(61,214,208,.10);
      color: var(--accent);
      box-shadow: 0 0 0 3px rgba(61,214,208,.07);
      outline: none;
    }

    .resource-search-icon {
      position: relative;
      display: block;
      width: 17px;
      height: 17px;
      border: 2px solid currentColor;
      border-radius: 50%;
    }

    .resource-search-icon::after {
      content: '';
      position: absolute;
      right: -5px;
      bottom: -4px;
      width: 7px;
      height: 2px;
      border-radius: 2px;
      background: currentColor;
      transform: rotate(45deg);
      transform-origin: left center;
    }

    .resource-search-x { display: none; font-size: 26px; line-height: 1; transform: translateY(-1px); }
    .resource-search-action.has-query .resource-search-icon { display: none; }
    .resource-search-action.has-query .resource-search-x { display: block; }

    :global(.search-highlight) {
      display: inline;
      padding: 0 .12em !important;
      border-radius: .2em !important;
      background: rgba(61,214,208,.30) !important;
      color: #b8f4ff !important;
      box-shadow: 0 0 14px rgba(61,214,208,.38) !important;
      -webkit-box-decoration-break: clone;
      box-decoration-break: clone;
    }

    @media (max-width: 640px) {
      .search-box { min-height: 58px; padding-left: 16px; gap: 10px; }
      .resource-search-action { width: 40px; height: 40px; }
    }
  </style>

  <script>
    const search = document.querySelector('#resource-search');
    const searchForm = document.querySelector('#resource-search-form');
    const searchAction = document.querySelector('#resource-search-action');
    const items = [...document.querySelectorAll('.resource-item')];
    const chips = [...document.querySelectorAll('[data-filter]')];
    const categoryValues = chips.map((chip) => chip.dataset.filter || 'all');
    const empty = document.querySelector('#no-results');
    const count = document.querySelector('#results-count');
    const searchable = [...document.querySelectorAll('.searchable-text')];
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') || '';
    const initialCategory = params.get('category') || '';
    if (search && initialQuery) search.value = initialQuery;
    let activeFilter = categoryValues.includes(initialCategory) ? initialCategory : 'all';
    chips.forEach((chip) => chip.classList.toggle('is-active', (chip.dataset.filter || 'all') === activeFilter));

    const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    const restoreText = () => {
      searchable.forEach((element) => {
        if (element.dataset.originalText !== undefined) element.textContent = element.dataset.originalText;
        else element.dataset.originalText = element.textContent || '';
      });
    };

    const highlightMatches = (query) => {
      restoreText();
      const terms = [...new Set(query.split(/\s+/).filter(Boolean))].sort((a, b) => b.length - a.length);
      if (!terms.length) return;
      const pattern = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'gi');
      searchable.forEach((element) => {
        const text = element.dataset.originalText || '';
        const fragment = document.createDocumentFragment();
        let lastIndex = 0;
        text.replace(pattern, (match, _group, offset) => {
          fragment.append(document.createTextNode(text.slice(lastIndex, offset)));
          const mark = document.createElement('mark');
          mark.className = 'search-highlight';
          mark.textContent = match;
          fragment.append(mark);
          lastIndex = offset + match.length;
          return match;
        });
        fragment.append(document.createTextNode(text.slice(lastIndex)));
        element.replaceChildren(fragment);
      });
    };

    const syncSearchAction = () => {
      if (!search || !searchAction) return;
      const hasQuery = Boolean(search.value.trim());
      searchAction.classList.toggle('has-query', hasQuery);
      searchAction.setAttribute('aria-label', hasQuery ? 'Clear search' : 'Search resources');
    };

    const update = ({ syncUrl = true } = {}) => {
      const rawQuery = (search?.value || '').trim();
      const query = rawQuery.toLowerCase();
      const terms = [...new Set(query.split(/\s+/).filter(Boolean))];
      let visible = 0;
      items.forEach((item) => {
        const matchesFilter = activeFilter === 'all' || item.dataset.category === activeFilter;
        const searchText = item.dataset.search || '';
        const matchesSearch = !terms.length || terms.every((term) => searchText.includes(term));
        const show = matchesFilter && matchesSearch;
        item.hidden = !show;
        if (show) visible += 1;
      });

      highlightMatches(rawQuery);
      syncSearchAction();
      if (empty) empty.hidden = visible > 0;
      if (count) count.textContent = `${visible} shown`;

      if (syncUrl) {
        const next = new URL(window.location.href);
        if (rawQuery) next.searchParams.set('q', rawQuery);
        else next.searchParams.delete('q');
        if (activeFilter !== 'all') next.searchParams.set('category', activeFilter);
        else next.searchParams.delete('category');
        window.history.replaceState({}, '', `${next.pathname}${next.search}${next.hash}`);
      }
    };

    search?.addEventListener('input', () => update());
    search?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        update();
        search.blur();
      }
      if (event.key === 'Escape' && search.value) {
        search.value = '';
        update();
      }
    });

    searchForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      update();
    });

    searchAction?.addEventListener('click', () => {
      if (!search) return;
      if (search.value.trim()) {
        search.value = '';
        update();
        search.focus();
      } else {
        search.focus();
        update();
      }
    });

    chips.forEach((chip) => chip.addEventListener('click', () => {
      activeFilter = chip.dataset.filter || 'all';
      chips.forEach((item) => item.classList.toggle('is-active', item === chip));
      update();
    }));

    update({ syncUrl: false });
  </script>
</BaseLayout>
