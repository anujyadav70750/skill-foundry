---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail } from '../../lib/resource';

const resources = (await getCollection('resources')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const categories = [...new Set(resources.map((resource) => resource.data.category))].sort((a, b) => a.localeCompare(b));
---
<BaseLayout title="AI Resources & Prompts | Skill Foundry" description="Browse practical AI prompts, tutorials and workflows from Skill Foundry.">
  <section class="page-heading">
    <div class="container">
      <p class="eyebrow">RESOURCE LIBRARY</p>
      <h1>AI prompts & tutorials</h1>
      <p>Practical resources you can discover, understand, copy and use. Search the library or browse by category.</p>
    </div>
  </section>

  <section class="section library-section">
    <div class="container">
      <div class="library-toolbar">
        <div class="search-box" role="search">
          <span class="search-icon" aria-hidden="true">⌕</span>
          <label class="sr-only" for="resource-search">Search resources</label>
          <input id="resource-search" type="search" placeholder="Search prompts, tools or topics…" autocomplete="off" spellcheck="false" enterkeyhint="search" />
          <button class="search-clear" id="search-clear" type="button" aria-label="Clear search" hidden>×</button>
        </div>
        <div class="filter-row" role="group" aria-label="Filter by category">
          <button class="filter-chip is-active" type="button" data-filter="all">All</button>
          {categories.map((category) => <button class="filter-chip" type="button" data-filter={category}>{category}</button>)}
        </div>
      </div>

      <div class="library-meta"><span><strong>{resources.length}</strong> resource{resources.length === 1 ? '' : 's'}</span><span id="results-count" aria-live="polite"></span></div>

      <div class="resource-grid library-grid" id="resource-grid">
        {resources.map((resource) => {
          const slug = resourceSlug(resource);
          const thumbnail = resourceThumbnail(resource);
          const searchText = [resource.data.title, resource.data.description, resource.data.category, resource.data.tool, ...resource.data.tags].join(' ').toLowerCase();
          return <a class="resource-card resource-item" data-category={resource.data.category} data-search={searchText} href={`/resources/${slug}/`}>
            <img src={thumbnail} alt={resource.data.title} loading="lazy" />
            <div class="card-body"><span class="tag">{resource.data.category}</span><h2>{resource.data.title}</h2><p>{resource.data.description}</p><div class="card-meta"><span>{resource.data.tool}</span><span>Open →</span></div></div>
          </a>;
        })}
      </div>

      <div class="empty-state" id="no-results" hidden>
        <strong>No matching resources</strong>
        <span>Try another keyword or choose a different category.</span>
      </div>
    </div>
  </section>

  <style>
    .search-box {
      position: relative;
      min-height: 58px;
      padding-inline: 18px;
      gap: 12px;
    }

    .search-icon {
      flex: 0 0 auto;
      font-size: 21px;
      line-height: 1;
      transform: translateY(-1px);
    }

    .search-box input {
      min-width: 0;
    }

    .search-clear {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      width: 30px;
      height: 30px;
      padding: 0;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: rgba(255,255,255,.03);
      color: var(--muted);
      font-size: 20px;
      line-height: 1;
      cursor: pointer;
    }

    .search-clear:hover,
    .search-clear:focus-visible {
      border-color: rgba(61,214,208,.45);
      color: var(--accent);
      outline: none;
    }

    @media (max-width: 600px) {
      .search-box {
        min-height: 54px;
        padding-inline: 14px;
      }

      .search-clear {
        width: 28px;
        height: 28px;
      }
    }
  </style>

  <script>
    const search = document.querySelector('#resource-search');
    const clear = document.querySelector('#search-clear');
    const items = [...document.querySelectorAll('.resource-item')];
    const chips = [...document.querySelectorAll('[data-filter]')];
    const empty = document.querySelector('#no-results');
    const count = document.querySelector('#results-count');
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') || '';
    if (search && initialQuery) search.value = initialQuery;
    let activeFilter = 'all';

    const update = ({ syncUrl = true } = {}) => {
      const query = (search?.value || '').trim().toLowerCase();
      let visible = 0;
      items.forEach((item) => {
        const matchesFilter = activeFilter === 'all' || item.dataset.category === activeFilter;
        const matchesSearch = !query || (item.dataset.search || '').includes(query);
        const show = matchesFilter && matchesSearch;
        item.hidden = !show;
        if (show) visible += 1;
      });

      if (empty) empty.hidden = visible > 0;
      if (count) count.textContent = `${visible} shown`;
      if (clear) clear.hidden = !query;

      if (syncUrl) {
        const next = new URL(window.location.href);
        if (query) next.searchParams.set('q', search?.value.trim() || '');
        else next.searchParams.delete('q');
        window.history.replaceState({}, '', `${next.pathname}${next.search}${next.hash}`);
      }
    };

    search?.addEventListener('input', () => update());
    search?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && search.value) {
        search.value = '';
        update();
      }
    });

    clear?.addEventListener('click', () => {
      if (!search) return;
      search.value = '';
      search.focus();
      update();
    });

    chips.forEach((chip) => chip.addEventListener('click', () => {
      activeFilter = chip.dataset.filter || 'all';
      chips.forEach((item) => item.classList.toggle('is-active', item === chip));
      update();
    }));

    update({ syncUrl: false });
  </script>
</BaseLayout>
