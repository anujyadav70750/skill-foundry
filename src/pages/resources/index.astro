  /* Recent carousel: mirror the homepage's typography, spacing and card treatment.
     Scoped to this section so category cards below remain unchanged. */
  .recent-curated-section {
    margin-bottom: 28px;
  }

  .recent-curated-section .recent-works-header {
    display: flex;
    align-items: center;
    margin-bottom: 13px;
  }

  .recent-curated-section .recent-works-header-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .recent-curated-section .recent-works-title {
    margin: 0;
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: clamp(20px, 3.2vw, 25px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .recent-curated-section .recent-works-chevron {
    display: block;
    width: 16px;
    height: 24px;
    flex: 0 0 16px;
    color: currentColor;
    opacity: 0.58;
    align-self: center;
    transform: translateY(1px);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .recent-curated-section .recent-works-header-link:hover {
    color: var(--brand-accent, #38BDF8);
  }

  .recent-curated-section .recent-works-header-link:hover .recent-works-chevron {
    transform: translate(4px, 1px);
    opacity: 1;
  }

  .recent-curated-section .recent-scroll-wrapper {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    padding: 3px 1px 8px;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 1px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .recent-curated-section .recent-scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .recent-curated-section .recent-resource-card {
    flex: 0 0 calc((100% - 40px) / 3.25);
    min-width: 250px;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    padding: 14px;
    border-radius: 16px;
    background: #0B0D12;
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: inherit;
    text-decoration: none;
    scroll-snap-align: start;
    transition: border-color 0.2s ease;
  }

  .recent-curated-section .recent-resource-card:hover {
    border-color: rgba(255, 255, 255, 0.18);
  }

  .recent-curated-section .recent-resource-thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 10px;
    background: #04070D;
  }

  .recent-curated-section .recent-resource-thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .recent-curated-section .recent-resource-card:hover .recent-resource-thumb-img {
    transform: scale(1.03);
  }

  .recent-curated-section .recent-resource-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 12px;
  }

  .recent-curated-section .recent-resource-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 9px;
  }

  .recent-curated-section .recent-resource-meta-category {
    color: #CBD5E1;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 3px 9px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .recent-curated-section .recent-resource-meta-date {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    color: #9298A4;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
  }

  .recent-curated-section .recent-resource-meta-calendar {
    width: 14px;
    height: 14px;
    color: #7E8492;
    flex-shrink: 0;
    display: block;
  }

  .recent-curated-section .recent-resource-card-title {
    margin: 0;
    color: #F8FAFC;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global([data-theme="light"]) .recent-curated-section .recent-works-header-link,
  :global(html.light-theme) .recent-curated-section .recent-works-header-link,
  :global([data-theme="light"]) .recent-curated-section .recent-works-title,
