---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../../lib/resource';

// 1. SINGLE SOURCE OF TRUTH: Published resources sorted by date descending (Newest first)
const allResources = await getCollection('resources');
const publishedResources = allResources
  .filter((r) => !('draft' in r.data && r.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 2. DYNAMIC CATEGORIES: Display ONLY categories containing at least ONE published resource
const categoryCounts = new Map<string, number>();
publishedResources.forEach((resource) => {
  const cat = resource.data.category?.trim();
  if (cat) {
    categoryCounts.set(cat, (categoryCounts.get(cat) || 0) + 1);
  }
});

const dynamicCategories = Array.from(categoryCounts.entries())
  .filter(([_, count]) => count > 0)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([name, count]) => ({ name, count }));

// 3. FEATURED RESOURCE: ONE featured resource using genuine featured flag if available, else newest published
const explicitlyFeatured = publishedResources.find((r) => r.data.featured === true);
const leadResource = explicitlyFeatured || publishedResources[0];
const leadSlug = leadResource ? resourceSlug(leadResource) : null;

// 4. DATE FORMATTER
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }).format(new Date(date));
};

// 5. TOOL LOGO HELPER (Matches design system)
const toolLogo = (name: string) => {
  const raw = (name || '').toLowerCase();
  if (raw.includes('flow')) return '/google-flow-icon.svg';
  if (raw.includes('capcut')) return '/capcut-icon.svg';
  return '/skill-foundry-resource-icon.svg';
};
---

<BaseLayout
  title="Explore Resources & AI Workflows | Skill Foundry"
  description="Browse, search, and discover practical AI workflows, tutorials, and step-by-step blueprints from Skill Foundry."
>
  <div class="explore-page">
    <!-- 1. COMPACT PAGE INTRO / HERO -->
    <header class="explore-hero">
      <div class="container narrow explore-hero-inner">
        <span class="explore-capsule">EXPLORE RESOURCES</span>
        <h1 class="explore-title">
          Find practical AI workflows, prompts, and tutorials
        </h1>
        <p class="explore-lead">
          Discover step-by-step blueprints designed for real-world projects. Search by keyword or tool, filter by category, and jump straight into building.
        </p>
      </div>
    </header>

    <!-- 2. SEARCH & DISCOVERY TOOLBAR -->
    <section class="explore-toolbar-section">
      <div class="container narrow">
        <div class="toolbar-card">
          <!-- SEARCH BAR -->
          <div class="search-wrap">
            <form class="search-form" id="resource-search-form" role="search" onsubmit="return false;">
              <label class="sr-only" for="resource-search-input">Search workflows, prompts, tools, or topics</label>
              <span class="search-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              </span>
              <input
                id="resource-search-input"
                name="q"
                type="search"
                placeholder="Search workflows, tools, or topics…"
                autocomplete="off"
                spellcheck="false"
                enterkeyhint="search"
              />
              <button
                class="search-clear-btn"
                id="search-clear-btn"
                type="button"
                aria-label="Clear search query"
                hidden
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </form>
          </div>

          <!-- DYNAMIC CATEGORY NAVIGATION RAIL -->
          <div class="categories-nav-wrap">
            <div class="categories-nav-rail" role="tablist" aria-label="Filter by category">
              <button
                class="category-chip is-active"
                type="button"
                role="tab"
                aria-selected="true"
                data-category="all"
              >
                <span>All</span>
                <span class="chip-count">{publishedResources.length}</span>
              </button>
              {dynamicCategories.map((cat) => (
                <button
                  class="category-chip"
                  type="button"
                  role="tab"
                  aria-selected="false"
                  data-category={cat.name}
                >
                  <span>{cat.name}</span>
                  <span class="chip-count">{cat.count}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- CONTROLS & FILTER STATUS ROW -->
          <div class="toolbar-meta-row">
            <div class="meta-left">
              <span class="results-count-text" id="results-count-text">
                Showing {publishedResources.length} resource{publishedResources.length === 1 ? '' : 's'}
              </span>
              <button class="clear-filters-btn" id="clear-all-btn" type="button" hidden>
                <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
                Clear filters
              </button>
            </div>

            <!-- SORTING (Newest, Oldest, A–Z — No Most Viewed since no view data exists) -->
            <div class="sort-wrap">
              <label for="sort-select" class="sort-label">Sort by:</label>
              <div class="select-container">
                <select id="sort-select" aria-label="Sort resources">
                  <option value="newest" selected>Newest first</option>
                  <option value="oldest">Oldest first</option>
                  <option value="title">Alphabetical (A–Z)</option>
                </select>
                <svg class="select-chevron" viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. FEATURED SPOTLIGHT SECTION (ONE featured resource, shown when unfiltered) -->
    {leadResource && (
      <section class="explore-section spotlight-section" id="featured-spotlight-section">
        <div class="container narrow">
          <div class="spotlight-card">
            <a class="spotlight-thumb-wrap" href={`/resources/${leadSlug}/`} aria-label={`Open featured blueprint: ${leadResource.data.title}`}>
              <img
                class="spotlight-thumb-img"
                src={resourceThumbnail(leadResource)}
                alt={resourceImageAlt(leadResource)}
                loading="eager"
              />
              <span class="spotlight-cat-badge">{leadResource.data.category}</span>
            </a>

            <div class="spotlight-content">
              <div class="spotlight-eyebrow-row">
                <span class="spotlight-capsule">
                  <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
                    <path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/>
                  </svg>
                  FEATURED BLUEPRINT
                </span>
                <span class="spotlight-date">{formatDate(leadResource.data.date)}</span>
              </div>

              <h2 class="spotlight-title">
                <a href={`/resources/${leadSlug}/`}>{leadResource.data.title}</a>
              </h2>

              <p class="spotlight-desc">{leadResource.data.description}</p>

              <div class="spotlight-meta-footer">
                <div class="spotlight-tool-badge">
                  <img
                    class="spotlight-tool-logo"
                    src={toolLogo(leadResource.data.tool)}
                    alt=""
                    width="16"
                    height="16"
                    loading="lazy"
                  />
                  <span>{leadResource.data.tool}</span>
                </div>

                <a class="spotlight-cta-btn" href={`/resources/${leadSlug}/`}>
                  View Blueprint
                  <svg viewBox="0 0 20 20" width="15" height="15" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 4. ALL RESOURCES LIBRARY GRID -->
    <section class="explore-section library-grid-section">
      <div class="container narrow">
        <div class="section-heading-row">
          <div>
            <h2 class="section-title" id="library-heading">All Resources</h2>
            <p class="section-subcopy">
              Explore step-by-step blueprints, workflows, and prompts ready for production.
            </p>
          </div>
        </div>

        {publishedResources.length > 0 ? (
          <div class="resources-grid" id="resources-grid">
            {publishedResources.map((resource) => {
              const slug = resourceSlug(resource);
              const thumbnail = resourceThumbnail(resource);
              const alt = resourceImageAlt(resource);
              const toolsList = Array.isArray(resource.data.toolsUsed)
                ? resource.data.toolsUsed.map((t) => t.name).join(' ')
                : '';
              const searchBlob = [
                resource.data.title,
                resource.data.description,
                resource.data.category,
                resource.data.tool,
                toolsList,
                ...(resource.data.tags || [])
              ]
                .filter(Boolean)
                .join(' ')
                .toLowerCase();

              const timestamp = new Date(resource.data.date).getTime();

              return (
                <article
                  class="resource-card"
                  data-category={resource.data.category}
                  data-search={searchBlob}
                  data-date={timestamp}
                  data-title={resource.data.title.toLowerCase()}
                  data-slug={slug}
                >
                  <a class="card-thumb-link" href={`/resources/${slug}/`} aria-label={`Open ${resource.data.title}`}>
                    <img class="card-thumb-img" src={thumbnail} alt={alt} loading="lazy" />
                    <span class="card-category-badge">{resource.data.category}</span>
                  </a>

                  <div class="card-content">
                    <div class="card-meta-top">
                      <span class="card-date">{formatDate(resource.data.date)}</span>
                      {resource.data.tool && (
                        <span class="card-tool-chip">
                          <img class="card-tool-logo" src={toolLogo(resource.data.tool)} alt="" width="14" height="14" loading="lazy" />
                          {resource.data.tool}
                        </span>
                      )}
                    </div>

                    <h3 class="card-title">
                      <a class="card-title-link searchable-target" href={`/resources/${slug}/`}>
                        {resource.data.title}
                      </a>
                    </h3>

                    <p class="card-desc searchable-target">{resource.data.description}</p>

                    <div class="card-footer">
                      <a class="card-view-btn" href={`/resources/${slug}/`}>
                        View Resource
                        <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
                          <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/>
                        </svg>
                      </a>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="empty-state-box">
            <h3 class="empty-state-title">No published resources yet</h3>
            <p class="empty-state-text">New step-by-step tutorials and verified workflows are currently being crafted. Check back soon.</p>
          </div>
        )}

        <!-- 5. INTENTIONAL EMPTY STATE (When search/filters return 0 matches) -->
        <div class="empty-state-box" id="empty-search-state" hidden>
          <div class="empty-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </div>
          <h3 class="empty-state-title">No matching resources found</h3>
          <p class="empty-state-text" id="empty-state-desc">
            We couldn't find any resources matching your search. Try different keywords or clear your active filters.
          </p>
          <button class="empty-reset-btn" id="empty-reset-btn" type="button">
            Clear all filters & search
          </button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     SKILL FOUNDRY EXPLORE RESOURCES STYLES
     Scoped cleanly to .explore-page to avoid interfering with any other page.
     Adheres to the established dark luxury design system:
     - Dark navy background (#080D14)
     - Newsreader display headings & Plus Jakarta Sans body
     - JetBrains Mono badges
     - Cyan (#38BDF8) & Orange (#EA5500) accents
     - Spacing rhythm: CAPSULE -> 16px -> TITLE -> 12px -> DESCRIPTION
     ========================================================================== */

  .explore-page {
    background-color: #080D14;
    color: #F8FAFC;
    min-height: 100vh;
    padding-bottom: 60px;
  }

  /* Shared Section Spacing */
  .explore-section {
    padding: 36px 0;
  }

  @media (max-width: 640px) {
    .explore-section {
      padding: 24px 0;
    }
  }

  /* Shared Capsule Eyebrow */
  .explore-capsule {
    display: inline-flex;
    align-items: center;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38BDF8;
    border-radius: 9999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 5px 14px;
    margin: 0 0 16px 0;
    line-height: 1;
    user-select: none;
  }

  /* ==========================================================================
     1. COMPACT PAGE INTRO / HERO
     ========================================================================== */
  .explore-hero {
    position: relative;
    padding: clamp(48px, 6vw, 68px) 0 clamp(32px, 4vw, 44px);
    background:
      radial-gradient(ellipse 80% 55% at 50% -10%, rgba(56, 189, 248, 0.12) 0%, transparent 60%),
      radial-gradient(circle at 80% 20%, rgba(255, 102, 0, 0.06) 0%, transparent 40%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .explore-hero-inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .explore-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 4.6vw, 48px);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    margin: 0 0 14px 0;
    max-width: 820px;
    text-wrap: balance;
  }

  .explore-lead {
    color: #CBD5E1;
    font-size: clamp(15.5px, 2vw, 17.5px);
    line-height: 1.65;
    max-width: 680px;
    margin: 0;
    text-wrap: balance;
  }

  /* ==========================================================================
     2. TOOLBAR & DISCOVERY
     ========================================================================== */
  .explore-toolbar-section {
    padding: 32px 0 16px;
  }

  .toolbar-card {
    background: linear-gradient(180deg, rgba(16, 26, 44, 0.75) 0%, rgba(9, 15, 27, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 24px;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  /* Search Input */
  .search-wrap {
    margin-bottom: 20px;
  }

  .search-form {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(8, 13, 22, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    padding: 0 12px 0 16px;
    min-height: 52px;
  }

  .search-form:focus-within {
    border-color: rgba(56, 189, 248, 0.55);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.12);
  }

  .search-icon-box {
    color: #94A3B8;
    display: flex;
    align-items: center;
    margin-right: 12px;
    flex-shrink: 0;
  }

  .search-form input {
    flex: 1 1 auto;
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 15px;
    font-family: inherit;
    padding: 12px 0;
    min-width: 0;
  }

  .search-form input::placeholder {
    color: #64748B;
  }

  .search-clear-btn {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    color: #94A3B8;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    flex-shrink: 0;
  }

  .search-clear-btn:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #FFFFFF;
  }

  /* Dynamic Categories Rail */
  .categories-nav-wrap {
    margin-bottom: 20px;
    position: relative;
  }

  .categories-nav-rail {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding: 2px 2px 6px;
  }

  .categories-nav-rail::-webkit-scrollbar {
    display: none;
  }

  .category-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 9999px;
    padding: 8px 16px;
    color: #CBD5E1;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    user-select: none;
    flex-shrink: 0;
  }

  .category-chip:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
  }

  .category-chip.is-active {
    background: rgba(56, 189, 248, 0.14);
    border-color: rgba(56, 189, 248, 0.5);
    color: #38BDF8;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.15);
  }

  .chip-count {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 700;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 9999px;
    padding: 2px 6px;
    line-height: 1;
  }

  .category-chip.is-active .chip-count {
    background: rgba(56, 189, 248, 0.2);
    color: #38BDF8;
  }

  /* Toolbar Meta Row (Results Count, Clear Filters, Sorting) */
  .toolbar-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 16px;
    flex-wrap: wrap;
  }

  .meta-left {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .results-count-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12.5px;
    color: #94A3B8;
  }

  .clear-filters-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(234, 85, 0, 0.1);
    border: 1px solid rgba(234, 85, 0, 0.3);
    color: #FF9E44;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .clear-filters-btn:hover {
    background: rgba(234, 85, 0, 0.2);
    border-color: rgba(234, 85, 0, 0.5);
    color: #FFFFFF;
  }

  /* Sorting Dropdown */
  .sort-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .sort-label {
    font-size: 13px;
    color: #64748B;
    font-weight: 600;
    white-space: nowrap;
  }

  .select-container {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .select-container select {
    appearance: none;
    -webkit-appearance: none;
    background: rgba(8, 13, 22, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #CBD5E1;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 28px 6px 12px;
    border-radius: 8px;
    outline: none;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .select-container select:hover,
  .select-container select:focus {
    border-color: rgba(56, 189, 248, 0.4);
    color: #FFFFFF;
  }

  .select-chevron {
    position: absolute;
    right: 8px;
    color: #94A3B8;
    pointer-events: none;
  }

  /* ==========================================================================
     3. FEATURED SPOTLIGHT CARD
     ========================================================================== */
  .spotlight-card {
    background: linear-gradient(180deg, rgba(20, 32, 54, 0.8) 0%, rgba(10, 18, 32, 0.95) 100%);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 24px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6), 0 0 40px rgba(56, 189, 248, 0.08);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .spotlight-card:hover {
    border-color: rgba(56, 189, 248, 0.45);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.7), 0 0 50px rgba(56, 189, 248, 0.12);
  }

  .spotlight-thumb-wrap {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    background: #04070D;
    overflow: hidden;
  }

  .spotlight-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .spotlight-card:hover .spotlight-thumb-img {
    transform: scale(1.03);
  }

  .spotlight-cat-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(8, 14, 24, 0.9);
    border: 1px solid rgba(56, 189, 248, 0.4);
    color: #38BDF8;
