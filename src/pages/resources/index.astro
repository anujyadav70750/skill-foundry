<script>
  // CLIENT-SIDE SEARCH, FILTER & SORT CONTROLLER (TWO-STATE DRAFT / SAVED MODEL)
  const searchInput = document.getElementById('resource-search-input') as HTMLInputElement | null;
  const searchSubmitBtn = document.getElementById('search-submit-btn') as HTMLButtonElement | null;
  const filterToggleBtn = document.getElementById('filter-toggle-btn') as HTMLButtonElement | null;
  const filterBackdrop = document.getElementById('filter-backdrop') as HTMLElement | null;
  const filterDialog = document.getElementById('filter-dialog') as HTMLElement | null;
  const filterDialogCloseBtn = document.getElementById('filter-dialog-close-btn') as HTMLButtonElement | null;
  const filterChipOptions = Array.from(document.querySelectorAll('.filter-chip-option')) as HTMLButtonElement[];
  const sortOptionBtns = Array.from(document.querySelectorAll('.sort-option-btn')) as HTMLButtonElement[];
  const filterResetActionBtn = document.getElementById('filter-reset-action-btn') as HTMLButtonElement | null;
  const filterApplyActionBtn = document.getElementById('filter-apply-action-btn') as HTMLButtonElement | null;

  const categoryToggleButtons = Array.from(document.querySelectorAll('[data-category-toggle]')) as HTMLButtonElement[];
  const emptyResetBtn = document.getElementById('empty-reset-btn') as HTMLButtonElement | null;
  const emptySearchState = document.getElementById('empty-search-state') as HTMLElement | null;
  const emptyStateTitle = document.getElementById('empty-state-title') as HTMLElement | null;
  const emptyStateDesc = document.getElementById('empty-state-desc') as HTMLElement | null;
  const emptyResetBtnLabel = emptyResetBtn;
  const resourcesGrid = document.getElementById('resources-grid') as HTMLElement | null;
  const curatedLibraryView = document.getElementById('curated-library-view') as HTMLElement | null;
  const flatLibraryView = document.getElementById('flat-library-view') as HTMLElement | null;
  const flatViewSubcopy = document.getElementById('flat-view-subcopy') as HTMLElement | null;

  const cardElements = Array.from(document.querySelectorAll('#flat-library-view .resource-card')) as HTMLElement[];
  const searchableTargets = Array.from(document.querySelectorAll('.searchable-target')) as HTMLElement[];

  // Store original text for search highlighting
  searchableTargets.forEach((el) => {
    el.dataset.original = el.textContent || '';
  });

  // Homepage learning-domain links map to the existing resource categories.
  // Keep this mapping aligned with the five homepage skill-area cards.
  const CATEGORY_GROUPS: Record<string, string[]> = {
    'ai & technology': ['ai image', 'ai video', 'prompt systems', 'prompt engineering', 'ai tools'],
    'automation': ['ai automation', 'creative workflows', 'workflows', 'automation'],
    'content creation & editing': ['content creation', 'video editing', 'video editing & motion', 'content creation & visuals', 'social media'],
    'design & templates': ['design', 'templates', 'graphic design', 'poster design', 'thumbnails'],
    'digital productivity': ['productivity', 'digital productivity', 'digital tools']
  };

  // 1. SAVED / APPLIED STATE (Controls the actual resource listing)
  const urlParams = new URLSearchParams(window.location.search);
  let savedCategory = urlParams.get('category') || 'all';
  let savedSort = urlParams.get('sort') || 'newest';
  let activeQuery = urlParams.get('q') || '';

  // 2. TEMPORARY / DRAFT STATE (Modified only while filter panel is open until Apply)
  let draftCategory = savedCategory;
  let draftSort = savedSort;

  // Apply initial values to controls
  if (searchInput && activeQuery) {
    searchInput.value = activeQuery;
  }

  // Update visual state on filter icon for SAVED/APPLIED state only (NO separate dot)
  const syncSavedFilterIcon = () => {
    const isSavedNonDefault = savedCategory.toLowerCase() !== 'all' || savedSort !== 'newest';
    if (filterToggleBtn) {
      filterToggleBtn.classList.toggle('is-active', isSavedNonDefault);
    }
  };

  // Sync Draft UI selections inside the open panel and evaluate Apply/Reset button states
  const syncDialogDraftUI = () => {
    // 1. Category selection chips
    filterChipOptions.forEach((opt) => {
      const cat = opt.dataset.category || 'all';
      const isSelected = cat.toLowerCase() === draftCategory.toLowerCase();
      opt.classList.toggle('is-selected', isSelected);
      opt.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
    });

    // 2. Sort option buttons
    sortOptionBtns.forEach((opt) => {
      const sort = opt.dataset.sort || 'newest';
      const isSelected = sort === draftSort;
      opt.classList.toggle('is-selected', isSelected);
      opt.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
    });

    // 3. APPLY BUTTON: Enabled and glowing ONLY when draft differs from saved state
    const isDraftChanged = (draftCategory.toLowerCase() !== savedCategory.toLowerCase()) || (draftSort !== savedSort);
    if (filterApplyActionBtn) {
      filterApplyActionBtn.disabled = !isDraftChanged;
    }

    // 4. RESET BUTTON: Enabled when draft is non-default (i.e. not 'all' + 'newest')
    const isDraftNonDefault = (draftCategory.toLowerCase() !== 'all') || (draftSort !== 'newest');
    if (filterResetActionBtn) {
      filterResetActionBtn.disabled = !isDraftNonDefault;
    }
  };

  // Open Filter Dialog (Always loads current SAVED state as starting draft)
  const openFilterDialog = () => {
    if (!filterDialog) return;
    draftCategory = savedCategory;
    draftSort = savedSort;
    syncDialogDraftUI();

    filterDialog.hidden = false;
    if (filterBackdrop) filterBackdrop.hidden = false;
    filterToggleBtn?.setAttribute('aria-expanded', 'true');

    // Prevent body scroll on mobile
    if (window.innerWidth <= 640) {
      document.body.style.overflow = 'hidden';
    }
  };

  // Close Filter Dialog (Discards uncommitted draft changes)
  const closeFilterDialog = () => {
    if (!filterDialog) return;
    // Discard any unsaved draft modifications
    draftCategory = savedCategory;
    draftSort = savedSort;
    syncDialogDraftUI();

    filterDialog.hidden = true;
    if (filterBackdrop) filterBackdrop.hidden = true;
    filterToggleBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  };

  filterToggleBtn?.addEventListener('click', () => {
    if (filterDialog?.hidden) {
      openFilterDialog();
    } else {
      closeFilterDialog();
    }
  });

  filterDialogCloseBtn?.addEventListener('click', closeFilterDialog);
  filterBackdrop?.addEventListener('click', closeFilterDialog);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && filterDialog && !filterDialog.hidden) {
      closeFilterDialog();
    }
  });

  // DRAFT CHANGE: Selecting category chip changes only draft state (resource list NOT changed yet)
  filterChipOptions.forEach((btn) => {
    btn.addEventListener('click', () => {
      draftCategory = btn.dataset.category || 'all';
      syncDialogDraftUI();
    });
  });

  // DRAFT CHANGE: Selecting sort option changes only draft state (resource list NOT changed yet)
  sortOptionBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      draftSort = btn.dataset.sort || 'newest';
      syncDialogDraftUI();
    });
  });

  // DRAFT RESET: Resets draft to default 'all' + 'newest' (User can then press Apply to commit)
  filterResetActionBtn?.addEventListener('click', () => {
    if (filterResetActionBtn.disabled) return;
    draftCategory = 'all';
    draftSort = 'newest';
    syncDialogDraftUI();
  });

  // APPLY: Commits draft state to saved state, closes panel, and updates resource list
  filterApplyActionBtn?.addEventListener('click', () => {
    if (filterApplyActionBtn.disabled) return;
    savedCategory = draftCategory;
    savedSort = draftSort;

    syncSavedFilterIcon();

    // Close panel
    filterDialog!.hidden = true;
    if (filterBackdrop) filterBackdrop.hidden = true;
    filterToggleBtn?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';

    updateLibrary();
  });

  // Escape special chars for RegExp
  const escapeRegex = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  // Highlight matches in card titles & descriptions
  const applyHighlights = (query: string) => {
    const terms = query
      .trim()
      .split(/\s+/)
      .filter((t) => t.length > 1)
      .map(escapeRegex);

    if (!terms.length) {
      searchableTargets.forEach((el) => {
        el.textContent = el.dataset.original || '';
      });
      return;
    }

    const regex = new RegExp(`(${terms.join('|')})`, 'gi');

    searchableTargets.forEach((el) => {
      const original = el.dataset.original || '';
      const parts = original.split(regex);
      el.innerHTML = '';
      parts.forEach((part) => {
        if (regex.test(part)) {
          const mark = document.createElement('mark');
          mark.className = 'search-hl';
          mark.textContent = part;
          el.appendChild(mark);
        } else {
          el.appendChild(document.createTextNode(part));
        }
      });
    });
  };

  // Sort resources in DOM based on savedSort
  const sortCards = (cards: HTMLElement[], sortType: string) => {
    if (!resourcesGrid) return;
    cards.sort((a, b) => {
      if (sortType === 'oldest') {
        const dateA = Number(a.dataset.date || 0);
        const dateB = Number(b.dataset.date || 0);
        return dateA - dateB;
      }
      if (sortType === 'title') {
        const titleA = a.dataset.title || '';
        const titleB = b.dataset.title || '';
        return titleA.localeCompare(titleB);
      }
      // default: newest
      const dateA = Number(a.dataset.date || 0);
      const dateB = Number(b.dataset.date || 0);
      return dateB - dateA;
    });

    cards.forEach((card) => resourcesGrid.appendChild(card));
  };

  // Main resource list filter & update function (Controlled strictly by SAVED state)
  const updateLibrary = (syncUrl = true) => {
    const trimmedQuery = (searchInput?.value || '').trim();
    const lowerQuery = trimmedQuery.toLowerCase();
    const queryTerms = lowerQuery.split(/\s+/).filter(Boolean);

    const isSearching = queryTerms.length > 0;
    const isCategoryFiltered = savedCategory.toLowerCase() !== 'all';
    const isSortCustom = savedSort !== 'newest';
    const isCuratedDefault = !isSearching && !isCategoryFiltered && !isSortCustom;
    const isCategoryLanding = isCategoryFiltered && !isSearching;

    if (searchInput) {
      searchInput.placeholder = isCategoryFiltered
        ? `Search ${savedCategory} resources…`
        : 'Search workflows, tools, or topics…';
      searchInput.setAttribute(
        'aria-label',
        isCategoryFiltered ? `Search ${savedCategory} resources` : 'Search workflows, tools, or topics'
      );
    }
    const searchLabel = document.querySelector<HTMLLabelElement>('label[for="resource-search-input"]');
    if (searchLabel) {
      searchLabel.textContent = isCategoryFiltered
        ? `Search ${savedCategory} resources`
        : 'Search workflows, tools, or topics';
    }

    let matchCount = 0;

    if (isCuratedDefault) {
      // 1. Curated Default View
      if (curatedLibraryView) curatedLibraryView.hidden = false;
      if (flatLibraryView) flatLibraryView.hidden = true;
      if (emptySearchState) emptySearchState.hidden = true;

      // Reset highlights
      searchableTargets.forEach((el) => {
        el.textContent = el.dataset.original || '';
      });

      matchCount = cardElements.length;
    } else {
      // 2. Flat Filtered / Search View
      if (curatedLibraryView) curatedLibraryView.hidden = true;
      if (flatLibraryView) {
        flatLibraryView.hidden = false;
        flatLibraryView.classList.toggle('is-category-view', isCategoryLanding);
        flatLibraryView.classList.toggle('is-search-view', isSearching);
      }

      // Search and category views share the same resource list and card structure.
      const flatViewTitle = document.getElementById('flat-view-title');
      if (flatViewTitle) {
        flatViewTitle.textContent = isSearching
          ? 'Search results'
          : (savedCategory.toLowerCase() === 'all' ? 'All Resources' : savedCategory);
        flatViewTitle.hidden = false;
      }
      const flatViewSubcopy = document.getElementById('flat-view-subcopy');
      if (flatViewSubcopy) flatViewSubcopy.hidden = false;

      cardElements.forEach((card) => {
        const cardCategory = (card.dataset.category || '').toLowerCase();
        const cardSearchBlob = card.dataset.search || '';

        // Category check against SAVED category
        const selectedCategory = savedCategory.toLowerCase();
        const groupedCategories = CATEGORY_GROUPS[selectedCategory];
        const matchesCategory =
          selectedCategory === 'all' ||
          cardCategory === selectedCategory ||
          Boolean(groupedCategories?.includes(cardCategory));

        // Search query check
        const matchesQuery =
          !queryTerms.length || queryTerms.every((term) => cardSearchBlob.includes(term));

        const isVisible = matchesCategory && matchesQuery;
        card.hidden = !isVisible;
        if (isVisible) matchCount += 1;
      });

      // Display a useful result count and the active ordering.
      if (flatViewSubcopy) {
        const sortLabel = savedSort === 'oldest'
          ? 'Oldest first'
          : savedSort === 'title'
            ? 'Alphabetical (A–Z)'
            : 'Newest first';
        if (isSearching) {
          const categoryContext = isCategoryFiltered ? ` in ${savedCategory}` : '';
          flatViewSubcopy.textContent = `${matchCount} matching resource${matchCount === 1 ? '' : 's'}${categoryContext} for "${trimmedQuery}" · ${sortLabel}.`;
        } else if (isCategoryLanding) {
          flatViewSubcopy.textContent = `${matchCount} resource${matchCount === 1 ? '' : 's'} in ${savedCategory}.`;
        } else {
          flatViewSubcopy.textContent = `${matchCount} resources · ${sortLabel}.`;
        }
      }

      // Sort matching cards by the selected order (without pinning the latest item).
      sortCards(cardElements, savedSort);

      // Apply search highlights
      applyHighlights(trimmedQuery);

      // Empty state: explain whether the selected category is awaiting its first resource
      // or the current search simply has no matches.
      if (emptySearchState) {
        emptySearchState.hidden = matchCount > 0;
      }
      if (matchCount === 0 && isCategoryLanding) {
        if (emptyStateTitle) emptyStateTitle.textContent = 'New resources are on the way';
        if (emptyStateDesc) {
          emptyStateDesc.textContent = `We're preparing practical guides and step-by-step resources for ${savedCategory}. This section is being built, so please check back soon.`;
        }
        if (emptyResetBtnLabel) emptyResetBtnLabel.textContent = 'Browse all resources';
      } else {
        if (emptyStateTitle) emptyStateTitle.textContent = 'No matching resources found';
        if (emptyStateDesc) {
          emptyStateDesc.textContent = `We couldn't find any resources matching your search. Try different keywords or reset your filters.`;
        }
        if (emptyResetBtnLabel) emptyResetBtnLabel.textContent = 'Clear all filters & search';
      }
    }

    syncSavedFilterIcon();

    // URL parameter synchronization
    if (syncUrl) {
      const url = new URL(window.location.href);
      if (trimmedQuery) url.searchParams.set('q', trimmedQuery);
      else url.searchParams.delete('q');

      if (savedCategory.toLowerCase() !== 'all') url.searchParams.set('category', savedCategory);
      else url.searchParams.delete('category');

      if (savedSort !== 'newest') url.searchParams.set('sort', savedSort);
      else url.searchParams.delete('sort');
      url.searchParams.delete('focus');

      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }
  };

  // Search Input Listeners (Real-time library search)
  searchInput?.addEventListener('input', () => {
    updateLibrary();
  });

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (searchInput.value) {
        searchInput.value = '';
        updateLibrary();
      }
    }
    if (e.key === 'Enter') {
      searchInput.blur();
    }
  });

  // Search button action: activates search button and focuses input or runs search
  searchSubmitBtn?.addEventListener('click', () => {
    updateLibrary();
    searchInput?.focus();
  });

  // Open the complete category as a browser-history entry so Back returns to the library view.
  const openCategory = (category: string) => {
    if (searchInput) searchInput.value = '';
    savedCategory = category;
    draftCategory = category;

    const categoryUrl = new URL(window.location.href);
    categoryUrl.searchParams.set('category', category);
    categoryUrl.searchParams.delete('q');
    if (categoryUrl.href !== window.location.href) {
      window.history.pushState({ resourceCategoryView: true }, '', categoryUrl);
    }

    syncSavedFilterIcon();
    updateLibrary();
    const toolbar = document.querySelector('.explore-toolbar-section');
    if (toolbar) toolbar.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  document.querySelectorAll<HTMLButtonElement>('[data-category-open]').forEach((btn) => {
    btn.addEventListener('click', () => openCategory(btn.dataset.categoryOpen || 'all'));
  });

  // Bottom arrow expands beyond the first four items; for shorter categories it opens the full category listing.
  categoryToggleButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const section = btn.closest('.category-curated-section') as HTMLElement | null;
      if (!section) return;
      const resources = Array.from(section.querySelectorAll<HTMLElement>('.category-resource-row'));
      const hasMoreThanPreview = resources.length > 4;
      if (!hasMoreThanPreview) {
        openCategory(btn.dataset.categoryName || section.dataset.sectionCategory || 'all');
        return;
      }
      const expanded = section.classList.toggle('is-expanded');
      resources.forEach((resource, index) => {
        resource.hidden = !expanded && index >= 4;
      });
      btn.setAttribute('aria-expanded', String(expanded));
      btn.setAttribute(
        'aria-label',
        expanded
          ? `Show fewer ${section.dataset.sectionCategory || ''} resources`
          : `Show all ${section.dataset.sectionCategory || ''} resources`
      );
    });
  });

  // Restore resource state when browser Back or Forward is used.
  window.addEventListener('popstate', () => {
    const params = new URLSearchParams(window.location.search);
    savedCategory = params.get('category') || 'all';
    savedSort = params.get('sort') || 'newest';
    if (searchInput) searchInput.value = params.get('q') || '';
    draftCategory = savedCategory;
    draftSort = savedSort;
    syncSavedFilterIcon();
    syncDialogDraftUI();
    updateLibrary(false);
  });

  // Empty Search State Reset Button
  const resetAllFilters = () => {
    if (searchInput) searchInput.value = '';
    savedCategory = 'all';
    savedSort = 'newest';
    draftCategory = 'all';
    draftSort = 'newest';
    syncSavedFilterIcon();
    updateLibrary();
  };

  emptyResetBtn?.addEventListener('click', resetAllFilters);

  // Initial render on load
  syncSavedFilterIcon();
  updateLibrary(false);

  // Header search links and legacy /search/ redirects land here with focus=search.
  const shouldFocusSearch = urlParams.get('focus') === 'search';
  if (shouldFocusSearch && searchInput) {
    window.requestAnimationFrame(() => {
      searchInput.focus({ preventScroll: true });
      searchInput.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
    const cleanUrl = new URL(window.location.href);
    cleanUrl.searchParams.delete('focus');
    window.history.replaceState({}, '', `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`);
  }
</script>
