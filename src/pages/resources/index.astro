</style>

<script>
  // CLIENT-SIDE SEARCH, FILTER & SORT CONTROLLER
  const searchInput = document.getElementById('resource-search-input') as HTMLInputElement | null;
  const searchClearBtn = document.getElementById('search-clear-btn') as HTMLButtonElement | null;
  const categoryChips = Array.from(document.querySelectorAll('.category-chip')) as HTMLButtonElement[];
  const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
  const clearAllBtn = document.getElementById('clear-all-btn') as HTMLButtonElement | null;
  const emptyResetBtn = document.getElementById('empty-reset-btn') as HTMLButtonElement | null;
  const resultsCountText = document.getElementById('results-count-text');
  const emptySearchState = document.getElementById('empty-search-state');
  const spotlightSection = document.getElementById('featured-spotlight-section');
  const resourcesGrid = document.getElementById('resources-grid');
  const cardElements = Array.from(document.querySelectorAll('.resource-card')) as HTMLElement[];
  const searchableTargets = Array.from(document.querySelectorAll('.searchable-target')) as HTMLElement[];

  // Store original text for highlighting
  searchableTargets.forEach((el) => {
    el.dataset.original = el.textContent || '';
  });

  // Read initial query params from URL
  const urlParams = new URLSearchParams(window.location.search);
  let activeCategory = urlParams.get('category') || 'all';
  let activeQuery = urlParams.get('q') || '';
  let activeSort = urlParams.get('sort') || 'newest';

  // Apply initial values to controls
  if (searchInput && activeQuery) {
    searchInput.value = activeQuery;
    if (searchClearBtn) searchClearBtn.hidden = false;
  }

  if (sortSelect && ['newest', 'oldest', 'title'].includes(activeSort)) {
    sortSelect.value = activeSort;
  }

  const syncCategoryChipsUI = () => {
    categoryChips.forEach((chip) => {
      const cat = chip.dataset.category || 'all';
      const isSelected = cat.toLowerCase() === activeCategory.toLowerCase();
      chip.classList.toggle('is-active', isSelected);
      chip.setAttribute('aria-selected', isSelected ? 'true' : 'false');
    });
  };

  syncCategoryChipsUI();

  // Escape special chars for RegExp
  const escapeRegex = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  // Highlight matches in card titles & descriptions
  const applyHighlights = (query: string) => {
    const terms = query
      .trim()
      .split(/\s+/)
      .filter((t) => t.length > 1)
      .map(escapeRegex);

    if (!terms.length) {
      searchableTargets.forEach((el) => {
        el.textContent = el.dataset.original || '';
      });
      return;
    }

    const regex = new RegExp(`(${terms.join('|')})`, 'gi');

    searchableTargets.forEach((el) => {
      const original = el.dataset.original || '';
      const parts = original.split(regex);
      el.innerHTML = '';
      parts.forEach((part) => {
        if (regex.test(part)) {
          const mark = document.createElement('mark');
          mark.className = 'search-hl';
          mark.textContent = part;
          el.appendChild(mark);
        } else {
          el.appendChild(document.createTextNode(part));
        }
      });
    });
  };

  // Sort resources in DOM
  const sortCards = (cards: HTMLElement[], sortType: string) => {
    if (!resourcesGrid) return;
    cards.sort((a, b) => {
      if (sortType === 'oldest') {
        const dateA = Number(a.dataset.date || 0);
        const dateB = Number(b.dataset.date || 0);
        return dateA - dateB;
      }
      if (sortType === 'title') {
        const titleA = a.dataset.title || '';
        const titleB = b.dataset.title || '';
        return titleA.localeCompare(titleB);
      }
      // default: newest
      const dateA = Number(a.dataset.date || 0);
      const dateB = Number(b.dataset.date || 0);
      return dateB - dateA;
    });

    cards.forEach((card) => resourcesGrid.appendChild(card));
  };

  // Main filter & update function
  const updateLibrary = (syncUrl = true) => {
    const trimmedQuery = (searchInput?.value || '').trim();
    const lowerQuery = trimmedQuery.toLowerCase();
    const queryTerms = lowerQuery.split(/\s+/).filter(Boolean);

    let matchCount = 0;

    cardElements.forEach((card) => {
      const cardCategory = (card.dataset.category || '').toLowerCase();
      const cardSearchBlob = card.dataset.search || '';

      // Category check
      const matchesCategory =
        activeCategory === 'all' || cardCategory === activeCategory.toLowerCase();

      // Search terms check (every term must appear in the search blob)
      const matchesQuery =
        !queryTerms.length || queryTerms.every((term) => cardSearchBlob.includes(term));

      const isVisible = matchesCategory && matchesQuery;
      card.hidden = !isVisible;
      if (isVisible) matchCount += 1;
    });

    // Re-order visible cards
    sortCards(cardElements, activeSort);

    // Spotlight visibility: hide spotlight if actively filtering or searching
    if (spotlightSection) {
      const isFiltered = activeCategory !== 'all' || lowerQuery.length > 0;
      spotlightSection.hidden = isFiltered;
    }

    // Update highlights
    applyHighlights(trimmedQuery);

    // Update clear button visibility
    if (searchClearBtn) {
      searchClearBtn.hidden = trimmedQuery.length === 0;
    }

    // Update clear all filters button visibility
    const hasActiveFilters = activeCategory !== 'all' || trimmedQuery.length > 0 || activeSort !== 'newest';
    if (clearAllBtn) {
      clearAllBtn.hidden = !hasActiveFilters;
    }

    // Update results counter
    if (resultsCountText) {
      if (trimmedQuery) {
        resultsCountText.textContent = `Found ${matchCount} resource${matchCount === 1 ? '' : 's'} matching "${trimmedQuery}"`;
      } else if (activeCategory !== 'all') {
        resultsCountText.textContent = `Showing ${matchCount} resource${matchCount === 1 ? '' : 's'} in ${activeCategory}`;
      } else {
        resultsCountText.textContent = `Showing ${matchCount} resource${matchCount === 1 ? '' : 's'}`;
      }
    }

    // Empty state
    if (emptySearchState) {
      emptySearchState.hidden = matchCount > 0;
    }

    // URL parameter synchronization
    if (syncUrl) {
      const url = new URL(window.location.href);
      if (trimmedQuery) url.searchParams.set('q', trimmedQuery);
      else url.searchParams.delete('q');

      if (activeCategory !== 'all') url.searchParams.set('category', activeCategory);
      else url.searchParams.delete('category');

      if (activeSort !== 'newest') url.searchParams.set('sort', activeSort);
      else url.searchParams.delete('sort');

      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }
  };

  // Event Listeners
  searchInput?.addEventListener('input', () => updateLibrary());

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (searchInput.value) {
        searchInput.value = '';
        updateLibrary();
      }
    }
  });

  searchClearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      updateLibrary();
    }
  });

  categoryChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeCategory = chip.dataset.category || 'all';
      syncCategoryChipsUI();
      updateLibrary();
    });
  });

  sortSelect?.addEventListener('change', () => {
    activeSort = sortSelect.value || 'newest';
    updateLibrary();
  });

  const resetAllFilters = () => {
    if (searchInput) searchInput.value = '';
    activeCategory = 'all';
    activeSort = 'newest';
    if (sortSelect) sortSelect.value = 'newest';
    syncCategoryChipsUI();
    updateLibrary();
  };

  clearAllBtn?.addEventListener('click', resetAllFilters);
  emptyResetBtn?.addEventListener('click', resetAllFilters);

  // Initial render (no URL push on first run)
  updateLibrary(false);
</script>
