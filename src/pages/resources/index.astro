  }

  @media (max-width: 640px) {
    .recent-curated-section {
      margin-bottom: 24px;
    }

    .recent-curated-section .recent-works-header {
      margin-bottom: 13px;
    }

    .recent-curated-section .recent-scroll-wrapper {
      gap: 18px;
      padding: 3px 1px 8px;
    }

    .recent-curated-section .recent-resource-card {
      flex: 0 0 67%;
      width: 67%;
      min-width: 0;
      max-width: 380px;
      padding: 0;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
    }

    .recent-curated-section .recent-resource-thumb-wrap {
      border-radius: 12px;
    }

    .recent-curated-section .recent-resource-card-body {
      padding: 10px 12px 2px;
      box-sizing: border-box;
    }

    .recent-curated-section .recent-resource-meta-row {
      margin-bottom: 8px;
    }

    .recent-curated-section .recent-resource-card-title {
      font-size: 14px;
      line-height: 1.35;
      -webkit-line-clamp: 3;
    }

    :global([data-theme="light"]) .recent-curated-section .recent-resource-card,
    :global(html.light-theme) .recent-curated-section .recent-resource-card {
      background: transparent;
      border: 0;
      box-shadow: none;
    }
  }


