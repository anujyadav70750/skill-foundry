---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  formatResourceDate,
  resourceImageAlt,
  resourceDisplaySrcSet,
  resourceSlug,
  resourceThumbnail
} from '../lib/resource';

const siteUrl = 'https://hub.skillfoundry-web.workers.dev';
const instagramUrl = 'https://www.instagram.com/skillfoundry.ai/';
const authorImage = '/images/skill-foundry-author.jpg';

const allResources = await getCollection('resources');
const publishedResources = allResources
  .filter((resource) => !('draft' in resource.data && resource.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// The latest four are highlighted above. Older resources appear in the archive below,
// so the same resource is not repeated twice on this page.
const latestResources = publishedResources.slice(0, 4);
const archiveResources = publishedResources.slice(4);
const archiveCategories = [...new Set(archiveResources.map((resource) => resource.data.category).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));

const authorPageUrl = new URL('/author/', siteUrl).href;
const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: 'Skill Foundry — Creator & Author',
  url: authorPageUrl,
  mainEntity: {
    '@type': 'Person',
    name: 'Skill Foundry',
    jobTitle: 'Creator & Author',
    url: authorPageUrl,
    image: new URL(authorImage, siteUrl).href,
    sameAs: [instagramUrl],
    worksFor: {
      '@type': 'Organization',
      name: 'Skill Foundry',
      url: siteUrl
    }
  }
};
---

<BaseLayout
  title="Author | Skill Foundry"
  description="Meet the creator behind Skill Foundry and explore practical resources, tutorials and workflows."
  canonical={authorPageUrl}
  image={authorImage}
  imageAlt="Skill Foundry creator profile photograph"
>
  <script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />

  <div class="author-page">
    <section class="author-profile-section">
      <div class="author-page-container">
        <div class="author-profile">
          <img
            class="author-profile-photo"
            src={authorImage}
            alt="Skill Foundry creator"
            width="720"
            height="720"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="author-profile-copy">
            <p class="author-profile-role">Creator &amp; Author</p>
            <h1>Skill Foundry</h1>
            <a class="author-instagram-handle" href={instagramUrl} target="_blank" rel="noopener noreferrer">
              @skillfoundry.ai
              <svg viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true">
                <path d="M4.5 11.5 11.5 4.5M5 4.5h6.5V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <p class="author-profile-intro">
              Creating practical guides and clear workflows that help people understand useful skills and put them to work.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="author-section author-latest-section" aria-labelledby="author-latest-heading">
      <div class="author-page-container">
        <div class="author-section-header">
          <div>
            <h2 id="author-latest-heading">Latest Resources</h2>
            <p>Newly published guides and practical workflows.</p>
          </div>
          <a class="author-section-link" href="/resources/" aria-label="Browse all Skill Foundry resources">
            All resources
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
              <path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>

        {latestResources.length > 0 ? (
          <div class="recent-work-carousel-wrapper author-latest-carousel">
            <button type="button" class="recent-work-nav-btn recent-work-prev" data-author-carousel-prev aria-label="Scroll latest resources left">
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </button>

            <div class="recent-work-carousel-track" data-author-latest-track role="region" aria-label="Latest published resources">
              {latestResources.map((resource, index) => {
                const slug = resourceSlug(resource);
                const thumbnail = resourceThumbnail(resource);
                const alt = resourceImageAlt(resource);
                const dateStr = formatResourceDate(resource.data.date);
                const srcSet = resourceDisplaySrcSet(resource.data.heroImage || resource.data.thumbnail || resource.data.inputImage);

                return (
                  <a class="recent-work-card" href={`/resources/${slug}/`} aria-label={`Open ${resource.data.title}`}>
                    <div class="recent-work-thumb-wrap">
                      <img
                        class="recent-work-thumb-img"
                        src={thumbnail}
                        srcset={srcSet}
                        sizes="(max-width: 600px) 84vw, 380px"
                        alt={alt}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </div>
                    <div class="recent-work-card-body">
                      <div class="recent-work-meta-row">
                        <span class="recent-work-meta-category">{resource.data.category}</span>
                        <span class="recent-work-meta-date">{dateStr}</span>
                      </div>
                      <h3 class="recent-work-card-title">{resource.data.title}</h3>
                    </div>
                  </a>
                );
              })}
            </div>

            <button type="button" class="recent-work-nav-btn recent-work-next" data-author-carousel-next aria-label="Scroll latest resources right">
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        ) : (
          <p class="author-empty-message">New resources will appear here when they are published.</p>
        )}
      </div>
    </section>

    <section class="author-section author-archive-section" aria-labelledby="author-archive-heading" data-author-archive>
      <div class="author-page-container">
        <div class="author-section-header author-archive-header">
          <div>
            <h2 id="author-archive-heading">All Published Resources</h2>
            <p>Browse earlier publications from the Skill Foundry library.</p>
          </div>
        </div>

        {archiveResources.length > 0 ? (
          <>
            <div class="author-resource-filters">
              <label class="author-search-field">
                <span class="sr-only">Search older resources</span>
                <input type="search" placeholder="Search resources…" autocomplete="off" data-author-search />
              </label>
              <label class="author-category-field">
                <span class="sr-only">Filter resources by category</span>
                <select data-author-category>
                  <option value="">All categories</option>
                  {archiveCategories.map((category) => <option value={category}>{category}</option>)}
                </select>
              </label>
            </div>

            <div class="author-archive-grid" data-author-archive-grid>
              {archiveResources.map((resource) => {
                const slug = resourceSlug(resource);
                const thumbnail = resourceThumbnail(resource);
                const alt = resourceImageAlt(resource);
                const dateStr = formatResourceDate(resource.data.date);
                const searchText = [resource.data.title, resource.data.description, resource.data.category, ...(resource.data.tags || [])].join(' ').toLowerCase();
                const srcSet = resourceDisplaySrcSet(resource.data.heroImage || resource.data.thumbnail || resource.data.inputImage);

                return (
                  <a
                    class="recent-work-card author-archive-card"
                    href={`/resources/${slug}/`}
                    aria-label={`Open ${resource.data.title}`}
                    data-author-archive-card
                    data-category={resource.data.category}
                    data-search={searchText}
                  >
                    <div class="recent-work-thumb-wrap">
                      <img class="recent-work-thumb-img" src={thumbnail} srcset={srcSet} sizes="(max-width: 600px) 90vw, 360px" alt={alt} loading="lazy" decoding="async" />
                    </div>
                    <div class="recent-work-card-body">
                      <div class="recent-work-meta-row">
                        <span class="recent-work-meta-category">{resource.data.category}</span>
                        <span class="recent-work-meta-date">{dateStr}</span>
                      </div>
                      <h3 class="recent-work-card-title">{resource.data.title}</h3>
                    </div>
                  </a>
                );
              })}
            </div>

            <p class="author-archive-empty" data-author-archive-empty hidden>No resources match your search. Try another word or category.</p>
            <div class="author-load-more-wrap">
              <button type="button" class="author-load-more" data-author-load-more>Load more resources</button>
            </div>
          </>
        ) : (
          <div class="author-archive-empty-state">
            <p>All currently published resources are shown in the Latest Resources section above. Older resources will appear here automatically as the library grows.</p>
          </div>
        )}
      </div>
    </section>

    <section class="author-section" aria-labelledby="author-about-heading">
      <div class="author-page-container author-reading-width">
        <div class="author-section-header">
          <div>
            <h2 id="author-about-heading">About the Author</h2>
            <p>The creator behind Skill Foundry.</p>
          </div>
        </div>
        <div class="author-about-copy">
          <p>I created Skill Foundry to make useful skills easier to understand and apply. I build practical tutorials and workflows that explain the steps, tools and decisions behind a result—not just the finished example.</p>
          <p>The aim is to help people learn by doing, understand how a process works, and adapt what they learn to their own projects. Skill Foundry is growing as a place for practical skills that make creating and everyday work easier, including areas beyond AI.</p>
        </div>
      </div>
    </section>

    <section class="author-section" aria-labelledby="author-expertise-heading">
      <div class="author-page-container">
        <div class="author-section-header">
          <div>
            <h2 id="author-expertise-heading">Areas of Expertise</h2>
            <p>Practical topics covered through Skill Foundry resources.</p>
          </div>
        </div>
        <div class="author-expertise-grid">
          <article class="author-expertise-item">
            <h3>AI Image &amp; Video Creation</h3>
            <p>Prompt-led visual creation, reference workflows and practical generation techniques.</p>
          </article>
          <article class="author-expertise-item">
            <h3>Automation</h3>
            <p>Useful systems and workflows that reduce repetitive tasks.</p>
          </article>
          <article class="author-expertise-item">
            <h3>Content Creation &amp; Editing</h3>
            <p>Planning, creating and improving content from the first idea to the final result.</p>
          </article>
          <article class="author-expertise-item">
            <h3>Design &amp; Templates</h3>
            <p>Reusable layouts, templates and visual resources for practical projects.</p>
          </article>
          <article class="author-expertise-item">
            <h3>Practical Digital Skills</h3>
            <p>Tools, techniques and everyday workflows that help people work more effectively.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="author-section author-connect-section" aria-labelledby="author-connect-heading">
      <div class="author-page-container">
        <div class="author-section-header">
          <div>
            <h2 id="author-connect-heading">Connect</h2>
            <p>Follow the work or send a message through the website.</p>
          </div>
        </div>
        <div class="author-connect-grid">
          <a class="author-connect-card" href={instagramUrl} target="_blank" rel="noopener noreferrer">
            <span class="author-connect-label">Instagram</span>
            <span class="author-connect-value">@skillfoundry.ai</span>
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
              <path d="M4.5 11.5 11.5 4.5M5 4.5h6.5V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
          <a class="author-connect-card" href="/contact/">
            <span class="author-connect-label">Website Contact Form</span>
            <span class="author-connect-value">Send an enquiry</span>
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
              <path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const latestTrack = document.querySelector('[data-author-latest-track]');
  const previousButton = document.querySelector('[data-author-carousel-prev]');
  const nextButton = document.querySelector('[data-author-carousel-next]');

  if (latestTrack instanceof HTMLElement) {
    previousButton?.addEventListener('click', () => {
      latestTrack.scrollBy({ left: -Math.max(280, latestTrack.clientWidth * 0.85), behavior: 'smooth' });
    });
    nextButton?.addEventListener('click', () => {
      latestTrack.scrollBy({ left: Math.max(280, latestTrack.clientWidth * 0.85), behavior: 'smooth' });
    });
  }

  const archive = document.querySelector('[data-author-archive]');
  if (archive) {
    const cards = Array.from(archive.querySelectorAll<HTMLElement>('[data-author-archive-card]'));
    const search = archive.querySelector('[data-author-search]');
    const category = archive.querySelector('[data-author-category]');
    const loadMore = archive.querySelector('[data-author-load-more]');
    const emptyMessage = archive.querySelector('[data-author-archive-empty]');
    let visibleLimit = 6;

    const updateArchive = () => {
      const query = (search instanceof HTMLInputElement ? search.value : '').trim().toLowerCase();
      const selectedCategory = category instanceof HTMLSelectElement ? category.value : '';
      const matches = cards.filter((card) => {
        const text = card.getAttribute('data-search') || '';
        const cardCategory = card.getAttribute('data-category') || '';
        return text.includes(query) && (!selectedCategory || cardCategory === selectedCategory);
      });

      cards.forEach((card) => { card.hidden = !matches.includes(card); });
      matches.forEach((card, index) => { card.hidden = index >= visibleLimit; });

      if (loadMore instanceof HTMLButtonElement) {
        loadMore.hidden = matches.length <= visibleLimit;
        loadMore.textContent = `Load more resources (${Math.max(0, matches.length - visibleLimit)})`;
      }
      if (emptyMessage instanceof HTMLElement) emptyMessage.hidden = matches.length > 0;
    };

    search?.addEventListener('input', () => {
      visibleLimit = 6;
      updateArchive();
    });
    category?.addEventListener('change', () => {
      visibleLimit = 6;
      updateArchive();
    });
    loadMore?.addEventListener('click', () => {
      visibleLimit += 6;
      updateArchive();
    });

    updateArchive();
  }
</script>

<style>
  .author-page {
    padding-bottom: 0;
  }

  .author-page-container {
    width: min(var(--max, 1180px), calc(100% - 48px));
    margin-inline: auto;
  }

  .author-reading-width {
    max-width: 780px;
  }

  .author-profile-section {
    padding: 42px 0 32px;
  }

  .author-profile {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: 900px;
    margin-inline: auto;
  }

  .author-profile-photo {
    display: block;
    flex: 0 0 136px;
    width: 136px;
    height: 136px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--sf-page-border, rgba(255,255,255,.08));
    background: var(--sf-page-surface, #0B0D12);
  }

  .author-profile-copy {
    min-width: 0;
  }

  .author-profile-role {
    margin: 0 0 5px;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .04em;
  }

  .author-profile-copy h1 {
    margin: 0;
    color: var(--sf-page-heading, #F5F5F5);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.025em;
  }

  .author-instagram-handle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 9px;
    color: var(--sf-page-accent, #35C9C1);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .author-instagram-handle:hover,
  .author-section-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .author-profile-intro {
    max-width: 640px;
    margin: 12px 0 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    line-height: 1.65;
  }

  .author-section {
    padding: 30px 0;
    border-top: 1px solid var(--sf-page-border, rgba(255,255,255,.08));
  }

  .author-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .author-section-header h2 {
    margin: 0;
    color: var(--sf-page-heading, #F5F5F5);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(25px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -.02em;
  }

  .author-section-header p {
    margin: 7px 0 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    line-height: 1.55;
  }

  .author-section-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    color: var(--sf-page-accent, #35C9C1);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .author-empty-message,
  .author-archive-empty-state {
    margin: 0;
    padding: 16px 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    line-height: 1.65;
  }

  /* Keep the Recent carousel's established card appearance and mobile peek. */
  .author-latest-carousel {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .author-latest-carousel .recent-work-carousel-track {
    display: flex;
    align-items: stretch;
    gap: 20px;
    width: 100%;
    padding: 4px 2px 12px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .author-latest-carousel .recent-work-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .author-latest-carousel .recent-work-card {
    flex: 0 0 calc((100% - 40px) / 3.25);
    min-width: 280px;
    max-width: 380px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: 14px;
    border-radius: 18px;
    background: rgba(17, 23, 34, .75);
    border: 1px solid rgba(255, 255, 255, .08);
    box-sizing: border-box;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
  }

  :global([data-theme="light"]) .author-latest-carousel .recent-work-card,
  :global(html.light-theme) .author-latest-carousel .recent-work-card {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 2px 8px rgba(15,23,42,.05);
  }

  .author-latest-carousel .recent-work-card:hover {
    transform: translateY(-3px);
    border-color: rgba(56,189,248,.35);
    box-shadow: 0 12px 30px rgba(0,0,0,.4);
  }

  .author-latest-carousel .recent-work-thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 12px;
    background: #04070D;
    border: 1px solid rgba(255,255,255,.06);
    flex-shrink: 0;
  }

  .author-latest-carousel .recent-work-thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s ease;
  }

  .author-latest-carousel .recent-work-card:hover .recent-work-thumb-img {
    transform: scale(1.03);
  }

  .author-latest-carousel .recent-work-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 14px;
  }

  .author-latest-carousel .recent-work-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
  }

  .author-latest-carousel .recent-work-meta-category {
    padding: 3px 9px;
    border: 1px solid var(--badge-border, rgba(255,255,255,.12));
    border-radius: 9999px;
    background: var(--badge-bg, rgba(255,255,255,.05));
    color: var(--badge-text, #CBD5E1);
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: .08em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .author-latest-carousel .recent-work-meta-date {
    color: #94A3B8;
    font-family: 'JetBrains Mono', monospace;
    font-size: 11.5px;
    font-weight: 500;
    white-space: nowrap;
  }

  .author-latest-carousel .recent-work-card-title {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: #F8FAFC;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  :global([data-theme="light"]) .author-latest-carousel .recent-work-card-title,
  :global(html.light-theme) .author-latest-carousel .recent-work-card-title {
    color: #0F172A;
  }

  .author-latest-carousel .recent-work-nav-btn {
    position: absolute;
    top: calc(50% - 16px);
    z-index: 5;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: 50%;
    background: rgba(15,23,42,.92);
    color: #CBD5E1;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .author-latest-carousel .recent-work-prev { left: -18px; }
  .author-latest-carousel .recent-work-next { right: -18px; }

  :global([data-theme="light"]) .author-latest-carousel .recent-work-nav-btn,
  :global(html.light-theme) .author-latest-carousel .recent-work-nav-btn {
    background: #FFFFFF;
    border-color: #CBD5E1;
    color: #475569;
  }

  .author-archive-section .author-section-header {
    margin-bottom: 18px;
  }

  .author-resource-filters {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, .38fr);
    gap: 12px;
    margin-bottom: 18px;
  }

  .author-resource-filters input,
  .author-resource-filters select {
    width: 100%;
    min-height: 44px;
    box-sizing: border-box;
    padding: 10px 13px;
