---
import { getCollection } from 'astro:content';
import { AUTHOR_PROFILES } from '../data/authors';
import { SKILL_FOUNDRY_AUTHOR_ID } from '../lib/author';
import AuthorChannelPage from '../components/authors/AuthorChannelPage.astro';
import { resourceDisplayDate } from '../lib/resource';

const profile = AUTHOR_PROFILES[SKILL_FOUNDRY_AUTHOR_ID];
const resources = (await getCollection('resources'))
  .filter((resource) => !('draft' in resource.data && resource.data.draft === true))
  .filter((resource) => resource.data.authorId === SKILL_FOUNDRY_AUTHOR_ID)
  .sort((a, b) => resourceDisplayDate(b).valueOf() - resourceDisplayDate(a).valueOf());
---
<AuthorChannelPage profile={profile} resources={resources} basePath="/author/" view="home" />
