---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { SKILL_FOUNDRY_AUTHOR_ID } from '../lib/author';
import {
  formatResourceDate,
  resourceImageAlt,
  resourceDisplaySrcSet,
  resourceSlug,
  resourceThumbnail
} from '../lib/resource';

const siteUrl = 'https://hub.skillfoundry-web.workers.dev';
const [allResources, authorProfiles] = await Promise.all([
  getCollection('resources'),
  getCollection('authors')
]);
const authorProfile = authorProfiles.find((profile) => profile.id === SKILL_FOUNDRY_AUTHOR_ID);
if (!authorProfile) throw new Error('Missing author profile: skill-foundry');

const authorName = authorProfile.data.name;
const authorRole = authorProfile.data.role;
const authorHandle = authorProfile.data.handle || '';
const instagramUrl = authorProfile.data.instagramUrl || '';
const authorImage = authorProfile.data.image;

const publishedResources = allResources
  .filter((resource) => !('draft' in resource.data && resource.data.draft === true))
  .filter((resource) => resource.data.authorId === SKILL_FOUNDRY_AUTHOR_ID)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Latest Resources highlights the newest four. The archive contains the complete author catalogue.
const latestResources = publishedResources.slice(0, 4);
const archiveResources = publishedResources;
const archiveCategories = [...new Set(publishedResources.map((resource) => resource.data.category).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));

const authorPageUrl = new URL('/author/', siteUrl).href;
const authorSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: authorName + ' — ' + authorRole,
  url: authorPageUrl,
  mainEntity: {
    '@type': 'Person',
    name: authorName,
    jobTitle: authorRole,
    url: authorPageUrl,
    image: new URL(authorImage, siteUrl).href,
    sameAs: instagramUrl ? [instagramUrl] : [],
    worksFor: {
      '@type': 'Organization',
      name: 'Skill Foundry',
      url: siteUrl
    }
  }
};
---

<BaseLayout
  title={authorName + ' | Skill Foundry'}
  description={authorProfile.data.description}
  canonical={authorPageUrl}
  image={authorImage}
  imageAlt={authorName + ' profile photograph'}
>
  <script type="application/ld+json" set:html={JSON.stringify(authorSchema)} />

  <div class="author-page">
    <section class="author-profile-section">
      <div class="author-page-container">
        <div class="author-profile">
          <div class="author-profile-main">
            <img
              class="author-profile-photo"
              src={authorImage}
              alt={authorName + ' creator portrait'}
              width="720"
              height="720"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
            <div class="author-profile-copy">
              <p class="author-profile-role">{authorRole}</p>
              <h1>{authorName}</h1>
              {instagramUrl && authorHandle && (
                <a class="author-instagram-handle" href={instagramUrl} target="_blank" rel="noopener noreferrer">
                  {authorHandle}
                  <svg viewBox="0 0 16 16" width="13" height="13" fill="none" aria-hidden="true">
                    <path d="M4.5 11.5 11.5 4.5M5 4.5h6.5V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              )}
            </div>
          </div>
          <p class="author-profile-intro">{authorProfile.data.description}</p>
        </div>
      </div>
    </section>

    <section class="author-section author-latest-section" aria-labelledby="author-latest-heading">
      <div class="author-page-container recent-work-container">
        <div class="recent-works-header">
          <a class="recent-works-header-link" href="/resources/" aria-label="Browse all Skill Foundry resources">
            <h2 class="recent-works-title" id="author-latest-heading">Latest Resources</h2>
            <svg class="recent-works-chevron" aria-hidden="true" viewBox="0 0 16 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 5L10 12L3 19" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        </div>

        {latestResources.length > 0 ? (
          <div class="recent-work-carousel-wrapper author-latest-carousel">
            <button type="button" class="recent-work-nav-btn recent-work-prev" data-author-carousel-prev aria-label="Scroll latest resources left">
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
            </button>

            <div class="recent-work-carousel-track" data-author-latest-track role="region" aria-label="Latest published resources">
              {latestResources.map((resource, index) => {
                const slug = resourceSlug(resource);
                const thumbnail = resourceThumbnail(resource);
                const alt = resourceImageAlt(resource);
                const dateStr = formatResourceDate(resource.data.date);
                const srcSet = resourceDisplaySrcSet(resource.data.heroImage || resource.data.thumbnail || resource.data.inputImage);

                return (
                  <a class="recent-work-card" href={`/resources/${slug}/`} aria-label={`Open ${resource.data.title}`}>
                    <div class="recent-work-thumb-wrap">
                      <img
                        class="recent-work-thumb-img"
                        src={thumbnail}
                        srcset={srcSet}
                        sizes="(max-width: 600px) 78vw, 420px"
                        alt={alt}
                        loading={index === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    </div>
                    <div class="recent-work-card-body">
                      <div class="recent-work-meta-row">
                        <span class="recent-work-meta-category">{resource.data.category}</span>
                        <span class="recent-work-meta-date">
                          <svg class="recent-work-meta-calendar" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                          </svg>
                          <span>{dateStr}</span>
                        </span>
                      </div>
                      <h3 class="recent-work-card-title">{resource.data.title}</h3>
                    </div>
                  </a>
                );
              })}
            </div>

            <button type="button" class="recent-work-nav-btn recent-work-next" data-author-carousel-next aria-label="Scroll latest resources right">
              <svg viewBox="0 0 20 20" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            </button>
          </div>
        ) : (
          <p class="author-empty-message">New resources will appear here when they are published.</p>
        )}
      </div>
    </section>

    <section class="author-section author-archive-section" aria-labelledby="author-archive-heading" data-author-archive>
      <div class="author-page-container">
        <div class="author-section-header author-archive-header">
          <div>
            <h2 id="author-archive-heading">All Published Resources</h2>
            <p>Browse every resource published under this author profile.</p>
          </div>
        </div>

        {archiveResources.length > 0 ? (
          <>
            <div class="author-resource-filters">
              <label class="author-search-field">
                <span class="sr-only">Search published resources</span>
                <input type="search" placeholder="Search all resources…" autocomplete="off" data-author-search />
              </label>
              <label class="author-category-field">
                <span class="sr-only">Filter resources by category</span>
                <select data-author-category>
                  <option value="">All categories</option>
                  {archiveCategories.map((category) => <option value={category}>{category}</option>)}
                </select>
              </label>
            </div>

            <div class="author-archive-grid" data-author-archive-grid>
              {archiveResources.map((resource) => {
                const slug = resourceSlug(resource);
                const thumbnail = resourceThumbnail(resource);
                const alt = resourceImageAlt(resource);
                const dateStr = formatResourceDate(resource.data.date);
                const searchText = [resource.data.title, resource.data.description, resource.data.category, ...(resource.data.tags || [])].join(' ').toLowerCase();
                const srcSet = resourceDisplaySrcSet(resource.data.heroImage || resource.data.thumbnail || resource.data.inputImage);

                return (
                  <a
                    class="recent-work-card author-archive-card"
                    href={`/resources/${slug}/`}
                    aria-label={`Open ${resource.data.title}`}
                    data-author-archive-card
                    data-category={resource.data.category}
                    data-search={searchText}
                  >
                    <div class="recent-work-thumb-wrap">
                      <img class="recent-work-thumb-img" src={thumbnail} srcset={srcSet} sizes="(max-width: 600px) 90vw, 360px" alt={alt} loading="lazy" decoding="async" />
                    </div>
                    <div class="recent-work-card-body">
                      <div class="recent-work-meta-row">
                        <span class="recent-work-meta-category">{resource.data.category}</span>
                        <span class="recent-work-meta-date">{dateStr}</span>
                      </div>
                      <h3 class="recent-work-card-title">{resource.data.title}</h3>
                    </div>
                  </a>
                );
              })}
            </div>

            <p class="author-archive-empty" data-author-archive-empty hidden>No resources match your search. Try another word or category.</p>
            <div class="author-load-more-wrap">
              <button type="button" class="author-load-more" data-author-load-more>Load more resources</button>
            </div>
          </>
        ) : (
          <div class="author-archive-empty-state">
            <p>No resources have been published under this author profile yet. New resources will appear here when they are published.</p>
          </div>
        )}
      </div>
    </section>

    <section class="author-section" aria-labelledby="author-about-heading">
      <div class="author-page-container author-reading-width">
        <div class="author-section-header">
          <div>
            <h2 id="author-about-heading">About the Author</h2>
            <p>The creator behind Skill Foundry.</p>
          </div>
        </div>
        <div class="author-about-copy">
          {authorProfile.data.about.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="author-section" aria-labelledby="author-expertise-heading">
      <div class="author-page-container">
        <div class="author-section-header">
          <div>
            <h2 id="author-expertise-heading">Areas of Expertise</h2>
            <p>Practical topics covered through Skill Foundry resources.</p>
          </div>
        </div>
        <div class="author-expertise-grid">
          {authorProfile.data.expertise.map((item) => (
            <article class="author-expertise-item">
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="author-section author-connect-section" aria-labelledby="author-connect-heading">
      <div class="author-page-container">
        <div class="author-section-header">
          <div>
            <h2 id="author-connect-heading">Connect</h2>
            <p>Follow {authorName}'s work or send a message through the website.</p>
          </div>
        </div>
        <div class="author-connect-grid">
          {instagramUrl && authorHandle && (
            <a class="author-connect-card" href={instagramUrl} target="_blank" rel="noopener noreferrer">
              <span class="author-connect-label">Instagram</span>
              <span class="author-connect-value">{authorHandle}</span>
              <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
                <path d="M4.5 11.5 11.5 4.5M5 4.5h6.5V11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          )}
          <a class="author-connect-card" href="/contact/">
            <span class="author-connect-label">Website Contact Form</span>
            <span class="author-connect-value">Send an enquiry</span>
            <svg viewBox="0 0 16 16" width="15" height="15" fill="none" aria-hidden="true">
              <path d="M3 8h10M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const latestTrack = document.querySelector('[data-author-latest-track]');
  const previousButton = document.querySelector('[data-author-carousel-prev]');
  const nextButton = document.querySelector('[data-author-carousel-next]');

  if (latestTrack instanceof HTMLElement) {
    previousButton?.addEventListener('click', () => {
      latestTrack.scrollBy({ left: -Math.max(280, latestTrack.clientWidth * 0.85), behavior: 'smooth' });
    });
    nextButton?.addEventListener('click', () => {
      latestTrack.scrollBy({ left: Math.max(280, latestTrack.clientWidth * 0.85), behavior: 'smooth' });
    });
  }

  const archive = document.querySelector('[data-author-archive]');
  if (archive) {
    const cards = Array.from(archive.querySelectorAll<HTMLElement>('[data-author-archive-card]'));
    const search = archive.querySelector('[data-author-search]');
    const category = archive.querySelector('[data-author-category]');
    const loadMore = archive.querySelector('[data-author-load-more]');
    const emptyMessage = archive.querySelector('[data-author-archive-empty]');
    let visibleLimit = 6;

    const updateArchive = () => {
      const query = (search instanceof HTMLInputElement ? search.value : '').trim().toLowerCase();
      const selectedCategory = category instanceof HTMLSelectElement ? category.value : '';
      const matches = cards.filter((card) => {
        const text = card.getAttribute('data-search') || '';
        const cardCategory = card.getAttribute('data-category') || '';
        return text.includes(query) && (!selectedCategory || cardCategory === selectedCategory);
      });

      cards.forEach((card) => { card.hidden = !matches.includes(card); });
      matches.forEach((card, index) => { card.hidden = index >= visibleLimit; });

      if (loadMore instanceof HTMLButtonElement) {
        loadMore.hidden = matches.length <= visibleLimit;
        loadMore.textContent = `Load more resources (${Math.max(0, matches.length - visibleLimit)})`;
      }
      if (emptyMessage instanceof HTMLElement) emptyMessage.hidden = matches.length > 0;
    };

    search?.addEventListener('input', () => {
      visibleLimit = 6;
      updateArchive();
    });
    category?.addEventListener('change', () => {
      visibleLimit = 6;
      updateArchive();
    });
    loadMore?.addEventListener('click', () => {
      visibleLimit += 6;
      updateArchive();
    });

    updateArchive();
  }
</script>

<style>
  .author-page {
    padding-bottom: 0;
  }

  .author-page-container {
    width: min(var(--max, 1180px), calc(100% - 48px));
    margin-inline: auto;
  }

  .author-reading-width {
    max-width: 780px;
  }

  .author-profile-section {
    padding: 42px 0 32px;
  }

  .author-profile {
    max-width: 900px;
    margin-inline: auto;
  }

  .author-profile-main {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .author-profile-photo {
    display: block;
    flex: 0 0 156px;
    width: 156px;
    height: 156px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--sf-page-border, rgba(255,255,255,.08));
    background: var(--sf-page-surface, #0B0D12);
  }

  .author-profile-copy {
    display: flex;
    min-width: 0;
    min-height: 132px;
    flex-direction: column;
    justify-content: center;
    padding-left: 24px;
    border-left: 1px solid var(--sf-page-border, rgba(255,255,255,.16));
  }

  .author-profile-role {
    margin: 0 0 5px;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .04em;
  }

  .author-profile-copy h1 {
    margin: 0;
    color: var(--sf-page-heading, #F5F5F5);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(30px, 4vw, 42px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -.025em;
  }

  .author-instagram-handle {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 9px;
    color: var(--sf-page-accent, #35C9C1);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .author-instagram-handle:hover,
  .author-section-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .author-profile-intro {
    max-width: 760px;
    margin: 20px 0 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    line-height: 1.65;
  }

  .author-section {
    padding: 30px 0;
    border-top: 1px solid var(--sf-page-border, rgba(255,255,255,.08));
  }

  .author-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 18px;
  }

  .author-section-header h2 {
    margin: 0;
    color: var(--sf-page-heading, #F5F5F5);
    font-family: 'Newsreader', Georgia, serif;
    font-size: clamp(25px, 3vw, 32px);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -.02em;
  }

  .author-section-header p {
    margin: 7px 0 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    line-height: 1.55;
  }

  .author-section-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    flex-shrink: 0;
    color: var(--sf-page-accent, #35C9C1);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
  }

  .author-empty-message,
  .author-archive-empty-state {
    margin: 0;
    padding: 16px 0;
    color: var(--sf-page-copy, #A1A9B6);
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 14px;
    line-height: 1.65;
  }

  /* Latest Resources mirrors the homepage Recent section. */
  .author-latest-section {
    padding-top: 32px;
    padding-bottom: 32px;
    overflow: hidden;
  }

  .author-latest-section .recent-work-container {
    width: min(var(--max, 1180px), calc(100% - 48px));
    margin-inline: auto;
  }

  .author-latest-section .recent-works-header {
    margin-bottom: 18px;
    display: flex;
    align-items: center;
  }

  .author-latest-section .recent-works-header-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #F5F5F5;
    transition: color 0.18s ease;
  }

  .author-latest-section .recent-works-title {
    margin: 0 0 8px;
    color: #FFFFFF;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: clamp(20px, 3.2vw, 25px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .author-latest-section .recent-works-chevron {
    display: block;
    width: 16px;
    height: 24px;
    flex: 0 0 16px;
    color: #F5F5F5;
    opacity: 0.58;
    overflow: visible;
    align-self: center;
    transform: translateY(1px);
  }

  .author-latest-section .recent-work-carousel-wrapper {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
  }

  .author-latest-section .recent-work-carousel-track {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    gap: 20px;
    overflow-x: auto;
    overflow-y: hidden;
    white-space: normal;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 4px 2px 12px;
    width: 100%;
  }

  .author-latest-section .recent-work-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .author-latest-section .recent-work-card,
  .author-latest-section .recent-work-card:hover,
  .author-latest-section .recent-work-card:active,
  .author-latest-section .recent-work-card:focus {
    flex: 0 0 calc((100% - 40px) / 3.25);
    min-width: 280px;
    max-width: 380px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    transform: none;
    transition: none;
    text-decoration: none;
  }

  .author-latest-section .recent-work-thumb-wrap {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #04070D;
    flex-shrink: 0;
  }

  .author-latest-section .recent-work-thumb-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .author-latest-section .recent-work-card:hover .recent-work-thumb-img {
    transform: scale(1.03);
  }

  .author-latest-section .recent-work-card-body {
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .author-latest-section .recent-work-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 7px;
    width: 100%;
  }

  .author-latest-section .recent-work-meta-category {
    color: #9298A4;
    background: transparent;
    border: 0;
    border-radius: 0;
    padding: 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.07em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .author-latest-section .recent-work-meta-date {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: #9298A4;
    font-family: 'JetBrains Mono', monospace;
    font-size: 10.5px;
    font-weight: 500;
    white-space: nowrap;
    margin: 0;
    line-height: 1.2;
  }

  .author-latest-section .recent-work-meta-calendar {
    display: block;
    width: 14px;
    height: 14px;
    flex: 0 0 14px;
  }

  .author-latest-section .recent-work-card-title,
  .author-latest-section .recent-work-card:hover .recent-work-card-title {
    color: #F5F5F5;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.38;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .author-latest-section .recent-work-nav-btn {
    position: absolute;
    top: calc(50% - 16px);
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
