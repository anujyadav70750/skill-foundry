---
import BaseLayout from '../layouts/BaseLayout.astro';

const subjectOptions = [
  'General question',
  'Question not covered in FAQs',
  'Website or technical issue',
  'Question about a resource',
  'Feedback or suggestion',
  'Collaboration or business enquiry',
  'Question about these terms',
  'Permission to use Skill Foundry content',
  'Report a terms or copyright concern',
  'Question about this Privacy Policy',
  'Request to access, correct or delete personal information',
  'Question about information handling',
  'Report a privacy concern',
  'Other'
];

const requestedSubject = Astro.url.searchParams.get('subject') || '';
const selectedSubject = subjectOptions.includes(requestedSubject) ? requestedSubject : '';
---
<BaseLayout
  title="Contact | Skill Foundry"
  description="Have a question, found an issue, or want to share feedback? Send us a message."
  canonical="https://hub.skillfoundry-web.workers.dev/contact/"
>
  <div class="contact-page">
    <div class="contact-container">
      <section class="contact-card" aria-labelledby="contact-title">
        <div class="contact-heading">
          <div class="contact-heading-copy">
            <p class="contact-eyebrow">CONTACT</p>
            <h1 id="contact-title">Send us a message</h1>
            <p class="contact-intro">Have a question about a resource, need help with something on Skill Foundry, or want to share feedback? Use the form below to tell us what you need. Choose the subject that best matches your enquiry so we can understand your message.</p>
          </div>
        </div>

        <section class="contact-help" aria-labelledby="contact-help-title">
          <h2 id="contact-help-title">How can we help?</h2>
          <div class="contact-help-list">
            <div class="contact-help-item">
              <span class="contact-help-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 5.5v16M8 7h8M8 11h8"/></svg></span>
              <div><h3>Resources and tutorials</h3><p>Questions about guides, instructions or practical projects.</p></div>
            </div>
            <div class="contact-help-item">
              <span class="contact-help-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8z"/></svg></span>
              <div><h3>Feedback and suggestions</h3><p>Share ideas, report issues or suggest improvements.</p></div>
            </div>
            <div class="contact-help-item">
              <span class="contact-help-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="10" cy="7" r="4"/><path d="M20 8v6m-3-3h6"/></svg></span>
              <div><h3>Business and collaboration</h3><p>Discuss partnerships, collaborations or other enquiries.</p></div>
            </div>
          </div>
        </section>

        <div class="contact-form-intro">
          <h2>Your message</h2>
          <p>Please provide enough detail to help us understand your enquiry. Fields marked (*) are required.</p>
        </div>

        <form class="contact-form" id="contact-form" novalidate>
          <label class="contact-field">
            <span class="contact-field-title">Name <span class="contact-required" aria-hidden="true">*</span></span>
            <input name="name" type="text" autocomplete="name" maxlength="100" placeholder="Your name" required />
          </label>

          <label class="contact-field">
            <span class="contact-field-title">Email <span class="contact-required" aria-hidden="true">*</span></span>
            <input name="email" type="email" autocomplete="email" maxlength="254" placeholder="you@example.com" required />
          </label>

          <div class="contact-field" id="contact-subject-field">
            <span class="contact-field-title" id="contact-subject-label">Subject <span class="contact-required" aria-hidden="true">*</span></span>
            <input type="hidden" name="subject" id="contact-subject" value={selectedSubject} />
            <button type="button" class="contact-subject-trigger" id="contact-subject-trigger" aria-labelledby="contact-subject-label contact-subject-value" aria-haspopup="listbox" aria-expanded="false">
              <span id="contact-subject-value">{selectedSubject || 'Choose a subject'}</span>
              <svg class="contact-subject-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div class="contact-subject-menu" id="contact-subject-menu" role="listbox" aria-labelledby="contact-subject-label" hidden>
              {subjectOptions.map((subject) => (
                <button type="button" class="contact-subject-option" role="option" aria-selected={selectedSubject === subject} data-subject={subject}>{subject}</button>
              ))}
            </div>
          </div>

          <label class="contact-field" id="contact-other-wrap" hidden>
            <span class="contact-field-title">Enter your subject <span class="contact-required" aria-hidden="true">*</span></span>
            <input name="otherSubject" id="contact-other" type="text" maxlength="160" placeholder="Write your subject" />
          </label>

          <label class="contact-field">
            <span class="contact-field-title">Message <span class="contact-required" aria-hidden="true">*</span></span>
            <textarea name="message" rows="4" maxlength="5000" placeholder="Write your message here…" required></textarea>
          </label>

          <label class="contact-honey" aria-hidden="true">
            Website
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>

          <div class="contact-actions">
            <button type="submit" class="contact-submit" id="contact-submit">Send message <span aria-hidden="true">→</span></button>
            <p class="contact-status" id="contact-status" role="status" aria-live="polite"></p>
          </div>
        </form>
      </section>
    </div>
  </div>

  <script is:inline>
    (() => {
      const form = document.getElementById('contact-form');
      if (!form || form.dataset.ready) return;
      form.dataset.ready = 'true';

      const subject = form.querySelector('#contact-subject');
      const subjectField = form.querySelector('#contact-subject-field');
      const subjectTrigger = form.querySelector('#contact-subject-trigger');
      const subjectValue = form.querySelector('#contact-subject-value');
      const subjectMenu = form.querySelector('#contact-subject-menu');
      const subjectOptions = [...form.querySelectorAll('.contact-subject-option')];
      const otherWrap = form.querySelector('#contact-other-wrap');
      const other = form.querySelector('#contact-other');
      const submit = form.querySelector('#contact-submit');
      const status = form.querySelector('#contact-status');

      const closeSubjectMenu = () => {
        subjectMenu.hidden = true;
        subjectField.classList.remove('is-menu-open');
        subjectTrigger.setAttribute('aria-expanded', 'false');
        subjectTrigger.querySelector('svg').classList.remove('is-open');
      };

      const openSubjectMenu = () => {
        subjectMenu.hidden = false;
        subjectField.classList.add('is-menu-open');
        subjectTrigger.setAttribute('aria-expanded', 'true');
        subjectTrigger.querySelector('svg').classList.add('is-open');
      };

      const updateSubject = (value) => {
        subject.value = value;
        subjectValue.textContent = value || 'Choose a subject';
        subjectOptions.forEach((option) => {
          option.setAttribute('aria-selected', String(option.dataset.subject === value));
        });
        const isOther = value === 'Other';
        otherWrap.hidden = !isOther;
        other.required = isOther;
        if (!isOther) other.value = '';
        closeSubjectMenu();
      };

      subjectTrigger.addEventListener('click', () => {
        if (subjectMenu.hidden) openSubjectMenu();
        else closeSubjectMenu();
      });

      subjectOptions.forEach((option, index) => {
        option.addEventListener('click', () => {
          updateSubject(option.dataset.subject);
          subjectTrigger.focus();
        });
        option.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            const direction = event.key === 'ArrowDown' ? 1 : -1;
            subjectOptions[(index + direction + subjectOptions.length) % subjectOptions.length].focus();
          }
          if (event.key === 'Escape') {
            closeSubjectMenu();
            subjectTrigger.focus();
          }
        });
      });

      document.addEventListener('click', (event) => {
        if (!subjectField.contains(event.target)) closeSubjectMenu();
      });

      subjectTrigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          openSubjectMenu();
          subjectOptions[0]?.focus();
        }
      });

      subject.addEventListener('change', () => updateSubject(subject.value));

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (!subject.value) {
          status.textContent = 'Please choose a subject.';
          status.className = 'contact-status error';
          subjectTrigger.focus();
          return;
        }
        if (!form.reportValidity()) return;

        const email = form.elements.email.value.trim();
        if (email.length > 254 || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          status.textContent = 'Enter a valid email address.';
          status.className = 'contact-status error';
          form.elements.email.focus();
          return;
        }

        const chosenSubject = subject.value === 'Other' ? other.value.trim() : subject.value;
        if (!chosenSubject) {
          other.reportValidity();
          return;
        }

        submit.disabled = true;
        status.textContent = 'Sending message…';
        status.className = 'contact-status';

        const data = {
          name: form.elements.name.value.trim(),
          email,
          subject: chosenSubject,
          message: form.elements.message.value.trim(),
          website: form.elements.website.value
        };

        try {
          const response = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.ok) {
            throw new Error(result.error || 'We could not send your message. Please try again.');
          }

          form.reset();
          updateSubject('');
          otherWrap.hidden = true;
          other.required = false;
          status.textContent = 'Message sent successfully. Thanks for reaching out.';
          status.className = 'contact-status success';
        } catch (error) {
          status.textContent = error?.message || 'We could not send your message. Please try again later.';
          status.className = 'contact-status error';
        } finally {
          submit.disabled = false;
        }
      });
    })();
  </script>
</BaseLayout>

<style>
  .contact-page { min-height:70vh; padding:clamp(42px,5vw,64px) 20px 18px; box-sizing:border-box; }
  .contact-container { width:100%; max-width:820px; margin:0 auto; }
  .contact-card { box-sizing:border-box; padding:0; border:0; border-radius:0; background:transparent; color:#F8FAFC; box-shadow:none; }
  .contact-heading { display:flex; align-items:center; justify-content:center; gap:14px; margin:0 auto 34px; text-align:center; }
  .contact-heading-copy { width:100%; max-width:650px; min-width:0; }
  .contact-eyebrow { margin:0 0 10px; color:#3DD6C8; font-family:'JetBrains Mono',monospace; font-size:10.5px; font-weight:700; letter-spacing:.14em; }
  .contact-heading h1 { margin:0; color:var(--text-primary,#FFFFFF); font-family:'Newsreader','Playfair Display',Georgia,serif; font-size:clamp(32px,5vw,46px); font-weight:400; line-height:1.15; letter-spacing:-.025em; }
  .contact-intro { max-width:620px; margin:10px auto 0; color:var(--text-secondary,#94A3B8); font-size:clamp(14px,1.8vw,16px); line-height:1.6; }
  .contact-help { margin:0; padding:0 0 30px; border:0; border-radius:0; background:transparent; }
  .contact-help > h2,
  .contact-form-intro h2 { margin:0; color:#F8FAFC; font-size:clamp(18px,2.8vw,20px); line-height:1.3; font-weight:700; letter-spacing:-.02em; }
  .contact-help-list { display:grid; gap:0; margin-top:14px; }
  .contact-help-item { display:flex; align-items:flex-start; gap:14px; min-width:0; padding:16px 0; border-bottom:1px solid rgba(255,255,255,.09); }
  .contact-help-item:last-child { border-bottom:0; }
  .contact-help-icon { display:grid; flex:0 0 42px; width:42px; height:42px; place-items:center; border:1px solid rgba(61,214,200,.18); border-radius:11px; background:rgba(61,214,200,.07); color:#3DD6C8; }
  .contact-help-icon svg { width:20px; height:20px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .contact-help-item h3 { margin:0; color:#E2E8F0; font-size:15px; line-height:1.45; font-weight:700; letter-spacing:-.01em; }
  .contact-help-item p { margin:4px 0 0; color:#94A3B8; font-size:14px; line-height:1.6; font-weight:400; }
  .contact-form-intro { margin:0 0 20px; padding-top:28px; border-top:1px solid rgba(255,255,255,.10); }
  .contact-form-intro p { margin:7px 0 0; color:#94A3B8; font-size:14px; line-height:1.6; font-weight:400; }
  .contact-form { display:flex; flex-direction:column; gap:18px; max-width:720px; }
  .contact-field { position:relative; display:flex; min-width:0; flex-direction:column; gap:8px; color:#CBD5E1; font-size:14px; font-weight:650; }
  .contact-field-title { display:inline-flex; width:fit-content; align-items:center; gap:4px; min-height:20px; color:#CBD5E1; line-height:1.35; }
  .contact-required {
    flex: 0 0 auto;
    color: #F87171;
    font-size: 14px;
    font-weight: 800;
  }
  .contact-form input,
  .contact-form textarea {
    display: block;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    min-height: 43px;
    margin: 0;
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, .13);
    border-radius: 9px;
    background-color: #070A10;
    color: #F8FAFC;
    font-family: inherit;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    outline: none;
    color-scheme: dark;
  }
  .contact-subject-trigger {
    display: flex;
    width: 100%;
    min-height: 43px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    box-sizing: border-box;
    padding: 10px 12px;
    border: 1px solid rgba(255, 255, 255, .13);
    border-radius: 9px;
    background: #070A10;
    color: #F8FAFC;
    font-family: inherit;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    text-align: left;
    cursor: pointer;
  }
  .contact-subject-trigger:focus-visible {
    outline: none;
    border-color: #3DD6C8;
    box-shadow: 0 0 0 3px rgba(61, 214, 200, .1);
  }
  .contact-subject-chevron {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #CBD5E1;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform .18s ease;
  }
  .contact-subject-chevron.is-open { transform: rotate(180deg); }
  .contact-field.is-menu-open {
    z-index: 20;
  }
  .contact-subject-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 30;
    width: 100%;
    max-height: 260px;
    margin-top: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid rgba(148, 163, 184, .24);
    border-radius: 10px;
    background: #111720;
    box-shadow: 0 12px 28px rgba(0, 0, 0, .32);
    scrollbar-width: thin;
    scrollbar-color: #465365 transparent;
  }
  .contact-subject-menu[hidden] { display: none !important; }
  .contact-subject-option {
    display: block;
    width: 100%;
    min-height: 42px;
    padding: 11px 13px;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, .07);
    background: transparent;
    color: #DCE3EC;
    font: inherit;
    font-size: 13px;
    line-height: 1.4;
    text-align: left;
    white-space: normal;
    overflow-wrap: anywhere;
    cursor: pointer;
  }
  .contact-subject-option:last-child { border-bottom: 0; }
  .contact-subject-option:hover,
  .contact-subject-option:focus-visible,
  .contact-subject-option[aria-selected="true"] {
    outline: none;
    background: #102638;
    color: #55C8BE;
  }
  .contact-form textarea { min-height: 125px; resize: vertical; }
  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: #3DD6C8;
    box-shadow: 0 0 0 3px rgba(61, 214, 200, .1);
  }
  .contact-form input::placeholder,
  .contact-form textarea::placeholder { color: #778397; opacity: 1; }
  .contact-form input:-webkit-autofill,
  .contact-form input:-webkit-autofill:hover,
  .contact-form input:-webkit-autofill:focus {
    -webkit-text-fill-color: #F8FAFC;
    caret-color: #F8FAFC;
    -webkit-box-shadow: 0 0 0 1000px #070A10 inset;
    box-shadow: 0 0 0 1000px #070A10 inset;
    border: 1px solid rgba(255, 255, 255, .13);
  }
  .contact-form [hidden] { display: none !important; }
  .contact-honey {
    position: absolute !important;
    left: -10000px !important;
    width: 1px !important;
    height: 1px !important;
    overflow: hidden !important;
  }
  .contact-actions {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-top: 2px;
  }
  .contact-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 42px;
    padding: 0 18px;
    border: 1px solid #A8C8DF;
    border-radius: 9px;
    background: #C5DDED;
    color: #183247;
    font-family: inherit;
    font-size: 13px;
    font-weight: 750;
    cursor: pointer;
    transition: opacity .15s ease, transform .15s ease;
  }
  .contact-submit:hover:not(:disabled) {
    background: #C5DDED;
    border-color: #A8C8DF;
    color: #183247;
    transform: translateY(-1px);
  }
  .contact-submit:disabled { opacity: .55; cursor: wait; }
  .contact-status {
    min-width: 0;
    margin: 0;
    color: #94A3B8;
    font-size: 12px;
    line-height: 1.4;
  }
  .contact-status.success { color: #34D399; }
  .contact-status.error { color: #F87171; }

  :global([data-theme="light"]) .contact-card,
  :global(html.light-theme) .contact-card { color:#172033; }
  :global([data-theme="light"]) .contact-heading h1,
  :global(html.light-theme) .contact-heading h1,
  :global([data-theme="light"]) .contact-help > h2,
  :global(html.light-theme) .contact-help > h2,
  :global([data-theme="light"]) .contact-form-intro h2,
  :global(html.light-theme) .contact-form-intro h2 { color: #172033; }
  :global([data-theme="light"]) .contact-help-item,
  :global(html.light-theme) .contact-help-item { border-bottom-color:rgba(15,23,42,.10); }
  :global([data-theme="light"]) .contact-form-intro,
  :global(html.light-theme) .contact-form-intro { border-top-color:rgba(15,23,42,.12); }
  :global([data-theme="light"]) .contact-help-item h3,
  :global(html.light-theme) .contact-help-item h3 { color: #334155; }
  :global([data-theme="light"]) .contact-field-title,
  :global(html.light-theme) .contact-field-title { color: #334155; }
  :global([data-theme="light"]) .contact-form input,
  :global([data-theme="light"]) .contact-form textarea,
  :global(html.light-theme) .contact-form input,
  :global(html.light-theme) .contact-form textarea {
    background-color: #F8FAFC;
    border-color: #CBD5E1;
    color: #172033;
    color-scheme: light;
  }
  :global([data-theme="light"]) .contact-subject-trigger,
  :global(html.light-theme) .contact-subject-trigger {
    background: #F8FAFC;
    border-color: #CBD5E1;
    color: #172033;
  }
  :global([data-theme="light"]) .contact-subject-chevron,
  :global(html.light-theme) .contact-subject-chevron { stroke: #334155; }
  :global([data-theme="light"]) .contact-subject-menu,
  :global(html.light-theme) .contact-subject-menu {
    background: #FFFFFF;
    border-color: #CBD5E1;
    box-shadow: 0 12px 28px rgba(15, 23, 42, .14);
  }
  :global([data-theme="light"]) .contact-subject-option,
  :global(html.light-theme) .contact-subject-option {
    color: #334155;
    border-bottom-color: rgba(15, 23, 42, .08);
  }
  :global([data-theme="light"]) .contact-subject-option:hover,
  :global([data-theme="light"]) .contact-subject-option:focus-visible,
  :global([data-theme="light"]) .contact-subject-option[aria-selected="true"],
  :global(html.light-theme) .contact-subject-option:hover,
  :global(html.light-theme) .contact-subject-option:focus-visible,
  :global(html.light-theme) .contact-subject-option[aria-selected="true"] {
    background: #EAF5F7;
    color: #087E79;
  }
  :global([data-theme="light"]) .contact-form input::placeholder,
  :global([data-theme="light"]) .contact-form textarea::placeholder,
  :global(html.light-theme) .contact-form input::placeholder,
  :global(html.light-theme) .contact-form textarea::placeholder { color: #94A3B8; }
  :global([data-theme="light"]) .contact-form input:-webkit-autofill,
  :global(html.light-theme) .contact-form input:-webkit-autofill {
    -webkit-text-fill-color: #172033;
    caret-color: #172033;
    -webkit-box-shadow: 0 0 0 1000px #F8FAFC inset;
    box-shadow: 0 0 0 1000px #F8FAFC inset;
  }
  :global([data-theme="light"]) .contact-submit,
  :global(html.light-theme) .contact-submit {
    background: #C5DDED;
    border-color: #A8C8DF;
    color: #183247;
  }

  @media (max-width: 520px) {
    .contact-page { padding:34px 16px 12px; }
    .contact-heading { margin-bottom:28px; }
    .contact-form { gap:16px; }
    .contact-help { padding-bottom:24px; }
    .contact-help-item { padding:14px 0; }
    .contact-field { gap: 6px; }
    .contact-form input,
    .contact-subject-trigger { min-height: 42px; padding-top: 9px; padding-bottom: 9px; }
    .contact-form textarea { min-height: 120px; }
    .contact-actions { align-items: stretch; flex-direction: column; }
    .contact-submit { width: 100%; min-height: 44px; }
  }
  @media (max-width: 360px) {
    .contact-page { padding-inline:14px; }
    .contact-help-icon { flex-basis:38px; width:38px; height:38px; }
  }
</style>
