---
import { getCollection } from 'astro:content';
import { SKILL_FOUNDRY_AUTHOR_ID } from '../../lib/author';
import { AUTHOR_PROFILES } from '../../data/authors';
import AuthorChannelPage from '../../components/authors/AuthorChannelPage.astro';
import { resourceDisplayDate } from '../../lib/resource';

export async function getStaticPaths() {
  const allResources = await getCollection('resources');
  const published = allResources.filter((resource) => !('draft' in resource.data && resource.data.draft === true));
  return Object.values(AUTHOR_PROFILES)
    .filter((profile) => profile.id !== SKILL_FOUNDRY_AUTHOR_ID)
    .map((profile) => ({
      params: { authorId: profile.id },
      props: {
        profile,
        resources: published
          .filter((resource) => resource.data.authorId === profile.id)
          .sort((a, b) => resourceDisplayDate(b).valueOf() - resourceDisplayDate(a).valueOf())
      }
    }));
}
const { profile, resources } = Astro.props;
---
<AuthorChannelPage profile={profile} resources={resources} basePath={'/authors/' + profile.id + '/'} view="home" />
