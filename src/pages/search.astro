<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://hub.skillfoundry-web.workers.dev/resources/" />
    <meta name="description" content="Open Skill Foundry resource search to find practical tutorials, workflows and tools by topic or keyword." />
    <meta name="theme-color" content="#090D14" />
    <title>Opening Resource Search | Skill Foundry</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Skill Foundry" />
    <meta property="og:url" content="https://hub.skillfoundry-web.workers.dev/resources/" />
    <meta property="og:title" content="Search Practical Resources | Skill Foundry" />
    <meta property="og:description" content="Find practical tutorials, workflows and tools in the Skill Foundry resource library." />
    <meta property="og:image" content="https://hub.skillfoundry-web.workers.dev/og-image.svg" />
    <meta property="og:image:alt" content="Skill Foundry — Practical Skills Platform &amp; Resource Library" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Search Practical Resources | Skill Foundry" />
    <meta name="twitter:description" content="Find practical tutorials, workflows and tools in the Skill Foundry resource library." />
    <meta name="twitter:image" content="https://hub.skillfoundry-web.workers.dev/og-image.svg" />
    <script is:inline>
      (() => {
        const incoming = new URLSearchParams(window.location.search);
        const target = new URL('/resources/', window.location.origin);

        for (const key of ['q', 'category', 'sort']) {
          const value = incoming.get(key);
          if (value) target.searchParams.set(key, value);
        }

        target.searchParams.set('focus', 'search');
        window.location.replace(`${target.pathname}${target.search}${window.location.hash}`);
      })();
    </script>
  </head>
  <body>
    <main>
      <p>Search is now part of the resource library.</p>
      <p><a href="/resources/?focus=search">Open resource search</a></p>
    </main>
  </body>
</html>
