---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { resourceSlug, resourceThumbnail, resourceImageAlt } from '../lib/resource';

// Single Source of Truth: Published resources sorted by date descending (Newest first)
const allResources = await getCollection('resources');
const publishedResources = allResources
  .filter((r) => !('draft' in r.data && r.data.draft === true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Server-side fallback computation
const rawFrom = Astro.url.searchParams.get('from');
let fallbackBackUrl = '/resources/';
if (rawFrom && rawFrom.startsWith('/') && !rawFrom.startsWith('//') && !rawFrom.startsWith('/search')) {
  fallbackBackUrl = rawFrom;
}
---

<BaseLayout
  title="Search Workflows & Blueprints | Skill Foundry"
  description="Search and discover practical AI workflows, step-by-step blueprints, and executable systems from Skill Foundry."
  canonical="https://skillfoundry.dev/search/"
  hideHeader={true}
  hideHeaderSearch={true}
  hideFooter={true}
>
  <!-- Persistent Fixed "< Back" control at top-left -->
  <aside class="search-back-fixed" aria-label="Navigation back">
    <a href={fallbackBackUrl} class="search-back-btn" id="search-back-btn" aria-label="Back">
      <svg class="search-back-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M10 13L5 8l5-5"/>
      </svg>
      <span>Back</span>
    </a>
  </aside>

  <div class="search-page-container">
    <div class="search-page-inner">
      <!-- 1. SEARCH BAR NEAR THE TOP -->
      <section class="search-toolbar-section">
        <form class="search-bar-form" id="search-bar-form" role="search" onsubmit="return false;">
          <div class="search-icon-box" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>

          <label class="sr-only" for="search-page-input">Search workflows, tools, or topics</label>
          <input
            id="search-page-input"
            name="q"
            type="text"
            inputmode="search"
            placeholder="Search workflows, tools, or topics…"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
            autofocus
          />

          <button
            class="search-clear-action-btn"
            id="search-clear-action-btn"
            type="button"
            aria-label="Clear search text"
            hidden
          >
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </form>
      </section>

      <!-- 2. RESOURCE CARDS IMMEDIATELY UNDERNEATH -->
      <section class="search-results-section">
        <div class="search-cards-list" id="search-cards-list">
          {publishedResources.map((resource) => {
            const slug = resourceSlug(resource);
            const thumbnail = resourceThumbnail(resource);
            const alt = resourceImageAlt(resource);
            const toolsList = Array.isArray(resource.data.toolsUsed)
              ? resource.data.toolsUsed.map((t) => t.name).join(' ')
              : '';
            const searchBlob = [
              resource.data.title,
              resource.data.description,
              resource.data.category,
              resource.data.tool,
              toolsList,
              ...(resource.data.tags || [])
            ]
              .filter(Boolean)
              .join(' ')
              .toLowerCase();

            return (
              <a
                class="search-resource-card"
                href={`/resources/${slug}/`}
                aria-label={`Open ${resource.data.title}`}
                data-search={searchBlob}
              >
                <div class="card-thumb-wrap">
                  <img class="card-thumb-img" src={thumbnail} alt={alt} loading="lazy" />
                </div>

                <div class="card-content-wrap">
                  <h2 class="card-title">
                    <span class="searchable-text">{resource.data.title}</span>
                  </h2>
                  <p class="card-desc">
                    <span class="searchable-text">{resource.data.description}</span>
                  </p>
                </div>
              </a>
            );
          })}
        </div>

        <!-- 3. COMPACT EMPTY STATE (Shown only when 0 items match) -->
        <div class="search-empty-box" id="search-empty-box" hidden>
          <div class="empty-icon-circle" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              <line x1="8" y1="11" x2="14" y2="11"></line>
            </svg>
          </div>
          <p class="empty-text">No matching resources found</p>
          <button class="empty-clear-action" id="empty-clear-action" type="button">
            Clear search
          </button>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     DEDICATED MINIMAL SEARCH PAGE STYLES
     ========================================================================== */
  :global(body.no-header) {
    background:
      radial-gradient(ellipse 80% 55% at 50% -10%, rgba(56, 189, 248, 0.12) 0%, transparent 60%),
      radial-gradient(circle at 80% 20%, rgba(255, 102, 0, 0.06) 0%, transparent 40%),
      #080D14 !important;
    padding-top: 0 !important;
    min-height: 100vh;
  }

  .search-page-container {
    background: transparent;
    color: #F8FAFC;
    min-height: 100vh;
    padding: clamp(24px, 3.5vw, 36px) 16px 48px;
    box-sizing: border-box;
  }

  .search-page-inner {
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
  }

  /* Persistent Top-Left Back Control */
  .search-back-fixed {
    position: fixed;
    top: max(16px, env(safe-area-inset-top, 16px));
    left: max(18px, env(safe-area-inset-left, 18px));
    z-index: 100;
    pointer-events: auto;
  }

  .search-back-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 31px;
    padding: 5px 12px;
    border-radius: 9999px;
    background: #141D2D;
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #CBD5E1;
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.40);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    white-space: nowrap;
    user-select: none;
  }

  .search-back-btn:hover {
    background: #1B263B;
    border-color: rgba(56, 189, 248, 0.45);
    color: #FFFFFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45), 0 0 10px rgba(56, 189, 248, 0.15);
  }

  .search-back-chevron {
    flex-shrink: 0;
    display: block;
    transition: transform 0.18s ease;
  }

  .search-back-btn:hover .search-back-chevron {
    transform: translateX(-1px);
  }

  .search-back-btn:active {
    transform: scale(0.96);
  }

  /* 1. HORIZONTAL SEARCH BAR NEAR THE TOP */
  .search-toolbar-section {
    margin-top: clamp(32px, 5vw, 44px);
    margin-bottom: 20px;
    width: 100%;
  }

  .search-bar-form {
    position: relative;
    display: flex;
    align-items: center;
    background: rgba(13, 22, 38, 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 9999px;
    padding: 4px 12px;
    min-height: 44px;
    height: 44px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    box-sizing: border-box;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
  }

  .search-bar-form:focus-within {
    border-color: rgba(56, 189, 248, 0.55);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.14), 0 8px 24px rgba(0, 0, 0, 0.45);
  }

  .search-icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #38BDF8;
    flex-shrink: 0;
    margin-right: 8px;
  }

  .search-bar-form input {
    flex: 1 1 auto;
    background: transparent;
    border: none;
    outline: none;
    color: #FFFFFF;
    font-size: 14.5px;
    font-family: inherit;
    padding: 0;
    min-width: 0;
    height: 100%;
    box-sizing: border-box;
  }

  .search-bar-form input::placeholder {
    color: #64748B;
  }

  .search-bar-form input::-webkit-search-cancel-button,
  .search-bar-form input::-webkit-search-decoration,
  .search-bar-form input::-webkit-search-results-button,
  .search-bar-form input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }

  .search-clear-action-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94A3B8;
    width: 26px;
    height: 26px;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    transition: all 0.15s ease;
  }

  .search-clear-action-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
  }

  /* 2. COMPACT HORIZONTAL RESOURCE CARDS */
  .search-results-section {
    width: 100%;
  }

  .search-cards-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
  }

  .search-resource-card {
    background: linear-gradient(180deg, rgba(16, 26, 44, 0.75) 0%, rgba(9, 15, 27, 0.9) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 13px;
    padding: clamp(7px, 0.9vw, 10px);
    gap: clamp(10px, 1.5vw, 16px);
    overflow: hidden;
    display: flex;
    flex-direction: row;
    align-items: center;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    box-sizing: border-box;
    outline: none;
  }

  .search-resource-card:hover {
    transform: translateY(-2px);
    border-color: rgba(56, 189, 248, 0.35);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5), 0 0 16px rgba(56, 189, 248, 0.06);
  }

  .search-resource-card:focus-visible {
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.5);
  }

  .card-thumb-wrap {
    position: relative;
    flex: 0 0 clamp(200px, 34%, 280px);
    aspect-ratio: 16 / 9;
    background: #04070D;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    overflow: hidden;
    display: block;
  }

  .card-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .search-resource-card:hover .card-thumb-img {
    transform: scale(1.03);
  }

  .card-content-wrap {
    padding: 1px 2px 1px 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1 1 auto;
    min-width: 0;
    box-sizing: border-box;
  }

  .card-title {
    font-family: 'Newsreader', 'Playfair Display', Georgia, serif;
    font-size: clamp(15.5px, 1.5vw, 18px);
    font-weight: 500;
    color: #FFFFFF;
    margin: 0 0 3px 0;
    line-height: 1.26;
    letter-spacing: -0.012em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .search-resource-card:hover .card-title {
    color: #38BDF8;
  }

  .card-desc {
    color: #94A3B8;
    font-size: 13px;
    line-height: 1.48;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* 3. COMPACT EMPTY STATE */
  .search-empty-box {
    background: linear-gradient(180deg, rgba(16, 26, 44, 0.45) 0%, rgba(9, 15, 27, 0.65) 100%);
    border: 1px dashed rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    padding: 28px 16px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-top: 10px;
  }

  .empty-icon-circle {
    color: #64748B;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
  }

  .empty-text {
    font-size: 14.5px;
    font-weight: 500;
    color: #CBD5E1;
    margin: 0 0 12px 0;
  }

  .empty-clear-action {
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.35);
    color: #38BDF8;
    font-size: 12px;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .empty-clear-action:hover {
    background: rgba(56, 189, 248, 0.18);
    border-color: rgba(56, 189, 248, 0.6);
    color: #7DD3FC;
  }

  /* Search Highlight */
  :global(.search-hl) {
    background: rgba(56, 189, 248, 0.25);
    color: #7DD3FC;
    padding: 0 2px;
    border-radius: 3px;
  }

  /* Force hidden */
  :global([hidden]) {
    display: none !important;
  }

  /* ==========================================================================
     RESPONSIVE BREAKPOINTS (Mobile & Small screens)
     ========================================================================== */
  @media (max-width: 640px) {
    .search-back-fixed {
      top: max(14px, env(safe-area-inset-top, 14px));
      left: max(15px, env(safe-area-inset-left, 15px));
    }

    .search-back-btn {
      min-height: 29px;
      padding: 4px 11px;
      font-size: 12px;
      gap: 5px;
    }

    .search-toolbar-section {
      margin-top: clamp(28px, 8vw, 38px);
      margin-bottom: 16px;
    }

    .search-cards-list {
      gap: 9px;
    }

    .search-resource-card {
      border-radius: 12px;
      padding: 7px;
      gap: 9px;
      flex-direction: row !important;
      align-items: center;
    }

    .card-thumb-wrap {
      flex: 0 0 clamp(118px, 38%, 145px);
      border-radius: 7px;
      aspect-ratio: 16 / 9;
    }

    .card-content-wrap {
      padding: 1px 0;
    }

    .card-title {
      font-size: 13px;
      line-height: 1.24;
      margin: 0 0 2px 0;
      -webkit-line-clamp: 2;
    }

    .card-desc {
      font-size: 11.5px;
      line-height: 1.35;
      margin: 0;
      -webkit-line-clamp: 2;
    }
  }

  @media (max-width: 390px) {
    .search-resource-card {
      padding: 6px;
      gap: 7px;
    }

    .card-thumb-wrap {
      flex: 0 0 clamp(105px, 37%, 120px);
      border-radius: 6px;
    }

    .card-title {
      font-size: 12px;
      line-height: 1.2;
      margin-bottom: 2px;
    }

    .card-desc {
      font-size: 10.5px;
      line-height: 1.3;
      -webkit-line-clamp: 2;
    }
  }
</style>

<script>
  // CONTEXT-AWARE BACK NAVIGATION CONTROLLER
  const backBtn = document.getElementById('search-back-btn') as HTMLAnchorElement | null;
  const urlParams = new URLSearchParams(window.location.search);
  const fromParam = urlParams.get('from');

  const sanitizeReturnUrl = (urlStr: string | null): string | null => {
    if (!urlStr) return null;
    try {
      if (urlStr.startsWith('/') && !urlStr.startsWith('//')) {
        const parsed = new URL(urlStr, window.location.origin);
        if (parsed.pathname !== '/search' && parsed.pathname !== '/search/') {
          return `${parsed.pathname}${parsed.search}${parsed.hash}`;
        }
      }
    } catch (e) {}
    return null;
  };

  let returnTarget = sanitizeReturnUrl(fromParam);

  if (!returnTarget && document.referrer) {
    try {
      const refUrl = new URL(document.referrer);
      if (refUrl.origin === window.location.origin && refUrl.pathname !== '/search' && refUrl.pathname !== '/search/') {
        returnTarget = `${refUrl.pathname}${refUrl.search}${refUrl.hash}`;
      }
    } catch (e) {}
  }

  // Safe fallback if opened without valid originating context
  const finalBackUrl = returnTarget || '/resources/';

  if (backBtn) {
    backBtn.href = finalBackUrl;
    backBtn.addEventListener('click', (e) => {
      e.preventDefault();
      window.location.href = finalBackUrl;
    });
  }

  // CLIENT-SIDE SEARCH CONTROLLER
  const searchInput = document.getElementById('search-page-input') as HTMLInputElement | null;
  const searchClearBtn = document.getElementById('search-clear-action-btn') as HTMLButtonElement | null;
  const emptyClearBtn = document.getElementById('empty-clear-action') as HTMLButtonElement | null;
  const emptySearchBox = document.getElementById('search-empty-box') as HTMLElement | null;
  const cardElements = Array.from(document.querySelectorAll('.search-resource-card')) as HTMLElement[];
  const searchableTargets = Array.from(document.querySelectorAll('.searchable-text')) as HTMLElement[];

  // Store original text for highlighting
  searchableTargets.forEach((el) => {
    el.dataset.original = el.textContent || '';
  });

  // Read initial query parameter from URL
  const initialQuery = urlParams.get('q') || '';
  if (searchInput && initialQuery) {
    searchInput.value = initialQuery;
    if (searchClearBtn) searchClearBtn.hidden = false;
  }

  const escapeRegex = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

  const applyHighlights = (query: string) => {
    const terms = query
      .trim()
      .split(/\s+/)
      .filter((t) => t.length > 1)
      .map(escapeRegex);

    if (!terms.length) {
      searchableTargets.forEach((el) => {
        el.textContent = el.dataset.original || '';
      });
      return;
    }

    const regex = new RegExp(`(${terms.join('|')})`, 'gi');

    searchableTargets.forEach((el) => {
      const original = el.dataset.original || '';
      const parts = original.split(regex);
      el.innerHTML = '';
      parts.forEach((part) => {
        if (regex.test(part)) {
          const mark = document.createElement('mark');
          mark.className = 'search-hl';
          mark.textContent = part;
          el.appendChild(mark);
        } else {
          el.appendChild(document.createTextNode(part));
        }
      });
    });
  };

  const performSearch = (syncUrl = true) => {
    const trimmed = (searchInput?.value || '').trim();
    const queryTerms = trimmed.toLowerCase().split(/\s+/).filter(Boolean);

    let matchCount = 0;

    cardElements.forEach((card) => {
      const cardBlob = card.dataset.search || '';
      const isMatch = !queryTerms.length || queryTerms.every((t) => cardBlob.includes(t));
      card.hidden = !isMatch;
      if (isMatch) matchCount += 1;
    });

    applyHighlights(trimmed);

    if (emptySearchBox) {
      emptySearchBox.hidden = matchCount > 0;
    }

    if (searchClearBtn) {
      searchClearBtn.hidden = trimmed.length === 0;
    }

    if (syncUrl) {
      const url = new URL(window.location.href);
      if (trimmed) url.searchParams.set('q', trimmed);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }
  };

  searchInput?.addEventListener('input', () => performSearch());

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (searchInput.value) {
        searchInput.value = '';
        performSearch();
      }
    }
  });

  const clearQuery = () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      performSearch();
    }
  };

  searchClearBtn?.addEventListener('click', clearQuery);
  emptyClearBtn?.addEventListener('click', clearQuery);

  // Initial search filter on mount if query present
  performSearch(false);
</script>
