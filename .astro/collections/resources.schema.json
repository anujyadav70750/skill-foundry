{
  "$ref": "#/definitions/resources",
  "definitions": {
    "resources": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "toolUrl": {
          "type": "string",
          "format": "uri"
        },
        "toolAffiliate": {
          "type": "boolean",
          "default": false
        },
        "date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "thumbnail": {
          "type": [
            "string",
            "null"
          ]
        },
        "thumbnailRatio": {
          "type": "string",
          "default": "16:9"
        },
        "thumbnailPositionX": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "thumbnailPositionY": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "default": 50
        },
        "heroImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputImage": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputImages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "inputImageRatios": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "resultImages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "resultImageRatios": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "imageAlt": {
          "type": [
            "string",
            "null"
          ]
        },
        "intro": {
          "type": "string"
        },
        "whatItDoes": {
          "type": "string"
        },
        "toolsUsed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "affiliate": {
                "type": "boolean",
                "default": false
              }
            },
            "required": [
              "name",
              "purpose"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "prompt": {
          "type": "string"
        },
        "videoEmbedUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "originalVideoUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "description"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "tips": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "relatedResources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "seoTitle": {
          "type": "string"
        },
        "seoDescription": {
          "type": "string"
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "category",
        "tool",
        "date",
        "prompt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}